//! zap's configuration, in s-expressions. Read in order: the built-in
//! defaults (`DEFAULTS`; `:defaults` shows them), then the nearest `init.zap`
//! in the start directory or above, if trusted (`:trust`), else
//! `~/.config/zap/init.zap` (`$XDG_CONFIG_HOME/zap/init.zap`). Each form is a
//! declaration:
//!
//! | form                                            | what it does                                         |
//! | ----------------------------------------------- | ---------------------------------------------------- |
//! | `(set name value)`                              | an option (`:set` lists them)                        |
//! | `(theme "name" [:inherit "t"] (face :fg ..)..)` | a theme; `(set theme "name")` picks it               |
//! | `(map mode "keys" "command")`                   | an ex command on keys (normal, insert, visual, tree) |
//! | `(command "name" :run ("prog" "arg" ..) ..)`    | an ex command that runs a program (below)            |
//! | `(on "save" "*.ae" "command")`                  | runs a command on an event (save, open)              |
//! | `(filetype "name" :ext (".x") :syntax "s" ..)`  | a file type: its syntax, comment, tabstop, icon      |
//! | `(special "README.md" ..)`                      | names the tree shows in the special face             |
//! | `(addin "name" forms..)`                        | forms that belong together; `(disable "name")`       |
//! | `(load "file.zap")`                             | reads another file (path relative to this one)       |
//!
//! `:run` words may use `%` (the file), `%:h` (its directory), `%:r` (the
//! file without extension), `%:t` (its name), `<cword>` (the word under the
//! cursor) and `<cwd>`. Options: `:save true` (write the buffer first),
//! `:errors true` (output `file:line:col: message` lines become diagnostics:
//! `:cnext`, the gutter), `:reload true` (reread the file after, for
//! formatters), `:show` (`"panel"`, default: last lines under the status
//! line; `"buffer"`: all output in a buffer; `"jump"`: go to the first
//! `file:line:col` printed; `"quiet"`: errors only), `:doc "..."`. Commands
//! run in the background; editing goes on.

import str from "std/string";
import tui from "std/tui";
import fs from "std/fs";
import path from "std/path";
import { Sx, SxKind, SyntaxError, parse } from "sexp.ae";
import { Theme, theme } from "themes/theme.ae";
import base from "themes/base.ae";
import builtin from "themes/builtin.ae";
import process from "std/process";
import state from "state.ae";
import syntax from "syntax.ae";

/// keys that run an ex command in a mode
export struct Keymap {
    export mode: string;
    export keys: string[];
    export cmd: string;
    export addin: string;
}

/// an ex command that runs a program
export struct Command {
    export name: string;
    export run: string[] = [];
    export save: bool = false;
    export errors: bool = false;
    export reload: bool = false;
    export show: string;
    export doc: string = "";
    export addin: string = "";
}

/// a command run on an event for files matching pattern
export struct Hook {
    export event: string;
    export pattern: string;
    export command: string;
    export addin: string;
}

/// a file type: name endings (or whole names), syntax, comment leader,
/// tabstop (0: the option's), icon
export struct FileType {
    export name: string;
    export exts: string[] = [];
    export names: string[] = [];
    export syntax: string = "";
    export comment: string = "";
    export tabstop: i64 = 0;
    export icon: string = "";
    export addin: string = "";
}

/// the whole configuration
export struct Config {
    export number: bool = true;
    export tabstop: i64 = 4;
    export expandtab: bool = true;
    export tree: bool = true;
    export tree_width: i64 = 28;
    export tree_hidden: bool = true;
    export icons: bool = true;
    export tildes: bool = true;         // ~ on rows past the buffer's end
    export gitsigns: bool = true;       // gutter git signs: lines added, changed, removed
    export keyaccel: bool = true;       // held h l Left Right speed up (to 3x)
    export scrolloff: i64 = 3;
    export scrollaccel: i64 = 6;        // a fast wheel scrolls up to this many times as far (1:
                                        //   never)
    export theme: string = "paper";
    export leader: string = "<Space>";
    export ignorecase: bool = true;
    export smartcase: bool = true;
    export regex: bool = false;
    export cmdheight: i64 = 0;
    export resident: i64 = 64;
    export autoindent: bool = true;
    export clipboard: bool = true;      // yanks also go to the terminal clipboard (OSC 52)
    export undofile: bool = true;       // keep undo history for each written file
    export autocomplete: bool = true;   // word menu while typing (insert mode)
    export sheets: bool = true;         // open CSV and TSV files as spreadsheets
    export mermaid: bool = true;        // clicking a Markdown mermaid block draws it
    export themes: Theme[] = [];
    export maps: Keymap[] = [];
    export commands: Command[] = [];
    export hooks: Hook[] = [];
    export filetypes: FileType[] = [];
    export special: string[] = [];
    export addins: string[] = [];
    export disabled: string[] = [];
    export errors: string[] = [];
    export files: string[] = [];         // files read, in order
    export local: string = "";           // local init.zap read instead of the user's ("": none)
    export untrusted: string = "";       // local init.zap skipped as untrusted (:trust)
}

/// option names, as `:set` and `(set ...)` use them
export let OPTIONS: string[] = [
    "number", "tabstop", "expandtab", "tree", "tree-width", "tree-hidden", "icons", "scrolloff",
    "theme", "leader", "ignorecase", "smartcase", "regex", "cmdheight", "resident", "autoindent",
    "clipboard", "undofile", "autocomplete", "sheets", "mermaid", "scrollaccel", "tildes",
    "keyaccel", "gitsigns"
];

impl Config {
    /// sets option name to value (text: "true", "4", "paper") -> the error
    /// ("": none)
    export fn set(mut self: &Config, name: string, value: string) -> string {
        let on: bool = str::eq(value, "true") || str::eq(value, "on") || str::eq(value, "yes");
        let off: bool = str::eq(value, "false") || str::eq(value, "off") || str::eq(value, "no");
        var n: i64 = -1;

        match (str::parse_int(value)) {
            v => { n = v; },
            e: str::BadInt => {}
        }
        match (name) {
            "number" | "nu" => {
                if (on || off) {
                    self.number = on;
                    return "";
                }
            },
            "expandtab" | "et" => {
                if (on || off) {
                    self.expandtab = on;
                    return "";
                }
            },
            "tree" => {
                if (on || off) {
                    self.tree = on;
                    return "";
                }
            },
            "tree-hidden" => {
                if (on || off) {
                    self.tree_hidden = on;
                    return "";
                }
            },
            "icons" => {
                if (on || off) {
                    self.icons = on;
                    return "";
                }
            },
            "tildes" => {
                if (on || off) {
                    self.tildes = on;
                    return "";
                }
            },
            "keyaccel" => {
                if (on || off) {
                    self.keyaccel = on;
                    return "";
                }
            },
            "gitsigns" => {
                if (on || off) {
                    self.gitsigns = on;
                    return "";
                }
            },
            "ignorecase" | "ic" => {
                if (on || off) {
                    self.ignorecase = on;
                    return "";
                }
            },
            "smartcase" | "scs" => {
                if (on || off) {
                    self.smartcase = on;
                    return "";
                }
            },
            "regex" => {
                if (on || off) {
                    self.regex = on;
                    return "";
                }
            },
            "autoindent" | "ai" => {
                if (on || off) {
                    self.autoindent = on;
                    return "";
                }
            },
            "clipboard" => {
                if (on || off) {
                    self.clipboard = on;
                    return "";
                }
            },
            "undofile" | "udf" => {
                if (on || off) {
                    self.undofile = on;
                    return "";
                }
            },
            "autocomplete" | "ac" => {
                if (on || off) {
                    self.autocomplete = on;
                    return "";
                }
            },
            "sheets" => {
                if (on || off) {
                    self.sheets = on;
                    return "";
                }
            },
            "mermaid" => {
                if (on || off) {
                    self.mermaid = on;
                    return "";
                }
            },
            "tabstop" | "ts" => {
                if (n >= 1 && n <= 16) {
                    self.tabstop = n;
                    return "";
                }
            },
            "tree-width" => {
                if (n >= 4) {
                    self.tree_width = n;
                    return "";
                }
            },
            "scrolloff" | "so" => {
                if (n >= 0) {
                    self.scrolloff = n;
                    return "";
                }
            },
            "scrollaccel" => {
                if (n >= 1 && n <= 50) {
                    self.scrollaccel = n;
                    return "";
                }
            },
            "cmdheight" | "ch" => {
                if (n == 0 || n == 1) {
                    self.cmdheight = n;
                    return "";
                }
            },
            "resident" => {
                if (n >= 2) {
                    self.resident = n;
                    return "";
                }
            },
            "theme" => {
                for (let t: &self::&Theme in &self.themes) {
                    if (str::eq(t.name, value)) {
                        self.theme = value;
                        return "";
                    }
                }
                return "no theme \(value)";
            },
            "leader" => {
                if (parse_keys(value, "").len == 1) {
                    self.leader = parse_keys(value, "")[0];
                    return "";
                }
            },
            _ => { return "no option \(name)"; }
        }
        return "\(name) cannot be \(value)";
    }

    /// option name's value, as text
    export fn get(self: &Config, name: string) -> string {
        match (name) {
            "number" | "nu" => { return "\(self.number)"; },
            "expandtab" | "et" => { return "\(self.expandtab)"; },
            "tree" => { return "\(self.tree)"; },
            "tree-hidden" => { return "\(self.tree_hidden)"; },
            "icons" => { return "\(self.icons)"; },
            "tildes" => { return "\(self.tildes)"; },
            "keyaccel" => { return "\(self.keyaccel)"; },
            "gitsigns" => { return "\(self.gitsigns)"; },
            "ignorecase" | "ic" => { return "\(self.ignorecase)"; },
            "smartcase" | "scs" => { return "\(self.smartcase)"; },
            "regex" => { return "\(self.regex)"; },
            "autoindent" | "ai" => { return "\(self.autoindent)"; },
            "clipboard" => { return "\(self.clipboard)"; },
            "undofile" | "udf" => { return "\(self.undofile)"; },
            "autocomplete" | "ac" => { return "\(self.autocomplete)"; },
            "sheets" => { return "\(self.sheets)"; },
            "mermaid" => { return "\(self.mermaid)"; },
            "tabstop" | "ts" => { return "\(self.tabstop)"; },
            "tree-width" => { return "\(self.tree_width)"; },
            "scrolloff" | "so" => { return "\(self.scrolloff)"; },
            "scrollaccel" => { return "\(self.scrollaccel)"; },
            "cmdheight" | "ch" => { return "\(self.cmdheight)"; },
            "resident" => { return "\(self.resident)"; },
            "theme" => { return self.theme; },
            "leader" => { return self.leader; },
            _ => { return ""; }
        }
        return "";
    }

    /// is add-in name disabled?
    export fn disabled_addin(self: &Config, name: string) -> bool {
        if (name.len == 0) {
            return false;
        }

        for (let d: string in &self.disabled) {
            if (str::eq(d, name)) {
                return true;
            }
        }
        return false;
    }

    /// reads the built-in themes other than paper and ink (after the defaults)
    export fn read_builtin_themes(mut self: &Config) -> void {
        for (let k: i64 in 0..builtin::TEXTS.len) {
            self.read(builtin::TEXTS[k], builtin::ORIGINS[k]);
        }
    }

    /// reads text's forms (from file origin), in order
    export fn read(mut self: &Config, text: string, origin: string) -> void {
        self.files.push(origin);
        match (parse(text)) {
            forms => {
                for (let f: &forms::&Sx in &forms) { self.form(f, origin, ""); }
            },
            e: SyntaxError => { self.errors.push("\(origin):\(e.line): \(e.message)"); }
        }
    }

    // reads one form (in add-in addin, if any)
    fn form(mut self: &Config, f: &Sx, origin: string, addin: string) -> void {
        let head: string = f.head();
        let n: i64 = f.items.len;
        let at: string = "\(origin):\(f.line)";

        match (head) {
            "set" => {
                if (n != 3) {
                    self.errors.push("\(at): (set name value)");
                    return;
                }
                let why: string = self.set(f.items[1].text, f.items[2].text);

                if (why.len > 0) { self.errors.push("\(at): \(why)"); }
            },
            "theme" => {
                if (n < 2 || f.items[1].kind != SxKind::Str) {
                    self.errors.push("\(at): (theme \"name\" faces...)");
                    return;
                }
                var errs: string[] = [];

                self.themes.push(theme(f, mut &errs));

                for (let e: string in &errs) { self.errors.push("\(origin): \(e)"); }
            },
            "map" => {
                if (n != 4) {
                    self.errors.push("\(at): (map mode \"keys\" \"command\")");
                    return;
                }
                let mode: string = f.items[1].text;

                if (!str::eq(mode, "normal") && !str::eq(mode, "insert") &&
                    !str::eq(mode, "visual") &&
                    !str::eq(mode, "tree")) {
                    self.errors.push("\(at): no mode \(mode) (normal, insert, visual, tree)");
                    return;
                }
                self.maps.push(Keymap {
                    mode: mode, keys: parse_keys(f.items[2].text, self.leader),
                    cmd: f.items[3].text, addin: addin
                });
            },
            "command" => {
                if (n < 2) {
                    self.errors.push("\(at): (command \"name\" :run (...))");
                    return;
                }
                var c: Command = Command {
                    name: f.items[1].text, show: f.opt(":show") ?? "panel",
                    doc: f.opt(":doc") ?? "",
                    addin: addin
                };

                c.save = str::eq(f.opt(":save") ?? "", "true");
                c.errors = str::eq(f.opt(":errors") ?? "", "true");
                c.reload = str::eq(f.opt(":reload") ?? "", "true");

                for (let i: i64 in 1..(n - 1)) {
                    let k: &f::&Sx = &f.items[i];

                    if (k.is(":run")) {
                        let v: &f::&Sx = &f.items[i + 1];

                        for (let w: &v::&Sx in &v.items) { c.run.push(w.text); }
                    }
                }
                if (c.run.len == 0) {
                    self.errors.push("\(at): command \(c.name) has no :run (\"program\" args...)");
                    return;
                }
                // a redeclared command replaces the old one
                var kept: Command[] = [];

                for (let o: &self::&Command in &self.commands) {
                    if (!str::eq(o.name, c.name)) { kept.push(std::copy(*o)); }
                }
                kept.push(c);
                self.commands = kept;
            },
            "on" => {
                if (n != 4) {
                    self.errors.push("\(at): (on \"event\" \"pattern\" \"command\")");
                    return;
                }
                self.hooks.push(Hook {
                    event: f.items[1].text, pattern: f.items[2].text, command: f.items[3].text,
                    addin: addin
                });
            },
            "filetype" => {
                if (n < 2) {
                    self.errors.push("\(at): (filetype \"name\" :ext (...) ...)");
                    return;
                }
                var t: FileType = FileType {
                    name: f.items[1].text, syntax: f.opt(":syntax") ?? f.items[1].text,
                    comment: f.opt(":comment") ?? "", icon: f.opt(":icon") ?? "", addin: addin
                };

                match (str::parse_int(f.opt(":tabstop") ?? "0")) {
                    v => { t.tabstop = v; },
                    e: str::BadInt => {}
                }
                // unknown syntax: report it, treat the files as plain text
                if (!syntax::valid(t.syntax)) {
                    self.errors.push(
                        "\(at): (filetype \"\(t.name)\"): unknown syntax \"\(t.syntax)\" (known: \(syntax::lang_names()), csv, tsv, or \"\" for plain text)"
                    );
                    t.syntax = "";
                }

                for (let i: i64 in 1..(n - 1)) {
                    let k: &f::&Sx = &f.items[i];
                    let v: &f::&Sx = &f.items[i + 1];

                    if (k.is(":ext") || k.is(":names")) {
                        var words: string[] = [];

                        if (v.kind == SxKind::List) {
                            for (let w: &v::&Sx in &v.items) { words.push(w.text); }
                        } else {
                            words.push(v.text);
                        }
                        if (k.is(":ext")) { t.exts = words; } else { t.names = words; }
                    }
                }
                self.filetypes.push(t);
            },
            "special" => {
                for (let i: i64 in 1..n) { self.special.push(f.items[i].text); }
            },
            "addin" => {
                if (n < 2) {
                    self.errors.push("\(at): (addin \"name\" forms...)");
                    return;
                }
                let name: string = f.items[1].text;

                self.addins.push(name);

                for (let i: i64 in 2..n) {
                    let g: &f::&Sx = &f.items[i];

                    self.form(g, origin, name);
                }
            },
            "disable" => {
                for (let i: i64 in 1..n) { self.disabled.push(f.items[i].text); }
            },
            "load" => {
                if (n != 2) {
                    self.errors.push("\(at): (load \"file.zap\")");
                    return;
                }
                var p: string = f.items[1].text;

                if (str::starts_with(p, "~/")) {
                    p = "\(process::env("HOME"))/\(str::substr(p, 2, p.len - 2))";
                }
                if (!path::is_absolute(p)) { p = path::join(path::dir(origin), p); }
                if (self.files.len > 32) {
                    self.errors.push("\(at): too many loads (a loop?)");
                    return;
                }
                match (fs::read_text(p)) {
                    t => { self.read(t, p); },
                    e: fs::NotFound => { self.errors.push("\(at): no file \(p)"); },
                    e2: fs::PermissionDenied => { self.errors.push("\(at): cannot read \(p)"); },
                    e3: fs::IsADirectory => { self.errors.push("\(at): \(p) is a directory"); },
                    e4: fs::IoError => { self.errors.push("\(at): cannot read \(p)"); }
                }
            },
            _ => { self.errors.push("\(at): unknown form \(f.show())"); }
        }
    }

    /// the command called name (none if missing or its add-in is off)
    export fn command(self: &Config, name: string) -> Command? {
        for (let c: &self::&Command in &self.commands) {
            if (str::eq(c.name, name) && !self.disabled_addin(c.addin)) {
                return std::copy(*c);
            }
        }
        return none;
    }

    /// file p's type ("text" if none matches)
    export fn filetype(self: &Config, p: string) -> FileType {
        let base: string = path::base(p);
        var k: i64 = self.filetypes.len - 1;

        while (k >= 0) {
            let t: &self::&FileType = &self.filetypes[k];

            k -= 1;
            if (self.disabled_addin(t.addin)) { continue; }

            for (let nm: string in &t.names) {
                if (str::eq(nm, base)) {
                    return std::copy(*t);
                }
            }

            for (let e: string in &t.exts) {
                if (str::ends_with(base, e)) {
                    return std::copy(*t);
                }
            }
        }
        return FileType { name: "text", syntax: "" };
    }
}

/// the user's config file path
export fn config_path() -> string {
    var base: string = process::env("XDG_CONFIG_HOME");

    if (base.len == 0) { base = "\(process::env("HOME"))/.config"; }
    return "\(base)/zap/init.zap";
}

/// the nearest init.zap in dir or above ("": none, or it is the user's own)
export fn local_path(dir: string) -> string {
    var d: string = path::clean(dir);
    let own: string = path::clean(config_path());
    var steps: i64 = 0;

    while (steps < 64) {
        let p: string = path::join(d, "init.zap");

        if (!str::eq(p, own)) {
            match (fs::info(p)) {
                i => {
                    if (i.kind == fs::Kind::File) {
                        return p;
                    }
                },
                e: fs::NotFound => {}, e2: fs::PermissionDenied => {}, e3: fs::IoError => {}
            }
        }
        let up: string = path::dir(d);

        if (str::eq(up, d)) { break; }
        d = up;
        steps += 1;
    }
    return "";
}

// the trusted local files list: "hash path" lines
fn trust_path() -> string {
    return state::dir("trust");
}

/// is file p, with its current text, trusted in list (by :trust, for this
/// exact text)?
export fn trusted(list: string, p: string, text: string) -> bool {
    let want: string = "\(std::hash(text)) \(p)";

    for (let l: string in str::lines(fs::read_file(list) ?? "")) {
        if (str::eq(l, want)) {
            return true;
        }
    }
    return false;
}

/// trusts file p's current text in the user's trust list (replacing any
/// older entry) -> ok?
export fn trust(p: string) -> bool { return trust_in(trust_path(), p); }

fn trust_in(list: string, p: string) -> bool {
    let text: string = fs::read_file(p) ?? "";
    var out: str::Builder;

    for (let l: string in str::lines(fs::read_file(list) ?? "")) {
        if (l.len > 0 && !str::ends_with(l, " \(p)")) {
            out.add(l);
            out.add_byte(10);
        }
    }
    out.add("\(std::hash(text)) \(p)\n");
    state::ensure_dir(path::dir(list));
    return fs::write_file(list, out.to_string());
}

/// the defaults, then dir's config: the nearest init.zap in or above it, if
/// trusted (it replaces the user's; `(load "~/.config/zap/init.zap")` in it
/// reads that too), else the user's file, if any. A local file runs programs
/// (its hooks), so it is read only after `:trust` trusts its text (like
/// nvim's exrc).
export fn load(dir: string) -> Config { return load_with(dir, trust_path()); }

fn load_with(dir: string, list: string) -> Config {
    var c: Config = Config {};

    c.read(DEFAULTS, "<defaults>");
    c.read_builtin_themes();
    let local: string = local_path(dir);

    if (local.len > 0) {
        match (fs::read_text(local)) {
            t => {
                if (trusted(list, local, t)) {
                    c.local = local;
                    c.read(t, local);
                    return c;
                }
                c.untrusted = local;
            },
            e: fs::NotFound => {},
            e2: fs::PermissionDenied => { c.errors.push("cannot read \(local)"); },
            e3: fs::IsADirectory => {},
            e4: fs::IoError => { c.errors.push("cannot read \(local)"); }
        }
    }
    let p: string = config_path();

    match (fs::read_text(p)) {
        t => { c.read(t, p); },
        e: fs::NotFound => {},
        e2: fs::PermissionDenied => { c.errors.push("cannot read \(p)"); },
        e3: fs::IsADirectory => { c.errors.push("\(p) is a directory"); },
        e4: fs::IoError => { c.errors.push("cannot read \(p)"); }
    }
    return c;
}

// ---- keys ------------------------------------------------------------------------

// the canonical < > name of a key with several spellings
fn key_base(name: string) -> string {
    let low: string = str::to_lower(name);

    match (low) {
        "cr" | "enter" | "return" => { return "CR"; },
        "esc" | "escape" => { return "Esc"; },
        "space" => { return "Space"; },
        "tab" => { return "Tab"; },
        "bs" | "backspace" => { return "BS"; },
        "del" | "delete" => { return "Del"; },
        "up" => { return "Up"; },
        "down" => { return "Down"; },
        "left" => { return "Left"; },
        "right" => { return "Right"; },
        "home" => { return "Home"; },
        "end" => { return "End"; },
        "pageup" => { return "PageUp"; },
        "pagedown" => { return "PageDown"; },
        "insert" => { return "Insert"; },
        "lt" => { return "lt"; },
        _ => {}
    }
    if (low.len >= 2 && low[0] == 'f' && str::is_ascii_digit(low[1])) {
        return "F\(str::substr(low, 1, low.len - 1))";
    }
    return name;
}

/// spec's keys as tokens: "<C-s>" "<Space>e" "gg" "<leader>f"
/// (leader: what <leader> is) -> ["<C-s>"], ["<Space>", "e"], ["g", "g"]
export fn parse_keys(spec: string, leader: string) -> string[] {
    var out: string[] = [];
    let n: i64 = spec.len;
    var i: i64 = 0;

    while (i < n) {
        if (spec[i] == '<') {
            let close: i64 = str::find_from(spec, ">", i + 1) ?? -1;

            if (close > i + 1) {
                let inner: string = str::substr(spec, i + 1, close - i - 1);

                if (str::eq_fold(inner, "leader")) {
                    if (leader.len > 0) { out.push(leader); }
                    i = close + 1;
                    continue;
                }
                let parts: string[] = str::split(inner, "-");
                var mods: string = "";
                var ok: bool = true;
                let np: i64 = parts.len;

                for (let k: i64 in 0..(np - 1)) {
                    let m: string = str::to_lower(parts[k]);

                    if (str::eq(m, "c")) { mods = "\(mods)C-"; }
                    else if (str::eq(m, "m") || str::eq(m, "a")) { mods = "\(mods)M-"; }
                    else if (str::eq(m, "s")) { mods = "\(mods)S-"; }
                    else { ok = false; }
                }
                var base: string = parts[np - 1];

                if (base.len == 0 && np >= 2) { base = "-"; }   // <C-->
                if (ok && base.len > 0) {
                    base = key_base(base);
                    if (str::char_count(base) == 1 && str::contains(mods, "C-")) {
                        base = str::to_lower(base);
                    }
                    if (mods.len == 0 && str::eq(base, "lt")) {
                        out.push("<lt>");
                    } else if (mods.len == 0 && str::char_count(base) == 1) {
                        out.push(base);
                    } else {
                        out.push("<\(mods)\(base)>");
                    }
                    i = close + 1;
                    continue;
                }
            }
        }
        let w: i64 = str::char_width(spec, i);
        var c: string = str::substr(spec, i, w);

        if (str::eq(c, "<")) { c = "<lt>"; }
        if (str::eq(c, " ")) { c = "<Space>"; }
        out.push(c);
        i += w;
    }
    return out;
}

/// key k as a parse_keys token: "a", "<C-s>", "<CR>",
/// "<S-Tab>", "<M-x>", "<Space>"
export fn token(k: &tui::Key) -> string {
    if (let c = k.typed()) {
        if (c == ' ') {
            return "<Space>";
        }
        if (c == '<') {
            return "<lt>";
        }
        return str::from_char(c);
    }
    var name: string = k.name();
    var mods: string = "";

    while (true) {
        if (str::starts_with(name, "Ctrl+") && name.len > 5) {
            mods = "\(mods)C-";
            name = str::substr(name, 5, name.len - 5);
        } else if (str::starts_with(name, "Alt+") && name.len > 4) {
            mods = "\(mods)M-";
            name = str::substr(name, 4, name.len - 4);
        } else if (str::starts_with(name, "Shift+") && name.len > 6) {
            mods = "\(mods)S-";
            name = str::substr(name, 6, name.len - 6);
        } else {
            break;
        }
    }
    var base: string = key_base(name);

    if (str::eq(base, "BackTab")) {
        base = "Tab";
        if (!str::contains(mods, "S-")) { mods = "\(mods)S-"; }
    }
    if (str::char_count(base) == 1 && str::contains(mods, "C-")) { base = str::to_lower(base); }
    if (mods.len == 0 && str::char_count(base) == 1) {
        return base;
    }
    return "<\(mods)\(base)>";
}

// the built-in config, around its base themes (themes/base.ae)
let DEFAULTS_TOP: string = """;; zap's built-in configuration. ~/.config/zap/init.zap is read after
;; this; its forms replace or add to these.

(set number true)
(set tabstop 4)
(set tree true)
(set tree-width 28)
(set icons true)
(set tildes true)
(set keyaccel true)
(set gitsigns true)
(set scrolloff 3)

""";
let DEFAULTS_REST: string = """;; ---- files ----------------------------------------------------------------

(filetype "markdown" :ext (".md" ".markdown") :syntax "markdown" :icon "")
(filetype "zap" :ext (".zap") :syntax "sexp" :comment ";" :icon "")
(filetype "sexp" :ext (".sexp" ".sxp") :syntax "sexp" :comment ";" :icon "")
(filetype "lisp" :ext (".lisp" ".lsp" ".cl" ".asd") :syntax "sexp" :comment ";" :tabstop 2 :icon "")
(filetype "elisp" :ext (".el") :syntax "sexp" :comment ";" :tabstop 2 :icon "")
(filetype "scheme" :ext (".scm" ".ss" ".sld" ".rkt") :syntax "sexp" :comment ";" :tabstop 2 :icon "")
(filetype "clojure" :ext (".clj" ".cljs" ".cljc" ".edn" ".bb") :syntax "sexp" :comment ";" :tabstop 2 :icon "")
(filetype "fennel" :ext (".fnl") :syntax "sexp" :comment ";" :tabstop 2 :icon "")
(filetype "shell" :ext (".sh" ".bash" ".zsh") :syntax "shell" :comment "#" :icon "")
(filetype "c" :ext (".c" ".h") :syntax "c" :comment "//" :icon "")
(filetype "cpp" :ext (".cpp" ".cc" ".cxx" ".c++" ".hpp" ".hh" ".hxx" ".h++" ".ipp" ".tpp") :syntax "cpp" :comment "//" :icon "")
(filetype "swift" :ext (".swift") :syntax "swift" :comment "//" :icon "")
(filetype "javascript" :ext (".js" ".mjs" ".cjs" ".jsx" ".ts" ".tsx") :syntax "js" :comment "//" :icon "")
(filetype "json" :ext (".json" ".geojson" ".webmanifest" ".har") :syntax "json" :tabstop 2 :icon "")
(filetype "jsonc" :ext (".jsonc" ".json5") :names ("tsconfig.json" "jsconfig.json" ".eslintrc" ".babelrc" "settings.json" "devcontainer.json") :syntax "json" :comment "//" :tabstop 2 :icon "")
(filetype "jsonl" :ext (".jsonl" ".ndjson" ".jsonlines") :syntax "json" :icon "")
(filetype "css" :ext (".css") :syntax "css" :icon "")
(filetype "html" :ext (".html" ".htm") :syntax "html" :tabstop 2 :icon "")
(filetype "python" :ext (".py" ".pyi" ".pyw") :syntax "python" :comment "#" :icon "")
(filetype "mermaid" :ext (".mmd" ".mermaid") :syntax "mermaid" :comment "%%" :icon "")
(filetype "asm" :ext (".asm" ".nasm" ".inc") :syntax "asm" :comment ";" :icon "")
(filetype "gas" :ext (".s") :syntax "asm" :comment "#" :icon "")
(filetype "gas-cpp" :ext (".S") :syntax "asm" :comment "//" :icon "")
(filetype "csv" :ext (".csv") :syntax "csv" :icon "")
(filetype "tsv" :ext (".tsv" ".tab") :syntax "tsv" :icon "")
(filetype "text" :ext (".txt") :syntax "" :icon "")
(special "README.md" "readme.md" "README" "Makefile" "index.json" "LICENSE")

;; ---- keys -----------------------------------------------------------------

(map normal "<C-t>" "tree")
(map tree "<C-t>" "tree")
(map normal "<leader>e" "tree focus")
(map normal "<C-k>" "palette")
(map tree "<C-k>" "palette")
(map insert "<C-k>" "palette")
(map visual "<C-k>" "palette")
;; (alternative for terminals and tmux setups that take Ctrl-K)
(map normal "<leader>p" "palette")
(map tree "<leader>p" "palette")
(map visual "<leader>p" "palette")
(map normal "<Tab>" "focus next")
(map normal "<S-Tab>" "focus prev")
(map tree "<Tab>" "focus next")
(map tree "<S-Tab>" "focus prev")
(map normal "<C-n>" "bnext")
(map normal "<C-p>" "bprevious")
(map normal "<leader>f" "palette files")
(map normal "<leader>/" "palette grep")
(map normal "<leader>s" "palette symbols")
(map normal "<leader>b" "palette buffers")
(map normal "<leader>n" "set number!")
(map normal "<leader>m" "mermaid")
(map normal "<C-s>" "w")
(map insert "<C-s>" "w")
(map normal "]d" "cnext")
(map normal "[d" "cprev")

;; ---- the Aela compiler's tools --------------------------------------------

(addin "aela"
  (filetype "aela" :ext (".ae") :syntax "aela" :comment "//" :icon "")
  (command "check" :run ("aec" "%" "--check-only" "--message-format" "short")
    :save true :errors true :show "quiet" :doc "check the file: its errors in the gutter")
  (command "build" :run ("aec" "%" "-o" "%:r" "--message-format" "short")
    :save true :errors true :doc "build the file into %:r")
  (command "run" :run ("sh" "-c" "aec \"$1\" -o \"$2\" --message-format short && \"$2\"" "sh" "%" "%:r")
    :save true :errors true :show "buffer" :doc "build the file and run it")
  (command "test" :run ("aec" "test" "%") :save true :show "buffer" :doc "the file's #test functions")
  (command "fmt" :run ("aec" "fmt" "%") :save true :reload true :show "quiet" :doc "format the file")
  (command "def" :run ("aec" "query" "def" "%" "<cword>") :show "jump" :doc "go to what the word names")
  (command "refs" :run ("aec" "query" "refs" "%" "<cword>") :errors true :doc "where the word is used")
  (command "explain" :run ("aec" "explain" "<cword>") :show "buffer" :doc "what an error code means")
  (command "docs" :run ("aec" "docs" "<cword>") :show "buffer" :doc "search the language docs")
  (command "outline" :run ("aec" "outline" "%") :show "buffer" :doc "the file's declarations")
  (command "symbols" :run ("aec" "outline" "--deps" "<cwd>") :show "outline"
    :doc "the project's declarations and its imports', for the palette and completion")
  (on "save" "*.ae" "check")
  (map normal "gd" "def")
  (map normal "gr" "refs")
  (map normal "K" "explain")
  (map normal "<leader>c" "check")
  (map normal "<leader>r" "run")
  (map normal "<leader>t" "test"))
""";

/// the built-in configuration (the user's init.zap, read after, may change
/// any of it): options, base themes, then the rest
export let DEFAULTS: string = "\(DEFAULTS_TOP)\(base::BASE)\(DEFAULTS_REST)";

#test fn reads_the_defaults() -> i32 {
    var c: Config = Config {};

    c.read(DEFAULTS, "<defaults>");
    c.read_builtin_themes();
    if (c.errors.len > 0) {
        for (let e: string in &c.errors) { println(e); }
        return 1;
    }
    if (c.themes.len != 49 || !str::eq(c.theme, "paper")) {
        return 2;
    }
    let ft: FileType = c.filetype("notes/HOSTED.md");

    if (!str::eq(ft.syntax, "markdown")) {
        return 3;
    }
    if (!str::eq(c.filetype("v1/src/main.ae").syntax, "aela")) {
        return 4;
    }
    if (!str::eq(c.filetype("a/b.swift").syntax, "swift") ||
        !str::eq(c.filetype("x.h").syntax, "c") ||
        !str::eq(c.filetype("app.tsx").syntax, "js") ||
        !str::eq(c.filetype("a.hxx").syntax, "cpp") ||
            !str::eq(c.filetype("b.cxx").syntax, "cpp") ||
        !str::eq(c.filetype("c.hpp").syntax, "cpp") ||
            !str::eq(c.filetype("d.cpp").syntax, "cpp") ||
            !str::eq(c.filetype("s.css").syntax, "css") ||
        !str::eq(c.filetype("index.html").syntax, "html")) {
        return 9;
    }
    if (!str::eq(c.filetype("tool.py").syntax, "python") ||
        !str::eq(c.filetype("flow.mmd").syntax, "mermaid") ||
        !str::eq(c.filetype("boot.asm").syntax, "asm") ||
            !str::eq(c.filetype("regs.inc").syntax, "asm") ||
        !str::eq(c.filetype("start.S").comment, "//") ||
            !str::eq(c.filetype("start.s").comment, "#")) {
        return 10;
    }
    if (let cmd = c.command("check")) {
        if (!cmd.errors || !cmd.save || cmd.run.len != 5) {
            return 5;
        }
    } else {
        return 6;
    }
    c.read("(disable \"aela\")", "<test>");
    if (c.command("check") != none) {
        return 7;
    }
    c.read("(set tabstop 99) (bogus)", "<test>");
    if (c.errors.len != 2) {
        return 8;
    }
    return 0;
}

#test fn parses_key_specs() -> i32 {
    let a: string[] = parse_keys("<C-S>x", "<Space>");

    if (a.len != 2 || !str::eq(a[0], "<C-s>") || !str::eq(a[1], "x")) {
        return 1;
    }
    let b: string[] = parse_keys("<leader>e", "<Space>");

    if (b.len != 2 || !str::eq(b[0], "<Space>")) {
        return 2;
    }
    let c: string[] = parse_keys("<cr><s-tab><lt>gg", "");

    if (c.len != 5 || !str::eq(c[0], "<CR>") || !str::eq(c[1], "<S-Tab>") ||
        !str::eq(c[2], "<lt>")) {
        return 3;
    }
    if (!str::eq(token(&tui::key("ctrl+s")), "<C-s>")) {
        return 4;
    }
    if (!str::eq(token(&tui::key("enter")), "<CR>")) {
        return 5;
    }
    if (!str::eq(token(&tui::key("shift+tab")), "<S-Tab>")) {
        return 6;
    }
    if (!str::eq(token(&tui::key("space")), "<Space>")) {
        return 7;
    }
    if (!str::eq(token(&tui::key("G")), "G")) {
        return 8;
    }
    return 0;
}

#test fn local_config_once_trusted() -> i32 {
    let tmp: string = fs::temp_dir();
    let base: string = "\(tmp)/zap-local-config";

    state::ensure_dir("\(base)/proj/sub");
    let list: string = "\(base)/trust";

    fs::write_file(list, "");
    fs::write_file("\(base)/proj/init.zap", "(set tabstop 7)");
    // found from a subdirectory, but not read until trusted
    if (!str::eq(local_path("\(base)/proj/sub"), "\(base)/proj/init.zap")) {
        return 1;
    }
    let before: Config = load_with("\(base)/proj/sub", list);

    if (before.tabstop == 7 || !str::eq(before.untrusted, "\(base)/proj/init.zap")) {
        return 2;
    }
    if (!trust_in(list, "\(base)/proj/init.zap")) {
        return 3;
    }
    let after: Config = load_with("\(base)/proj/sub", list);

    if (after.tabstop != 7 || after.untrusted.len > 0 || after.local.len == 0) {
        return 4;
    }
    // changed since trusted: not read until trusted again
    fs::write_file("\(base)/proj/init.zap", "(set tabstop 9)");
    let changed: Config = load_with("\(base)/proj", list);

    if (changed.tabstop == 9 || changed.untrusted.len == 0) {
        return 5;
    }
    return 0;
}

#test fn unknown_syntax_is_an_error() -> i32 {
    var c: Config = Config {};

    c.read(DEFAULTS, "<defaults>");
    if (c.errors.len != 0) {                        // (csv, tsv and "" are fine)
        return 1;
    }
    c.read(
        "(filetype \"typo\" :ext (\".zz\") :syntax \"rust\")\n(filetype \"ok\" :ext (\".ok\") :syntax \"json\")",
        "init.zap"
    );
    if (c.errors.len != 1) {
        return 2;
    }
    if (!str::contains(c.errors[0], "unknown syntax \"rust\"") ||
        !str::contains(c.errors[0], "json")) {
        return 3;
    }
    // its files are plain text; the other form is still read
    if (c.filetype("/a/q.zz").syntax.len != 0 || !str::eq(c.filetype("/a/q.zz").name, "typo")) {
        return 4;
    }
    if (!str::eq(c.filetype("/a/x.ok").syntax, "json")) {
        return 5;
    }
    return 0;
}
