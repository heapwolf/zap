//! zap's configuration language: s-expressions. A file is a list of forms;
//! a form is a list `( ... )`, a symbol (`set`, `:fg`, `true`), a string
//! (`"#ffffff"`, with `\"`, `\\`, `\n`, `\t`) or an integer. `;` comments to
//! the end of the line.
//!
//! ```ae,ignore
//! let forms: sexp::Sx[] = sexp::parse("(set number true) ; on")?;
//! ```

import str from "std/string";

/// value kinds
export enum SxKind { List, Sym, Str, Num }

/// a value: a list, symbol, string or number, and its start line
/// (1-based)
export struct Sx {
    export kind: SxKind;
    export text: string = "";  // symbol name, string text
    export n: i64 = 0;         // number
    export items: Sx[] = [];   // list values
    export line: i64;
}

/// invalid s-expression text: the line and what is wrong
export failure SyntaxError { line: i64; message: string; }

// reader position
struct Reader {
    at: i64;
    line: i64;
}

/// the forms of src, in order
export fn parse(src: string) -> Sx[] | SyntaxError {
    var r: Reader = Reader { at: 0, line: 1 };
    var out: Sx[] = [];

    while (true) {
        skip(&src, mut &r);
        if (r.at >= src.len) { break; }
        out.push(read(&src, mut &r)?);
    }
    return out;
}

// skip spaces and comments
fn skip(s: &string, mut r: &Reader) -> void {
    let n: i64 = s.len;

    while (r.at < n) {
        let c: u8 = s[r.at];

        if (c == '\n') {
            r.line += 1;
            r.at += 1;
        } else if (c == ' ' || c == '\t' || c == '\r') {
            r.at += 1;
        } else if (c == ';') {
            while (r.at < n && s[r.at] != '\n') { r.at += 1; }
        } else {
            return;
        }
    }
}

// does byte c end a symbol or number?
fn delimiter(c: u8) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '(' || c == ')' || c == '"' ||
        c == ';';
}

// read one value at r.at (not at the end)
fn read(s: &string, mut r: &Reader) -> Sx | SyntaxError {
    let n: i64 = s.len;
    let c: u8 = s[r.at];
    let line: i64 = r.line;

    if (c == '(') {
        r.at += 1;
        var items: Sx[] = [];

        while (true) {
            skip(s, r);
            if (r.at >= n) { fail SyntaxError { line: line, message: "this ( is not closed" }; }
            if (s[r.at] == ')') {
                r.at += 1;
                return Sx { kind: SxKind::List, items: items, line: line };
            }
            items.push(read(s, r)?);
        }
    }

    if (c == ')') { fail SyntaxError { line: line, message: "a ) with no ( before it" }; }
    if (c == '"') {
        r.at += 1;
        var b: str::Builder;

        while (true) {
            if (r.at >= n) {
                fail SyntaxError { line: line, message: "this string is not closed" };
            }
            let d: u8 = s[r.at];

            r.at += 1;
            if (d == '"') { break; }
            if (d == '\n') { r.line += 1; }
            if (d == '\\' && r.at < n) {
                let e: u8 = s[r.at];

                r.at += 1;
                if (e == 'n') { b.add_byte(10); }
                else if (e == 't') { b.add_byte(9); }
                else { b.add_byte(e); }
                continue;
            }
            b.add_byte(d);
        }
        return Sx { kind: SxKind::Str, text: b.to_string(), line: line };
    }
    let start: i64 = r.at;

    while (r.at < n && !delimiter(s[r.at])) { r.at += 1; }
    let word: string = str::substr(*s, start, r.at - start);

    match (str::parse_int(word)) {
        v => { return Sx { kind: SxKind::Num, n: v, text: word, line: line }; },
        e: str::BadInt => {}
    }
    return Sx { kind: SxKind::Sym, text: word, line: line };
}

impl Sx {
    /// is it the symbol name?
    export fn is(self: &Sx, name: string) -> bool {
        return self.kind == SxKind::Sym && str::eq(self.text, name);
    }

    /// the list's head symbol ("": not a list starting with one)
    export fn head(self: &Sx) -> string {
        if (self.kind != SxKind::List || self.items.len == 0) {
            return "";
        }
        if (self.items[0].kind != SxKind::Sym) {
            return "";
        }
        return self.items[0].text;
    }

    /// a list's value after keyword key (`:fg "#fff"`), or none
    export fn opt(self: &Sx, key: string) -> string? {
        let n: i64 = self.items.len;

        for (let i: i64 in 0..(n - 1)) {
            let k: &self::&Sx = &self.items[i];

            if (k.is(key)) {
                return self.items[i + 1].text;
            }
        }
        return none;
    }

    /// as source text: strings quoted, symbols and numbers as written, lists
    /// rebuilt
    export fn show(self: &Sx) -> string {
        match (self.kind) {
            SxKind::Str => { return "\"\(self.text)\""; },
            SxKind::List => {
                var parts: string[] = [];

                for (let x: &self::&Sx in &self.items) { parts.push(x.show()); }
                return "(\(str::join(&parts, " ")))";
            },
            _ => { return self.text; }
        }
        return self.text;
    }
}

#test fn parses_forms() -> i32 {
    let src: string = "; settings\n(set number true)\n(theme \"pa\\\"per\")\n(map normal \"<C-s>\" -12 (a b))";

    match (parse(src)) {
        forms => {
            if (forms.len != 3) {
                return 1;
            }
            let f0: &forms::&Sx = &forms[0];
            let f2: &forms::&Sx = &forms[2];

            if (!str::eq(f0.head(), "set") || f0.line != 2) {
                return 2;
            }
            if (!str::eq(forms[1].items[1].text, "pa\"per")) {
                return 3;
            }
            if (f2.items[3].n != -12 || f2.items[3].kind != SxKind::Num) {
                return 4;
            }
            if (!str::eq(f2.show(), "(map normal \"<C-s>\" -12 (a b))")) {
                return 5;
            }
        },
        e: SyntaxError => { return 9; }
    }
    match (parse("(a (b)")) {
        forms => { return 6; },
        e: SyntaxError => {
            if (e.line != 1) {
                return 7;
            }
        }
    }
    return 0;
}

#test fn reads_keywords() -> i32 {
    match (parse("(normal :fg \"#ff0000\" :bold true)")) {
        forms => {
            let f: &forms::&Sx = &forms[0];

            if (!str::eq(f.opt(":fg") ?? "", "#ff0000")) {
                return 1;
            }
            if (!str::eq(f.opt(":bold") ?? "", "true")) {
                return 2;
            }
            if (f.opt(":bg") != none) {
                return 3;
            }
        },
        e: SyntaxError => { return 9; }
    }
    return 0;
}
