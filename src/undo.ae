//! zap's undo history: every change made to a buffer, as a tree. Undo
//! goes to the parent state, redo to the child last left; a change after an
//! undo starts a branch and the old one stays (`g-` and `g+` walk every
//! state in creation order, `:earlier` and `:later` by count or time).
//! Nothing is dropped.
//!
//! The history is written to an undo file (in `~/.local/state/zap/undo/`)
//! when the buffer is written, with the file's size and time; opening a file
//! that still matches them reads it back, so history outlives the editor.

import str from "std/string";
import fs from "std/fs";
import path from "std/path";
import state from "state.ae";

/// an edit: 0 line changed old -> new; 1 line new inserted; 2 line old removed
export struct Op {
    export kind: i64;
    export line: i64;
    export old: string = "";
    export new: string = "";
}

/// one command's edits: the state it made, from state parent (0: the file
/// as read); the cursor before and after; when (seconds since 1970); the
/// child a redo goes to (0: none)
export struct Change {
    export ops: Op[] = [];
    export parent: i64 = 0;
    export child: i64 = 0;
    export cy: i64 = 0;
    export cx: i64 = 0;
    export ay: i64 = 0;
    export ax: i64 = 0;
    export time: i64 = 0;
}

/// the tree: state k (1..) is what change k made (nodes[k - 1]); at: the
/// buffer's current state; saved: the state its file has; root_next: the
/// child of state 0 a redo goes to
export struct History {
    export nodes: Change[] = [];
    export at: i64 = 0;
    export saved: i64 = 0;
    export root_next: i64 = 0;
}

impl History {
    /// state k's parent (0 for 0)
    export fn parent(self: &History, k: i64) -> i64 {
        if (k <= 0) {
            return 0;
        }
        return self.nodes[k - 1].parent;
    }

    /// the child of state k a redo goes to (0: none)
    export fn next_of(self: &History, k: i64) -> i64 {
        if (k == 0) {
            return self.root_next;
        }
        return self.nodes[k - 1].child;
    }

    /// set state k's redo child to c
    export fn set_next(mut self: &History, k: i64, c: i64) -> void {
        if (k == 0) {
            self.root_next = c;
        } else {
            self.nodes[k - 1].child = c;
        }
    }

    /// the path from state at to state to: states to undo (each to its
    /// parent, in order), then states to redo (in order)
    export fn way(self: &History, to: i64) -> (i64[], i64[]) {
        // (a parent is always older than its child, so the later of the two
        // steps up until they meet at their nearest common ancestor: cost is
        // the history's depth, not its square)
        var undo: i64[] = [];
        var down: i64[] = [];
        var a: i64 = self.at;
        var b: i64 = to;

        while (a != b) {
            if (a > b) {
                undo.push(a);
                a = self.parent(a);
            } else {
                down.push(b);
                b = self.parent(b);
            }
        }
        var redo: i64[] = [];
        var k: i64 = down.len - 1;

        while (k >= 0) {
            redo.push(down[k]);
            k -= 1;
        }
        return (undo, redo);
    }

    /// latest state made at or before time t (seconds; 0: none)
    export fn before(self: &History, t: i64) -> i64 {
        var best: i64 = 0;

        for (let k: i64, let c: &self::&Change in &self.nodes) {
            if (c.time <= t) { best = k + 1; }
        }
        return best;
    }
}

// ---- the undo file ---------------------------------------------------------------

/// where file p's history is stored
export fn file_for(p: string) -> string {
    return "\(state::dir("undo"))/\(state::flat(p))";
}

/// h as undo file text, for a file of size bytes modified at mtime (ns)
export fn encode(h: &History, size: i64, mtime: i64) -> string {
    var b: str::Builder;

    b.add("zap-undo 1\n\(size) \(mtime) \(h.at) \(h.saved) \(h.root_next) \(h.nodes.len)\n");

    for (let c: &h::&Change in &h.nodes) {
        b.add("\(c.parent) \(c.child) \(c.cy) \(c.cx) \(c.ay) \(c.ax) \(c.time) \(c.ops.len)\n");

        for (let o: &c::&Op in &c.ops) {
            b.add("\(o.kind) \(o.line) \(o.old.len) \(o.new.len)\n");
            b.add(o.old);
            b.add(o.new);
            b.add_byte(10);
        }
    }
    return b.to_string();
}

/// the text is not an undo file (or not for this file)
export failure BadUndo { why: string; }

// reader over an undo file's text
struct Reader {
    at: i64;
}

// the numbers on the next line (want of them)
fn numbers(t: &string, mut r: &Reader, want: i64) -> i64[] | BadUndo {
    let end: i64 = str::find_from(*t, "\n", r.at) ?? -1;

    if (end < 0) { fail BadUndo { why: "cut short" }; }
    let words: string[] = str::fields(str::substr(*t, r.at, end - r.at));

    r.at = end + 1;
    if (words.len != want) {
        fail BadUndo { why: "a line of \(words.len) numbers, not \(want)" };
    }
    var out: i64[] = [];

    for (let w: string in &words) {
        match (str::parse_int(w)) {
            n => { out.push(n); },
            e: str::BadInt => { fail BadUndo { why: "not a number: \(w)" }; }
        }
    }
    return out;
}

// the next n bytes
fn bytes(t: &string, mut r: &Reader, n: i64) -> string | BadUndo {
    if (n < 0 || r.at + n > t.len) { fail BadUndo { why: "cut short" }; }
    let s: string = str::substr(*t, r.at, n);

    r.at += n;
    return s;
}

/// the history in undo file text, if written for a file of size bytes
/// modified at mtime (ns)
export fn decode(t: string, size: i64, mtime: i64) -> History | BadUndo {
    if (!str::starts_with(t, "zap-undo 1\n")) { fail BadUndo { why: "not an undo file" }; }
    var r: Reader = Reader { at: 11 };
    let head: i64[] = numbers(&t, mut &r, 6)?;

    if (head[0] != size || head[1] != mtime) { fail BadUndo { why: "the file changed since" }; }
    var h: History = History { at: head[2], saved: head[3], root_next: head[4] };
    let n: i64 = head[5];

    for (let k: i64 in 0..n) {
        let c: i64[] = numbers(&t, mut &r, 8)?;
        var ch: Change = Change {
            parent: c[0], child: c[1], cy: c[2], cx: c[3], ay: c[4], ax: c[5], time: c[6]
        };

        if (ch.parent < 0 || ch.parent > k || ch.child < 0 || ch.child > n) {
            fail BadUndo { why: "a state out of the tree" };
        }

        for (let j: i64 in 0..c[7]) {
            let o: i64[] = numbers(&t, mut &r, 4)?;
            let old: string = bytes(&t, mut &r, o[2])?;
            let new: string = bytes(&t, mut &r, o[3])?;

            bytes(&t, mut &r, 1)?;
            ch.ops.push(Op { kind: o[0], line: o[1], old: old, new: new });
        }
        h.nodes.push(ch);
    }
    if (h.at < 0 || h.at > n || h.saved < 0 || h.saved > n || h.root_next > n) {
        fail BadUndo { why: "a state out of the tree" };
    }
    return h;
}

/// write h as file p's undo file (p: size bytes, modified at mtime) -> did it work?
export fn save(h: &History, p: string, size: i64, mtime: i64) -> bool {
    let u: string = file_for(p);

    state::ensure_dir(path::dir(u));
    return fs::write_file(u, encode(h, size, mtime));
}
