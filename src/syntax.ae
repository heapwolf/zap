//! zap's syntax highlighting: a small lexer per language, one line at a
//! time. Each line starts in a state (inside a block comment, a fenced code
//! block, ...) and returns the next line's start state, so a buffer saves
//! the state at every 64th line and highlights only on-screen lines, from
//! the nearest saved one (buffer.ae). Only a line's first 2000 bytes are
//! highlighted; the rest is plain.
//!
//! Aela, Markdown, zap's s-expressions and shell are here; C, C++, Swift,
//! JavaScript, CSS, HTML, Python, Mermaid and assembly each have a file in
//! syntax/ (shared code, including the C family's lexer, is in
//! syntax/core.ae). A Markdown ```lang fence is highlighted as lang.

import str from "std/string";
import {
    Group, GROUP_NAMES, Hl, add, is_ident_start, is_ident, is_digit, limit_to, string_end,
    number_end, one_of, Words, words
} from "syntax/core.ae";
import c from "syntax/c.ae";
import cpp from "syntax/cpp.ae";
import swift from "syntax/swift.ae";
import js from "syntax/js.ae";
import css from "syntax/css.ae";
import html from "syntax/html.ae";
import python from "syntax/python.ae";
import sexpl from "syntax/sexp.ae";
import json from "syntax/json.ae";
import mermaid from "syntax/mermaid.ae";
import asm from "syntax/asm.ae";

export Group;
export Hl;
export GROUP_NAMES;

/// languages with a lexer (keep in sync with line's match)
export let LANGS: string[] = [
    "aela", "markdown", "sexp", "shell", "c", "cpp", "swift", "js", "css", "html", "python",
    "mermaid", "asm", "json"
];

/// valid values for a filetype's :syntax: a language, csv or tsv (a
/// spreadsheet), or "" (plain text)
export fn valid(lang: string) -> bool {
    return lang.len == 0 || str::eq(lang, "csv") || str::eq(lang, "tsv") || known(lang);
}

/// the languages as a space-separated list ("aela markdown ...")
export fn lang_names() -> string { return str::join(&LANGS, " "); }

/// is there a lexer for lang?
export fn known(lang: string) -> bool {
    for (let l: string in &LANGS) {
        if (str::eq(l, lang)) {
            return true;
        }
    }
    return false;
}

/// highlight line in lang, starting in state; out gets the pieces (in
/// order, non-overlapping; gaps are Normal) -> the next line's start state
export fn line(lang: string, text: &string, state: i64, mut out: &Hl[]) -> i64 {
    let n: i64 = text.len;

    match (lang) {
        "aela" => { return aela(text, state, out); },
        "markdown" => { return markdown(text, state, out); },
        "sexp" => { return sexpl::line(text, 0, n, state, out); },
        "json" => { return json::line(text, 0, n, state, out); },
        "shell" => { return shell(text, out); },
        "c" => { return c::line(text, 0, n, state, out); },
        "cpp" => { return cpp::line(text, 0, n, state, out); },
        "swift" => { return swift::line(text, 0, n, state, out); },
        "js" => { return js::line(text, 0, n, state, out); },
        "css" => { return css::line(text, 0, n, state, out); },
        "html" => { return html::line(text, 0, n, state, out); },
        "python" => { return python::line(text, 0, n, state, out); },
        "mermaid" => { return mermaid::line(text, 0, n, state, out); },
        "asm" => { return asm::line(text, 0, n, state, out); },
        _ => { return 0; }
    }
    return 0;
}

fn limit(text: &string) -> i64 { return limit_to(text, 0, text.len); }

// ---- Aela ------------------------------------------------------------------

let AELA_KEYWORDS: string[] = [
    "let", "var", "fn", "async", "if", "in", "else", "while", "for", "return", "break",
    "continue", "await", "where", "as", "struct", "impl", "task", "pure", "enum", "match", "type",
    "arena", "import", "export", "from", "interface", "failure", "fail", "reserve", "weak",
    "static", "mut", "public", "select", "extern", "packed", "new", "work"
];

let AELA_TYPES: string[] = [
    "u8", "i8", "u16", "i16", "u32", "i32", "u64", "i64", "f32", "f64", "bool", "char", "string",
    "void", "Duration", "Self"
];

let AELA_CONSTANTS: string[] = ["true", "false", "none", "self"];

// the three word lists for lookup (keywords 0, types 1, constants 2)
let AELA_WORDS: Words = words(
    &[std::copy(AELA_KEYWORDS), std::copy(AELA_TYPES), std::copy(AELA_CONSTANTS)]
);

/// lang's reserved words (keywords, types, constants), for completion
export fn keywords(lang: string) -> string[] {
    var out: string[] = [];
    var sets: string[][] = [];

    match (lang) {
        "aela" => {
            sets = [std::copy(AELA_KEYWORDS), std::copy(AELA_TYPES), std::copy(AELA_CONSTANTS)];
        },
        "c" => { sets = [std::copy(c::KEYWORDS), std::copy(c::TYPES), std::copy(c::CONSTANTS)]; },
        "cpp" => {
            sets = [std::copy(cpp::KEYWORDS), std::copy(cpp::TYPES), std::copy(cpp::CONSTANTS)];
        },
        "swift" => {
            sets = [
                std::copy(swift::KEYWORDS), std::copy(swift::TYPES), std::copy(swift::CONSTANTS)
            ];
        },
        "js" => {
            sets = [std::copy(js::KEYWORDS), std::copy(js::TYPES), std::copy(js::CONSTANTS)];
        },
        "css" => { sets = [std::copy(css::KEYWORDS)]; },
        "html" => { sets = [std::copy(html::KEYWORDS)]; },
        "python" => {
            sets = [
                std::copy(python::KEYWORDS), std::copy(python::TYPES), std::copy(python::CONSTANTS)
            ];
        },
        "mermaid" => { sets = [std::copy(mermaid::KEYWORDS), std::copy(mermaid::CONSTANTS)]; },
        "sexp" => { sets = [std::copy(sexpl::DEFINERS), std::copy(sexpl::CONSTANTS)]; },
        "json" => { sets = [std::copy(json::CONSTANTS)]; },
        "asm" => { sets = [std::copy(asm::KEYWORDS), std::copy(asm::TYPES)]; },
        _ => {}
    }

    for (let set: string[] in &sets) {
        for (let w: string in &set) { out.push(w); }
    }
    return out;
}

// states: 0 code, 1 inside /* */
fn aela(text: &string, state: i64, mut out: &Hl[]) -> i64 {
    let n: i64 = limit(text);
    var i: i64 = 0;

    if (state == 1) {
        let close: i64 = str::find(*text, "*/") ?? -1;

        if (close < 0) {
            add(out, 0, n, Group::Comment);
            return 1;
        }
        add(out, 0, close + 2, Group::Comment);
        i = close + 2;
    }

    while (i < n) {
        let c: u8 = text[i];

        if (c == '/' && i + 1 < n && text[i + 1] == '/') {
            add(out, i, n, Group::Comment);
            return 0;
        }
        if (c == '/' && i + 1 < n && text[i + 1] == '*') {
            let close: i64 = str::find_from(*text, "*/", i + 2) ?? -1;

            if (close < 0) {
                add(out, i, n, Group::Comment);
                return 1;
            }
            add(out, i, close + 2, Group::Comment);
            i = close + 2;
            continue;
        }
        if (c == '"') {
            let j: i64 = string_end(text, i, n, '"');

            add(out, i, j, Group::String);
            i = j;
            continue;
        }
        if (c == '`') {
            var j: i64 = i + 1;

            while (j < n && text[j] != '`') { j += 1; }
            if (j < n) { j += 1; }
            add(out, i, j, Group::String);
            i = j;
            continue;
        }
        if (c == '\'') {
            let j: i64 = string_end(text, i, n, '\'');

            if (j - i <= 12) {
                add(out, i, j, Group::String);
                i = j;
                continue;
            }
        }
        if (c == '#' && i + 1 < n && is_ident_start(text[i + 1])) {
            var j: i64 = i + 1;

            while (j < n && is_ident(text[j])) { j += 1; }
            add(out, i, j, Group::Constant);
            i = j;
            continue;
        }
        if (is_digit(c)) {
            let j: i64 = number_end(text, i, n);

            add(out, i, j, Group::Number);
            i = j;
            continue;
        }
        if (is_ident_start(c)) {
            var j: i64 = i;

            while (j < n && is_ident(text[j])) { j += 1; }
            let kind: i64 = AELA_WORDS.kind_at(text, i, j);

            if (kind == 0) {
                add(out, i, j, Group::Keyword);
            } else if (kind == 1) {
                add(out, i, j, Group::Type);
            } else if (kind == 2) {
                add(out, i, j, Group::Constant);
            } else if (c >= 'A' && c <= 'Z') {
                add(out, i, j, Group::Type);
            } else if (j < n && text[j] == '(') {
                add(out, i, j, Group::Function);
            }
            i = j;
            continue;
        }
        if (c == '?' || c == '&' || c == '|' || c == '=' || c == '!' || c == '<' || c == '>' ||
            c == '+' || c == '-' || c == '*' || c == '%' || c == ':') {
            add(out, i, i + 1, Group::Operator);
        }
        i += 1;
    }
    return 0;
}

// ---- Markdown --------------------------------------------------------------

// languages a ``` fence can name, and the names it accepts for each
let FENCE_LANGS: string[] = [
    "aela", "sexp", "shell", "c", "cpp", "swift", "js", "css", "html", "python", "mermaid", "asm",
    "json"
];
let FENCE_NAMES: string[][] = [
    ["aela", "ae"],
    [
        "sexp", "zap", "lisp", "scheme", "clojure", "clj", "edn", "racket", "elisp", "emacs-lisp",
        "common-lisp", "fennel", "s-expression"
    ], ["shell", "sh", "bash", "zsh", "console"],
    ["c", "h"], ["cpp", "c++", "cxx", "hpp"], ["swift"],
    ["js", "javascript", "ts", "typescript", "jsx", "tsx"], ["css"], ["html", "xml", "svg"],
    ["python", "py", "python3", "pyi"], ["mermaid", "mmd"],
    ["asm", "nasm", "masm", "gas", "s", "x86asm", "armasm", "assembly"],
    ["json", "jsonc", "json5", "jsonl", "ndjson", "geojson"]
];

// the fence language a ```name opens (-1: none known)
fn fence_lang(text: &string, at: i64, n: i64) -> i64 {
    var i: i64 = at;

    while (i < n && (text[i] == '`' || text[i] == ' ' || text[i] == '{' || text[i] == '.')) {
        i += 1;
    }
    var j: i64 = i;

    while (j < n && text[j] != ' ' && text[j] != '}' && text[j] != ',' && text[j] != '`') {
        j += 1;
    }
    let name: string = str::to_lower(str::substr(*text, i, j - i));

    for (let k: i64, let names: string[] in &FENCE_NAMES) {
        if (one_of(&name, &names)) {
            return k;
        }
    }
    return -1;
}

// states: 0 text, 1 inside a ``` fence of unknown language, 2 + k +
// len(FENCE_LANGS) * s inside a FENCE_LANGS[k] fence, its lexer in state s
fn markdown(text: &string, state: i64, mut out: &Hl[]) -> i64 {
    let n: i64 = limit(text);
    var lead: i64 = 0;

    while (lead < n && text[lead] == ' ') { lead += 1; }
    let fence: bool = n - lead >= 3 && text[lead] == '`' && text[lead + 1] == '`' &&
        text[lead + 2] == '`';

    if (state >= 1) {
        if (fence) {
            add(out, 0, n, Group::Code);
            return 0;
        }
        if (state == 1) {
            add(out, 0, n, Group::Code);
            return 1;
        }
        let nl: i64 = FENCE_LANGS.len;
        let k: i64 = (state - 2) % nl;
        let inner: i64 = line(FENCE_LANGS[k], text, (state - 2) / nl, out);

        return 2 + k + nl * inner;
    }
    if (fence) {
        add(out, 0, n, Group::Code);
        let k: i64 = fence_lang(text, lead, n);

        if (k < 0) {
            return 1;
        }
        return 2 + k;
    }
    if (lead >= 4) {
        add(out, 0, n, Group::Code);  // an indented code block
        return 0;
    }
    var i: i64 = lead;

    // a heading: #s plain, text a heading
    if (i < n && text[i] == '#') {
        var j: i64 = i;

        while (j < n && text[j] == '#') { j += 1; }
        if (j - i <= 6 && (j == n || text[j] == ' ')) {
            add(out, j, n, Group::Heading);
            return 0;
        }
    }
    if (i < n && text[i] == '>') {
        add(out, i, n, Group::Quote);
        return 0;
    }
    // a rule: --- *** ___
    if (n - i >= 3 && (text[i] == '-' || text[i] == '*' || text[i] == '_')) {
        var all: bool = true;

        for (let j: i64 in i..n) {
            if (text[j] != text[i] && text[j] != ' ') { all = false; }
        }
        if (all) {
            add(out, i, n, Group::Punct);
            return 0;
        }
    }
    // a list item marker
    if (i + 1 < n && (text[i] == '-' || text[i] == '*' || text[i] == '+') && text[i + 1] == ' ') {
        add(out, i, i + 1, Group::ListMark);
        i += 2;
    } else if (i < n && is_digit(text[i])) {
        var j: i64 = i;

        while (j < n && is_digit(text[j])) { j += 1; }
        if (j + 1 < n && (text[j] == '.' || text[j] == ')') && text[j + 1] == ' ') {
            add(out, i, j + 1, Group::ListMark);
            i = j + 2;
        }
    }
    inline_md(text, i, n, out);
    return 0;
}

// emphasis, code and links in text[i..n]
fn inline_md(text: &string, start: i64, n: i64, mut out: &Hl[]) -> void {
    var i: i64 = start;

    while (i < n) {
        let c: u8 = text[i];

        if (c == '`') {
            var j: i64 = i + 1;

            while (j < n && text[j] != '`') { j += 1; }
            if (j < n) {
                add(out, i, j + 1, Group::Code);
                i = j + 1;
                continue;
            }
        }
        if ((c == '*' || c == '_') && i + 1 < n && text[i + 1] == c) {
            let close: i64 = str::find_from(*text, str::substr(*text, i, 2), i + 2) ?? -1;

            if (close > i + 2 && close + 2 <= n) {
                add(out, i, close + 2, Group::Bold);
                i = close + 2;
                continue;
            }
        }
        if ((c == '*' || c == '_') && i + 1 < n && text[i + 1] != ' ' &&
            (i == start || text[i - 1] == ' ' || text[i - 1] == '(')) {
            var j: i64 = i + 1;

            while (j < n && text[j] != c) { j += 1; }
            if (j < n && j > i + 1) {
                add(out, i, j + 1, Group::Italic);
                i = j + 1;
                continue;
            }
        }
        if (c == '[') {
            // [text](url): text a link, url a url, brackets plain
            let close: i64 = str::find_from(*text, "](", i + 1) ?? -1;

            if (close > i && close < n) {
                let end: i64 = str::find_from(*text, ")", close + 2) ?? -1;

                if (end > close && end < n) {
                    add(out, i + 1, close, Group::Link);
                    add(out, close + 2, end, Group::Url);
                    i = end + 1;
                    continue;
                }
            }
        }
        if (c == '<' && i + 1 < n && (str::starts_with(str::substr(*text, i + 1, 8), "http") ||
            str::starts_with(str::substr(*text, i + 1, 8), "mailto"))) {
            let end: i64 = str::find_from(*text, ">", i) ?? -1;

            if (end > i) {
                add(out, i + 1, end, Group::Url);
                i = end + 1;
                continue;
            }
        }
        if (c == '\\' && i + 1 < n) {
            add(out, i, i + 2, Group::Escape);
            i += 2;
            continue;
        }
        i += 1;
    }
}

// ---- s-expressions (zap's own configuration) --------------------------------

// ---- shell -----------------------------------------------------------------

fn shell(text: &string, mut out: &Hl[]) -> i64 {
    let n: i64 = limit(text);
    var i: i64 = 0;

    while (i < n) {
        let c: u8 = text[i];

        if (c == '#' && (i == 0 || text[i - 1] == ' ' || text[i - 1] == '\t')) {
            add(out, i, n, Group::Comment);
            return 0;
        }
        if (c == '"' || c == '\'') {
            let j: i64 = string_end(text, i, n, c);

            add(out, i, j, Group::String);
            i = j;
            continue;
        }
        if (c == '$') {
            var j: i64 = i + 1;

            if (j < n && text[j] == '{') {
                while (j < n && text[j] != '}') { j += 1; }
                if (j < n) { j += 1; }
            } else {
                while (j < n && is_ident(text[j])) { j += 1; }
            }
            add(out, i, j, Group::Constant);
            i = j;
            continue;
        }
        i += 1;
    }
    return 0;
}

#test fn highlights_aela() -> i32 {
    var out: Hl[] = [];
    let s: string = "let x: i64 = f(\"a\\\"b\"); // done";
    let st: i64 = line("aela", &s, 0, mut &out);

    if (st != 0 || out.len < 5) {
        return 1;
    }
    if (out[0].g != Group::Keyword || out[0].hi != 3) {
        return 2;
    }
    if (out[out.len - 1].g != Group::Comment) {
        return 3;
    }
    var o2: Hl[] = [];
    let s2: string = "a /* open";

    if (line("aela", &s2, 0, mut &o2) != 1) {
        return 4;
    }
    var o3: Hl[] = [];
    let s3: string = "still */ fn";

    if (line("aela", &s3, 1, mut &o3) != 0 || o3[1].g != Group::Keyword) {
        return 5;
    }
    return 0;
}

#test fn highlights_markdown() -> i32 {
    var out: Hl[] = [];
    let h: string = "## The rules";

    markdown(&h, 0, mut &out);
    if (out.len != 1 || out[0].g != Group::Heading || out[0].lo != 2) {
        return 1;
    }
    out.clear();
    let l: string = "1. **The host owns the loop.** see [FFI.md](../docs/FFI.md).";

    markdown(&l, 0, mut &out);
    if (out.len != 4) {
        return 2;
    }
    if (out[0].g != Group::ListMark || out[1].g != Group::Bold || out[2].g != Group::Link) {
        return 3;
    }
    if (out[3].g != Group::Url ||
        !str::eq(str::substr(l, out[3].lo, out[3].hi - out[3].lo), "../docs/FFI.md")) {
        return 4;
    }
    out.clear();
    let f: string = "```ae";

    if (markdown(&f, 0, mut &out) != 2) {
        return 5;
    }
    let u: string = "```";

    if (markdown(&u, 0, mut &out) != 1) {
        return 6;
    }
    return 0;
}

// the pieces of text in lang, as group:text (from state; plus the end state)
fn pieces(lang: string, text: string, state: i64) -> (string, i64) {
    var out: Hl[] = [];
    let st: i64 = line(lang, &text, state, mut &out);
    var b: str::Builder;

    for (let h: &out::&Hl in &out) {
        b.add("\(GROUP_NAMES[h.g as i64]):\(str::substr(text, h.lo, h.hi - h.lo)) ");
    }
    return (str::trim(b.to_string()), st);
}

// does text give want in lang (from state 0, ending in state after)?
fn expect(lang: string, text: string, want: string, after: i64) -> bool {
    let (got, st) = pieces(lang, text, 0);

    if (str::eq(got, want) && st == after) {
        return true;
    }
    println("\(lang): \(text)\n  got  \(got) (\(st))\n  want \(want) (\(after))");
    return false;
}

#test fn highlights_c() -> i32 {
    if (!expect("c", "#include <stdio.h>", "constant:#include string:<stdio.h>", 0)) {
        return 1;
    }
    if (!expect(
        "c", "static int f(char c) { return 'x' + 0x1F; } /* a",
        "keyword:static type:int function:f type:char keyword:return string:'x' operator:+ number:0x1F comment:/* a",
        1
    )) {
        return 2;
    }
    let (got, st) = pieces("c", "still */ NULL", 1);

    if (!str::eq(got, "comment:still */ constant:NULL") || st != 0) {
        return 3;
    }
    return 0;
}
