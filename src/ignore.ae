//! .gitignore patterns: which project paths git ignores (the palette's Grep
//! skips them). As git: blank lines and `#` comments skipped, `!` re-includes,
//! a trailing `/` matches only directories, a `/` at the start or in the
//! middle anchors the pattern to the root (else it matches at any depth);
//! `*` `?` `[...]` don't match `/`, `**` matches any number of directories.
//! The last matching pattern wins, and nothing inside an ignored directory
//! is re-included.

import str from "std/string";

struct Rule {
    pat: string = "";       // anchored to the root (unanchored ones get "**/")
    neg: bool = false;      // `!`: re-includes
    dir_only: bool = false; // trailing `/`
}

/// a .gitignore's patterns
export struct Ignore {
    rules: Rule[] = [];
}

/// the patterns of a .gitignore's text
export fn parse(text: string) -> Ignore {
    var ig: Ignore = Ignore {};

    for (let raw: string in str::lines(text)) {
        var l: string = str::trim_end(raw);

        if (l.len == 0 || l[0] == '#') { continue; }
        var r: Rule = Rule {};

        if (l[0] == '!') {
            r.neg = true;
            l = str::substr(l, 1, l.len - 1);
        } else if (l[0] == '\\') {
            l = str::substr(l, 1, l.len - 1);
        }
        if (l.len > 0 && l[l.len - 1] == '/') {
            r.dir_only = true;
            l = str::substr(l, 0, l.len - 1);
        }
        if (l.len == 0) { continue; }
        if (l[0] == '/') {
            l = str::substr(l, 1, l.len - 1);
        } else if (!str::contains(l, "/")) {
            l = "**/\(l)";
        }
        if (l.len == 0) { continue; }
        r.pat = l;
        ig.rules.push(r);
    }
    return ig;
}

impl Ignore {
    /// is p (relative to the .gitignore's directory, `/`-separated) ignored,
    /// itself or through a directory it is in?
    export fn ignored(self: &Ignore, p: string, is_dir: bool) -> bool {
        if (self.rules.len == 0) { return false; }
        for (let k: i64 in 0..p.len) {
            if (p[k] == '/' && k > 0 && self.verdict(str::substr(p, 0, k), true)) {
                return true;
            }
        }
        return self.verdict(p, is_dir);
    }

    // does the last pattern matching p ignore it?
    fn verdict(self: &Ignore, p: string, is_dir: bool) -> bool {
        var out: bool = false;

        for (let r: &Rule in &self.rules) {
            if (r.dir_only && !is_dir) { continue; }
            if (out != r.neg) { continue; }     // (it can't change the verdict)
            if (glob(&r.pat, 0, &p, 0)) { out = !r.neg; }
        }
        return out;
    }
}

// does pattern pat from pi match s from si?
fn glob(pat: &string, pi: i64, s: &string, si: i64) -> bool {
    var i: i64 = pi;
    var j: i64 = si;

    while (i < pat.len) {
        let c: u8 = pat[i];

        if (c == '*') {
            // `**` as a whole segment: any number of directories
            if (i + 1 < pat.len && pat[i + 1] == '*' && (i == 0 || pat[i - 1] == '/') &&
                (i + 2 == pat.len || pat[i + 2] == '/')) {
                if (i + 2 == pat.len) { return true; }
                if (glob(pat, i + 3, s, j)) { return true; }
                for (let k: i64 in j..s.len) {
                    if (s[k] == '/' && glob(pat, i + 3, s, k + 1)) { return true; }
                }
                return false;
            }
            // `*` (or a `**` within a segment): anything but `/`
            while (i < pat.len && pat[i] == '*') { i += 1; }
            var k: i64 = j;

            while (true) {
                if (glob(pat, i, s, k)) { return true; }
                if (k >= s.len || s[k] == '/') { return false; }
                k += 1;
            }
        }
        if (j >= s.len) { return false; }
        let d: u8 = s[j];

        if (c == '?') {
            if (d == '/') { return false; }
        } else if (c == '[') {
            let end: i64 = class_end(pat, i);

            if (end < 0) {
                if (d != '[') { return false; }
            } else {
                if (d == '/' || !in_class(pat, i + 1, end, d)) { return false; }
                i = end;
            }
        } else if (c == '\\' && i + 1 < pat.len) {
            i += 1;
            if (pat[i] != d) { return false; }
        } else if (c != d) {
            return false;
        }
        i += 1;
        j += 1;
    }
    return j == s.len;
}

// index of the `]` closing the class opened at i (-1: none)
fn class_end(pat: &string, i: i64) -> i64 {
    var k: i64 = i + 1;

    if (k < pat.len && (pat[k] == '!' || pat[k] == '^')) { k += 1; }
    if (k < pat.len && pat[k] == ']') { k += 1; }
    while (k < pat.len) {
        if (pat[k] == ']') { return k; }
        k += 1;
    }
    return -1;
}

// is d in the class pat[lo..end) (after its `[`)?
fn in_class(pat: &string, lo: i64, end: i64, d: u8) -> bool {
    var k: i64 = lo;
    var neg: bool = false;

    if (k < end && (pat[k] == '!' || pat[k] == '^')) {
        neg = true;
        k += 1;
    }
    var hit: bool = false;
    var first: bool = true;

    while (k < end) {
        let a: u8 = pat[k];

        if (k + 2 < end && pat[k + 1] == '-') {
            if (d >= a && d <= pat[k + 2]) { hit = true; }
            k += 3;
        } else {
            if (d == a && (a != ']' || first)) { hit = true; }
            k += 1;
        }
        first = false;
    }
    return hit != neg;
}

#test fn matches_as_git_does() -> i32 {
    let ig: Ignore = parse(
        "# build output\nbuild/\n*.log\n!keep.log\n/top.txt\ndocs/*.md\nsrc/**/gen\n\n[ab]?.c\n"
    );

    if (!ig.ignored("build/zap", false) || !ig.ignored("x/build/y", false)) { return 1; }
    if (ig.ignored("build", false)) { return 2; }   // (a file named build)
    if (!ig.ignored("a.log", false) || !ig.ignored("x/y/a.log", false)) { return 3; }
    if (ig.ignored("keep.log", false) || ig.ignored("x/keep.log", false)) { return 4; }
    if (!ig.ignored("top.txt", false) || ig.ignored("x/top.txt", false)) { return 5; }
    if (!ig.ignored("docs/a.md", false) || ig.ignored("docs/x/a.md", false)) { return 6; }
    if (!ig.ignored("src/gen", true) || !ig.ignored("src/a/b/gen/f.ae", false)) { return 7; }
    if (!ig.ignored("a1.c", false) || ig.ignored("c1.c", false) || ig.ignored("a12.c", false)) {
        return 8;
    }
    if (ig.ignored("src/main.ae", false) || ig.ignored("README.md", false)) { return 9; }
    // (nothing inside an ignored directory comes back)
    let ig2: Ignore = parse("out/\n!out/keep\n");

    if (!ig2.ignored("out/keep", false)) { return 10; }
    if (parse("").ignored("a", false)) { return 11; }
    return 0;
}
