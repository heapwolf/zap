//! zap's screen: the tree and editor side by side (the mouse drags the
//! split), the status line, the command line, a panel for long messages, and
//! a picker on top. Each frame uses only what App.prepare read: the lines and
//! rows on screen.

import tui from "std/tui";
import { Node, Frame, Rect, Size, Sizing, Pen } from "std/tui";
import str from "std/string";
import path from "std/path";
import { App, Mode, VisLine, VisRow } from "editor.ae";
import { SheetVis, VisCell } from "sheet.ae";
import sheetm from "sheet.ae";
import { DiagramVis } from "editor.ae";
import editor from "editor.ae";
import { Look } from "themes/theme.ae";
import { Kind, Decl } from "symbols.ae";
import { next_char, cell_width, col_of } from "buffer.ae";

// ---- the tree ----------------------------------------------------------------------

/// the tree's rows on screen
export struct TreePane(A) {
    export rows: VisRow[];
    export look: Look;
}

impl TreePane(A) as Node(A) {
    export fn measure(self: &TreePane(A), avail: i64) -> Size { return Size { w: 0, h: 0 }; }

    export fn sizing(self: &TreePane(A)) -> Sizing {
        return Sizing { w: tui::fill(1), h: tui::fill(1) };
    }

    export fn render(self: &TreePane(A), mut f: &Frame(A), area: Rect) -> void {
        f.fill(std::copy(area), &self.look.tree);
        let search: Pen = f.pen(&self.look.search);

        for (let y: i64, let r: &self::&VisRow in &self.rows) {
            if (y >= area.h) { break; }
            let row: Rect = Rect { x: area.x, y: area.y + y, w: area.w, h: 1 };
            var s: tui::Style = std::copy(self.look.tree_file);

            if (r.kind == 0) { s = std::copy(self.look.tree_root); }
            else if (r.kind == 1) { s = std::copy(self.look.tree_dir); }
            else if (r.special) { s = std::copy(self.look.tree_special); }
            if (r.open) { s = tui::merge(&s, &self.look.tree_open); }
            if (r.selected) {
                f.fill(std::copy(row), &self.look.tree_cursor);
                s.bg = std::copy(self.look.tree_cursor.bg);
            }
            let p: Pen = f.pen(&s);
            let x0: i64 = area.x + 1 + r.depth * 2;
            let w: i64 = area.w - (x0 - area.x);

            if (w <= 0) { continue; }
            // the name, with search matches highlighted
            var x: i64 = x0;
            var at: i64 = 0;
            var k: i64 = 0;
            let n: i64 = r.name.len;

            while (at < n && x < x0 + w) {
                var end: i64 = n;
                var lit: bool = false;

                if (k + 1 < r.matches.len) {
                    if (r.matches[k] <= at) {
                        end = r.matches[k + 1];
                        lit = true;
                        k += 2;
                    } else {
                        end = r.matches[k];
                    }
                }
                if (end <= at) { end = next_char(&r.name, at); }
                if (lit) {
                    x += f.print(x, area.y + y, &r.name, at, end, &search, x0 + w - x);
                } else {
                    x += f.print(x, area.y + y, &r.name, at, end, &p, x0 + w - x);
                }
                at = end;
            }
        }
    }
}

// ---- the editor ----------------------------------------------------------------------

/// the buffer's lines on screen: the gutter (line numbers), the text from
/// column left, the cursor (cx, cy: in text cells; -1: none)
export struct EditPane(A) {
    export lines: VisLine[];
    export gutter: i64;
    export left: i64;
    export tabstop: i64;
    export tildes: bool;            // ~ on rows past the end
    export icons: bool;             // git signs as bars (else + ~ _)
    export look: Look;
    export cx: i64;
    export cy: i64;
    export intro: tui::Span[][];    // splash lines, centered over an empty buffer
    export ghost: string;           // rest of the chosen completion, shown after the cursor
}

impl EditPane(A) as Node(A) {
    export fn measure(self: &EditPane(A), avail: i64) -> Size { return Size { w: 0, h: 0 }; }

    export fn sizing(self: &EditPane(A)) -> Sizing {
        return Sizing { w: tui::fill(1), h: tui::fill(1) };
    }

    export fn render(self: &EditPane(A), mut f: &Frame(A), area: Rect) -> void {
        f.fill(std::copy(area), &self.look.normal);

        var pens: Pen[] = [];

        for (let s: &self::&tui::Style in &self.look.syn) { pens.push(f.pen(s)); }
        let normal: Pen = f.pen(&self.look.normal);
        let search: Pen = f.pen(&self.look.search);
        let gut: Pen = f.pen(&self.look.gutter);
        let gut_cur: Pen = f.pen(&self.look.gutter_current);
        let gut_err: Pen = f.pen(&self.look.gutter_error);
        let git_pens: Pen[] = [
            std::copy(gut), f.pen(&self.look.git_add), f.pen(&self.look.git_change),
            f.pen(&self.look.git_delete), f.pen(&self.look.git_delete)
        ];
        var marks: string[] = ["", "▎", "▎", "▁", "▔"];

        if (!self.icons) { marks = ["", "+", "~", "_", "-"]; }

        let x0: i64 = area.x + self.gutter;
        let w: i64 = area.w - self.gutter;

        for (let y: i64, let vl: &self::&VisLine in &self.lines) {
            if (y >= area.h) { break; }
            let row: i64 = area.y + y;

            if (vl.no == 0) {
                if (self.tildes) { f.print(x0, row, &"~", 0, 1, &gut, 1); }
                continue;
            }
            // (git sign in the gutter's first column)
            if (self.gutter > 0 && vl.sign > 0 && vl.sign < marks.len) {
                f.print(area.x, row, &marks[vl.sign], 0, marks[vl.sign].len, &git_pens[vl.sign], 1);
            }
            if (self.gutter > 1) {
                let num: string = str::pad_start("\(vl.no)", self.gutter - 2, ' ');
                var p: Pen = std::copy(gut);

                if (vl.current) { p = std::copy(gut_cur); }
                if (vl.diag) { p = std::copy(gut_err); }
                f.print(area.x + 1, row, &num, 0, num.len, &p, self.gutter - 1);
            }
            if (w > 0) {
                line(f, vl, x0, row, w, self.left, self.tabstop, &pens, &normal, &search);
                if (vl.sel_lo >= 0) {
                    var a: i64 = vl.sel_lo - self.left;
                    var e: i64 = vl.sel_hi - self.left;

                    if (a < 0) { a = 0; }
                    if (e > w) { e = w; }
                    if (e > a) {
                        f.tint(Rect { x: x0 + a, y: row, w: e - a, h: 1 }, &self.look.visual);
                    }
                }
            }
        }
        // the intro, centered in the text area (the logo dropped if it does not fit)
        var first: i64 = 0;

        if (self.intro.len > area.h) { first = self.intro.len - area.h; }
        if (first > 0 && first < LOGO_LINES) { first = LOGO_LINES; }
        let h: i64 = self.intro.len - first;

        if (h > 0 && h <= area.h) {
            let top: i64 = area.y + (area.h - h) / 2;

            for (let k: i64 in first..self.intro.len) {
                let spans: &self::&tui::Span[] = &self.intro[k];
                var lw: i64 = 0;

                for (let sp: &spans::&tui::Span in spans) { lw += tui::width(sp.text); }
                var x: i64 = x0 + (w - lw) / 2;

                if (x < x0) { x = x0; }
                let y: i64 = top + k - first;

                for (let sp: &spans::&tui::Span in spans) {
                    let st: tui::Style = tui::merge(&self.look.normal, &sp.style);

                    x += f.text(x, y, sp.text, &st, x0 + w - x);
                }
            }
        }

        if (self.cy >= 0 && self.cy < area.h && self.cx >= 0 && self.cx < w) {
            if (self.ghost.len > 0) {
                var gst: tui::Style = tui::merge(&self.look.normal, &self.look.syn[1]);

                gst.dim = true;
                gst.italic = false;
                f.text(x0 + self.cx, area.y + self.cy, self.ghost, &gst, w - self.cx);
            }
            f.cursor(x0 + self.cx, area.y + self.cy);
        }
    }
}

/// a mermaid diagram's window: a bar (what it is, the keys), then the
/// drawing's rows, each cell colored by kind (the theme's syntax colors)
export struct DiagramPane(A) {
    export vis: DiagramVis;
    export look: Look;
}

                while (i < t.len && gone < skip) {
                    let j: i64 = next_char(&t, i);

                    gone += tui::width(str::substr(t, i, j - i));
                    i = j;
                }
                t = str::substr(t, i, t.len - i);
            }
            f.text(x0, area.y, t, &lk.sheet_bar, area.x + area.w - x0);
            f.cursor(x0 + cw - skip, area.y);
        } else {
            f.text(area.x + 1, area.y, self.vis.bar, &lk.sheet_bar, area.w - 1);
        }
        if (area.h < 2) {
            return;
        }
        let g: i64 = self.vis.gutter;

        f.fill(Rect { x: area.x, y: area.y + 1, w: area.w, h: 1 }, &lk.sheet_head);

        for (let h: &self::&VisCell in &self.vis.heads) {
            var st: tui::Style = std::copy(lk.sheet_head);

            if (h.cur || h.sel) { st = std::copy(lk.sheet_head_current); }
            let x: i64 = area.x + h.x;

            f.fill(Rect { x: x, y: area.y + 1, w: h.w, h: 1 }, &st);
            var at: i64 = (h.w - 1 - tui::width(h.text)) / 2;

            if (at < 0) { at = 0; }
            f.text(x + at, area.y + 1, h.text, &st, h.w - at);
        }
        let err: tui::Style = tui::merge(&lk.normal, &lk.syn[19]);

        for (let k: i64, let row: &self::&sheetm::VisRow in &self.vis.rows) {
            let y: i64 = area.y + 2 + k;

            if (y >= area.y + area.h) { break; }
            var hs: tui::Style = std::copy(lk.sheet_head);

            if (row.current || row.sel) { hs = std::copy(lk.sheet_head_current); }
            f.fill(Rect { x: area.x, y: y, w: g, h: 1 }, &hs);
            let no: string = str::pad_start(row.no, g - 1, ' ');

            f.text(area.x, y, no, &hs, g - 1);

            for (let c: &row::&VisCell in &row.cells) {
                var st: tui::Style = std::copy(lk.normal);

                if (row.header) { st = std::copy(lk.sheet_header); }
                if (c.kind == 2) { st = std::copy(err); }
                let x: i64 = area.x + c.x;

                if (c.sel && !c.cur) {
                    st = tui::merge(&st, &lk.sheet_sel);
                    f.fill(Rect { x: x, y: y, w: c.w, h: 1 }, &st);
                }
                if (c.cur) {
                    st = tui::merge(&st, &lk.sheet_cursor);
                    f.fill(Rect { x: x, y: y, w: c.w, h: 1 }, &st);
                }
                let room: i64 = c.w - 1;

                if (room <= 0) { continue; }
                var tx: i64 = x;

                if (c.right) {
                    let tw: i64 = tui::width(c.text);

                    if (tw < room) { tx = x + room - tw; }
                }
                // (a cell with a line break: its first line and an ellipsis)
                var t: string = c.text;

                if (let nl = str::find(t, "\n")) { t = "\(str::substr(t, 0, nl))…"; }
                f.text(tx, y, t, &st, x + room - tx);
            }
        }
    }
}

// draws a line's text from column left, w cells, at (x0, y): highlight
// pens, search matches over them, tabs expanded to the stops
fn line(
    A; mut f: &Frame(A), vl: &VisLine, x0: i64, y: i64, w: i64, left: i64, ts: i64, pens: &Pen[],
    normal: &Pen, search: &Pen
) -> void {
    let t: &string = &vl.text;
    let n: i64 = t.len;
    let nh: i64 = vl.hls.len;
    let nm: i64 = vl.matches.len;
    var i: i64 = 0;
    var col: i64 = 0;
    var hi: i64 = 0;
    var mi: i64 = 0;

    while (i < n && col - left < w) {
        while (hi < nh && vl.hls[hi].hi <= i) { hi += 1; }

        while (mi + 1 < nm && vl.matches[mi + 1] <= i) { mi += 2; }
        let in_match: bool = mi + 1 < nm && vl.matches[mi] <= i;
        let in_span: bool = hi < nh && vl.hls[hi].lo <= i;
        var end: i64 = n;

        if (in_match) {
            if (vl.matches[mi + 1] < end) { end = vl.matches[mi + 1]; }
        } else if (mi < nm && vl.matches[mi] < end) {
            end = vl.matches[mi];
        }
        if (in_span) {
            if (vl.hls[hi].hi < end) { end = vl.hls[hi].hi; }
        } else if (hi < nh && vl.hls[hi].lo < end) {
            end = vl.hls[hi].lo;
        }
        var p: &Pen = normal;

        if (in_match) { p = search; } else if (in_span) { p = &pens[vl.hls[hi].g as i64]; }
        // a tab: spaces up to the next stop
        if (t[i] == 9) {
            let cw: i64 = ts - col % ts;

            for (let c: i64 in col..(col + cw)) {
                if (c >= left && c - left < w) { f.put(x0 + c - left, y, ' ', p); }
            }
            col += cw;
            i += 1;
            continue;
        }
        // the run i..end (stops at a tab)
        var j: i64 = i;
        var run_w: i64 = 0;
        var c: i64 = col;

        while (j < end && t[j] != 9) {
            let cw: i64 = cell_width(t, j, c, ts);

            if (c < left) {
                // left of the window: skipped (a wide char cut by the edge: a space)
                if (c + cw > left) {
                    for (let k: i64 in left..(c + cw)) {
                        if (k - left < w) { f.put(x0 + k - left, y, ' ', p); }
                    }
                }
                c += cw;
                j = next_char(t, j);
                i = j;
                col = c;
                continue;
            }
            run_w += cw;
            c += cw;
            j = next_char(t, j);
        }
        if (run_w > 0) {
            let room: i64 = w - (col - left);
            let used: i64 = f.print(x0 + col - left, y, t, i, j, p, room);

            if (used < run_w) {
                return;
            }
        }
        col = c;
        i = j;
    }
}

// ---- the intro --------------------------------------------------------------------------

let LOGO: string[] = [
    "╺━┓┏━┓┏━┓",
    "┏━┛┣━┫┣━┛",
    "┗━╸╹ ╹╹  "
];
let LOGO_LINES: i64 = 4;

// the intro text (like nvim's: name and version, then what to type)
fn intro_lines(s: &App) -> tui::Span[][] {
    let lk: &s::&Look = &s.look;
    let accent: tui::Style = std::copy(lk.syn[10]);          // the heading face
    var title: tui::Style = tui::Style { bold: true };
    var dim: tui::Style = tui::Style { dim: true };
    var out: tui::Span[][] = [];

    for (let l: string in LOGO) { out.push([tui::span(l, std::copy(accent))]); }
    out.push([]);
    out.push([tui::span("ZAP v\(editor::VERSION)", title)]);
    out.push([]);
    out.push([tui::span("zap is a terminal editor written in Aela", std::copy(dim))]);
    out.push([tui::span("its add-ins speak to aec, the Aela compiler", std::copy(dim))]);
    out.push([]);
    let rows: string[] = [
        ":help<Enter>", "for help", "<C-k>", "for the palette (files, grep, symbols)",
        "<C-t>", "to show or hide the tree", ":config<Enter>", "to configure zap",
        ":q<Enter>", "to exit"
    ];
    var k: i64 = 0;

    while (k + 1 < rows.len) {
        out.push([
            tui::plain("type  "), tui::span(str::pad_end(rows[k], 16, ' '), std::copy(accent)),
            tui::plain(str::pad_end(rows[k + 1], 40, ' '))
        ]);
        k += 2;
    }
    return out;
}

// ---- the status line ------------------------------------------------------------------

// a separator glyph between two segments: fg the left one's background,
// bg the right one's
fn sep(glyph: string, left: &tui::Style, right: &tui::Style) -> tui::Span {
    return tui::span(glyph, tui::Style { fg: std::copy(left.bg), bg: std::copy(right.bg) });
}

fn status(s: &App) -> Node(App) {
    let lk: &s::&Look = &s.look;
    var mode_style: tui::Style = std::copy(lk.mode_normal);

    if (s.mode == Mode::Insert) { mode_style = std::copy(lk.mode_insert); }
    if (s.mode == Mode::Command || s.mode == Mode::Search) {
        mode_style = std::copy(lk.mode_command);
    }
    if (s.focus_tree && s.mode == Mode::Normal) { mode_style = std::copy(lk.mode_tree); }
    if (s.mode == Mode::Visual) { mode_style = std::copy(lk.mode_visual); }
    let icons: bool = s.cfg.icons;
    var hard_r: string = "";
    var thin_l: string = "";
    var hard_l: string = "";

    if (!icons) {
        hard_r = " ";
        thin_l = "|";
        hard_l = " ";
    }
    var name: string = "[No Name]";

    if (s.b.name.len > 0) { name = path::base(s.b.name); }
    if (s.b.modified) { name = "\(name) [+]"; }
    if (s.b.text.broken.len > 0) { name = "\(name) [! \(s.b.text.broken)]"; }
    var left: tui::Span[] = [
        tui::span(" \(s.mode_name()) ", std::copy(mode_style)),
        sep(hard_r, &mode_style, &lk.status)
    ];
    // (a temporary message replaces the file name)
    let showing: bool = s.msg.len > 0 && s.msg_in_status();

    if (showing) {
        left.push(tui::plain(""));              // (filled in once the right side is known)
    } else {
        left.push(tui::span(" \(name)", std::copy(lk.status_file)));
    }
    if (s.pending.len > 0) {
        left.push(tui::span("  \(str::join(&s.pending, ""))", std::copy(lk.status_info)));
    }
    var right: tui::Span[] = [];

    if (s.busy()) {
        let frames: string[] = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
        let j: &s::&editor::Job = &s.jobs[0];
        let k: i64 = (j.started.elapsed() / 100ms) % 10;

        right.push(tui::span("\(frames[k]) \(j.name)  ", std::copy(lk.status_info)));
    }
    if (s.b.diags.len > 0) {
        right.push(tui::span("E\(s.b.diags.len)  ", std::copy(lk.error)));
    }
    var ff: string = "unix";

    if (s.b.text.crlf) { ff = "dos"; }
    if (icons) {
        ff = "";
        if (s.b.text.crlf) { ff = ""; }
    }
    var ft: string = s.b.ft.name;

    if (icons && s.b.ft.icon.len > 0) { ft = "\(s.b.ft.icon) \(ft)"; }
    var count: i64 = s.b.text.count;
    var at: i64 = s.b.cy;
    var place: string = "\(s.b.cy + 1):\(s.b.cx + 1)";

    if (s.sheet_on()) {
        let sh: &s::&sheetm::Sheet = &s.b.sheet[0];

        count = sh.rows.len;
        at = sh.r;
        place = sheetm::cell_name(sh.r, sh.c);
    }
    var pct: string = "\((at + 1) * 100 / count)%";

    if (at == 0) { pct = "Top"; }
    if (at == count - 1 && count > 1) { pct = "Bot"; }
    let info: tui::Style = std::copy(lk.status_info);

    right.push(tui::span("utf-8 ", std::copy(info)));
    right.push(tui::span(thin_l, std::copy(info)));
    right.push(tui::span(" \(ff) ", std::copy(info)));
    right.push(tui::span(thin_l, std::copy(info)));
    right.push(tui::span(" \(ft) ", std::copy(info)));
    right.push(tui::span(thin_l, std::copy(info)));
    right.push(tui::span(" \(pct) ", std::copy(info)));
    right.push(sep(hard_l, &lk.status, &lk.status_end));
    right.push(tui::span(" \(place) ", std::copy(lk.status_end)));
    // (the right hard separator points left: the end's color over the bar's)
    let last: i64 = right.len - 2;

    right[last] = tui::span(
        hard_l, tui::Style { fg: std::copy(lk.status_end.bg), bg: std::copy(lk.status.bg) }
    );
    if (showing) {
        // as much as fits before the right side (one line)
        var used: i64 = 1;

        for (let sp: &left::&tui::Span in &left) { used += tui::width(sp.text); }

        for (let sp: &right::&tui::Span in &right) { used += tui::width(sp.text); }
        var text: string = str::replace(s.msg, "\n", " ");
        let room: i64 = s.cols - used - 1;

        if (tui::width(text) > room) {
            if (room <= 1) { text = ""; } else { text = "\(tui::truncate(text, room - 1))…"; }
        }
        var st: tui::Style = tui::merge(&lk.status, &lk.message);

        if (s.msg_error) { st = tui::merge(&lk.status, &lk.error); }
        st.bg = std::copy(lk.status.bg);
        left[2] = tui::span(" \(text)", st);
    }
    return tui::Status {
        left: left,
        right: right,
        style: std::copy(lk.status),
        height: tui::fixed(1)
    };
}

// ---- the bottom: the command line, the panel ---------------------------------------------

fn bottom(s: &App) -> Node(App) {
    if (s.mode == Mode::Command || s.mode == Mode::Search) {
        return tui::Input {
            state: std::copy(s.cmd), prompt: s.cmd_prompt(), focus: true,
            style: std::copy(s.look.cmdline),
            height: tui::fixed(1)
        };
    }
    var st: tui::Style = std::copy(s.look.message);

    if (s.msg_error) { st = std::copy(s.look.error); }
    return tui::Text {
        text: s.msg, style: st, wrap: tui::Wrap::Ellipsis, height: tui::fixed(1),
        width: tui::fill(1)
    };
}

fn panel(s: &App) -> Node(App) {
    let h: i64 = s.panel_height();
    var kids: Node(App)[] = [];
    var title: tui::Style = std::copy(s.look.panel);

    title.bold = true;
    kids.push(tui::Text { text: s.panel_title, style: title, height: tui::fixed(1) });
    var first: i64 = s.panel.len - (h - 1);

    if (first < 0) { first = 0; }

    for (let i: i64 in first..s.panel.len) {
        kids.push(tui::Text {
            text: s.panel[i], style: std::copy(s.look.panel), wrap: tui::Wrap::Ellipsis,
            height: tui::fixed(1)
        });
    }
    return tui::Column { children: kids, style: std::copy(s.look.panel), height: tui::fixed(h) };
}

// ---- the command line's completions -------------------------------------------------

/// Tab's completions, in a menu above the command line, at the column of the
/// word they complete (the chosen one marked)
export struct WildMenu(A) {
    export items: string[];
    export at: i64;
    export x: i64;
    export look: Look;
}

impl WildMenu(A) as Node(A) {
    export fn measure(self: &WildMenu(A), avail: i64) -> Size { return Size { w: 0, h: 0 }; }

    export fn sizing(self: &WildMenu(A)) -> Sizing {
        return Sizing { w: tui::fill(1), h: tui::fill(1) };
    }

    export fn render(self: &WildMenu(A), mut f: &Frame(A), area: Rect) -> void {
        let n: i64 = self.items.len;
        var h: i64 = n;

        if (h > 12) { h = 12; }
        if (h > area.h - 2) { h = area.h - 2; }
        if (h < 1) {
            return;
        }
        var w: i64 = 0;

        for (let it: &self::&string in &self.items) {
            let iw: i64 = tui::width(*it);

            if (iw > w) { w = iw; }
        }
        w += 2;
        if (w > area.w) { w = area.w; }
        var x: i64 = area.x + self.x - 1;

        if (x + w > area.x + area.w) { x = area.x + area.w - w; }
        if (x < area.x) { x = area.x; }
        // (its last row just above the command line)
        let y0: i64 = area.y + area.h - 1 - h;
        var first: i64 = 0;

        if (self.at >= h) { first = self.at - h + 1; }

        for (let k: i64 in 0..h) {
            let i: i64 = first + k;
            var st: &tui::Style = &self.look.menu;

            if (i == self.at) { st = &self.look.menu_selected; }
            f.fill(Rect { x: x, y: y0 + k, w: w, h: 1 }, st);
            f.text(x + 1, y0 + k, self.items[i], st, w - 2);
        }
    }
}

/// a menu completion: its icon (and the syntax group it is colored by), its
/// word, and what it is ("pub fn", "field Item")
export struct MenuRow {
    export icon: string;
    export group: i64;              // -1: menu.kind's color
    export word: string;
    export label: string;
}

/// insert mode's completions, in a menu below the typed word (above it if no
/// room): x, y is its first cell on screen; the chosen one's docs are in a
/// box beside it
export struct PopMenu(A) {
    export rows: MenuRow[];
    export at: i64;
    export typed: i64;              // characters typed (marked in each word)
    export x: i64;
    export y: i64;
    export bottom: i64;             // first row it must not cover (the status line)
    export title: string;           // the chosen one's signature ("": no box)
    export doc: string[];
    export place: string;           // where it is declared
    export look: Look;
}

impl PopMenu(A) as Node(A) {
    export fn measure(self: &PopMenu(A), avail: i64) -> Size { return Size { w: 0, h: 0 }; }

    export fn sizing(self: &PopMenu(A)) -> Sizing {
        return Sizing { w: tui::fill(1), h: tui::fill(1) };
    }

    export fn render(self: &PopMenu(A), mut f: &Frame(A), area: Rect) -> void {
        let n: i64 = self.rows.len;
        var h: i64 = n;

        if (h > 10) { h = 10; }
        var y0: i64 = area.y + self.y + 1;
        let below: i64 = area.y + self.bottom - y0;
        let above: i64 = self.y;

        if (h > below) {
            if (above > below) {
                if (h > above) { h = above; }
                y0 = area.y + self.y - h;
            } else {
                h = below;
            }
        }
        if (h < 1) {
            return;
        }
        // the columns: icon, word, label
        var ww: i64 = 0;
        var lw: i64 = 0;

        for (let r: &self::&MenuRow in &self.rows) {
            let a: i64 = tui::width(r.word);

            if (a > ww) { ww = a; }
            let b: i64 = tui::width(r.label);

            if (b > lw) { lw = b; }
        }
        if (ww > 40) { ww = 40; }
        if (lw > 24) { lw = 24; }
        var w: i64 = 4 + ww + 2 + lw + 1;

        if (w > area.w) { w = area.w; }
        // (each word aligned under the typed word, the icon to its left)
        var x: i64 = area.x + self.x - 3;

        if (x + w > area.x + area.w) { x = area.x + area.w - w; }
        if (x < area.x) { x = area.x; }
        var first: i64 = 0;

        if (self.at >= h) { first = self.at - h + 1; }

        for (let k: i64 in 0..h) {
            let i: i64 = first + k;
            let r: &self::&MenuRow = &self.rows[i];
            var st: tui::Style = std::copy(self.look.menu);

            if (i == self.at) { st = std::copy(self.look.menu_selected); }
            let row: i64 = y0 + k;

            f.fill(Rect { x: x, y: row, w: w, h: 1 }, &st);
            var ist: tui::Style = tui::merge(&st, &self.look.menu_kind);

            if (r.group >= 0 && r.group < self.look.syn.len) {
                let g: &self::&tui::Style = &self.look.syn[r.group];

                ist.fg = std::copy(g.fg);
            }
            f.text(x + 1, row, r.icon, &ist, 2);
            // the word, its typed part marked
            let typed: i64 = self.typed;
            var cut: i64 = typed;

            if (cut > r.word.len) { cut = r.word.len; }
            let mst: tui::Style = tui::merge(&st, &self.look.menu_match);
            let used: i64 = f.text(x + 3, row, str::substr(r.word, 0, cut), &mst, ww);

            f.text(x + 3 + used, row, str::substr(r.word, cut, r.word.len - cut), &st, ww - used);
            var lst: tui::Style = std::copy(st);

            lst.dim = i != self.at;
            f.text(x + 4 + ww + 1, row, r.label, &lst, lw);
        }
        if (self.title.len == 0) {
            return;
        }
        // the docs beside it (right if they fit, else left)
        var dw: i64 = 60;
        var dx: i64 = x + w;

        if (dx + 24 > area.x + area.w) {
            dx = x - dw;
            if (dx < area.x) {
                dw = x - area.x;
                dx = area.x;
            }
        } else if (dx + dw > area.x + area.w) {
            dw = area.x + area.w - dx;
        }
        if (dw < 20) {
            return;
        }
        var inner: i64 = dw - 4;
        var lines: string[] = [];
        var kinds: i64[] = [];          // 0 title, 1 comment, 2 place

        for (let l: string in wrap(&self.title, inner)) {
            lines.push(l);
            kinds.push(0);
        }
        if (self.doc.len > 0) {
            lines.push("");
            kinds.push(1);

            for (let d: &self::&string in &self.doc) {
                for (let l: string in wrap(d, inner)) {
                    lines.push(l);
                    kinds.push(1);
                }
            }
        }
        if (self.place.len > 0) {
            lines.push("");
            kinds.push(2);
            lines.push(self.place);
            kinds.push(2);
        }
        // (as wide as the widest line)
        var widest: i64 = 0;

        for (let l: &lines::&string in &lines) {
            let lw2: i64 = tui::width(*l);

            if (lw2 > widest) { widest = lw2; }
        }
        if (widest < inner) {
            if (dx < x) { dx += inner - widest; }
            dw -= inner - widest;
            inner = widest;
        }
        var dh: i64 = lines.len + 2;

        if (dh > 16) { dh = 16; }
        var dy: i64 = y0;

        if (dy + dh > area.y + self.bottom) { dy = area.y + self.bottom - dh; }
        if (dy < area.y) { dy = area.y; }
        if (dh > self.bottom) { dh = self.bottom; }
        let box: tui::Style = std::copy(self.look.menu_doc);

        f.fill(Rect { x: dx, y: dy, w: dw, h: dh }, &box);
        let bst: tui::Style = tui::merge(&box, &self.look.menu_border);
        let bar: string = str::repeat("─", dw - 2);

        f.text(dx, dy, "╭\(bar)╮", &bst, dw);
        f.text(dx, dy + dh - 1, "╰\(bar)╯", &bst, dw);

        for (let k: i64 in 1..(dh - 1)) {
            f.text(dx, dy + k, "│", &bst, 1);
            f.text(dx + dw - 1, dy + k, "│", &bst, 1);
        }
        let tst: tui::Style = tui::merge(&box, &self.look.menu_doc_title);
        var wst: tui::Style = std::copy(box);

        wst.dim = true;

        for (let k: i64 in 0..(dh - 2)) {
            if (k >= lines.len) { break; }
            var st: &tui::Style = &box;

            if (kinds[k] == 0) { st = &tst; }
            if (kinds[k] == 2) { st = &wst; }
            f.text(dx + 2, dy + 1 + k, lines[k], st, inner);
        }
    }
}

// wraps s into lines of at most w cells, at spaces
fn wrap(s: &string, w: i64) -> string[] {
    var out: string[] = [];
    var line: string = "";

    for (let word: string in str::split(*s, " ")) {
        if (line.len == 0) {
            line = word;
        } else if (tui::width(line) + 1 + tui::width(word) <= w) {
            line = "\(line) \(word)";
        } else {
            out.push(line);
            line = word;
        }

        while (tui::width(line) > w && w > 0) {
            out.push(tui::truncate(line, w));
            line = str::substr(
                line, tui::truncate(line, w).len, line.len - tui::truncate(line, w).len
            );
        }
    }
    if (line.len > 0 || out.len == 0) { out.push(line); }
    return out;
}

// a kind's icon (icons: a Nerd Font codicon, else a letter), syntax group
// color, and name
fn kind_icon(k: Kind, icons: bool) -> (string, i64, string) {
    match (k) {
        Kind::Function => { return (pick(icons, "", "f"), 6, "fn"); },
        Kind::Method => { return (pick(icons, "", "m"), 6, "method"); },
        Kind::Field => { return (pick(icons, "", "."), 10, "field"); },
        Kind::Struct => { return (pick(icons, "", "S"), 4, "struct"); },
        Kind::Enum => { return (pick(icons, "", "E"), 4, "enum"); },
        Kind::Variant => { return (pick(icons, "", "e"), 7, "variant"); },
        Kind::Interface => { return (pick(icons, "", "I"), 4, "interface"); },
        Kind::Constant => { return (pick(icons, "", "c"), 7, "let"); },
        Kind::Variable => { return (pick(icons, "", "v"), 10, "var"); },
        Kind::Failure => { return (pick(icons, "", "!"), 4, "failure"); },
        Kind::Module => { return (pick(icons, "", "M"), 13, "module"); },
        Kind::Keyword => { return (pick(icons, "", "k"), 3, "keyword"); },
        Kind::Type => { return (pick(icons, "", "T"), 4, "type"); },
        Kind::Reexport => { return (pick(icons, "", "M"), 13, "export"); },
        _ => {}
    }
    return (pick(icons, "", "w"), -1, "");
}

fn pick(c: bool, a: string, b: string) -> string {
    if (c) {
        return a;
    }
    return b;
}

// the rest of the chosen completion, if the cursor is at its line's end
fn ghost_of(s: &App) -> string {
    if (s.comp.len == 0 || s.mode != Mode::Insert || s.comp_at < 0 || s.comp_at >= s.comp.len) {
        return "";
    }
    if (s.b.cy != s.comp_y || s.b.cx != s.vis_line(s.b.cy).len) {
        return "";
    }
    let w: string = s.comp[s.comp_at].word;
    let n: i64 = s.comp_prefix.len;

    if (w.len <= n) {
        return "";
    }
    return str::substr(w, n, w.len - n);
}

// the menu's rows, plus the chosen one's signature and place
fn menu_of(s: &App) -> PopMenu(App) {
    var rows: MenuRow[] = [];

    for (let it: &s::&editor::CompItem in &s.comp) {
        let (icon, group, name) = kind_icon(it.kind, s.cfg.icons);
        var label: string = name;

        if (it.owner.len > 0 && (it.kind == Kind::Method || it.kind == Kind::Field ||
            it.kind == Kind::Variant || it.kind == Kind::Module)) {
            label = "\(label) \(it.owner)";
        }
        if (it.exported && it.kind != Kind::Field && it.kind != Kind::Variant) {
            label = "pub \(label)";
        }
        rows.push(MenuRow { icon: icon, group: group, word: it.word, label: label });
    }
    var title: string = "";
    var place: string = "";

    if (s.comp_at >= 0 && s.comp_at < s.comp.len) {
        let k: i64 = s.comp[s.comp_at].decl;

        if (k >= 0) {
            let d: &s::&Decl = &s.index.decls[k];

            title = d.detail;
            var f: string = d.file;

            if (let i = str::rfind(f, "/std/")) {
                f = str::substr(f, i + 1, f.len - i - 1);
            } else {
                f = editor::short_name(s.cwd, f);
            }
            place = "\(f):\(d.line)";
        }
    }
    let l: string = s.vis_line(s.comp_y);
    let col: i64 = col_of(&l, s.comp_x, s.b.tabstop) - s.b.left;

    return PopMenu {
        rows: rows, at: s.comp_at, typed: s.comp_prefix.len, x: s.edit_x + s.gutter + col,
        y: s.comp_y - s.b.top, bottom: s.edit_h, title: title, doc: std::copy(s.comp_doc),
        place: place, look: std::copy(s.look)
    };
}

// ---- the whole screen ----------------------------------------------------------------

/// app's frame: paints what prepare read
export fn view(s: &App) -> Node(App) {
    var cx: i64 = -1;
    var cy: i64 = -1;

    if (!s.focus_tree && s.mode != Mode::Command && s.mode != Mode::Search && s.picking.len == 0 &&
        !s.sheet_on() && !s.viewing()) {
        let l: string = s.vis_line(s.b.cy);

        cx = col_of(&l, s.b.cx, s.b.tabstop) - s.b.left;
        cy = s.b.cy - s.b.top;
    }
    var intro: tui::Span[][] = [];

    if (s.intro()) { intro = intro_lines(s); }
    var pane: Node(App) = EditPane {
        lines: std::copy(s.vis), gutter: s.gutter, left: s.b.left, tabstop: s.b.tabstop,
        tildes: s.cfg.tildes, icons: s.cfg.icons, look: std::copy(s.look), cx: cx, cy: cy,
        intro: intro, ghost: ghost_of(s)
    };

    if (s.viewing()) {
        pane = DiagramPane { vis: std::copy(s.diagram_vis), look: std::copy(s.look) };
    } else if (s.sheet_on()) {
        let editing: bool = s.mode == Mode::Search && str::eq(s.cmd_kind, "cell");

        pane = SheetPane {
            vis: std::copy(s.sheet_vis), look: std::copy(s.look), editing: editing,
            prompt: s.cmd_prompt(),
            input: s.cmd.text, at: s.cmd.cursor
        };
    }
    let edit: Node(App) = tui::Block {
        border: tui::Border::None, width: tui::fill(1), height: tui::fill(1),
        on_click: fn(a, c) -> { a.click_edit(c.x, c.y); },
        child: pane
    };
    var top: Node(App) = tui::Spacer {};

    if (s.split.at <= 0) {
        top = edit;
    } else {
        top = tui::Split {
            state: std::copy(s.split), divider: " ", style: std::copy(s.look.divider), min: 4,
            height: tui::fill(1),
            first: tui::Block {
                border: tui::Border::None, on_click: fn(a, c) -> { a.click_tree(c.y); },
                child: TreePane { rows: std::copy(s.tree_vis), look: std::copy(s.look) }
            },
            second: edit
        };
    }
    var kids: Node(App)[] = [top];

    if (s.panel.len > 0) { kids.push(panel(s)); }
    kids.push(status(s));
    if (s.cmd_line_shown()) { kids.push(bottom(s)); }
    let main: Node(App) = tui::Column { children: kids, style: std::copy(s.look.normal) };

    if (s.comp.len > 0 && s.mode == Mode::Insert && s.picking.len == 0) {
        return tui::Stack { layers: [main, menu_of(s)] };
    }
    if (s.wild.len > 0 && s.mode == Mode::Command) {
        return tui::Stack { layers: [main, WildMenu {
            items: std::copy(s.wild), at: s.wild_at, x: 1 + tui::width(s.wild_head),
            look: std::copy(s.look)
        }] };
    }
    if (s.picking.len == 0) {
        return main;
    }
    // the palette: categories (Tab, Shift+Tab), a search over the items
    var tabs: tui::Span[] = [];
    var on: tui::Style = std::copy(s.look.search);

    on.bold = true;
    var off: tui::Style = std::copy(s.look.dialog);

    off.dim = true;

    for (let k: i64, let c: string in editor::CATEGORIES) {
        // (padded right with a no-break space: trailing spaces are not
        // drawn, so the last tab's highlight would lose one)
        let label: string = " \(c)\u{a0}";

        if (k == s.cat) { tabs.push(tui::span(label, std::copy(on))); } else {
            tabs.push(tui::span(label, std::copy(off)));
        }
        if (k + 1 < editor::CATEGORIES.len) { tabs.push(tui::plain(" ")); }
    }
    var hint: string = "Tab: category  Up/Down: choose  Enter: open  Esc: close";

    if (s.cat == 1) {
        hint = "\(s.pick_items.len) lines in \(s.grep_at) of \(s.files.len) files";
        if (s.walking) { hint = "\(hint) (listing the project)"; }
        if (s.grep_query.len < 2) { hint = "type at least two characters to search the project"; }
    }
    if (s.cat == 2 && s.pick_items.len == 0) { hint = "aec outline is reading the project..."; }
    if (s.cat == 0 && s.walking) { hint = "listing the project... (\(s.files.len) files)"; }
    var dim: tui::Style = std::copy(s.look.dialog);

    dim.dim = true;
    return tui::Stack { layers: [main, tui::Dialog {
        title: "Palette", box_w: tui::percent(70), box_h: tui::percent(60),
        border: tui::Border::Rounded, style: std::copy(s.look.dialog),
        on_dismiss: fn(a) -> { a.picking = ""; },
        keys: [
            tui::bind("esc", fn(mut a: &App) -> { a.picking = ""; }),
            tui::bind("tab", fn(mut a: &App) -> { a.next_category(1); }),
            tui::bind("shift+tab", fn(mut a: &App) -> { a.next_category(-1); })
        ],
        child: tui::Column { children: [
            tui::Text { spans: tabs, wrap: tui::Wrap::Clip, height: tui::fixed(1) },
            tui::Text { text: hint, style: dim, wrap: tui::Wrap::Ellipsis, height: tui::fixed(1) },
            tui::Picker {
                state: std::copy(s.picker), items: std::copy(s.shown), prompt: "> ",
                placeholder: "type to filter", focus: true, height: tui::fill(1),
                in_order: true,
                on_select: fn(a, i) -> { a.picked_shown(i); },
                match_style: std::copy(s.look.search),
                style: std::copy(s.look.dialog)
            },
        ] }
    }] };
}
