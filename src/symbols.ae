//! zap's declaration index, for completion: the output of `aec outline
//! --deps` (the add-in command `symbols`), parsed into each declaration's
//! name, kind, signature, location and first comment line; each file's
//! imports; struct fields, enum variants and impl methods, with their owner.
//!
//! The index is by name only: `x.` offers every struct's fields and methods
//! (zap has no types), `str::` the exports of the module str names.

import str from "std/string";
import path from "std/path";

/// a declaration's kind (as the menu's icons and labels show it)
export enum Kind {
    Text,           // a word in a buffer
    Function,
    Method,
    Field,
    Struct,
    Enum,
    Variant,
    Interface,
    Constant,       // let
    Variable,       // var
    Failure,
    Module,         // an import's name
    Keyword,
    Type,
    Reexport        // export Name; (declared in the file it came from)
}

/// a declaration
export struct Decl {
    export name: string;
    export kind: Kind;
    export exported: bool;
    export detail: string;      // signature, on one line
    export owner: string;       // a method's or field's type, a variant's enum
    export file: string;        // where (absolute), and its line (1-based)
    export line: i64;
    export doc: string = "";    // first line of the comment above it
}

/// an import: file imports target as alias, or the names in braces
export struct Import {
    export file: string;
    export target: string;       // as written ("std/string", "buffer.ae")
    export alias: string = "";   // "" for braces
    export names: string[] = [];
}

/// what the index knows
export struct Index {
    export decls: Decl[] = [];
    export imports: Import[] = [];
    export files: string[] = [];  // files outlined (absolute)
}

// s without prefix p (s if it lacks it)
fn after(s: &string, p: string) -> string {
    if (str::starts_with(*s, p)) {
        return str::substr(*s, p.len, s.len - p.len);
    }
    return *s;
}

// the name at the start of s (letters, digits, _)
fn name_at(s: &string) -> string {
    var e: i64 = 0;

    while (e < s.len && ident(s[e])) { e += 1; }
    return str::substr(*s, 0, e);
}

fn ident(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// s split at sep (comma or semicolon) at depth 0
fn parts(s: &string, sep: u8) -> string[] {
    var out: string[] = [];
    var depth: i64 = 0;
    var start: i64 = 0;

    for (let i: i64 in 0..s.len) {
        let c: u8 = s[i];

        if (c == '(' || c == '{' || c == '[') { depth += 1; }
        if (c == ')' || c == '}' || c == ']') { depth -= 1; }
        if (c == sep && depth == 0) {
            out.push(str::trim(str::substr(*s, start, i - start)));
            start = i + 1;
        }
    }
    let last: string = str::trim(str::substr(*s, start, s.len - start));

    if (last.len > 0) { out.push(last); }
    return out;
}

// the text between the first { and last } of s ("": none)
fn body(s: &string) -> string {
    let a: i64 = str::find(*s, "{") ?? -1;
    let b: i64 = str::rfind(*s, "}") ?? -1;

    if (a < 0 || b <= a) {
        return "";
    }
    return str::substr(*s, a + 1, b - a - 1);
}

/// index an outline's lines (relative paths: from cwd)
export fn parse(lines: &string[], cwd: string) -> Index {
    var x: Index = Index {};
    var file: string = "";
    var owner: string = "";

    for (let l: string in lines) {
        if (str::starts_with(l, "== ")) {
            var f: string = str::substr(l, 3, l.len - 3);

            if (let paren = str::rfind(f, " (")) { f = str::substr(f, 0, paren); }
            if (!path::is_absolute(f)) { f = path::join(cwd, f); }
            file = path::clean(f);
            owner = "";
            x.files.push(file);
            continue;
        }
        if (file.len == 0) { continue; }
        let t: string = str::trim(l);

        if (str::starts_with(t, "imports: ")) {
            for (let p: string in parts(&str::substr(t, 9, t.len - 9), ',')) {
                take_import(mut &x, file, p);
            }
            continue;
        }
        // line number, then the declaration (two extra spaces: a method)
        let sp: i64 = str::find(t, " ") ?? -1;

        if (sp <= 0) { continue; }
        var no: i64 = 0;

        match (str::parse_int(str::substr(t, 0, sp))) {
            n => { no = n; },
            e: str::BadInt => { continue; }
        }
        let rest: string = str::substr(t, sp + 1, t.len - sp - 1);
        let method: bool = str::starts_with(rest, "  ");
        var decl: string = str::trim(rest);
        var doc: string = "";

        if (let c = str::find(decl, "   // ")) {
            doc = str::trim(str::substr(decl, c + 6, decl.len - c - 6));
            decl = str::trim(str::substr(decl, 0, c));
        }
        if (!method) { owner = ""; }
        take_decl(mut &x, file, no, decl, doc, method, mut &owner);
    }
    return x;
}

// "std/string (str)" or "tui/text.ae { Span, span }"
fn take_import(mut x: &Index, file: string, p: string) -> void {
    if (let b = str::find(p, " {")) {
        var names: string[] = [];

        for (let n: string in parts(&body(&p), ',')) { names.push(n); }
        x.imports.push(Import { file: file, target: str::substr(p, 0, b), names: names });
        return;
    }
    if (let b = str::find(p, " (")) {
        let alias: string = str::trim_suffix(str::substr(p, b + 2, p.len - b - 2), ")");

        x.imports.push(Import { file: file, target: str::substr(p, 0, b), alias: alias });
    }
}

fn take_decl(
    mut x: &Index, file: string, no: i64, decl0: string, doc: string, method: bool,
    mut owner: &string
) -> void {
    var d: string = decl0;
    let exported: bool = str::starts_with(d, "export ");

    d = after(&d, "export ");
    if (str::starts_with(d, "impl ")) {
        // impl Name(A) as Interface
        *owner = name_at(&str::substr(d, 5, d.len - 5));
        return;
    }
    var bare: string = d;

    for (let q: string in ["async ", "pure ", "task ", "#inline ", "extern "]) {
        bare = after(&bare, q);
    }
    var kind: Kind = Kind::Function;
    var rest: string = "";

    if (str::starts_with(bare, "fn ")) {
        rest = str::substr(bare, 3, bare.len - 3);
        if (method) { kind = Kind::Method; }
    } else if (str::starts_with(bare, "struct ") || str::starts_with(bare, "packed struct ")) {
        kind = Kind::Struct;
        rest = after(&after(&bare, "packed "), "struct ");
    } else if (str::starts_with(bare, "enum ")) {
        kind = Kind::Enum;
        rest = str::substr(bare, 5, bare.len - 5);
    } else if (str::starts_with(bare, "failure ")) {
        kind = Kind::Failure;
        rest = str::substr(bare, 8, bare.len - 8);
    } else if (str::starts_with(bare, "interface ")) {
        kind = Kind::Interface;
        rest = str::substr(bare, 10, bare.len - 10);
    } else if (str::starts_with(bare, "let ")) {
        kind = Kind::Constant;
        rest = str::substr(bare, 4, bare.len - 4);
    } else if (str::starts_with(bare, "var ")) {
        kind = Kind::Variable;
        rest = str::substr(bare, 4, bare.len - 4);
    } else if (str::starts_with(bare, "type ")) {
        kind = Kind::Type;
        rest = str::substr(bare, 5, bare.len - 5);
    } else if (exported && str::ends_with(bare, ";")) {
        kind = Kind::Reexport;
        rest = bare;
    } else {
        return;
    }
    let name: string = name_at(&rest);

    if (name.len == 0) {
        return;
    }
    // (struct or enum signature: up to its body)
    var detail: string = decl0;

    if (kind == Kind::Struct || kind == Kind::Enum || kind == Kind::Failure) {
        if (let b = str::find(decl0, " {")) { detail = str::substr(decl0, 0, b); }
    }
    var own: string = "";

    if (method) { own = *owner; }
    x.decls.push(Decl {
        name: name, kind: kind, exported: exported, detail: detail, owner: own, file: file,
        line: no, doc: doc
    });
    // struct fields, enum variants
    if (kind == Kind::Struct || kind == Kind::Failure) {
        for (let f: string in parts(&body(&d), ';')) {
            let fe: bool = str::starts_with(f, "export ");
            let ft: string = after(&f, "export ");
            let fname: string = name_at(&ft);

            if (fname.len == 0) { continue; }
            x.decls.push(Decl {
                name: fname, kind: Kind::Field, exported: fe, detail: ft, owner: name, file: file,
                line: no
            });
        }
    }
    if (kind == Kind::Enum) {
        for (let v: string in parts(&body(&d), ',')) {
            let vname: string = name_at(&v);

            if (vname.len == 0) { continue; }
            x.decls.push(Decl {
                name: vname, kind: Kind::Variant, exported: exported, detail: "\(name)::\(v)",
                owner: name, file: file, line: no
            });
        }
    }
}

impl Index {
    /// the file that file's import of target (as written) resolves to ("": not outlined)
    export fn resolve(self: &Index, file: string, target: string) -> string {
        var want: string = target;

        if (!str::ends_with(want, ".ae")) { want = "\(want).ae"; }
        if (!str::starts_with(want, "std/") && !path::is_absolute(want)) {
            let p: string = path::clean(path::join(path::dir(file), want));

            for (let f: string in &self.files) {
                if (str::eq(f, p)) {
                    return f;
                }
            }
            return "";
        }
        if (path::is_absolute(want)) {
            return path::clean(want);
        }

        for (let f: string in &self.files) {
            if (str::ends_with(f, "/\(want)")) {
                return f;
            }
        }
        return "";
    }

    /// the file that file imports as alias ("": none)
    export fn module_of(self: &Index, file: string, alias: string) -> string {
        for (let im: &self::&Import in &self.imports) {
            if (str::eq(im.file, file) && str::eq(im.alias, alias)) {
                return self.resolve(file, im.target);
            }
        }
        return "";
    }

    /// the declaration (index; -1: none) that name, a re-export or brace
    /// import in file, stands for
    export fn origin(self: &Index, file: string, name: string, depth: i64) -> i64 {
        if (depth > 6) {
            return -1;
        }

        for (let k: i64, let d: &self::&Decl in &self.decls) {
            if (str::eq(d.file, file) && str::eq(d.name, name) && d.kind != Kind::Reexport &&
                d.kind != Kind::Field && d.kind != Kind::Variant && d.kind != Kind::Method) {
                return k;
            }
        }

        for (let im: &self::&Import in &self.imports) {
            if (!str::eq(im.file, file)) { continue; }

            for (let n: string in &im.names) {
                if (str::eq(n, name)) {
                    let f: string = self.resolve(file, im.target);

                    if (f.len > 0) {
                        return self.origin(f, name, depth + 1);
                    }
                }
            }
        }
        return -1;
    }
}

/// the comment above line no (1-based) of lines, comment marks stripped
/// (empty: none)
export fn doc_above(lines: &string[], no: i64) -> string[] {
    var out: string[] = [];
    var k: i64 = no - 2;

    while (k >= 0 && k < lines.len) {
        let t: string = str::trim(lines[k]);

        if (str::starts_with(t, "#")) {
            k -= 1;
            continue;
        }
        if (!str::starts_with(t, "//")) { break; }
        var c: string = str::substr(t, 2, t.len - 2);

        if (str::starts_with(c, "/") || str::starts_with(c, "!")) {
            c = str::substr(c, 1, c.len - 1);
        }
        if (str::starts_with(c, " ")) { c = str::substr(c, 1, c.len - 1); }
        out.push(c);
        k -= 1;
    }
    // (read upward: reverse into order)
    var ordered: string[] = [];

    while (out.len > 0) { ordered.push(out.pop()); }
    return ordered;
}

#test fn reads_an_outline() -> i32 {
    let text: string = """== /p/shop.ae (40 lines)
     imports: std/string (str), tui/text.ae { Span, span }
    3 export struct Item { export name: string; qty: i64; }   // an item
    9 enum Size { Small, Large(n: i64) }
   12 impl Item
   14   export fn total(self: &Item) -> i64   // how many
   20 export let MAX: i64
   22 export Span;
== /h/std/string.ae (900 lines)
   10 export fn trim(s: string) -> string   // s without spaces
== /p/tui/text.ae (50 lines)
    4 export struct Span { export text: string; }   // some text
""";
    let x: Index = parse(&str::split(text, "\n"), "/p");
    var names: string[] = [];

    for (let d: &x::&Decl in &x.decls) { names.push("\(d.name):\(d.kind as i64):\(d.owner)"); }
    let got: string = str::join(&names, " ");
    let want: string = "Item:4: name:3:Item qty:3:Item Size:5: Small:6:Size Large:6:Size total:2:Item MAX:8: Span:14: trim:1: Span:4: text:3:Span";

    if (!str::eq(got, want)) {
        println(got);
        return 1;
    }
    if (!str::eq(x.module_of("/p/shop.ae", "str"), "/h/std/string.ae")) {
        return 2;
    }
    let o: i64 = x.origin("/p/shop.ae", "Span", 0);

    if (o < 0 || !str::eq(x.decls[o].file, "/p/tui/text.ae")) {
        return 3;
    }
    if (!x.decls[0].exported || !str::eq(x.decls[0].doc, "an item") ||
        !str::eq(x.decls[0].detail, "export struct Item")) {
        return 4;
    }
    let src: string[] = [
        "// not this", "", "/// the first", "/// and second", "#inline", "fn f() {}"
    ];
    let doc: string[] = doc_above(&src, 6);

    if (doc.len != 2 || !str::eq(doc[1], "and second")) {
        return 5;
    }
    return 0;
}
