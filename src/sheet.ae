//! zap's spreadsheet: a CSV (or TSV) buffer shown and edited as a grid, like
//! sc. The buffer holds the file's text; the sheet is reparsed whenever it
//! changes (Buf.gen), and a cell edit edits its record's lines, so undo, :w
//! and the swap file work on the text.
//!
//! A cell starting with = is a formula: numbers, "text", cells (B3, $B$3),
//! + - * / ^ & (joins text), = <> < > <= >= (1 or 0), ( ), and functions
//! (SUM AVERAGE AVG MIN MAX COUNT COUNTA ABS ROUND INT SQRT MOD POW IF AND
//! OR NOT LEN UPPER LOWER CONCAT), which take ranges (A1:B9). sc's
//! @sum(...) is SUM(...). Rows count from 1 as shown; a header row is row 1.
//! Errors show as #REF! #DIV/0! #VALUE! #NAME? #CYCLE! or #ERR!.

import str from "std/string";
import math from "std/math";
import tui from "std/tui";
import { MemLine } from "memline.ae";
import ml from "memline.ae";

/// a cell's value
export struct Val {
    export kind: i64;               // 0 empty, 1 number, 2 text, 3 error (text: which)
    export num: f64 = 0.0;
    export text: string = "";
}

fn empty() -> Val { return Val { kind: 0 }; }

fn number(x: f64) -> Val { return Val { kind: 1, num: x }; }

fn text_val(s: string) -> Val { return Val { kind: 2, text: s }; }

fn error(e: string) -> Val { return Val { kind: 3, text: e }; }

/// a cell as the grid shows it
export struct VisCell {
    export text: string;
    export x: i64;                  // pane column, and width
    export w: i64;
    export right: bool = false;     // right-aligned (a number)
    export kind: i64 = 0;           // 0 text, 1 number, 2 error
    export cur: bool;               // under the cursor
    export sel: bool;               // selected
}

/// a row as the grid shows it
export struct VisRow {
    export no: string;              // row number
    export header: bool;
    export current: bool;           // the cursor's row
    export sel: bool;               // wholly selected (a row selection)
    export cells: VisCell[] = [];
}

/// what the pane shows: the formula bar, the columns' letters, the rows
export struct SheetVis {
    export bar: string = "";        // the cursor cell's name and text
    export gutter: i64 = 0;         // row number width
    export heads: VisCell[] = [];   // column letters (cur: the cursor's column)
    export rows: VisRow[] = [];
}

/// a sheet: the records of a CSV, and the grid's state
export struct Sheet {
    export rows: string[][] = [];   // each record's fields, as written (formulas too)
    export starts: i64[] = [];      // each record's first line, then the line after the last
    export ncols: i64 = 0;
    export sep: u8 = 0;             // , ; or tab
    export gen: i64 = -1;           // buffer gen it was read at
    export widths: i64[] = [];      // column widths in cells (including the gap after)
    export r: i64 = 0;              // cursor cell
    export c: i64 = 0;
    export top: i64 = 0;            // first row and column shown (below a header row)
    export left: i64 = 0;
    export header: bool = false;    // row 1 is a header: bold, pinned at the top
    export sel: i64 = 0;            // selection from (ar, ac) to the cursor: 0 none,
    export ar: i64 = 0;             // 1 cells, 2 whole rows, 3 whole columns
    export ac: i64 = 0;
    export sized: bool = false;     // widths already fit to the contents
    vals: Val[] = [];               // computed values (index r * ncols + c)
    st: i64[] = [];                 // 0 not yet, 1 computing, 2 done
}

/// max auto-fit column width, and a new column's width
export let MAX_AUTO: i64 = 40;
export let DEFAULT_WIDTH: i64 = 10;

/// minimum grid shown: columns A to Z, rows 1 to 256
export let MIN_COLS: i64 = 26;
export let MIN_ROWS: i64 = 256;

// ---- CSV ----------------------------------------------------------------------------

/// a CSV's separator, from its first line: whichever of , ; and tab is most
/// common outside quotes (, if none)
export fn guess_sep(line: &string) -> u8 {
    var commas: i64 = 0;
    var semis: i64 = 0;
    var tabs: i64 = 0;
    var quoted: bool = false;

    for (let i: i64 in 0..line.len) {
        let ch: u8 = line[i];

        if (ch == '"') { quoted = !quoted; }
        if (quoted) { continue; }
        if (ch == ',') { commas += 1; }
        if (ch == ';') { semis += 1; }
        if (ch == '\t') { tabs += 1; }
    }
    if (tabs > commas && tabs >= semis) {
        return '\t';
    }
    if (semis > commas) {
        return ';';
    }
    return ',';
}

// does record text leave a quote open (the record continues on the next line)?
fn quote_open(text: &string, sep: u8) -> bool {
    var quoted: bool = false;
    var start: bool = true;         // at a field's start (where a quote opens it)
    let n: i64 = text.len;
    var i: i64 = 0;

    while (i < n) {
        let ch: u8 = text[i];

        if (quoted) {
            if (ch == '"') {
                if (i + 1 < n && text[i + 1] == '"') { i += 1; } else { quoted = false; }
            }
        } else if (ch == '"' && start) {
            quoted = true;
        }
        start = !quoted && ch == sep;
        i += 1;
    }
    return quoted;
}

/// a record's fields (split on sep; a field starting with " is quoted up to
/// its closing ", with "" for a quote; a quote elsewhere is literal)
export fn fields_of(text: &string, sep: u8) -> string[] {
    var out: string[] = [];
    var b: str::Builder;
    var quoted: bool = false;
    var start: bool = true;
    var i: i64 = 0;
    let n: i64 = text.len;

    while (i < n) {
        let ch: u8 = text[i];

        if (quoted) {
            if (ch == '"') {
                if (i + 1 < n && text[i + 1] == '"') {
                    b.add_byte('"');
                    i += 2;
                    continue;
                }
                quoted = false;
            } else {
                b.add_byte(ch);
            }
            start = false;
        } else if (ch == '"' && start) {
            quoted = true;
            start = false;
        } else if (ch == sep) {
            out.push(b.to_string());
            b.clear();
            start = true;
        } else {
            if (ch != '\r') { b.add_byte(ch); }
            start = false;
        }
        i += 1;
    }
    out.push(b.to_string());
    return out;
}

/// a field as written in a record: quoted if it has the separator, a quote,
/// a line break, or a leading or trailing space
export fn field(s: &string, sep: u8) -> string {
    let n: i64 = s.len;
    var quote: bool = n > 0 && (s[0] == ' ' || s[n - 1] == ' ');

    for (let i: i64 in 0..n) {
        let ch: u8 = s[i];

        if (ch == sep || ch == '"' || ch == '\n' || ch == '\r') { quote = true; }
    }
    if (!quote) {
        return *s;
    }
    return "\"\(str::replace(*s, "\"", "\"\""))\"";
}

/// a record's text from its fields
export fn record(cells: &string[], sep: u8) -> string {
    var b: str::Builder;

    for (let k: i64, let s: string in cells) {
        if (k > 0) { b.add_byte(sep); }
        b.add(field(&s, sep));
    }
    return b.to_string();
}

/// a column's name: A..Z, AA..
export fn col_name(c: i64) -> string {
    var n: i64 = c + 1;
    var out: string = "";

    while (n > 0) {
        let d: i64 = (n - 1) % 26;

        out = "\(str::from_char((('A' as i64) + d) as char))\(out)";
        n = (n - 1) / 26;
    }
    return out;
}

/// a cell's name: B3 (rows from 1)
export fn cell_name(r: i64, c: i64) -> string { return "\(col_name(c))\(r + 1)"; }

impl Sheet {
    /// rereads the buffer's text if it changed (per gen), with separator sep
    /// (0: guess from the first line)
    export fn sync(mut self: &Sheet, mut text: &MemLine, gen: i64, sep: u8) -> void {
        if (gen == self.gen) {
            return;
        }
        self.gen = gen;
        let count: i64 = text.count;

        if (sep != 0) {
            self.sep = sep;
        } else if (self.sep == 0) {
            var first: string = "";

            if (count > 0) { first = text.get(0); }
            self.sep = guess_sep(&first);
        }
        var rows: string[][] = [];
        var starts: i64[] = [];
        var i: i64 = 0;
        var most: i64 = 1;

        while (i < count) {
            starts.push(i);
            var rec: string = text.get(i);

            i += 1;

            while (quote_open(&rec, self.sep) && i < count) {
                rec = "\(rec)\n\(text.get(i))";
                i += 1;
            }
            let f: string[] = fields_of(&rec, self.sep);

            if (f.len > most) { most = f.len; }
            rows.push(f);
        }
        if (rows.len == 0) {
            rows.push([""]);
            starts.push(0);
        }
        starts.push(i);
        self.rows = rows;
        self.starts = starts;
        self.ncols = most;

        while (self.widths.len < self.grid_cols()) { self.widths.push(DEFAULT_WIDTH); }
        self.forget();
        if (!self.sized) {
            self.sized = true;
            self.fit_all();
            self.header = self.looks_like_header();
        }
        self.clamp();
    }

    // drops computed values (the cells changed; rebuilt on the next formula)
    fn forget(mut self: &Sheet) -> void {
        self.vals = [];
        self.st = [];
    }

    // is the first row a header (2+ rows, and no cell in it a number)?
    fn looks_like_header(mut self: &Sheet) -> bool {
        if (self.rows.len < 2) {
            return false;
        }
        var words: i64 = 0;

        for (let s: string in &self.rows[0]) {
            let t: string = str::trim(s);

            if (t.len == 0) { continue; }
            if (is_number(&t) || t[0] == '=') {
                return false;
            }
            words += 1;
        }
        return words > 0;
    }

    /// fits each column to its widest cell (in the first 1000 rows), from 3
    /// to MAX_AUTO
    export fn fit_all(mut self: &Sheet) -> void {
        for (let c: i64 in 0..self.ncols) { self.fit(c); }
    }

    /// fits column c to its widest cell
    export fn fit(mut self: &Sheet, c: i64) -> void {
        var w: i64 = 3;
        var k: i64 = 0;

        while (k < self.rows.len && k < 1000) {
            if (c < self.rows[k].len) {
                var t: string = self.rows[k][c];

                if (t.len > 0 && t[0] == '=') { t = self.shown(k, c); }
                let tw: i64 = tui::width(t);

                if (tw > w) { w = tw; }
            }
            k += 1;
        }
        if (w > MAX_AUTO) { w = MAX_AUTO; }
        self.widths[c] = w + 1;
    }
