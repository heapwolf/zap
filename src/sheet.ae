//! zap's spreadsheet: a CSV (or TSV) buffer shown and edited as a grid, like
//! sc. The buffer holds the file's text; the sheet is reparsed whenever it
//! changes (Buf.gen), and a cell edit edits its record's lines, so undo, :w
//! and the swap file work on the text.
//!
//! A cell starting with = is a formula: numbers, "text", cells (B3, $B$3),
//! + - * / ^ & (joins text), = <> < > <= >= (1 or 0), ( ), and functions
//! (SUM AVERAGE AVG MIN MAX COUNT COUNTA ABS ROUND INT SQRT MOD POW IF AND
//! OR NOT LEN UPPER LOWER CONCAT), which take ranges (A1:B9). sc's
//! @sum(...) is SUM(...). Rows count from 1 as shown; a header row is row 1.
//! Errors show as #REF! #DIV/0! #VALUE! #NAME? #CYCLE! or #ERR!.

import str from "std/string";
import math from "std/math";
import tui from "std/tui";
import { MemLine } from "memline.ae";
import ml from "memline.ae";

/// a cell's value
export struct Val {
    export kind: i64;               // 0 empty, 1 number, 2 text, 3 error (text: which)
    export num: f64 = 0.0;
    export text: string = "";
}

fn empty() -> Val { return Val { kind: 0 }; }

fn number(x: f64) -> Val { return Val { kind: 1, num: x }; }

fn text_val(s: string) -> Val { return Val { kind: 2, text: s }; }

fn error(e: string) -> Val { return Val { kind: 3, text: e }; }

/// a cell as the grid shows it
export struct VisCell {
    export text: string;
    export x: i64;                  // pane column, and width
    export w: i64;
    export right: bool = false;     // right-aligned (a number)
    export kind: i64 = 0;           // 0 text, 1 number, 2 error
    export cur: bool;               // under the cursor
    export sel: bool;               // selected
}

/// a row as the grid shows it
export struct VisRow {
    export no: string;              // row number
    export header: bool;
    export current: bool;           // the cursor's row
    export sel: bool;               // wholly selected (a row selection)
    export cells: VisCell[] = [];
}

/// what the pane shows: the formula bar, the columns' letters, the rows
export struct SheetVis {
    export bar: string = "";        // the cursor cell's name and text
    export gutter: i64 = 0;         // row number width
    export heads: VisCell[] = [];   // column letters (cur: the cursor's column)
    export rows: VisRow[] = [];
}

/// a sheet: the records of a CSV, and the grid's state
export struct Sheet {
    export rows: string[][] = [];   // each record's fields, as written (formulas too)
    export starts: i64[] = [];      // each record's first line, then the line after the last
    export ncols: i64 = 0;
    export sep: u8 = 0;             // , ; or tab
    export gen: i64 = -1;           // buffer gen it was read at
    export widths: i64[] = [];      // column widths in cells (including the gap after)
    export r: i64 = 0;              // cursor cell
    export c: i64 = 0;
    export top: i64 = 0;            // first row and column shown (below a header row)
    export left: i64 = 0;
    export header: bool = false;    // row 1 is a header: bold, pinned at the top
    export sel: i64 = 0;            // selection from (ar, ac) to the cursor: 0 none,
    export ar: i64 = 0;             // 1 cells, 2 whole rows, 3 whole columns
    export ac: i64 = 0;
    export sized: bool = false;     // widths already fit to the contents
    vals: Val[] = [];               // computed values (index r * ncols + c)
    st: i64[] = [];                 // 0 not yet, 1 computing, 2 done
}

/// max auto-fit column width, and a new column's width
export let MAX_AUTO: i64 = 40;
export let DEFAULT_WIDTH: i64 = 10;

/// minimum grid shown: columns A to Z, rows 1 to 256
export let MIN_COLS: i64 = 26;
export let MIN_ROWS: i64 = 256;

// ---- CSV ----------------------------------------------------------------------------

/// a CSV's separator, from its first line: whichever of , ; and tab is most
/// common outside quotes (, if none)
export fn guess_sep(line: &string) -> u8 {
    var commas: i64 = 0;
    var semis: i64 = 0;
    var tabs: i64 = 0;
    var quoted: bool = false;

    for (let i: i64 in 0..line.len) {
        let ch: u8 = line[i];

        if (ch == '"') { quoted = !quoted; }
        if (quoted) { continue; }
        if (ch == ',') { commas += 1; }
        if (ch == ';') { semis += 1; }
        if (ch == '\t') { tabs += 1; }
    }
    if (tabs > commas && tabs >= semis) {
        return '\t';
    }
    if (semis > commas) {
        return ';';
    }
    return ',';
}

// does record text leave a quote open (the record continues on the next line)?
fn quote_open(text: &string, sep: u8) -> bool {
    var quoted: bool = false;
    var start: bool = true;         // at a field's start (where a quote opens it)
    let n: i64 = text.len;
    var i: i64 = 0;

    while (i < n) {
        let ch: u8 = text[i];

        if (quoted) {
            if (ch == '"') {
                if (i + 1 < n && text[i + 1] == '"') { i += 1; } else { quoted = false; }
            }
        } else if (ch == '"' && start) {
            quoted = true;
        }
        start = !quoted && ch == sep;
        i += 1;
    }
    return quoted;
}

/// a record's fields (split on sep; a field starting with " is quoted up to
/// its closing ", with "" for a quote; a quote elsewhere is literal)
export fn fields_of(text: &string, sep: u8) -> string[] {
    var out: string[] = [];
    var b: str::Builder;
    var quoted: bool = false;
    var start: bool = true;
    var i: i64 = 0;
    let n: i64 = text.len;

    while (i < n) {
        let ch: u8 = text[i];

        if (quoted) {
            if (ch == '"') {
                if (i + 1 < n && text[i + 1] == '"') {
                    b.add_byte('"');
                    i += 2;
                    continue;
                }
                quoted = false;
            } else {
                b.add_byte(ch);
            }
            start = false;
        } else if (ch == '"' && start) {
            quoted = true;
            start = false;
        } else if (ch == sep) {
            out.push(b.to_string());
            b.clear();
            start = true;
        } else {
            if (ch != '\r') { b.add_byte(ch); }
            start = false;
        }
        i += 1;
    }
    out.push(b.to_string());
    return out;
}

/// a field as written in a record: quoted if it has the separator, a quote,
/// a line break, or a leading or trailing space
export fn field(s: &string, sep: u8) -> string {
    let n: i64 = s.len;
    var quote: bool = n > 0 && (s[0] == ' ' || s[n - 1] == ' ');

    for (let i: i64 in 0..n) {
        let ch: u8 = s[i];

        if (ch == sep || ch == '"' || ch == '\n' || ch == '\r') { quote = true; }
    }
    if (!quote) {
        return *s;
    }
    return "\"\(str::replace(*s, "\"", "\"\""))\"";
}

/// a record's text from its fields
export fn record(cells: &string[], sep: u8) -> string {
    var b: str::Builder;

    for (let k: i64, let s: string in cells) {
        if (k > 0) { b.add_byte(sep); }
        b.add(field(&s, sep));
    }
    return b.to_string();
}

/// a column's name: A..Z, AA..
export fn col_name(c: i64) -> string {
    var n: i64 = c + 1;
    var out: string = "";

    while (n > 0) {
        let d: i64 = (n - 1) % 26;

        out = "\(str::from_char((('A' as i64) + d) as char))\(out)";
        n = (n - 1) / 26;
    }
    return out;
}

/// a cell's name: B3 (rows from 1)
export fn cell_name(r: i64, c: i64) -> string { return "\(col_name(c))\(r + 1)"; }

impl Sheet {
    /// rereads the buffer's text if it changed (per gen), with separator sep
    /// (0: guess from the first line)
    export fn sync(mut self: &Sheet, mut text: &MemLine, gen: i64, sep: u8) -> void {
        if (gen == self.gen) {
            return;
        }
        self.gen = gen;
        let count: i64 = text.count;

        if (sep != 0) {
            self.sep = sep;
        } else if (self.sep == 0) {
            var first: string = "";

            if (count > 0) { first = text.get(0); }
            self.sep = guess_sep(&first);
        }
        var rows: string[][] = [];
        var starts: i64[] = [];
        var i: i64 = 0;
        var most: i64 = 1;

        while (i < count) {
            starts.push(i);
            var rec: string = text.get(i);

            i += 1;

            while (quote_open(&rec, self.sep) && i < count) {
                rec = "\(rec)\n\(text.get(i))";
                i += 1;
            }
            let f: string[] = fields_of(&rec, self.sep);

            if (f.len > most) { most = f.len; }
            rows.push(f);
        }
        if (rows.len == 0) {
            rows.push([""]);
            starts.push(0);
        }
        starts.push(i);
        self.rows = rows;
        self.starts = starts;
        self.ncols = most;

        while (self.widths.len < self.grid_cols()) { self.widths.push(DEFAULT_WIDTH); }
        self.forget();
        if (!self.sized) {
            self.sized = true;
            self.fit_all();
            self.header = self.looks_like_header();
        }
        self.clamp();
    }

    // drops computed values (the cells changed; rebuilt on the next formula)
    fn forget(mut self: &Sheet) -> void {
        self.vals = [];
        self.st = [];
    }

    // is the first row a header (2+ rows, and no cell in it a number)?
    fn looks_like_header(mut self: &Sheet) -> bool {
        if (self.rows.len < 2) {
            return false;
        }
        var words: i64 = 0;

        for (let s: string in &self.rows[0]) {
            let t: string = str::trim(s);

            if (t.len == 0) { continue; }
            if (is_number(&t) || t[0] == '=') {
                return false;
            }
            words += 1;
        }
        return words > 0;
    }

    /// fits each column to its widest cell (in the first 1000 rows), from 3
    /// to MAX_AUTO
    export fn fit_all(mut self: &Sheet) -> void {
        for (let c: i64 in 0..self.ncols) { self.fit(c); }
    }

    /// fits column c to its widest cell
    export fn fit(mut self: &Sheet, c: i64) -> void {
        var w: i64 = 3;
        var k: i64 = 0;

        while (k < self.rows.len && k < 1000) {
            if (c < self.rows[k].len) {
                var t: string = self.rows[k][c];

                if (t.len > 0 && t[0] == '=') { t = self.shown(k, c); }
                let tw: i64 = tui::width(t);

                if (tw > w) { w = tw; }
            }
            k += 1;
        }
        if (w > MAX_AUTO) { w = MAX_AUTO; }
        self.widths[c] = w + 1;
    }

    /// keeps the cursor on a cell (or the empty row and column past the
    /// last, for typing a new one)
    export fn clamp(mut self: &Sheet) -> void {
        if (self.r >= self.grid_rows()) { self.r = self.grid_rows() - 1; }
        if (self.r < 0) { self.r = 0; }
        if (self.c >= self.grid_cols()) { self.c = self.grid_cols() - 1; }
        if (self.c < 0) { self.c = 0; }

        while (self.widths.len < self.grid_cols()) { self.widths.push(DEFAULT_WIDTH); }
    }

    /// the grid's rows and columns: the sheet's plus one empty past each, at
    /// least MIN_ROWS by MIN_COLS
    export fn grid_rows(self: &Sheet) -> i64 {
        if (self.rows.len + 1 < MIN_ROWS) {
            return MIN_ROWS;
        }
        return self.rows.len + 1;
    }

    export fn grid_cols(self: &Sheet) -> i64 {
        if (self.ncols + 1 < MIN_COLS) {
            return MIN_COLS;
        }
        return self.ncols + 1;
    }

    /// the selection's corners (r1, c1, r2, c2), r1 <= r2, c1 <= c2 (the
    /// cursor cell if none)
    export fn sel_range(self: &Sheet) -> (i64, i64, i64, i64) {
        var r1: i64 = self.r;
        var r2: i64 = self.r;
        var c1: i64 = self.c;
        var c2: i64 = self.c;

        if (self.sel == 0) {
            return (r1, c1, r2, c2);
        }
        if (self.ar < r1) { r1 = self.ar; } else { r2 = self.ar; }
        if (self.ac < c1) { c1 = self.ac; } else { c2 = self.ac; }
        if (self.sel == 2) {
            c1 = 0;
            c2 = self.grid_cols() - 1;
        }
        if (self.sel == 3) {
            r1 = 0;
            r2 = self.grid_rows() - 1;
        }
        return (r1, c1, r2, c2);
    }

    /// starts a selection of kind k (1 cells, 2 rows, 3 columns) at the cursor
    export fn select(mut self: &Sheet, k: i64) -> void {
        self.sel = k;
        self.ar = self.r;
        self.ac = self.c;
    }

    // sum, average and count of the selection's numbers
    fn sel_stats(mut self: &Sheet) -> string {
        let (r1, c1, r2, c2) = self.sel_range();
        var rb: i64 = r2;

        if (rb >= self.rows.len) { rb = self.rows.len - 1; }
        var cb: i64 = c2;

        if (cb >= self.ncols) { cb = self.ncols - 1; }
        var total: f64 = 0.0;
        var n: i64 = 0;

        for (let r: i64 in r1..(rb + 1)) {
            for (let c: i64 in c1..(cb + 1)) {
                let v: Val = self.value(r, c);

                if (v.kind == 1) {
                    total += v.num;
                    n += 1;
                }
            }
        }
        if (n == 0) {
            return "";
        }
        return "sum \(num_text(total))  avg \(num_text(total / (n as f64)))  count \(n)";
    }

    /// cell (r, c)'s text as written ("" past its record's end)
    export fn raw(self: &Sheet, r: i64, c: i64) -> string {
        if (r < 0 || r >= self.rows.len || c < 0 || c >= self.rows[r].len) {
            return "";
        }
        return self.rows[r][c];
    }

    /// cell (r, c)'s value (formulas computed, with the cells they need)
    export fn value(mut self: &Sheet, r: i64, c: i64) -> Val {
        if (r < 0 || c < 0) {
            return error("#REF!");
        }
        if (r >= self.rows.len || c >= self.ncols) {
            return empty();
        }
        let t: string = self.raw(r, c);

        // (only formulas are cached: the rest is read from the text)
        if (t.len == 0 || t[0] != '=') {
            return plain(&t);
        }
        if (self.st.len == 0) {
            let n: i64 = self.rows.len * self.ncols;

            for (let k: i64 in 0..n) {
                self.vals.push(empty());
                self.st.push(0);
            }
        }
        let k: i64 = r * self.ncols + c;

        if (self.st[k] == 2) {
            return std::copy(self.vals[k]);
        }
        if (self.st[k] == 1) {
            return error("#CYCLE!");
        }
        self.st[k] = 1;
        var p: Parser = Parser { s: str::substr(t, 1, t.len - 1) };
        var v: Val = self.expr(mut &p);

        p.space();
        if (v.kind != 3 && p.i < p.s.len) { v = error("#ERR!"); }
        // (a cell in a cycle keeps the cycle's error, not the value set meanwhile)
        if (self.st[k] == 1) {
            self.vals[k] = std::copy(v);
            self.st[k] = 2;
        }
        return v;
    }

    /// cell (r, c) as the grid shows it
    export fn shown(mut self: &Sheet, r: i64, c: i64) -> string {
        let t: string = self.raw(r, c);

        if (t.len == 0 || t[0] != '=') {
            return t;
        }
        return val_text(&self.value(r, c));
    }

    // ---- the grid ---------------------------------------------------------------------

    // data rows in a pane h lines tall (minus the bar, the letters, a header row)
    fn data_rows(self: &Sheet, h: i64) -> i64 {
        var n: i64 = h - 2;

        if (self.header) { n -= 1; }
        if (n < 1) { n = 1; }
        return n;
    }

    // the first data row (not a header row)
    fn first_data(self: &Sheet) -> i64 {
        if (self.header) {
            return 1;
        }
        return 0;
    }

    /// row number width
    export fn gutter(self: &Sheet) -> i64 {
        var d: i64 = ("\(self.grid_rows())").len;

        if (d < 3) { d = 3; }
        return d + 1;
    }

    /// scrolls to keep the cursor in a pane w by h
    export fn show(mut self: &Sheet, w: i64, h: i64) -> void {
        let n: i64 = self.data_rows(h);
        let first: i64 = self.first_data();

        if (self.top < first) { self.top = first; }
        if (self.r >= first) {
            if (self.r < self.top) { self.top = self.r; }
            if (self.r >= self.top + n) { self.top = self.r - n + 1; }
        }
        if (self.c < self.left) { self.left = self.c; }
        // advance left until the columns up to the cursor's fit
        let room: i64 = w - self.gutter();

        while (self.left < self.c) {
            var used: i64 = 0;

            for (let k: i64 in self.left..(self.c + 1)) { used += self.widths[k]; }
            if (used <= room) { break; }
            self.left += 1;
        }
    }

    /// what a pane w by h shows
    export fn layout(mut self: &Sheet, w: i64, h: i64) -> SheetVis {
        self.show(w, h);
        let g: i64 = self.gutter();
        var vis: SheetVis = SheetVis { gutter: g };
        let raw: string = self.raw(self.r, self.c);

        vis.bar = "\(cell_name(self.r, self.c))  \(raw)";
        if (raw.len > 0 && raw[0] == '=') {
            vis.bar = "\(vis.bar)  → \(val_text(&self.value(self.r, self.c)))";
        }
        if (self.sel != 0) {
            let (r1, c1, r2, c2) = self.sel_range();
            var name: string = "\(cell_name(r1, c1)):\(cell_name(r2, c2))";

            if (self.sel == 2) { name = "\(r1 + 1):\(r2 + 1)"; }
            if (self.sel == 3) { name = "\(col_name(c1)):\(col_name(c2))"; }
            vis.bar = "\(name)  \(self.sel_stats())";
        }
        let (s1, d1, s2, d2) = self.sel_range();
        // the columns that fit (the last one clipped)
        var cols: i64[] = [];
        var xs: i64[] = [];
        var ws: i64[] = [];
        var x: i64 = g;
        var c: i64 = self.left;

        while (c < self.grid_cols() && x < w) {
            var cw: i64 = self.widths[c];

            if (x + cw > w) { cw = w - x; }
            cols.push(c);
            xs.push(x);
            ws.push(cw);
            vis.heads.push(VisCell {
                text: col_name(c), x: x, w: cw, cur: c == self.c,
                sel: self.sel == 3 && c >= d1 && c <= d2
            });
            x += self.widths[c];
            c += 1;
        }
        var order: i64[] = [];

        if (self.header) { order.push(0); }
        let n: i64 = self.data_rows(h);

        for (let k: i64 in 0..n) {
            let r: i64 = self.top + k;

            if (r >= self.grid_rows()) { break; }
            order.push(r);
        }

        for (let r: i64 in &order) {
            var row: VisRow = VisRow {
                no: "\(r + 1)", header: self.header && r == 0, current: r == self.r,
                sel: self.sel == 2 && r >= s1 && r <= s2
            };

            for (let j: i64, let cc: i64 in &cols) {
                let t: string = self.raw(r, cc);
                var kind: i64 = 0;
                var shown: string = t;
                var right: bool = false;

                if (t.len > 0 && t[0] == '=') {
                    let v: Val = self.value(r, cc);

                    shown = val_text(&v);
                    if (v.kind == 1) { kind = 1; }
                    if (v.kind == 3) { kind = 2; }
                } else if (is_number(&str::trim(t))) {
                    kind = 1;
                }
                right = kind == 1;
                // (a number too wide for its column shows as #s, like sc)
                if (kind == 1 && tui::width(shown) > ws[j] - 1) {
                    shown = str::repeat("#", ws[j] - 1);
                }
                row.cells.push(VisCell {
                    text: shown, x: xs[j], w: ws[j], right: right, kind: kind,
                    cur: r == self.r && cc == self.c,
                    sel: self.sel != 0 && r >= s1 && r <= s2 && cc >= d1 && cc <= d2
                });
            }
            vis.rows.push(row);
        }
        return vis;
    }

    /// the cell at (x, y) in a pane w by h (y: 0 the bar, 1 the letters) ->
    /// (r, c), (-1, -1) if none
    export fn cell_at(self: &Sheet, x: i64, y: i64, w: i64, h: i64) -> (i64, i64) {
        let c: i64 = self.col_at(x, w);

        if (c < 0 || y < 2) {
            return (-1, -1);
        }
        var k: i64 = y - 2;

        if (self.header) {
            if (k == 0) {
                return (0, c);
            }
            k -= 1;
        }
        let r: i64 = self.top + k;

        if (r >= self.grid_rows()) {
            return (-1, -1);
        }
        return (r, c);
    }

    /// the row at pane row y of a pane h tall (-1: none, or the bar or letters)
    export fn row_at(self: &Sheet, y: i64, h: i64) -> i64 {
        if (y < 2) {
            return -1;
        }
        var k: i64 = y - 2;

        if (self.header) {
            if (k == 0) {
                return 0;
            }
            k -= 1;
        }
        let r: i64 = self.top + k;

        if (r >= self.grid_rows()) {
            return -1;
        }
        return r;
    }

    /// the column at pane column x (-1: none)
    export fn col_at(self: &Sheet, x: i64, w: i64) -> i64 {
        var at: i64 = self.gutter();

        if (x < at) {
            return -1;
        }
        var c: i64 = self.left;

        while (c < self.grid_cols() && at < w) {
            if (x < at + self.widths[c]) {
                return c;
            }
            at += self.widths[c];
            c += 1;
        }
        return -1;
    }

    /// the column whose right edge is at pane column x (or one left of it):
    /// the one a drag on the letters' row resizes (-1: none)
    export fn edge_at(self: &Sheet, x: i64, w: i64) -> i64 {
        var at: i64 = self.gutter();
        var c: i64 = self.left;

        while (c < self.grid_cols() && at < w) {
            at += self.widths[c];
            if (x == at - 1 || x == at) {
                return c;
            }
            c += 1;
        }
        return -1;
    }

    /// column c's left edge on the pane
    export fn col_x(self: &Sheet, c: i64) -> i64 {
        var at: i64 = self.gutter();

        for (let k: i64 in self.left..c) { at += self.widths[k]; }
        return at;
    }

    /// sets column c's width to w (2 to 200; 2 is one cell plus its gap)
    export fn set_width(mut self: &Sheet, c: i64, w: i64) -> void {
        if (c < 0 || c >= self.widths.len) {
            return;
        }
        var ww: i64 = w;

        if (ww < 2) { ww = 2; }
        if (ww > 200) { ww = 200; }
        self.widths[c] = ww;
    }

    /// row r's fields with cell c set to t (padded with empty cells up to c)
    export fn with_cell(self: &Sheet, r: i64, c: i64, t: string) -> string[] {
        var cells: string[] = [];

        if (r < self.rows.len) { cells = std::copy(self.rows[r]); }

        while (cells.len <= c) { cells.push(""); }
        cells[c] = t;
        return cells;
    }
}

// ---- values -------------------------------------------------------------------------

/// is t a number (digits, a sign, a point, an exponent)?
export fn is_number(t: &string) -> bool {
    if (t.len == 0) {
        return false;
    }
    let ch: u8 = t[0];

    if (!(ch >= '0' && ch <= '9') && ch != '-' && ch != '+' && ch != '.') {
        return false;
    }
    match (str::parse_float(*t)) {
        v => { return true; },
        e: str::BadFloat => { return false; }
    }
    return false;
}

// a cell's value from its text (not a formula)
fn plain(t: &string) -> Val {
    let s: string = str::trim(*t);

    if (s.len == 0) {
        return empty();
    }
    if (is_number(&s)) {
        match (str::parse_float(s)) {
            v => { return number(v); },
            e: str::BadFloat => {}
        }
    }
    return text_val(*t);
}

/// a number as a cell shows it: integers without a point, else at most nine
/// decimal places
export fn num_text(x: f64) -> string {
    if (x != x) {
        return "#NUM!";
    }
    let a: f64 = math::abs_f64(x);

    if (a < 1.0e15 && math::floor(x) == x) {
        return "\(x as i64)";
    }
    if (a >= 1.0e15 || a < 1.0e-9) {
        return "\(x)";
    }
    let r: f64 = math::round(x * 1.0e9) / 1.0e9;

    if (math::floor(r) == r) {
        return "\(r as i64)";
    }
    return "\(r)";
}

/// a value as a cell shows it
export fn val_text(v: &Val) -> string {
    if (v.kind == 1) {
        return num_text(v.num);
    }
    if (v.kind == 0) {
        return "";
    }
    return v.text;
}

// v as a number (empty: 0; numeric text: its number) -> (it, an error if not a number)
fn num_of(v: &Val) -> (f64, Val) {
    if (v.kind == 1) {
        return (v.num, empty());
    }
    if (v.kind == 0) {
        return (0.0, empty());
    }
    if (v.kind == 3) {
        return (0.0, std::copy(*v));
    }
    let t: string = str::trim(v.text);

    if (is_number(&t)) {
        match (str::parse_float(t)) {
            x => { return (x, empty()); },
            e: str::BadFloat => {}
        }
    }
    return (0.0, error("#VALUE!"));
}

fn truthy(v: &Val) -> bool {
    if (v.kind == 1) {
        return v.num != 0.0;
    }
    if (v.kind == 2) {
        return v.text.len > 0 && !str::eq(str::to_upper(v.text), "FALSE");
    }
    return false;
}

// ---- formulas -----------------------------------------------------------------------

// a formula parser: the text and the position in it
struct Parser {
    s: string;
    i: i64 = 0;
}

impl Parser {
    fn space(mut self: &Parser) -> void {
        while (self.i < self.s.len && (self.s[self.i] == ' ' || self.s[self.i] == '\t')) {
            self.i += 1;
        }
    }

    // the next character after spaces (0 at the end)
    fn peek(mut self: &Parser) -> u8 {
        self.space();
        if (self.i >= self.s.len) {
            return 0;
        }
        return self.s[self.i];
    }

    // is t at i? (if so, skips it)
    fn eat(mut self: &Parser, t: string) -> bool {
        self.space();
        if (self.i + t.len <= self.s.len && str::eq(str::substr(self.s, self.i, t.len), t)) {
            self.i += t.len;
            return true;
        }
        return false;
    }

    // a cell name at i, ($)letters($)digits -> (r, c), skipping it; (-1, -1) if none
    fn cell(mut self: &Parser) -> (i64, i64) {
        self.space();
        var j: i64 = self.i;
        let n: i64 = self.s.len;

        if (j < n && self.s[j] == '$') { j += 1; }
        var c: i64 = 0;
        var letters: i64 = 0;

        while (j < n && letters < 4) {
            var ch: u8 = self.s[j];

            if (ch >= 'a' && ch <= 'z') { ch = ch - 32; }
            if (ch < 'A' || ch > 'Z') { break; }
            c = c * 26 + ((ch - 'A') as i64) + 1;
            letters += 1;
            j += 1;
        }
        if (letters == 0) {
            return (-1, -1);
        }
        if (j < n && self.s[j] == '$') { j += 1; }
        var r: i64 = 0;
        var digits: i64 = 0;

        while (j < n && self.s[j] >= '0' && self.s[j] <= '9' && digits < 9) {
            r = r * 10 + ((self.s[j] - '0') as i64);
            digits += 1;
            j += 1;
        }
        if (digits == 0 || r == 0) {
            return (-1, -1);
        }
        // (not a function's name: SUM2( is not a cell)
        if (j < n && (self.s[j] == '(' || (self.s[j] >= 'a' && self.s[j] <= 'z') ||
            (self.s[j] >= 'A' && self.s[j] <= 'Z') || self.s[j] == '_')) {
            return (-1, -1);
        }
        self.i = j;
        return (r - 1, c - 1);
    }
}

impl Sheet {
    // comparisons (lowest precedence)
    fn expr(mut self: &Sheet, mut p: &Parser) -> Val {
        var a: Val = self.join(p);

        while (true) {
            var op: string = "";

            if (p.eat("<>")) { op = "<>"; }
            else if (p.eat("<=")) { op = "<="; }
            else if (p.eat(">=")) { op = ">="; }
            else if (p.eat("=")) { op = "="; }
            else if (p.eat("<")) { op = "<"; }
            else if (p.eat(">")) { op = ">"; }
            if (op.len == 0) {
                return a;
            }
            let b: Val = self.join(p);

            if (a.kind == 3) { continue; }
            if (b.kind == 3) {
                a = b;
                continue;
            }
            var cmp: i64 = 0;

            if ((a.kind == 2 || b.kind == 2) && !(a.kind == 1 && b.kind == 0) &&
                !(a.kind == 0 && b.kind == 1)) {
                cmp = str::cmp(str::to_lower(val_text(&a)), str::to_lower(val_text(&b)));
            } else {
                let (x, ea) = num_of(&a);
                let (y, eb) = num_of(&b);

                if (x < y) { cmp = -1; }
                if (x > y) { cmp = 1; }
            }
            var yes: bool = false;

            if (str::eq(op, "=")) { yes = cmp == 0; }
            if (str::eq(op, "<>")) { yes = cmp != 0; }
            if (str::eq(op, "<")) { yes = cmp < 0; }
            if (str::eq(op, ">")) { yes = cmp > 0; }
            if (str::eq(op, "<=")) { yes = cmp <= 0; }
            if (str::eq(op, ">=")) { yes = cmp >= 0; }
            if (yes) { a = number(1.0); } else { a = number(0.0); }
        }
        return a;
    }
