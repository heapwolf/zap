//! zap driven without a terminal: keys in, frames out (std/tui's headless
//! UI). `aec test ui_test.ae`; ZAP_SHOW=1 prints the frames.

import tui from "std/tui";
import term from "std/term";
import str from "std/string";
import fs from "std/fs";
import { Config, parse_keys, DEFAULTS } from "config.ae";
import editor from "editor.ae";
import { App, Mode } from "editor.ae";
import view from "view.ae";
import { Kind } from "symbols.ae";
import { Group } from "syntax.ae";
import sheetm from "sheet.ae";
import process from "std/process";
import state from "state.ae";

// the key a token names
fn key_of(t: string) -> tui::Key {
    if (t.len > 2 && t[0] == '<' && t[t.len - 1] == '>') {
        var inner: string = str::substr(t, 1, t.len - 2);
        var spec: string = "";

        while (inner.len > 2 && inner[1] == '-') {
            let m: string = str::substr(inner, 0, 1);

            if (str::eq(m, "C")) { spec = "\(spec)ctrl+"; }
            if (str::eq(m, "M")) { spec = "\(spec)alt+"; }
            if (str::eq(m, "S")) { spec = "\(spec)shift+"; }
            inner = str::substr(inner, 2, inner.len - 2);
        }
        match (inner) {
            "CR" => { inner = "enter"; },
            "BS" => { inner = "backspace"; },
            "Del" => { inner = "delete"; },
            "lt" => { inner = "<"; },
            _ => {}
        }
        return tui::key("\(spec)\(inner)");
    }
    return tui::key(t);
}

// type keys written as in a spec ("ihello<Esc>")
fn type_keys(mut ui: &tui::Ui(App), mut a: &App, spec: string) -> void {
    for (let t: string in parse_keys(spec, "<Space>")) {
        a.prepare();
        tui::frame(ui, a);
        if (a.picking.len > 0) {
            tui::handle(ui, a, &tui::Event::Key { key: key_of(t) });
        } else {
            a.key(&key_of(t));
        }
    }
}

fn shot(mut ui: &tui::Ui(App), mut a: &App) -> string {
    a.prepare();
    tui::frame(ui, a);
    let t: string = ui.text();

    if (process::env("ZAP_SHOW").len > 0) { print("\(t)----\n"); }
    return t;
}

fn row(t: &string, y: i64) -> string {
    let lines: string[] = str::split(*t, "\n");

    if (y < lines.len) {
        return lines[y];
    }
    return "";
}

fn setup(name: string) -> App {
    let dir: string = fs::temp_dir();
    let base: string = "\(dir)/zap-ui-\(name)";

    state::ensure_dir("\(base)/notes");
    fs::write_file(
        "\(base)/notes/HOSTED.md",
        "# Hosted Aela\n\nToday an Aela program owns its process.\nThis note is the design.\n\n## The rules\n\n1. **The host owns the loop.** see [FFI.md](../docs/FFI.md)\n"
    );
    fs::write_file("\(base)/README.md", "readme\n");
    fs::write_file("\(base)/main.ae", "fn main() -> i32 {\n    return 0;\n}\n");
    var c: Config = Config {};

    c.read(DEFAULTS, "<defaults>");
    c.read_builtin_themes();
    var a: App = editor::app(c, base);

    a.cols = 70;
    a.rows = 12;
    return a;
}

#test fn opens_and_paints() -> i32 {
    var a: App = setup("paint");
    var ui = tui::headless(70, 12, view::view);

    a.edit("notes/HOSTED.md");
    let t: string = shot(mut &ui, mut &a);

    // the tree's root and the editor's first line
    if (!str::contains(row(&t, 0), "zap-ui-paint")) {
        return 1;
    }
    if (!str::contains(row(&t, 0), "1 # Hosted Aela")) {
        return 2;
    }
    // the status line is the last row: a message briefly replaces the file
    // name (nothing moves), then the name returns
    if (!str::contains(row(&t, 11), "NORMAL")) {
        return 3;
    }
    if (!str::contains(row(&t, 11), "\"notes/HOSTED.md\"")) {
        return 4;
    }
    a.msg_until = 1;
    let after: string = shot(mut &ui, mut &a);

    if (a.msg.len > 0 || !str::contains(row(&after, 11), " HOSTED.md")) {
        return 5;
    }
    if (!str::contains(row(&after, 11), "NORMAL")) {
        return 6;
    }
    // an error too; Esc dismisses it
    a.fail_msg("E999: something went wrong");
    let err: string = shot(mut &ui, mut &a);

    if (!str::contains(row(&err, 11), "E999") || str::contains(row(&err, 11), "HOSTED.md")) {
        return 7;
    }
    type_keys(mut &ui, mut &a, "<Esc>");
    if (a.msg.len > 0) {
        return 8;
    }
    return 0;
}

#test fn edits_and_saves() -> i32 {
    var a: App = setup("edit");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    type_keys(mut &ui, mut &a, "jA // done<Esc>");
    if (!str::eq(a.b.text.get(1), "    return 0; // done")) {
        return 1;
    }
    type_keys(mut &ui, mut &a, "ggdd");
    if (!str::eq(a.b.text.get(0), "    return 0; // done") || a.b.text.count != 2) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "u");
    if (a.b.text.count != 3) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "yyjp");
    if (a.b.text.count != 4 || !str::eq(a.b.text.get(2), "fn main() -> i32 {")) {
        return 4;
    }
    type_keys(mut &ui, mut &a, "u:w<CR>");
    if (a.b.modified) {
        return 5;
    }
    let saved: string = fs::read_file("\(a.cwd)/main.ae") ?? "";

    if (!str::eq(saved, "fn main() -> i32 {\n    return 0; // done\n}\n")) {
        return 6;
    }
    type_keys(mut &ui, mut &a, "ggwcwfun<Esc>");
    if (!str::eq(a.b.text.get(0), "fn fun() -> i32 {")) {
        return 7;
    }
    type_keys(mut &ui, mut &a, "0d$");
    if (a.b.text.get(0).len != 0) {
        return 8;
    }
    return 0;
}

#test fn searches_twice() -> i32 {
    var a: App = setup("search");
    var ui = tui::headless(70, 12, view::view);

    a.edit("notes/HOSTED.md");
    type_keys(mut &ui, mut &a, "/the<CR>");
    if (a.b.cy != 3) {
        return 1;
    }
    // / then Enter: repeat the last search
    type_keys(mut &ui, mut &a, "/<CR>");
    if (a.b.cy != 5) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "n");
    if (a.b.cy != 7) {
        return 3;
    }
    let t: string = shot(mut &ui, mut &a);

    if (!a.hl) {
        return 4;
    }
    type_keys(mut &ui, mut &a, ":noh<CR>");
    if (a.hl) {
        return 5;
    }
    return 0;
}

#test fn toggles_numbers_and_tree() -> i32 {
    var a: App = setup("toggle");
    var ui = tui::headless(70, 12, view::view);

    a.edit("notes/HOSTED.md");
    type_keys(mut &ui, mut &a, ":set nonu<CR>");
    let t: string = shot(mut &ui, mut &a);

    if (a.cfg.number || str::contains(row(&t, 0), "1 #")) {
        return 1;
    }
    type_keys(mut &ui, mut &a, ":set nu!<CR>");
    if (!a.cfg.number) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "<C-t>");
    let t2: string = shot(mut &ui, mut &a);

    if (a.split.at != 0 || !str::starts_with(row(&t2, 0), "   1 # Hosted")) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "<C-t>");
    if (a.split.at == 0) {
        return 4;
    }
    return 0;
}

#test fn walks_the_tree() -> i32 {
    var a: App = setup("tree");
    var ui = tui::headless(70, 12, view::view);

    shot(mut &ui, mut &a);
    type_keys(mut &ui, mut &a, "<C-w>h");
    if (!a.focus_tree) {
        return 1;
    }
    // root, notes/, README.md, main.ae: notes is row 1
    type_keys(mut &ui, mut &a, "j<CR>");
    if (a.tree.rows.len != 5 || !a.tree.rows[1].open) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "j<CR>");
    if (!str::ends_with(a.b.path, "HOSTED.md") || a.focus_tree) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "<C-w>hkh");
    if (a.tree.rows[1].open) {
        return 4;
    }
    type_keys(mut &ui, mut &a, ":ls<CR>");
    if (a.panel.len != 1) {
        return 5;
    }
    return 0;
}

#test fn tab_focuses_and_ctrl_n_buffers() -> i32 {
    var a: App = setup("focus");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    a.edit("notes/HOSTED.md");
    shot(mut &ui, mut &a);
    // Tab: the tree, then the editor again; Shift+Tab the other way
    type_keys(mut &ui, mut &a, "<Tab>");
    if (!a.focus_tree) {
        return 1;
    }
    type_keys(mut &ui, mut &a, "<Tab>");
    if (a.focus_tree) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "<S-Tab>");
    if (!a.focus_tree) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "<S-Tab>");
    if (a.focus_tree) {
        return 4;
    }
    // a hidden tree: Tab shows it
    type_keys(mut &ui, mut &a, "<C-t>");
    if (a.split.at != 0) {
        return 5;
    }
    type_keys(mut &ui, mut &a, "<Tab>");
    if (!a.focus_tree || a.split.at == 0) {
        return 6;
    }
    type_keys(mut &ui, mut &a, "<Tab>");
    // Ctrl+n / Ctrl+p: the next buffer, the one before
    type_keys(mut &ui, mut &a, "<C-p>");
    if (!str::ends_with(a.b.path, "main.ae")) {
        return 7;
    }
    type_keys(mut &ui, mut &a, "<C-n>");
    if (!str::ends_with(a.b.path, "HOSTED.md")) {
        return 8;
    }
    return 0;
}

    // (the last tab's highlight keeps its trailing space)
    if (!str::contains(t, " Themes\u{a0}")) {
        return 10;
    }
    type_keys(mut &ui, mut &a, "HOS");
    if (a.shown.len != 1 || !str::contains(a.shown[0], "HOSTED.md")) {
        return 11;
    }
    type_keys(mut &ui, mut &a, "<CR>");
    if (a.picking.len > 0 || !str::ends_with(a.b.path, "notes/HOSTED.md")) {
        return 3;
    }
    // Grep: Tab to it; the search runs in the background as the query grows
    type_keys(mut &ui, mut &a, "<C-k><Tab>owns");
    if (a.cat != 1) {
        return 4;
    }

    while (a.has_work()) { a.background(); }
    if (a.pick_items.len != 2) {                 // HOSTED.md:3 and :8
        return 5;
    }
    type_keys(mut &ui, mut &a, "<Down><CR>");
    if (a.b.cy != 7) {
        return 6;
    }
    // reopens on the last category; Shift+Tab goes back, wrapping to
    // Themes; Enter applies one
    type_keys(mut &ui, mut &a, "<C-k><S-Tab><S-Tab>");
    if (a.cat != 5) {
        return 7;
    }
    type_keys(mut &ui, mut &a, "<BS><BS><BS><BS>ink<CR>");
    if (!str::eq(a.cfg.theme, "ink")) {
        return 8;
    }
    // Esc closes it
    type_keys(mut &ui, mut &a, "<C-k><Esc>");
    if (a.picking.len > 0) {
        return 9;
    }

    // reopened: files as listed, while being relisted
    while (a.has_work()) { a.background(); }
    type_keys(mut &ui, mut &a, "<C-k><Tab>");
    if (a.cat != 0 || a.pick_items.len != 3) {
        return 12;
    }
    // <leader>p opens it too
    type_keys(mut &ui, mut &a, "<Esc><Space>p");
    if (a.picking.len == 0) {
        return 13;
    }
    return 0;
}

#test fn splash_until_an_edit() -> i32 {
    var a: App = setup("splash");

    a.splash = true;
    var ui = tui::headless(90, 30, view::view);
    let t: string = shot(mut &ui, mut &a);

    if (!str::contains(t, "ZAP v\(editor::VERSION)") || !str::contains(t, ":help<Enter>")) {
        return 1;
    }
    if (!str::contains(t, "[No Name]")) {
        return 2;
    }
    // hidden once something is typed, back after undo
    type_keys(mut &ui, mut &a, "ihi<Esc>");
    if (str::contains(shot(mut &ui, mut &a), "ZAP v")) {
        return 3;
    }
    // opening a file hides it
    type_keys(mut &ui, mut &a, "u:e main.ae<CR>");
    if (str::contains(shot(mut &ui, mut &a), "ZAP v")) {
        return 4;
    }
    // too short for the logo: text only
    var small = tui::headless(90, 14, view::view);
    var b: App = setup("splash2");

    b.splash = true;
    b.rows = 14;
    b.cols = 90;
    let t2: string = shot(mut &small, mut &b);

    if (!str::contains(t2, "ZAP v") || str::contains(t2, "██")) {
        return 5;
    }
    return 0;
}

#test fn selects_and_operates() -> i32 {
    var a: App = setup("visual");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    // v: characters; y yanks them, also to the terminal clipboard
    type_keys(mut &ui, mut &a, "vel");
    let t: string = shot(mut &ui, mut &a);

    if (a.mode != Mode::Visual || !str::contains(t, " VISUAL ")) {
        return 1;
    }
    type_keys(mut &ui, mut &a, "y");
    if (!str::eq(a.reg, "fn ") || a.mode != Mode::Normal) {
        return 2;
    }
    if (a.clips.len != 1 || !str::eq(a.clips[0], "\x1b]52;c;Zm4g\x07")) {
        return 3;
    }
    // V: lines
    type_keys(mut &ui, mut &a, "Vjd");
    if (a.b.text.count != 1 || !str::eq(a.b.text.get(0), "}")) {
        return 4;
    }
    type_keys(mut &ui, mut &a, "u");
    if (a.b.text.count != 3) {
        return 5;
    }
    // Ctrl+v: a block, cut from two lines
    type_keys(mut &ui, mut &a, "gg<C-v>jlx");
    if (!str::eq(a.b.text.get(0), " main() -> i32 {") || !str::eq(a.b.text.get(1), "  return 0;")) {
        return 6;
    }
    type_keys(mut &ui, mut &a, "u");
    // I on a block: typed on each of its lines
    type_keys(mut &ui, mut &a, "gg<C-v>jI// <Esc>");
    if (!str::eq(a.b.text.get(0), "// fn main() -> i32 {") ||
        !str::eq(a.b.text.get(1), "//     return 0;")) {
        return 7;
    }
    // (one change, one undo)
    type_keys(mut &ui, mut &a, "u");
    if (!str::eq(a.b.text.get(1), "    return 0;")) {
        return 8;
    }
    // : on a selection: its lines become the range
    type_keys(mut &ui, mut &a, "ggVj:");
    if (!str::eq(a.cmd.text, "'<,'>")) {
        return 9;
    }
    type_keys(mut &ui, mut &a, "s/ /_/g<CR>");
    if (!str::eq(a.b.text.get(0), "fn_main()_->_i32_{") || !str::eq(a.b.text.get(2), "}")) {
        return 10;
    }
    // U, gv, ~
    type_keys(mut &ui, mut &a, "uggveU");
    if (!str::eq(a.b.text.get(0), "FN main() -> i32 {")) {
        return 11;
    }
    type_keys(mut &ui, mut &a, "gv~");
    if (!str::eq(a.b.text.get(0), "fn main() -> i32 {")) {
        return 12;
    }
    // p over a selection: replaces it with the register
    type_keys(mut &ui, mut &a, "yiwwviwp");
    if (!str::eq(a.b.text.get(0), "fn fn() -> i32 {") || !str::eq(a.reg, "main")) {
        return 13;
    }
    return 0;
}

#test fn mouse_selects() -> i32 {
    var a: App = setup("mouse");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    shot(mut &ui, mut &a);
    let g: i64 = a.gutter;

    // press on line 1, drag to line 2's fourth column
    if (!a.in_text(a.edit_x + g, 0) || a.in_text(a.edit_x - 2, 0)) {
        return 1;
    }
    a.mouse_press(g, 0, 1000);
    a.mouse_drag(g + 1, 0);
    if (a.mode != Mode::Visual) {
        return 2;
    }
    a.mouse_drag(g + 3, 1);
    a.mouse_release();
    let t: string = shot(mut &ui, mut &a);

    if (a.vis[0].sel_lo != 0 || a.vis[1].sel_hi != 4) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "y");
    if (!str::eq(a.reg, "fn main() -> i32 {\n    ")) {
        return 4;
    }
    // double click: a word; triple: the line
    a.mouse_press(g + 4, 0, 5000);
    a.mouse_press(g + 4, 0, 5100);
    a.mouse_release();
    if (a.mode != Mode::Visual || a.vkind != 1) {
        return 5;
    }
    type_keys(mut &ui, mut &a, "y");
    if (!str::eq(a.reg, "main")) {
        return 6;
    }
    a.mouse_press(g + 4, 1, 9000);
    a.mouse_press(g + 4, 1, 9100);
    a.mouse_press(g + 4, 1, 9200);
    if (a.mode != Mode::Visual || a.vkind != 2) {
        return 7;
    }
    type_keys(mut &ui, mut &a, "d");
    if (a.b.text.count != 2) {
        return 8;
    }
    // a press alone moves the cursor without selecting
    a.mouse_press(g + 1, 0, 20000);
    a.mouse_release();
    if (a.mode != Mode::Normal || a.b.cx != 1) {
        return 9;
    }
    return 0;
}

#test fn keeps_every_state() -> i32 {
    var a: App = setup("history");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    type_keys(mut &ui, mut &a, "GAone<Esc>otwo<Esc>uothree<Esc>");
    if (!str::eq(a.b.text.get(2), "}one") || !str::eq(a.b.text.get(3), "three")) {
        return 1;
    }
    // g-: back through every state, including the branch u left
    type_keys(mut &ui, mut &a, "g-");
    if (!str::eq(a.b.text.get(3), "two")) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "g-g-");
    if (!str::eq(a.b.text.get(2), "}") || a.b.modified) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "3g+");
    if (!str::eq(a.b.text.get(3), "three")) {
        return 4;
    }
    type_keys(mut &ui, mut &a, ":earlier 1h<CR>");
    if (a.b.hist.at != 0) {
        return 5;
    }
    type_keys(mut &ui, mut &a, ":later 1h<CR>");
    if (a.b.hist.at != 3) {
        return 6;
    }
    type_keys(mut &ui, mut &a, ":undolist<CR>");
    if (a.panel.len != 4) {
        return 7;
    }
    return 0;
}

#test fn ranges_and_careful_writes() -> i32 {
    var a: App = setup("ranges");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    type_keys(mut &ui, mut &a, ":2,$d<CR>");
    if (a.b.text.count != 1) {
        return 1;
    }
    type_keys(mut &ui, mut &a, "u:%s/i/I/g<CR>");
    if (!str::eq(a.b.text.get(0), "fn maIn() -> I32 {")) {
        return 2;
    }
    type_keys(mut &ui, mut &a, ":.+1y<CR>");
    if (!str::eq(a.reg, "    return 0;\n")) {
        return 3;
    }
    // the file changed under the buffer: not overwritten without !
    let p: string = a.b.path;

    fs::write_file(p, "changed elsewhere\n");
    type_keys(mut &ui, mut &a, ":w<CR>");
    if (!str::contains(a.msg, "E949") || !str::eq(fs::read_file(p) ?? "", "changed elsewhere\n")) {
        return 4;
    }
    type_keys(mut &ui, mut &a, ":w!<CR>");
    if (!str::starts_with(fs::read_file(p) ?? "", "fn maIn()") || a.b.modified) {
        return 5;
    }
    return 0;
}

#test fn tab_menu_cycles() -> i32 {
    var a: App = setup("wild");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    type_keys(mut &ui, mut &a, ":b<Tab>");
    // bdelete, bnext, bprevious, buffer, buffers, build: first one chosen, in a menu
    if (a.wild.len < 5 || !str::eq(a.cmd.text, "bdelete")) {
        return 1;
    }
    let t: string = shot(mut &ui, mut &a);

    if (!str::contains(row(&t, 5), "bdelete") || !str::contains(row(&t, 9), "buffers")) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "<Tab><Tab>");
    if (!str::eq(a.cmd.text, "bprevious")) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "<S-Tab>");
    if (!str::eq(a.cmd.text, "bnext")) {
        return 4;
    }
    // typing on closes the menu
    type_keys(mut &ui, mut &a, "<Space>");
    if (a.wild.len != 0 || !str::eq(a.cmd.text, "bnext ")) {
        return 5;
    }
    type_keys(mut &ui, mut &a, "<Esc>:theme <Tab>");
    if (a.wild.len != 49 || !str::eq(a.cmd.text, "theme amber")) {
        return 6;
    }
    return 0;
}

#test fn help_is_a_buffer() -> i32 {
    var a: App = setup("help");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    type_keys(mut &ui, mut &a, ":help undo<CR>");
    if (!a.b.readonly || !str::eq(a.b.ft.syntax, "markdown")) {
        return 1;
    }
    if (!str::eq(a.b.text.get(a.b.cy), "## Undo")) {
        return 2;
    }
    let n: i64 = a.b.text.count;

    type_keys(mut &ui, mut &a, "dd");
    if (a.b.text.count != n || !str::contains(a.msg, "E21")) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "ihello<Esc>");
    if (a.b.text.count != n || a.mode != Mode::Normal || a.b.modified) {
        return 5;
    }
    type_keys(mut &ui, mut &a, "q");
    if (!str::ends_with(a.b.path, "main.ae")) {
        return 4;
    }
    return 0;
}

#test fn completes_words() -> i32 {
    var a: App = setup("complete");
    var ui = tui::headless(70, 12, view::view);

    a.edit("main.ae");
    // two characters of a word in the buffer: a menu below, first item chosen
    type_keys(mut &ui, mut &a, "Goma");
    // (main from the buffer; match, a keyword)
    if (a.comp.len != 2 || !str::eq(a.comp[0].word, "main") || a.comp_at != 0) {
        return 1;
    }
    let t: string = shot(mut &ui, mut &a);

    if (!str::contains(row(&t, 4), "main")) {
        return 2;
    }
    // (its rest shown after the cursor, not yet in the text)
    if (!str::contains(row(&t, 3), "main") || !str::eq(a.b.text.get(3), "ma")) {
        return 3;
    }
    // Enter accepts it (no newline)
    type_keys(mut &ui, mut &a, "<CR>");
    if (!str::eq(a.b.text.get(3), "main") || a.comp.len != 0 || a.b.text.count != 4) {
        return 4;
    }
    // Ctrl+n from one character; keywords too; Ctrl+e closes it
    type_keys(mut &ui, mut &a, "<Space>r<C-n>");
    if (a.comp.len == 0 || !str::eq(a.comp[0].word, "return")) {
        return 5;
    }
    type_keys(mut &ui, mut &a, "<C-e>");
    if (!str::eq(a.b.text.get(3), "main r") || a.comp.len != 0) {
        return 6;
    }
    type_keys(mut &ui, mut &a, "<Esc>");
    if (a.mode != Mode::Normal || a.comp.len != 0) {
        return 7;
    }
    // no match: no menu; Tab indents (expandtab: spaces)
    type_keys(mut &ui, mut &a, "o<Tab>zq<Esc>");
    if (a.comp.len != 0 || !str::eq(a.b.text.get(4), "    zq")) {
        return 8;
    }
    return 0;
}

#test fn completes_declarations() -> i32 {
    var a: App = setup("decls");
    var ui = tui::headless(100, 20, view::view);

    a.cols = 100;
    a.rows = 20;
    a.edit("main.ae");
    a.index_stale = false;
    let p: string = a.b.path;
    let head: string = "== \(p) (3 lines)\n     imports: std/string (str), shop.ae { Item }\n";
    let tail: string = """    1 fn main() -> i32
== /h/std/string.ae (900 lines)
   10 export fn trim(s: string) -> string   // s without the spaces at its ends
   12 export fn to_upper(s: string) -> string
   14 fn hidden() -> i32
== shop.ae (20 lines)
    3 export struct Item { export name: string; qty: i64; }   // an item
    9 export enum Size { Small, Large }
   12 impl Item
   14   export fn total(self: &Item) -> i64   // how many
""";
    let outline: string = "\(head)\(tail)";

    a.take_symbols(&str::split(outline, "\n"));
    // str:: : the module's exports (not its private names)
    type_keys(mut &ui, mut &a, "Gostr::");
    if (a.comp.len != 2 || !str::eq(a.comp[0].word, "to_upper") ||
        !str::eq(a.comp[1].word, "trim")) {
        return 1;
    }
    type_keys(mut &ui, mut &a, "t");
    if (a.comp.len != 2 || a.comp[0].kind != Kind::Function) {
        return 2;
    }
    type_keys(mut &ui, mut &a, "r");
    let t: string = shot(mut &ui, mut &a);

    // the menu: icon, word, kind; beside it the signature and comment
    if (!str::contains(t, "trim") || !str::contains(t, "pub fn") ||
        !str::contains(t, "export fn trim(s: string) -> string") ||
        !str::contains(t, "s without the spaces at its ends") ||
            !str::contains(t, "std/string.ae:10")) {
        return 3;
    }
    type_keys(mut &ui, mut &a, "<CR><Esc>");
    if (!str::eq(a.b.text.get(3), "str::trim")) {
        return 4;
    }
    // an enum's variants; . : fields and methods; an imported name
    type_keys(mut &ui, mut &a, "oSize::");
    if (a.comp.len != 2 || a.comp[0].kind != Kind::Variant) {
        return 5;
    }
    type_keys(mut &ui, mut &a, "<C-e><Esc>ox.to");
    if (a.comp.len != 1 || !str::eq(a.comp[0].word, "total") || a.comp[0].kind != Kind::Method) {
        return 6;
    }
    type_keys(mut &ui, mut &a, "<C-e><Esc>oIt");
    if (a.comp.len != 1 || !str::eq(a.comp[0].word, "Item") || a.comp[0].kind != Kind::Struct) {
        return 7;
    }
    return 0;
}

#test fn edits_a_spreadsheet() -> i32 {
    var a: App = setup("sheet");
    let p: string = "\(a.cwd)/costs.csv";

    fs::write_file(p, "item,qty,price\npen,2,1.5\nink,3,2\n");
    var ui = tui::headless(70, 14, view::view);

    type_keys(mut &ui, mut &a, "<C-t>");
    a.edit("costs.csv");
    let t: string = shot(mut &ui, mut &a);

    if (!a.sheet_on() || !a.b.sheet[0].header) {
        return 1;
    }
    // the bar, column letters, header row, rows (numbers right-aligned)
    if (!str::contains(row(&t, 0), "A1  item") || !str::contains(row(&t, 1), "A")) {
        print(t);
        return 2;
    }
    if (!str::contains(row(&t, 2), "item") || !str::contains(row(&t, 3), "pen")) {
        return 3;
    }
    if (!str::contains(t, " A1 ")) {
        return 4;
    }
    // a formula in D4: evaluated, written to the file as text
    type_keys(mut &ui, mut &a, "Gllo=SUM(C2:C3)*2<CR>");
    if (a.b.sheet[0].r != 3 || a.b.sheet[0].c != 2) {
        return 5;
    }
    type_keys(mut &ui, mut &a, "l");
    type_keys(mut &ui, mut &a, "=B2*C2<CR>");
    let t2: string = shot(mut &ui, mut &a);
