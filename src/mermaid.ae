//! Mermaid diagrams drawn as text: box-drawing characters on a canvas the
//! viewer pans (editor.ae, view.ae's MermaidPane).
//!
//! * Flowcharts (`graph` / `flowchart`, TD TB BT LR RL): node shapes
//!   (`[ ]` `( )` `([ ])` `[[ ]]` `[( )]` `(( ))` `{ }` `{{ }}` `>]`
//!   `[/ /]`), links (`-->` `---` `-.->` `==>` `--x` `--o` `<-->` `~~~`,
//!   and longer forms) with labels (`-->|a|`, `-- a -->`), chains
//!   (`A --> B --> C`) and `&` (`A & B --> C`). Laid out in ranks: cycles
//!   broken, each node ranked by longest path, a long link given a point in
//!   each rank it crosses, rank order by neighbors' order (fewer
//!   crossings), then routed at right angles.
//! * State diagrams (`stateDiagram`, `stateDiagram-v2`): like flowcharts,
//!   with `[*]` as start and end.
//! * Sequence diagrams: participants and actors (`as`), messages (`->>`
//!   `-->>` `->` `-->` `-x` `--x` `-)` `--)`, self-messages too), notes (left
//!   of, right of, over), blocks (loop alt else opt par and critical break
//!   rect, through their end), autonumber.
//!
//! Zoom sets spacing: the room boxes and gaps get (ZOOM_MIN to ZOOM_MAX);
//! below 0, labels are also truncated (with an ellipsis), to 3 cells at
//! least, so a big diagram fits.

import str from "std/string";
import tui from "std/tui";
import process from "std/process";

/// canvas cell kinds (colors: view.ae)
export let K_BLANK: i64 = 0;
export let K_BOX: i64 = 1;          // node or participant border
export let K_TEXT: i64 = 2;         // node text
export let K_LINE: i64 = 3;         // link
export let K_HEAD: i64 = 4;         // link head
export let K_LABEL: i64 = 5;        // link or message text
export let K_FRAME: i64 = 6;        // block line and title, lifeline
export let K_NOTE: i64 = 7;         // note
export let K_ERROR: i64 = 8;        // what could not be drawn

/// a drawn diagram
export struct Canvas {
    export w: i64 = 0;
    export h: i64 = 0;
    export ch: i64[] = [];      // each cell's code point (0: none)
    export kind: i64[] = [];
    export title: string = "";  // what it is: "flowchart TD", "sequence"
    export error: string = "";  // why it was not drawn ("": it was)
    export ids: string[] = [];  // nodes drawn, and their middles (zoom keeps one in place)
    export mx: i64[] = [];
    export my: i64[] = [];
    bits: i64[] = [];           // lines through the cell: 1 up 2 down 4 left 8 right, 16 dotted, 32
                                //   thick
}

fn canvas(w: i64, h: i64) -> Canvas {
    var c: Canvas = Canvas { w: w, h: h };

    for (let k: i64 in 0..(w * h)) {
        c.ch.push(0);
        c.kind.push(0);
        c.bits.push(0);
    }
    return c;
}

impl Canvas {
    fn put(mut self: &Canvas, x: i64, y: i64, cp: i64, k: i64) -> void {
        if (x < 0 || y < 0 || x >= self.w || y >= self.h) {
            return;
        }
        self.ch[y * self.w + x] = cp;
        self.kind[y * self.w + x] = k;
    }

    fn text(mut self: &Canvas, x: i64, y: i64, s: string, k: i64) -> void {
        var at: i64 = x;

        for (let c: char in str::chars(s)) {
            self.put(at, y, c as i64, k);
            at += 1;
        }
    }

    // add line bits b at (x, y)
    fn bit(mut self: &Canvas, x: i64, y: i64, b: i64) -> void {
        if (x < 0 || y < 0 || x >= self.w || y >= self.h) {
            return;
        }
        self.bits[y * self.w + x] = self.bits[y * self.w + x] | b;
    }

    /// a horizontal or vertical line from (x1, y1) to (x2, y2); style 16 dotted, 32 thick
    fn line(mut self: &Canvas, x1: i64, y1: i64, x2: i64, y2: i64, style: i64) -> void {
        if (y1 == y2) {
            var a: i64 = x1;
            var b: i64 = x2;

            if (b < a) {
                a = x2;
                b = x1;
            }

            for (let x: i64 in a..(b + 1)) {
                var m: i64 = style;

                if (x > a) { m = m | 4; }
                if (x < b) { m = m | 8; }
                self.bit(x, y1, m);
            }
        } else {
            var a: i64 = y1;
            var b: i64 = y2;

            if (b < a) {
                a = y2;
                b = y1;
            }

            for (let y: i64 in a..(b + 1)) {
                var m: i64 = style;

                if (y > a) { m = m | 1; }
                if (y < b) { m = m | 2; }
                self.bit(x1, y, m);
            }
        }
    }

    // is the w by h block at (x, y) on the canvas and empty?
    fn clear(self: &Canvas, x: i64, y: i64, w: i64, h: i64) -> bool {
        if (x < 0 || y < 0 || x + w > self.w || y + h > self.h) {
            return false;
        }

        for (let j: i64 in y..(y + h)) {
            for (let i: i64 in x..(x + w)) {
                if (self.ch[j * self.w + i] != 0 && self.ch[j * self.w + i] != 32) {
                    return false;
                }
            }
        }
        return true;
    }

    // turn line cells into characters (where nothing else is drawn)
    fn finish(mut self: &Canvas) -> void {
        for (let k: i64 in 0..(self.w * self.h)) {
            let b: i64 = self.bits[k];

            if (b == 0 || self.ch[k] != 0) { continue; }
            self.ch[k] = glyph(b);
            if (self.kind[k] == K_BLANK) { self.kind[k] = K_LINE; }
        }
    }

    // a box at (x, y), w by h, corners and sides by shape: 0 square, 1 round,
    // 2 decision (round, ◇ top and bottom), 3 subroutine (double sides),
    // 4 circle (round, ● top and bottom), 5 hexagon (round, ⬡ top and bottom)
    fn boxed(mut self: &Canvas, x: i64, y: i64, w: i64, h: i64, shape: i64, k: i64) -> void {
        var tl: i64 = 0x250C;
        var tr: i64 = 0x2510;
        var bl: i64 = 0x2514;
        var br: i64 = 0x2518;
        var side: i64 = 0x2502;

        if (shape == 1 || shape == 2 || shape == 4 || shape == 5) {
            tl = 0x256D;
            tr = 0x256E;
            bl = 0x2570;
            br = 0x256F;
        }
        if (shape == 3) { side = 0x2551; }
        self.put(x, y, tl, k);
        self.put(x + w - 1, y, tr, k);
        self.put(x, y + h - 1, bl, k);
        self.put(x + w - 1, y + h - 1, br, k);

        for (let i: i64 in (x + 1)..(x + w - 1)) {
            self.put(i, y, 0x2500, k);
            self.put(i, y + h - 1, 0x2500, k);
        }

        for (let j: i64 in (y + 1)..(y + h - 1)) {
            self.put(x, j, side, k);
            self.put(x + w - 1, j, side, k);

            for (let i: i64 in (x + 1)..(x + w - 1)) { self.put(i, j, ' ' as i64, k); }
        }
        var mark: i64 = 0;

        if (shape == 2) { mark = 0x25C7; }
        if (shape == 4) { mark = 0x25CF; }
        if (shape == 5) { mark = 0x2B21; }
        if (mark != 0 && w >= 5) {
            self.put(x + w / 2, y, mark, k);
            self.put(x + w / 2, y + h - 1, mark, k);
        }
    }

    /// row y as same-kind runs: (text, kind) pairs, from column x0, w cells
    export fn runs(self: &Canvas, y: i64, x0: i64, w: i64) -> (string[], i64[]) {
        var texts: string[] = [];
        var kinds: i64[] = [];

        if (y < 0 || y >= self.h) {
            return (texts, kinds);
        }
        var b: str::Builder;
        var cur: i64 = -1;

        for (let x: i64 in x0..(x0 + w)) {
            var cp: i64 = ' ' as i64;
            var k: i64 = 0;

            if (x >= 0 && x < self.w) {
                let c: i64 = self.ch[y * self.w + x];

                if (c != 0) {
                    cp = c;
                    k = self.kind[y * self.w + x];
                }
            }
            if (k != cur && cur >= 0) {
                texts.push(b.to_string());
                kinds.push(cur);
                b.clear();
            }
            cur = k;
            b.add_char(cp as char);
        }
        if (cur >= 0) {
            texts.push(b.to_string());
            kinds.push(cur);
        }
        return (texts, kinds);
    }
}

// the box-drawing character for line bits b
fn glyph(b: i64) -> i64 {
    let d: i64 = b & 15;
    let thick: bool = (b & 32) != 0;
    let dotted: bool = (b & 16) != 0;

    if (d == 1 || d == 2 || d == 3) {
        if (thick) {
            return 0x2503;
        }
        if (dotted) {
            return 0x2506;
        }
        return 0x2502;
    }
    if (d == 4 || d == 8 || d == 12) {
        if (thick) {
            return 0x2501;
        }
        if (dotted) {
            return 0x2504;
        }
        return 0x2500;
    }
    var light: i64[] = [
        0x20, 0x2502, 0x2502, 0x2502, 0x2500, 0x2518, 0x2510, 0x2524, 0x2500, 0x2514, 0x250C,
        0x251C, 0x2500, 0x2534, 0x252C, 0x253C
    ];
    var heavy: i64[] = [
        0x20, 0x2503, 0x2503, 0x2503, 0x2501, 0x251B, 0x2513, 0x252B, 0x2501, 0x2517, 0x250F,
        0x2523, 0x2501, 0x253B, 0x2533, 0x254B
    ];

    if (thick) {
        return heavy[d];
    }
    return light[d];
}

// a canvas showing why nothing was drawn
fn failed(why: string, title: string) -> Canvas {
    var c: Canvas = canvas(tui::width(why) + 2, 1);

    c.text(1, 0, why, K_ERROR);
    c.error = why;
    c.title = title;
    return c;
}

/// draw source text at zoom z
export fn draw(src: string, z: i64) -> Canvas {
    let lines: string[] = statements(src);

    if (lines.len == 0) {
        return failed("an empty diagram", "mermaid");
    }
    let head: string[] = str::fields(lines[0]);
    let kind: string = head[0];

    if (str::eq(kind, "graph") || str::eq(kind, "flowchart")) {
        var dir: string = "TD";

        if (head.len > 1) { dir = str::to_upper(head[1]); }
        var g: Graph = Graph {};

        g.flow(&lines);
        return g.draw(dir, z, "flowchart \(dir)");
    }
    if (str::eq(kind, "stateDiagram") || str::eq(kind, "stateDiagram-v2")) {
        var g: Graph = Graph {};
        let dir: string = g.states(&lines);

        return g.draw(dir, z, "state diagram");
    }
    if (str::eq(kind, "sequenceDiagram")) {
        return sequence(&lines, z);
    }
    return failed("\(kind): not drawn yet (flowcharts, state and sequence diagrams are)", kind);
}

// the diagram's statements: its lines, also split at ;, minus %% comments,
// front matter and blank lines
fn statements(src: string) -> string[] {
    var out: string[] = [];
    var front: bool = false;
    var first: bool = true;

    for (let l0: string in str::split(src, "\n")) {
        let l: string = str::trim(str::replace(l0, "\r", ""));

        if (str::eq(l, "---")) {
            if (first || front) {
                front = !front;
                first = false;
                continue;
            }
        }
        if (front || l.len == 0 || str::starts_with(l, "%%")) { continue; }
        first = false;

        for (let part: string in split_semis(l)) {
            let t: string = str::trim(part);

            if (t.len > 0) { out.push(t); }
        }
    }
    return out;
}

// split a line at ; outside quotes and brackets
fn split_semis(l: string) -> string[] {
    var out: string[] = [];
    var depth: i64 = 0;
    var quoted: bool = false;
    var at: i64 = 0;

    for (let i: i64 in 0..l.len) {
        let c: u8 = l[i];

        if (c == '"') { quoted = !quoted; }
        if (quoted) { continue; }
        if (c == '[' || c == '(' || c == '{') { depth += 1; }
        if (c == ']' || c == ')' || c == '}') { depth -= 1; }
        if (c == ';' && depth <= 0) {
            out.push(str::substr(l, at, i - at));
            at = i + 1;
        }
    }
    out.push(str::substr(l, at, l.len - at));
    return out;
}

// a label as drawn: quotes removed, <br> a line break, entities decoded
fn clean(s: string) -> string {
    var t: string = str::trim(s);

    if (t.len >= 2 && t[0] == '"' && t[t.len - 1] == '"') { t = str::substr(t, 1, t.len - 2); }
    if (t.len >= 2 && t[0] == '`' && t[t.len - 1] == '`') { t = str::substr(t, 1, t.len - 2); }
    t = str::replace(t, "<br/>", "\n");
    t = str::replace(t, "<br />", "\n");
    t = str::replace(t, "<br>", "\n");
    t = str::replace(t, "\\n", "\n");
    t = str::replace(t, "&amp;", "&");
    t = str::replace(t, "&lt;", "<");
    t = str::replace(t, "&gt;", ">");
    t = str::replace(t, "&quot;", "\"");
    t = str::replace(t, "**", "");
    return t;
}

/// max width of a label's lines at zoom z (0: unlimited): zoomed out,
/// they are truncated with an ellipsis
export fn cap_of(z: i64) -> i64 {
    if (z >= 0) {
        return 0;
    }
    let caps: i64[] = [20, 14, 10, 6, 3];
    var k: i64 = -z - 1;

    if (k >= caps.len) { k = caps.len - 1; }
    return caps[k];
}

// truncate a label's lines to cap cells (0: no limit)
fn cut(s: &string, cap: i64) -> string {
    if (cap <= 0) {
        return *s;
    }
    var out: string[] = [];

    for (let l: string in str::split(*s, "\n")) {
        if (tui::width(l) <= cap) {
            out.push(l);
        } else {
            // (truncate adds the ellipsis)
            out.push(tui::truncate(l, cap));
        }
    }
    return str::join(&out, "\n");
}

/// zoom range: out until labels are 3 cells, in to roomy boxes
export let ZOOM_MIN: i64 = -5;
export let ZOOM_MAX: i64 = 4;

// width of a label's widest line
fn label_w(s: &string) -> i64 {
    var w: i64 = 0;

    for (let l: string in str::split(*s, "\n")) {
        let lw: i64 = tui::width(l);

        if (lw > w) { w = lw; }
    }
    return w;
}

// ---- graphs (flowcharts, state diagrams) ----------------------------------------------

struct Node {
    id: string;
    label: string = "";
    shape: i64;         // as Canvas.boxed's (-1: a point a long link passes through)
    rank: i64 = 0;
    order: f64 = 0.0;
    main: i64 = 0;      // position along the ranks, and across them
    cross: i64 = 0;
    msize: i64 = 0;
    csize: i64 = 0;
}

struct Edge {
    a: i64;
    b: i64;
    label: string;
    style: i64 = 0;      // 0, 16 dotted, 32 thick, -1 none (~~~)
    head: i64;           // head at b: 0 none, 1 arrow, 2 x, 3 o
    tail: i64 = 0;       // and at a (<-->)
    back: bool = false;  // laid out b to a (it closes a cycle)
    path: i64[] = [];    // nodes it passes through, from its laid-out start
}

struct Graph {
    nodes: Node[] = [];
    edges: Edge[] = [];
}

// a link as written: style, heads, label (if inside it), end
struct Link {
    ok: bool = false;
    style: i64 = 0;
    head: i64 = 0;
    tail: i64 = 0;
    label: string = "";
    stop: i64 = 0;
}

fn is_id(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
        c == '_' || c >= 128;
}

fn skip(s: &string, i: i64) -> i64 {
    var j: i64 = i;

    while (j < s.len && (s[j] == ' ' || s[j] == '\t')) { j += 1; }
    return j;
}

fn at_str(s: &string, i: i64, t: string) -> bool {
    return i + t.len <= s.len && str::eq(str::substr(*s, i, t.len), t);
}

// a link head at i (x o >) -> (kind, end; none: the same i)
fn head_of(s: &string, i: i64) -> (i64, i64) {
    if (i < s.len) {
        let c: u8 = s[i];

        if (c == '>') {
            return (1, i + 1);
        }
        // (x and o end a link only if no name follows: --x B, not --xyz)
        if ((c == 'x' || c == 'o') && (i + 1 >= s.len || !is_id(s[i + 1]))) {
            if (c == 'x') {
                return (2, i + 1);
            }
            return (3, i + 1);
        }
    }
    return (0, i);
}

// the link at i (if any)
fn link_at(s: &string, i0: i64) -> Link {
    var i: i64 = skip(s, i0);
    let n: i64 = s.len;
    var l: Link = Link {};
    var tail: i64 = 0;

    if (i < n && s[i] == '<') {
        tail = 1;
        i += 1;
    } else if (i + 1 < n && (s[i] == 'x' || s[i] == 'o') && (s[i + 1] == '-' || s[i + 1] == '=')) {
        if (s[i] == 'x') { tail = 2; } else { tail = 3; }
        i += 1;
    }
    let start: i64 = i;

    while (i < n && (s[i] == '-' || s[i] == '=' || s[i] == '.' || s[i] == '~')) { i += 1; }
    let run: string = str::substr(*s, start, i - start);

    if (run.len < 2 && !(run.len == 1 && i < n && s[i] == '>')) {
        return l;
    }
    if (run.len == 0) {
        return l;
    }
    var style: i64 = 0;

    if (str::contains(run, "=")) { style = 32; }
    if (str::contains(run, ".")) { style = 16; }
    if (str::contains(run, "~")) { style = -1; }
    let (h0, e0) = head_of(s, i);
    var head: i64 = h0;
    var e: i64 = e0;
    var label: string = "";

    // -- text -->, == text ==>, -. text .->: label inside the link
    if (head == 0 && (str::eq(run, "--") || str::eq(run, "==") || str::eq(run, "-.")) && e < n &&
        s[e] == ' ') {
        var closes: string[] = ["-->", "---", "--x", "--o"];

        if (str::eq(run, "==")) { closes = ["==>", "===", "==x", "==o"]; }
        if (str::eq(run, "-.")) { closes = [".->", ".-"]; }
        var best: i64 = -1;
        var blen: i64 = 0;

        for (let c: string in &closes) {
            if (let k = str::find_from(*s, c, e)) {
                if (best < 0 || k < best) {
                    best = k;
                    blen = c.len;
                }
            }
        }
        if (best < 0) {
            return l;
        }
        label = clean(str::substr(*s, e, best - e));
        var j: i64 = best;

        while (j < n && (s[j] == '-' || s[j] == '=' || s[j] == '.')) { j += 1; }
        let (h2, e2) = head_of(s, j);

        head = h2;
        e = e2;
    }
    // -->|text|
    var k: i64 = skip(s, e);

    if (k < n && s[k] == '|') {
        if (let close = str::find_from(*s, "|", k + 1)) {
            label = clean(str::substr(*s, k + 1, close - k - 1));
            e = close + 1;
        }
    }
    return Link { ok: true, style: style, head: head, tail: tail, label: label, stop: e };
}

impl Graph {
    // node id's index (created if new)
    fn node(mut self: &Graph, id: string) -> i64 {
        for (let k: i64, let n: &self::&Node in &self.nodes) {
            if (str::eq(n.id, id)) {
                return k;
            }
        }
        self.nodes.push(Node { id: id, label: id, shape: 0 });
        return self.nodes.len - 1;
    }

    // a node at i: name and shape with text -> (index, end; -1: none)
    fn node_at(mut self: &Graph, s: &string, i0: i64) -> (i64, i64) {
        let i: i64 = skip(s, i0);
        var j: i64 = i;

        while (j < s.len && is_id(s[j])) { j += 1; }

        // (a - inside a name: a-b, not a link)
        while (j + 1 < s.len && s[j] == '-' && is_id(s[j + 1]) && !at_str(s, j, "--")) {
            j += 1;

            while (j < s.len && is_id(s[j])) { j += 1; }
        }
        if (j == i) {
            return (-1, i0);
        }
        let id: string = str::substr(*s, i, j - i);
        let k: i64 = self.node(id);
        let opens: string[] = [
            "(((", "((", "([", "[[", "[(", "[/", "[\\", "{{", "[", "(", "{", ">"
        ];
        let closes: string[] = [
            ")))", "))", "])", "]]", ")]", "/]", "\\]", "}}", "]", ")", "}", "]"
        ];
        let shapes: i64[] = [4, 4, 1, 3, 1, 0, 0, 5, 0, 1, 2, 0];

        for (let o: i64, let op: string in &opens) {
            if (!at_str(s, j, op)) { continue; }
            let a: i64 = j + op.len;
            // [/a/] [\a\] [/a\] [\a/]: either slant closes
            let slant: bool = o == 5 || o == 6;
            var e: i64 = a;
            var quoted: bool = false;

            while (e < s.len) {
                if (s[e] == '"') { quoted = !quoted; }
                if (!quoted && at_str(s, e, closes[o])) { break; }
                if (!quoted && slant && (at_str(s, e, "/]") || at_str(s, e, "\\]"))) { break; }
                e += 1;
            }
            if (e >= s.len) { break; }
            self.nodes[k].label = clean(str::substr(*s, a, e - a));
            self.nodes[k].shape = shapes[o];
            j = e + closes[o].len;
            break;
        }
        // :::aClass
        if (at_str(s, j, ":::")) {
            j += 3;

            while (j < s.len && (is_id(s[j]) || s[j] == '-')) { j += 1; }
        }
        return (k, j);
    }

    // nodes joined by &: their indexes, and the end
    fn group_at(mut self: &Graph, s: &string, i0: i64) -> (i64[], i64) {
        var out: i64[] = [];
        var i: i64 = i0;

        while (true) {
            let (k, e) = self.node_at(s, i);

            if (k < 0) { break; }
            out.push(k);
            i = e;
            let j: i64 = skip(s, i);

            if (j < s.len && s[j] == '&') {
                i = j + 1;
                continue;
            }
            break;
        }
        return (out, i);
    }

    // a flowchart's statements (the first is graph TD)
    fn flow(mut self: &Graph, lines: &string[]) -> void {
        for (let k: i64 in 1..lines.len) {
            let l: string = lines[k];
            let w: string = str::fields(l)[0];

            if (str::eq(w, "subgraph") || str::eq(w, "end") || str::eq(w, "classDef") ||
                str::eq(w, "class") || str::eq(w, "style") || str::eq(w, "linkStyle") ||
                str::eq(w, "click") || str::eq(w, "direction")) {
                continue;
            }
            let (left, e) = self.group_at(&l, 0);

            if (left.len == 0) { continue; }
            var src: i64[] = left;
            var i: i64 = e;

            while (true) {
                let ln: Link = link_at(&l, i);

                if (!ln.ok) { break; }
                let (right, e2) = self.group_at(&l, ln.stop);

                if (right.len == 0) { break; }

                for (let a: i64 in &src) {
                    for (let b: i64 in &right) {
                        self.edges.push(Edge {
                            a: a, b: b, label: ln.label, style: ln.style, head: ln.head,
                            tail: ln.tail
                        });
                    }
                }
                src = right;
                i = e2;
            }
        }
    }

    // a state diagram's statements -> the direction
    fn states(mut self: &Graph, lines: &string[]) -> string {
        var dir: string = "TD";
        let start: i64 = self.node("[*]start");

        self.nodes[start].label = "●";
        self.nodes[start].shape = 4;
        var used_start: bool = false;
        var fin: i64 = -1;

        for (let k: i64 in 1..lines.len) {
            let l: string = lines[k];
            let f: string[] = str::fields(l);

            if (str::eq(f[0], "direction") && f.len > 1) {
                dir = str::to_upper(f[1]);
                continue;
            }
            if (str::eq(f[0], "}") || str::eq(f[0], "note") || str::eq(f[0], "classDef") ||
                str::eq(f[0], "class")) {
                continue;
            }
            // state "a long name" as s1
            if (str::eq(f[0], "state")) {
                if (let q = str::find(l, " as ")) {
                    let name: string = clean(str::substr(l, 6, q - 6));
                    let id: string = str::trim(str::substr(l, q + 4, l.len - q - 4));
                    let n: i64 = self.node(str::trim_suffix(id, " {"));

                    self.nodes[n].label = name;
                    self.nodes[n].shape = 1;
                }
                continue;
            }
            if (let arrow = str::find(l, "-->")) {
                var rest: string = str::substr(l, arrow + 3, l.len - arrow - 3);
                var label: string = "";

                if (let c = str::find(rest, ":")) {
                    label = clean(str::substr(rest, c + 1, rest.len - c - 1));
                    rest = str::substr(rest, 0, c);
                }
                let a_id: string = str::trim(str::substr(l, 0, arrow));
                let b_id: string = str::trim(rest);
                var a: i64 = 0;
                var b: i64 = 0;

                if (str::eq(a_id, "[*]")) {
                    a = start;
                    used_start = true;
                } else {
                    a = self.node(a_id);
                    self.nodes[a].shape = 1;
                }
                if (str::eq(b_id, "[*]")) {
                    if (fin < 0) {
                        fin = self.node("[*]end");
                        self.nodes[fin].label = "◉";
                        self.nodes[fin].shape = 4;
                    }
                    b = fin;
                } else {
                    b = self.node(b_id);
                    self.nodes[b].shape = 1;
                }
                self.edges.push(Edge { a: a, b: b, label: label, head: 1 });
                continue;
            }
            // s1 : a description
            if (let c = str::find(l, ":")) {
                let n: i64 = self.node(str::trim(str::substr(l, 0, c)));

                self.nodes[n].label = clean(str::substr(l, c + 1, l.len - c - 1));
                self.nodes[n].shape = 1;
            }
        }
        if (!used_start) { self.nodes[start].shape = -2; }
        return dir;
    }

    // ---- layout ----------------------------------------------------------------------

    fn draw(mut self: &Graph, dir: string, z: i64, title: string) -> Canvas {
        let cap: i64 = cap_of(z);

        for (let k: i64 in 0..self.nodes.len) {
            if (!str::starts_with(self.nodes[k].id, "[*]")) {
                self.nodes[k].label = cut(&self.nodes[k].label, cap);
            }
        }

        for (let k: i64 in 0..self.edges.len) {
            self.edges[k].label = cut(&self.edges[k].label, cap);
        }
        // (a state diagram start with no outgoing links: dropped)
        var real: i64 = 0;

        for (let n: &self::&Node in &self.nodes) {
            if (n.shape != -2) { real += 1; }
        }
        if (real == 0) {
            return failed("nothing to draw", title);
        }
        let across: bool = str::eq(dir, "LR") || str::eq(dir, "RL");
        let flip: bool = str::eq(dir, "BT") || str::eq(dir, "RL");
        let n0: i64 = self.nodes.len;

        // links that close a cycle: laid out reversed
        self.break_cycles();

        // ranks: longest path from a node with no incoming links
        for (let k: i64 in 0..n0) { self.nodes[k].rank = 0; }
        var changed: bool = true;
        var rounds: i64 = 0;

        while (changed && rounds < n0 + 1) {
            changed = false;
            rounds += 1;

            for (let e: &self::&Edge in &self.edges) {
                if (e.style == -1 && false) { continue; }
                var a: i64 = e.a;
                var b: i64 = e.b;

                if (e.back) {
                    a = e.b;
                    b = e.a;
                }
                if (a == b) { continue; }
                if (self.nodes[b].rank < self.nodes[a].rank + 1) {
                    self.nodes[b].rank = self.nodes[a].rank + 1;
                    changed = true;
                }
            }
        }

        // a long link: a point in each rank it crosses
        for (let k: i64 in 0..self.edges.len) {
            var a: i64 = self.edges[k].a;
            var b: i64 = self.edges[k].b;

            if (self.edges[k].back) {
                a = self.edges[k].b;
                b = self.edges[k].a;
            }
            var path: i64[] = [a];

            if (a != b) {
                var r: i64 = self.nodes[a].rank + 1;

                while (r < self.nodes[b].rank) {
                    self.nodes.push(Node { id: "", shape: -1, rank: r });
                    path.push(self.nodes.len - 1);
                    r += 1;
                }
            }
            path.push(b);
            self.edges[k].path = path;
        }
        // sizes: a node's text plus padding
        var pad: i64 = 1 + z;

        if (pad < 0) { pad = 0; }
        var vpad: i64 = 0;

        if (z >= 2) { vpad = 1; }

        for (let k: i64 in 0..self.nodes.len) {
            var w: i64 = 1;
            var h: i64 = 1;

            if (self.nodes[k].shape >= 0) {
                let lw: i64 = label_w(&self.nodes[k].label);
                let lines: i64 = str::split(self.nodes[k].label, "\n").len;

                w = lw + 2 + 2 * pad;
                h = lines + 2 + 2 * vpad;
            } else if (self.nodes[k].shape == -2) {
                w = 0;
                h = 0;
            }
            if (across) {
                self.nodes[k].msize = w;
                self.nodes[k].csize = h;
            } else {
                self.nodes[k].msize = h;
                self.nodes[k].csize = w;
            }
        }
        // the ranks, in order
        var top: i64 = 0;

        for (let n: &self::&Node in &self.nodes) {
            if (n.rank > top) { top = n.rank; }
        }
        var ranks: i64[][] = [];

        for (let r: i64 in 0..(top + 1)) { ranks.push([]); }

        for (let k: i64 in 0..self.nodes.len) {
            if (self.nodes[k].shape == -2) { continue; }
            ranks[self.nodes[k].rank].push(k);
        }

        for (let r: i64 in 0..ranks.len) {
            for (let j: i64, let k: i64 in &ranks[r]) { self.nodes[k].order = j as f64; }
        }

        // order within a rank: by neighbors' order in adjacent ranks
        for (let pass: i64 in 0..6) {
            let down: bool = pass % 2 == 0;
            var r: i64 = 1;

            if (!down) { r = top - 1; }

            while (r >= 0 && r <= top) {
                if (down) {
                    self.sort_rank(mut &ranks[r], r - 1);
                } else {
                    self.sort_rank(mut &ranks[r], r + 1);
                }
                if (down) { r += 1; } else { r -= 1; }
            }
        }
        // hops: each link's steps from one rank to the next (via its nodes and points)
        var hop_e: i64[] = [];
        var hop_p: i64[] = [];
        var hop_q: i64[] = [];

        for (let k: i64, let e: &self::&Edge in &self.edges) {
            if (e.style == -1 || e.path.len < 2 || e.a == e.b) { continue; }

            for (let j: i64 in 1..e.path.len) {
                hop_e.push(k);
                hop_p.push(e.path[j - 1]);
                hop_q.push(e.path[j]);
            }
        }
        let nh: i64 = hop_e.len;
        // gaps between ranks: a row (or column) per hop bend, room for labels,
        // a row for heads
        var slots: i64[] = [];
        var labels: i64[] = []; // widest label leaving a rank (0: none)

        for (let r: i64 in 0..(top + 1)) {
            slots.push(0);
            labels.push(0);
        }

        for (let h: i64 in 0..nh) {
            let r: i64 = self.nodes[hop_p[h]].rank;

            if (slots[r] < 6) { slots[r] += 1; }
            let e: &self::&Edge = &self.edges[hop_e[h]];

            if (e.label.len > 0 && hop_p[h] == e.path[0] && label_w(&e.label) > labels[r]) {
                labels[r] = label_w(&e.label);
            }
        }
        var cgap: i64 = 3 + 2 * z;

        if (across) { cgap = 1 + z; }
        if (cgap < 1) { cgap = 1; }
        var gaps: i64[] = [];

        for (let r: i64 in 0..(top + 1)) {
            var g: i64 = 3 + z;

            if (across) { g = 6 + 2 * z; }
            if (g < 2) { g = 2; }
            var need: i64 = slots[r] + 2;

            if (labels[r] > 0) {
                if (across) { need += labels[r] + 3; } else { need += 1; }
            }
            if (g < need) { g = need; }
            gaps.push(g);
        }
        // along: each rank's band
        var band_at: i64[] = [];
        var band_size: i64[] = [];
        var at: i64 = 1;

        for (let r: i64 in 0..(top + 1)) {
            var size: i64 = 1;

            for (let k: i64 in &ranks[r]) {
                if (self.nodes[k].msize > size) { size = self.nodes[k].msize; }
            }
            band_at.push(at);
            band_size.push(size);

            for (let k: i64 in &ranks[r]) {
                self.nodes[k].main = at + (size - self.nodes[k].msize) / 2;
            }
            at += size + gaps[r];
        }
        let total_main: i64 = at - gaps[top] + 1;

        // across: in order, then each pulled toward its neighbors (a few passes), cgap apart
        for (let r: i64 in 0..(top + 1)) {
            var x: i64 = 1;

            for (let k: i64 in &ranks[r]) {
                self.nodes[k].cross = x;
                x += self.nodes[k].csize + cgap;
            }
        }

        for (let pass: i64 in 0..8) {
            let down: bool = pass % 2 == 0;
            var r: i64 = 1;

            if (!down) { r = top - 1; }

            while (r >= 0 && r <= top) {
                var near: i64 = r - 1;

                if (!down) { near = r + 1; }
                self.place_rank(&ranks[r], near, cgap);
                if (down) { r += 1; } else { r -= 1; }
            }
        }
        var lo: i64 = 0;
        var hi: i64 = 0;
        var any: bool = false;

        for (let n: &self::&Node in &self.nodes) {
            if (n.shape == -2) { continue; }
            if (!any || n.cross < lo) { lo = n.cross; }
            if (!any || n.cross + n.csize > hi) { hi = n.cross + n.csize; }
            any = true;
        }

        for (let k: i64 in 0..self.nodes.len) { self.nodes[k].cross += 1 - lo; }
        // ports: where each hop leaves its node and enters the next, spread
        // along the node's side in order of the other ends
        var hop_s: i64[] = [];
        var hop_t: i64[] = [];

        for (let h: i64 in 0..nh) {
            hop_s.push(self.mid(hop_p[h]));
            hop_t.push(self.mid(hop_q[h]));
        }

        for (let k: i64 in 0..self.nodes.len) {
            if (self.nodes[k].shape < 0) { continue; }
            var outs: i64[] = [];
            var ins: i64[] = [];

            for (let h: i64 in 0..nh) {
                if (hop_p[h] == k) { outs.push(h); }
                if (hop_q[h] == k) { ins.push(h); }
            }
            self.spread(&outs, mut &hop_s, &hop_q, k);
            self.spread(&ins, mut &hop_t, &hop_p, k);
        }

        // a dummy point's hops: through it, at its port
        for (let h: i64 in 0..nh) {
            if (self.nodes[hop_q[h]].shape == -1) {
                for (let h2: i64 in 0..nh) {
                    if (hop_p[h2] == hop_q[h] && hop_e[h2] == hop_e[h]) { hop_t[h] = hop_s[h2]; }
                }
            }
        }
        // each hop's bend: its own row in its gap
        var hop_m: i64[] = [];
        var used: i64[] = [];

        for (let r: i64 in 0..(top + 1)) { used.push(0); }

        for (let h: i64 in 0..nh) {
            let r: i64 = self.nodes[hop_p[h]].rank;
            var slot: i64 = used[r];

            if (slots[r] > 0) { slot = slot % slots[r]; }
            used[r] += 1;
            hop_m.push(band_at[r] + band_size[r] + 1 + slot);
        }
        // labels beside a link: room past the last column
        var total_cross: i64 = hi - lo + 3;

        if (!across) {
            for (let h: i64 in 0..nh) {
                let e: &self::&Edge = &self.edges[hop_e[h]];

                if (e.label.len == 0 || hop_p[h] != e.path[0]) { continue; }
                let need: i64 = hop_t[h] + 3 + label_w(&e.label);

                if (need > total_cross) { total_cross = need; }
            }
        }
        var w: i64 = total_cross;
        var h: i64 = total_main;

        if (across) {
            w = total_main;
            h = total_cross;
        }
        var c: Canvas = canvas(w, h);

        c.title = title;

        // links first (nodes drawn over their ends), then heads and labels
        for (let k: i64 in 0..nh) {
            let p: &self::&Node = &self.nodes[hop_p[k]];
            let q: &self::&Node = &self.nodes[hop_q[k]];
            let e: &self::&Edge = &self.edges[hop_e[k]];
            var sty: i64 = e.style;

            if (sty < 0) { sty = 0; }
            let gm: i64 = hop_m[k];
            var qm: i64 = q.main - 1;

            if (q.shape == -1) { qm = q.main; }
            var pts: i64[] = [p.main + p.msize, hop_s[k], gm, hop_s[k], gm, hop_t[k], qm, hop_t[k]];
            var j: i64 = 0;

            while (j + 3 < pts.len) {
                let (x1, y1) = place(pts[j], pts[j + 1], across, flip, total_main);
                let (x2, y2) = place(pts[j + 2], pts[j + 3], across, flip, total_main);

                c.line(x1, y1, x2, y2, sty);
                j += 2;
            }
        }
        c.finish();

        for (let k: i64 in 0..nh) {
            let e: &self::&Edge = &self.edges[hop_e[k]];
            let p: &self::&Node = &self.nodes[hop_p[k]];
            let q: &self::&Node = &self.nodes[hop_q[k]];
            // heads: at the end it points to (the start, if laid out reversed)
            var at_end: i64 = e.head;
            var at_start: i64 = e.tail;

            if (e.back) {
                at_end = e.tail;
                at_start = e.head;
            }
            if (at_end > 0 && q.shape >= 0) {
                let (x, y) = place(q.main - 1, hop_t[k], across, flip, total_main);

                c.put(x, y, head_char(at_end, across, flip, true), K_HEAD);
            }
            if (at_start > 0 && hop_p[k] == e.path[0]) {
                let (x, y) = place(p.main + p.msize, hop_s[k], across, flip, total_main);

                c.put(x, y, head_char(at_start, across, flip, false), K_HEAD);
            }
            if (e.label.len > 0 && hop_p[k] == e.path[0]) {
                let r: i64 = p.rank;
                let gs: i64 = band_at[r] + band_size[r];
                let lines: string[] = str::split(e.label, "\n");

                if (across) {
                    // above the horizontal part after the bends
                    let (x, y) = place(
                        gs + slots[r] + 2, hop_t[k] - lines.len, across, flip, total_main
                    );
                    var lx: i64 = x;

                    if (flip) { lx = x - label_w(&e.label) + 1; }

                    for (let j: i64, let l: string in &lines) { c.text(lx, y + j, l, K_LABEL); }
                } else {
                    // beside the vertical part after the bends
                    var ly: i64 = gs + slots[r] + 1;

                    if (flip) { ly = gs + slots[r] + lines.len; }
                    let (x, y) = place(ly, hop_t[k] + 2, across, flip, total_main);
                    // (left of its line if a line occupies the right)
                    let lw: i64 = label_w(&e.label);
                    var lx: i64 = x;

                    if (!c.clear(x, y, lw, lines.len) &&
                        c.clear(x - 4 - lw + 1, y, lw, lines.len)) {
                        lx = x - 4 - lw + 1;
                    }

                    for (let j: i64, let l: string in &lines) { c.text(lx, y + j, l, K_LABEL); }
                }
            }
        }

        for (let n: &self::&Node in &self.nodes) {
            if (n.shape < 0) { continue; }
            var mm: i64 = n.main;

            if (flip) { mm = total_main - n.main - n.msize; }
            var x: i64 = n.cross;
            var y: i64 = mm;
            var bw: i64 = n.csize;
            var bh: i64 = n.msize;

            if (across) {
                x = mm;
                y = n.cross;
                bw = n.msize;
                bh = n.csize;
            }
            // (a state's start and end: a dot)
            if (str::starts_with(n.id, "[*]")) {
                c.text(x + bw / 2, y + bh / 2, n.label, K_HEAD);
                continue;
            }
            c.boxed(x, y, bw, bh, n.shape, K_BOX);
            c.ids.push(n.id);
            c.mx.push(x + bw / 2);
            c.my.push(y + bh / 2);
            let lines: string[] = str::split(n.label, "\n");
            let ty: i64 = y + (bh - lines.len) / 2;

            for (let j: i64, let l: string in &lines) {
                let tx: i64 = x + (bw - tui::width(l)) / 2;

                c.text(tx, ty + j, l, K_TEXT);
            }
        }
        return c;
    }

    // node k's middle, across
    fn mid(self: &Graph, k: i64) -> i64 { return self.nodes[k].cross + self.nodes[k].csize / 2; }

    // give hops (on node k's side) ports along it, ordered by their other
    // ends (others[h]); ports stay within its border
    fn spread(self: &Graph, hops: &i64[], mut port: &i64[], others: &i64[], k: i64) -> void {
        let n: i64 = hops.len;

        if (n < 2) {
            return;
        }
        var order: i64[] = std::copy(*hops);

        for (let i: i64 in 1..n) {
            var j: i64 = i;

            while (j > 0 && self.mid(others[order[j - 1]]) > self.mid(others[order[j]])) {
                let t: i64 = order[j];

                order[j] = order[j - 1];
                order[j - 1] = t;
                j -= 1;
            }
        }
        let room: i64 = self.nodes[k].csize - 2;

        if (room < 1) {
            return;
        }

        for (let i: i64, let h: i64 in &order) {
            port[h] = self.nodes[k].cross + 1 + ((2 * i + 1) * room) / (2 * n);
        }
    }

    // mark links that would close a cycle as laid out b to a (a walk from
    // each node in order: a link back to a node on the current path)
    fn break_cycles(mut self: &Graph) -> void {
        let n: i64 = self.nodes.len;
        var state: i64[] = [];  // 0 unseen, 1 on the path, 2 done

        for (let k: i64 in 0..n) { state.push(0); }

        for (let root: i64 in 0..n) {
            if (state[root] != 0) { continue; }
            // iterative walk: the nodes on the path, and each one's next link
            var stack: i64[] = [root];
            var nxt: i64[] = [0];

            state[root] = 1;

            while (stack.len > 0) {
                let v: i64 = stack[stack.len - 1];
                let i: i64 = nxt[nxt.len - 1];

                if (i >= self.edges.len) {
                    state[v] = 2;
                    stack.pop();
                    nxt.pop();
                    continue;
                }
                nxt[nxt.len - 1] = i + 1;
                if (self.edges[i].a != v || self.edges[i].b == v) { continue; }
                let w: i64 = self.edges[i].b;

                if (state[w] == 1) {
                    self.edges[i].back = true;
                } else if (state[w] == 0) {
                    state[w] = 1;
                    stack.push(w);
                    nxt.push(0);
                }
            }
        }
    }

    // nodes in rank r joined to k by path links
    fn neighbors(self: &Graph, k: i64, r: i64) -> i64[] {
        var out: i64[] = [];

        for (let e: &self::&Edge in &self.edges) {
            for (let j: i64 in 0..e.path.len) {
                if (e.path[j] != k) { continue; }
                if (j > 0 && self.nodes[e.path[j - 1]].rank == r) { out.push(e.path[j - 1]); }
                if (j + 1 < e.path.len && self.nodes[e.path[j + 1]].rank == r) {
                    out.push(e.path[j + 1]);
                }
            }
        }
        return out;
    }

    // order rank's nodes by their neighbors' places in rank near (a node
    // without neighbors keeps its place)
    fn sort_rank(mut self: &Graph, mut rank: &i64[], near: i64) -> void {
        var keys: f64[] = [];

        for (let k: i64 in rank) {
            let nb: i64[] = self.neighbors(k, near);

            if (nb.len == 0) {
                keys.push(self.nodes[k].order);
                continue;
            }
            var sum: f64 = 0.0;

            for (let m: i64 in &nb) { sum += self.nodes[m].order; }
            keys.push(sum / (nb.len as f64));
        }
        // (insertion sort: stable, and ranks are short)
        let n: i64 = rank.len;

        for (let i: i64 in 1..n) {
            var j: i64 = i;

            while (j > 0 && keys[j - 1] > keys[j]) {
                let t: f64 = keys[j];

                keys[j] = keys[j - 1];
                keys[j - 1] = t;
                let u: i64 = rank[j];

                rank[j] = rank[j - 1];
                rank[j - 1] = u;
                j -= 1;
            }
        }

        for (let j: i64, let k: i64 in rank) { self.nodes[k].order = j as f64; }
    }

    // move rank's nodes toward their neighbors' middle in rank near, keeping
    // order, gap apart
    fn place_rank(mut self: &Graph, rank: &i64[], near: i64, gap: i64) -> void {
        var want: i64[] = [];

        for (let k: i64 in rank) {
            let nb: i64[] = self.neighbors(k, near);

            if (nb.len == 0) {
                want.push(self.nodes[k].cross);
                continue;
            }
            var sum: i64 = 0;

            for (let m: i64 in &nb) { sum += self.nodes[m].cross + self.nodes[m].csize / 2; }
            want.push(sum / nb.len - self.nodes[k].csize / 2);
        }
        // left to right: at its target, past the previous one
        var fin: i64 = -1000000;

        for (let j: i64, let k: i64 in rank) {
            var x: i64 = want[j];

            if (x < fin + gap) { x = fin + gap; }
            self.nodes[k].cross = x;
            fin = x + self.nodes[k].csize;
        }
        // right to left: back toward targets, short of the next one
        var j: i64 = rank.len - 2;

        while (j >= 0) {
            let k: i64 = rank[j];
            let nk: i64 = rank[j + 1];
            let room: i64 = self.nodes[nk].cross - gap - self.nodes[k].csize;

            if (self.nodes[k].cross > want[j]) {
                var x: i64 = want[j];

                if (j > 0) {
                    let pk: i64 = rank[j - 1];
                    let left: i64 = self.nodes[pk].cross + self.nodes[pk].csize + gap;

                    if (x < left) { x = left; }
                }
                if (x < self.nodes[k].cross) { self.nodes[k].cross = x; }
            } else if (self.nodes[k].cross < want[j]) {
                var x: i64 = want[j];

                if (x > room) { x = room; }
                if (x > self.nodes[k].cross) { self.nodes[k].cross = x; }
            }
            j -= 1;
        }
    }
}

// canvas position of a point (along the ranks, across them)
fn place(m: i64, c: i64, across: bool, flip: bool, total: i64) -> (i64, i64) {
    var mm: i64 = m;

    if (flip) { mm = total - 1 - m; }
    if (across) {
        return (mm, c);
    }
    return (c, mm);
}

// a link head character: an arrow in rank direction (at its end), or back (at its start)
fn head_char(kind: i64, across: bool, flip: bool, at_end: bool) -> i64 {
    if (kind == 2) {                        // ×
        return 0x00D7;
    }
    if (kind == 3) {                        // ○
        return 0x25CB;
    }
    var forward: bool = at_end != flip;

    if (across) {
        if (forward) {                      // ▶
            return 0x25B6;
        }
        return 0x25C0;                      // ◀
    }
    if (forward) {                          // ▼
        return 0x25BC;
    }
    return 0x25B2;                          // ▲
}

// ---- sequence diagrams -----------------------------------------------------------------

struct Actor {
    id: string;
    label: string;
    actor: bool = false;
    x: i64 = 0;  // its lifeline's column
    w: i64 = 0;
}

// sequence events in order: message, note, block start, else, end
struct Event {
    kind: i64;            // 0 message, 1 note, 2 block start, 3 else / and, 4 block end
    a: i64 = 0;
    b: i64 = 0;
    text: string = "";
    dotted: bool = false;
    head: i64 = 0;        // 0 none, 1 arrow, 2 x, 3 async (open arrow)
    side: i64 = 0;        // note: 0 left of, 1 right of, 2 over
}

fn actor_of(mut actors: &Actor[], id: string) -> i64 {
    for (let k: i64, let a: &actors::&Actor in actors) {
        if (str::eq(a.id, id)) {
            return k;
        }
    }
    actors.push(Actor { id: id, label: id });
    return actors.len - 1;
}

fn sequence(stmts: &string[], z: i64) -> Canvas {
    var actors: Actor[] = [];
    var events: Event[] = [];
    var number: bool = false;
    let arrows: string[] = ["-->>", "->>", "-->", "->", "--x", "-x", "--)", "-)"];

    for (let k: i64 in 1..stmts.len) {
        let l: string = stmts[k];
        let f: string[] = str::fields(l);
        let w: string = f[0];

        if (str::eq(w, "participant") || str::eq(w, "actor")) {
            var rest: string = str::trim(str::substr(l, w.len, l.len - w.len));
            var label: string = "";

            if (let q = str::find(rest, " as ")) {
                label = clean(str::substr(rest, q + 4, rest.len - q - 4));
                rest = str::trim(str::substr(rest, 0, q));
            }
            let i: i64 = actor_of(mut &actors, rest);

            if (label.len > 0) { actors[i].label = label; }
            actors[i].actor = str::eq(w, "actor");
            continue;
        }
        if (str::eq(w, "autonumber")) {
            number = true;
            continue;
        }
        if (str::eq(w, "activate") || str::eq(w, "deactivate") || str::eq(w, "title") ||
            str::eq(w, "box") || str::eq(w, "create") || str::eq(w, "destroy") ||
                str::eq(w, "link") ||
            str::eq(w, "links")) {
            continue;
        }
        if (str::eq(w, "loop") || str::eq(w, "alt") || str::eq(w, "opt") || str::eq(w, "par") ||
            str::eq(w, "critical") || str::eq(w, "break") || str::eq(w, "rect")) {
            events.push(Event { kind: 2, text: l });
            continue;
        }
        if (str::eq(w, "else") || str::eq(w, "and") || str::eq(w, "option")) {
            events.push(Event { kind: 3, text: l });
            continue;
        }
        if (str::eq(w, "end")) {
            events.push(Event { kind: 4 });
            continue;
        }
        if (str::eq(str::to_lower(w), "note")) {
            let c: i64 = str::find(l, ":") ?? l.len;
            let spec: string = str::trim(str::substr(l, w.len, c - w.len));
            var text: string = "";

            if (c < l.len) { text = clean(str::substr(l, c + 1, l.len - c - 1)); }
            var side: i64 = 2;
            var who: string = spec;

            if (str::starts_with(spec, "left of")) {
                side = 0;
                who = str::trim(str::substr(spec, 7, spec.len - 7));
            } else if (str::starts_with(spec, "right of")) {
                side = 1;
                who = str::trim(str::substr(spec, 8, spec.len - 8));
            } else if (str::starts_with(spec, "over")) {
                who = str::trim(str::substr(spec, 4, spec.len - 4));
            }
            let parts: string[] = str::split(who, ",");
            let a: i64 = actor_of(mut &actors, str::trim(parts[0]));
            var b: i64 = a;

            if (parts.len > 1) { b = actor_of(mut &actors, str::trim(parts[1])); }
            events.push(Event { kind: 1, a: a, b: b, text: text, side: side });
            continue;
        }
        // a message: A->>B: text (+ and - before B: activation, ignored)
        var found: i64 = -1;
        var arrow: string = "";

        for (let ar: string in &arrows) {
            if (let p = str::find(l, ar)) {
                if (found < 0 || p < found || (p == found && ar.len > arrow.len)) {
                    found = p;
                    arrow = ar;
                }
            }
        }
        if (found < 0) { continue; }
        let a_id: string = str::trim(str::substr(l, 0, found));
        var rest: string = str::substr(l, found + arrow.len, l.len - found - arrow.len);
        var text: string = "";

        if (let c = str::find(rest, ":")) {
            text = clean(str::substr(rest, c + 1, rest.len - c - 1));
            rest = str::substr(rest, 0, c);
        }
        var b_id: string = str::trim(rest);

        b_id = str::trim_prefix(str::trim_prefix(b_id, "+"), "-");
        if (a_id.len == 0 || b_id.len == 0) { continue; }
        let a: i64 = actor_of(mut &actors, a_id);
        let b: i64 = actor_of(mut &actors, b_id);
        var head: i64 = 0;

        if (str::ends_with(arrow, ">>")) { head = 1; }
        if (str::ends_with(arrow, "x")) { head = 2; }
        if (str::ends_with(arrow, ")")) { head = 3; }
        events.push(Event {
            kind: 0, a: a, b: b, text: text, dotted: str::starts_with(arrow, "--"), head: head
        });
    }
    if (actors.len == 0) {
        return failed("no participants", "sequence");
    }
    // numbers before the messages
    if (number) {
        var n: i64 = 1;

        for (let k: i64 in 0..events.len) {
            if (events[k].kind == 0) {
                events[k].text = "\(n) \(events[k].text)";
                n += 1;
            }
        }
    }
    // zoomed out: words truncated
    let cap: i64 = cap_of(z);

    for (let k: i64 in 0..actors.len) { actors[k].label = cut(&actors[k].label, cap); }

    for (let k: i64 in 0..events.len) { events[k].text = cut(&events[k].text, cap); }
    // columns: room for each box and the messages between them
    var pad: i64 = 1 + z;

    if (pad < 0) { pad = 0; }
    let n: i64 = actors.len;

    for (let k: i64 in 0..n) { actors[k].w = label_w(&actors[k].label) + 2 + 2 * pad; }
    var gaps: i64[] = [];

    for (let k: i64 in 0..n) {
        var g: i64 = 4 + 2 * z;

        if (g < 2) { g = 2; }
        gaps.push(g);
    }

    // (gaps[k]: from k's lifeline to k + 1's)
    for (let k: i64 in 0..(n - 1)) {
        let need: i64 = actors[k].w / 2 + (actors[k + 1].w + 1) / 2 + 2;

        if (gaps[k] < need) { gaps[k] = need; }
    }

    for (let e: &events::&Event in &events) {
        if (e.kind != 0 || e.a == e.b) { continue; }
        var lo: i64 = e.a;
        var hi: i64 = e.b;

        if (hi < lo) {
            lo = e.b;
            hi = e.a;
        }
        let need: i64 = label_w(&e.text) + 4;
        var have: i64 = 0;

        for (let k: i64 in lo..hi) { have += gaps[k]; }
        if (have < need) {
            let more: i64 = need - have;
            let span: i64 = hi - lo;

            for (let k: i64 in lo..hi) { gaps[k] += (more + span - 1) / span; }
        }
    }
    var x: i64 = actors[0].w / 2 + 2;

    for (let k: i64 in 0..n) {
        actors[k].x = x;
        x += gaps[k];
    }
    var right: i64 = actors[n - 1].x + (actors[n - 1].w + 1) / 2 + 2;

    // room past the last column for notes and self-messages
    for (let e: &events::&Event in &events) {
        var need: i64 = 0;

        if (e.kind == 0 && e.a == e.b) { need = actors[e.a].x + 4 + label_w(&e.text) + 2; }
        if (e.kind == 1 && e.side == 1) { need = actors[e.a].x + 3 + label_w(&e.text) + 4; }
        if (need > right) { right = need; }
    }
    // rows: the boxes, each event, then the boxes again
    var space: i64 = 1;

    if (z >= 2) { space = 2; }
    if (z < 0) { space = 0; }
    var h: i64 = 3 + 1;

    for (let e: &events::&Event in &events) {
        if (e.kind == 0) {
            h += str::split(e.text, "\n").len + 1 + space;
            if (e.a == e.b) { h += 1; }
        } else if (e.kind == 1) {
            h += str::split(e.text, "\n").len + 2 + space;
        } else {
            h += 1 + space;
        }
    }
    h += 3;
    var c: Canvas = canvas(right, h);

    c.title = "sequence";

    // the lifelines
    for (let a: &actors::&Actor in &actors) { c.line(a.x, 3, a.x, h - 4, 16); }
    var y: i64 = 4;
    var depth: i64 = 0;
    let left: i64 = 0;
    var mark_y: i64[] = [];     // block lines: their rows, kinds, texts
    var mark_k: i64[] = [];
    var mark_t: string[] = [];
