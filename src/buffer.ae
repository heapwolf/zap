//! zap's buffers: a memline (the lines), the cursor and view, the undo
//! history, the highlighter's saved states, and a tool's diagnostics for
//! the file.
//!
//! Every change goes through set_line, insert_line and remove_line, which
//! record it for undo. A change is one command's edits (one insert session,
//! one `dd`), undone together. The history is a tree keeping every state
//! (undo.ae), saved with the file when it is written.

import str from "std/string";
import fs from "std/fs";
import time from "std/time";
import regex from "std/regex";
import unicode from "std/unicode";
import ml from "memline.ae";
import { MemLine } from "memline.ae";
import syntax from "syntax.ae";
import { Hl } from "syntax.ae";
import { FileType } from "config.ae";
import undo from "undo.ae";
import { Sheet } from "sheet.ae";
import { History, Change, Op } from "undo.ae";

/// how often the highlighter's state is saved (every STEP lines)
export let STEP: i64 = 64;

/// a place a tool reported: line and column (0-based) and the message
export struct Diag {
    export line: i64;
    export col: i64;
    export message: string;
}

/// an open file (or a scratch buffer, e.g. a command's output)
export struct Buf {
    export id: i64;
    export name: string;                // as shown
    export path: string = "";           // its file ("": none yet)
    export text: MemLine;
    export modified: bool = false;
    export scratch: bool = false;
    export readonly: bool = false;      // changes refused (help)
    export refused: bool = false;       // one was, since the editor last checked
    export ft: FileType;
    export tabstop: i64 = 4;
    export git_tracked: bool = false;   // file is in a git commit (git_base: its lines)
    export git_base: i64[] = [];        // committed lines' hashes (git.ae)
    export signs: i64[] = [];           // each line's git sign (git.ae: NONE, ADD, ...)
    export signs_gen: i64 = -1;         // gen when signs were found
    export signs_ms: i64 = 0;           // and when (ms)
    export git_asked: i64 = 0;          // when git was last asked (ms)
    export cy: i64 = 0;                 // cursor: line, and byte in it
    export cx: i64 = 0;
    export want: i64 = 0;               // screen column kept by up/down
    export top: i64 = 0;                // first line on screen
    export left: i64 = 0;               // first column on screen
    export diags: Diag[] = [];
    export hist: History = History {};
    export gen: i64 = 0;                // times its text changed (for data derived from it)
    export sheet: Sheet[] = [];         // its sheet, if shown as a spreadsheet (CSV; none: text)
    cur: Change = Change {};
    changing: bool = false;
    states: i64[] = []; // highlighter state at every STEP-th line
    valid: i64 = 0;     // how many of them are current
}

/// a buffer of file p (empty if the file does not exist yet)
export fn open(id: i64, p: string, name: string, ft: FileType) -> Buf | fs::PermissionDenied |
    fs::IsADirectory | fs::IoError {
    var text: MemLine = ml::empty();

    match (ml::open(p)) {
        m => { text = m; },
        e: fs::NotFound => {},
        e2: fs::PermissionDenied => { fail e2; },
        e3: fs::IsADirectory => { fail e3; },
        e4: fs::IoError => { fail e4; }
    }
    let ts: i64 = ft.tabstop;
    var b: Buf = Buf { id: id, name: name, path: p, text: text, ft: ft, states: [0], valid: 1 };

    if (ts > 0) { b.tabstop = ts; }
    return b;
}

/// a scratch buffer holding text
export fn scratch(id: i64, name: string, text: string) -> Buf {
    return Buf {
        id: id, name: name, text: ml::of_text(text), scratch: true,
        ft: FileType { name: "text" }, states: [0], valid: 1
    };
}

// is byte b a UTF-8 continuation byte (not a sequence's first)?
fn cont(b: u8) -> bool { return (b & 0xC0) == 0x80; }

/// the byte after the character at i in s
export fn next_char(s: &string, i: i64) -> i64 {
    let n: i64 = s.len;

    if (i >= n) {
        return n;
    }
    var j: i64 = i + 1;

    while (j < n && cont(s[j])) { j += 1; }
    return j;
}

/// first byte of the character before i in s
export fn prev_char(s: &string, i: i64) -> i64 {
    if (i <= 0) {
        return 0;
    }
    var j: i64 = i - 1;

    while (j > 0 && cont(s[j])) { j -= 1; }
    return j;
}

/// cells the character at byte i of s takes at screen column col (tab:
/// up to the next stop)
export fn cell_width(s: &string, i: i64, col: i64, ts: i64) -> i64 {
    let c: u8 = s[i];

    if (c == 9) {
        return ts - col % ts;
    }
    if (c < 128) {
        return 1;
    }
    let ch: char = str::char_at(*s, i);
    let w: i64 = unicode::width(ch);

    if (w < 0) {
        return 1;
    }
    return w;
}

/// screen column of byte i of s
export fn col_of(s: &string, i: i64, ts: i64) -> i64 {
    var col: i64 = 0;
    var j: i64 = 0;
    let n: i64 = s.len;

    while (j < i && j < n) {
        col += cell_width(s, j, col, ts);
        j = next_char(s, j);
    }
    return col;
}

/// byte at screen column col of s (the character covering it; the end if
/// the line is shorter)
export fn byte_at(s: &string, col: i64, ts: i64) -> i64 {
    var c: i64 = 0;
    var j: i64 = 0;
    let n: i64 = s.len;

    while (j < n) {
        let w: i64 = cell_width(s, j, c, ts);

        if (c + w > col) {
            return j;
        }
        c += w;
        j = next_char(s, j);
    }
    return n;
}

/// is the byte a word character (letter, digit, _)?
export fn wordy(b: u8) -> bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_' ||
        b >= 128;
}

/// what a search looks for: a literal pattern (case-insensitive if fold)
/// or a regular expression
export struct Matcher {
    export pattern: string = "";
    export fold: bool = false;
    export bad: string = "";         // why the regex is invalid ("": valid)
    re: regex::Regex[] = [];         // compiled pattern (none: literal)
    low: string = "";
}

/// a matcher for pattern (smart case: case matters only if it has a capital)
export fn matcher(pattern: string, use_regex: bool, ignorecase: bool, smartcase: bool) -> Matcher {
    var fold: bool = ignorecase;

    if (smartcase && !str::eq(str::to_lower(pattern), pattern)) { fold = false; }
    var m: Matcher = Matcher { pattern: pattern, fold: fold, low: str::to_lower(pattern) };

    if (use_regex) {
        var o: regex::Options = regex::options();

        o.case_insensitive = fold;
        match (regex::new_with(pattern, &o)) {
            r => { m.re.push(r); },
            e: regex::BadRegex => { m.bad = "bad pattern at \(e.at): \(e.why)"; }
        }
    }
    return m;
}

impl Matcher {
    /// first match in s at or after byte start: (start, end), or none
    export fn find(self: &Matcher, s: &string, start: i64) -> (i64, i64)? {
        if (self.pattern.len == 0 || self.bad.len > 0) {
            return none;
        }
        if (self.re.len > 0) {
            let r: &self::&regex::Regex = &self.re[0];

            if (let mt = r.find_at(*s, start)) {
                if (mt.end == mt.start) {
                    return (mt.start, mt.start + 1);
                }
                return (mt.start, mt.end);
            }
            return none;
        }
        if (self.fold) {
            return self.find_plain(&str::to_lower(*s), start);
        }
        return self.find_plain(s, start);
    }

    // record op (in its own change if none is open)
    fn record(mut self: &Buf, op: Op) -> void {
        if (self.changing) {
            // (a line set again in the same change, as when typing: update the
            // previous op's new text instead of adding one op per key)
            let n: i64 = self.cur.ops.len;

            if (op.kind == 0 && n > 0 && self.cur.ops[n - 1].line == op.line &&
                self.cur.ops[n - 1].kind <= 1) {
                self.cur.ops[n - 1].new = op.new;
                return;
            }
            self.cur.ops.push(op);
            return;
        }
        self.begin();
        self.cur.ops.push(op);
        self.commit();
    }

    /// set line i to s
    export fn set_line(mut self: &Buf, i: i64, s: string) -> void {
        if (self.readonly) {
            self.refused = true;
            return;
        }
        let old: string = self.text.get(i);

        if (str::eq(old, s)) {
            return;
        }
        self.text.set(i, s);
        self.touched(i);
        self.record(Op { kind: 0, line: i, old: old, new: s });
    }

    /// insert s as line i
    export fn insert_line(mut self: &Buf, i: i64, s: string) -> void {
        if (self.readonly) {
            self.refused = true;
            return;
        }
        self.text.insert(i, s);
        self.touched(i);
        self.record(Op { kind: 1, line: i, new: s });
    }

    /// remove line i (the last remaining line becomes empty instead)
    export fn remove_line(mut self: &Buf, i: i64) -> void {
        if (self.readonly) {
            self.refused = true;
            return;
        }
        if (self.text.count == 1) {
            self.set_line(0, "");
            return;
        }
        let old: string = self.text.get(i);

        self.text.remove(i);
        self.touched(i);
        self.record(Op { kind: 2, line: i, old: old });
    }

    // undo state k: the buffer moves to its parent
    fn back_out(mut self: &Buf, k: i64) -> void {
        let c: Change = std::copy(self.hist.nodes[k - 1]);
        var j: i64 = c.ops.len - 1;

        while (j >= 0) {
            let op: &c::&Op = &c.ops[j];

            j -= 1;
            if (op.kind == 0) {
                self.text.set(op.line, op.old);
            } else if (op.kind == 1) {
                self.text.remove(op.line);
            } else {
                self.text.insert(op.line, op.old);
            }
            self.touched(op.line);
        }
        let parent: i64 = c.parent;

        self.hist.set_next(parent, k);
        self.hist.at = parent;
        self.cy = c.cy;
        self.cx = c.cx;
    }

    // redo state k: the buffer moves to it from its parent
    fn redo_state(mut self: &Buf, k: i64) -> void {
        let c: Change = std::copy(self.hist.nodes[k - 1]);

        for (let op: &c::&Op in &c.ops) {
            if (op.kind == 0) {
                self.text.set(op.line, op.new);
            } else if (op.kind == 1) {
                self.text.insert(op.line, op.new);
            } else {
                self.text.remove(op.line);
            }
            self.touched(op.line);
        }
        self.hist.set_next(c.parent, k);
        self.hist.at = k;
        self.cy = c.cy;
        self.cx = c.cx;
    }

    // fix the cursor and modified flag after moving through the history
    fn moved(mut self: &Buf) -> void {
        self.modified = self.hist.at != self.hist.saved;
        self.clamp();
    }

    /// undo the last change -> was there one?
    export fn undo_last(mut self: &Buf) -> bool {
        self.commit();
        if (self.hist.at == 0) {
            return false;
        }
        self.back_out(self.hist.at);
        self.moved();
        return true;
    }

    /// redo the last undone change -> was there one?
    export fn redo_last(mut self: &Buf) -> bool {
        self.commit();
        let k: i64 = self.hist.next_of(self.hist.at);

        if (k == 0) {
            return false;
        }
        self.redo_state(k);
        self.moved();
        return true;
    }

    /// move to state k (0: the file as first read; states are numbered in
    /// creation order) -> did it move?
    export fn go_to(mut self: &Buf, k: i64) -> bool {
        self.commit();
        var to: i64 = k;

        if (to < 0) { to = 0; }
        if (to > self.hist.nodes.len) { to = self.hist.nodes.len; }
        if (to == self.hist.at) {
            return false;
        }
        let (ups, downs) = self.hist.way(to);

        for (let u: i64 in &ups) { self.back_out(u); }

        for (let d: i64 in &downs) {
            self.redo_state(d);
            self.cy = self.hist.nodes[d - 1].ay;
            self.cx = self.hist.nodes[d - 1].ax;
        }
        self.moved();
        return true;
    }

    /// when state k was made (seconds since 1970; state 0: the first
    /// change's time; 0 if there are none)
    export fn made(self: &Buf, k: i64) -> i64 {
        if (self.hist.nodes.len == 0 || k > self.hist.nodes.len) {
            return 0;
        }
        if (k <= 0) {
            return self.hist.nodes[0].time;
        }
        return self.hist.nodes[k - 1].time;
    }

    /// move to secs seconds before the current state was made -> did it move?
    export fn earlier_by(mut self: &Buf, secs: i64) -> bool {
        self.commit();
        let t: i64 = self.made(self.hist.at) - secs;
        var to: i64 = self.hist.before(t);

        if (to > self.hist.at) { to = self.hist.at; }
        return self.go_to(to);
    }

    /// move to secs seconds after the current state was made (the last
    /// state made by then) -> did it move?
    export fn later_by(mut self: &Buf, secs: i64) -> bool {
        self.commit();
        let t: i64 = self.made(self.hist.at) + secs;
        var to: i64 = self.hist.before(t);

        if (to < self.hist.at) { to = self.hist.at; }
        return self.go_to(to);
    }

    /// keep the cursor on a line and on a character in it
    export fn clamp(mut self: &Buf) -> void {
        if (self.cy >= self.text.count) { self.cy = self.text.count - 1; }
        if (self.cy < 0) { self.cy = 0; }
        let l: string = self.text.get(self.cy);

        if (self.cx > l.len) { self.cx = l.len; }
        if (self.cx < 0) { self.cx = 0; }

        while (self.cx > 0 && self.cx < l.len && cont(l[self.cx])) { self.cx -= 1; }
    }

    // ---- text ----------------------------------------------------------------------

    /// insert text at line y, byte x (newlines split the line) -> where it
    /// ends (line, byte)
    export fn put(mut self: &Buf, y: i64, x: i64, text: string) -> (i64, i64) {
        let l: string = self.text.get(y);
        let head: string = str::substr(l, 0, x);
        let tail: string = str::substr(l, x, l.len - x);
        let parts: string[] = str::split(text, "\n");
        let n: i64 = parts.len;

        if (n == 1) {
            self.set_line(y, "\(head)\(text)\(tail)");
            return (y, x + text.len);
        }
        self.set_line(y, "\(head)\(parts[0])");

        for (let k: i64 in 1..(n - 1)) { self.insert_line(y + k, parts[k]); }
        let last: string = parts[n - 1];

        self.insert_line(y + n - 1, "\(last)\(tail)");
        return (y + n - 1, last.len);
    }

    /// remove the text from (y1, x1) to (y2, x2) (end excluded) -> the
    /// removed text
    export fn cut(mut self: &Buf, y1: i64, x1: i64, y2: i64, x2: i64) -> string {
        let first: string = self.text.get(y1);

        if (y1 == y2) {
            let gone: string = str::substr(first, x1, x2 - x1);

            self.set_line(
                y1, "\(str::substr(first, 0, x1))\(str::substr(first, x2, first.len - x2))"
            );
            return gone;
        }
        let last: string = self.text.get(y2);
        var b: str::Builder;

        b.add(str::substr(first, x1, first.len - x1));

        for (let k: i64 in (y1 + 1)..y2) {
            b.add_byte(10);
            b.add(self.text.get(k));
        }
        b.add_byte(10);
        b.add(str::substr(last, 0, x2));
        self.set_line(y1, "\(str::substr(first, 0, x1))\(str::substr(last, x2, last.len - x2))");

        for (let k: i64 in (y1 + 1)..(y2 + 1)) { self.remove_line(y1 + 1); }
        return b.to_string();
    }

    /// the word under the cursor ("": none)
    export fn word(mut self: &Buf) -> string {
        let l: string = self.text.get(self.cy);
        var a: i64 = self.cx;

        if (a >= l.len) {
            return "";
        }
        if (!wordy(l[a])) {
            return "";
        }

        while (a > 0 && wordy(l[a - 1])) { a -= 1; }
        var b: i64 = self.cx;

        while (b < l.len && wordy(l[b])) { b += 1; }
        return str::substr(l, a, b - a);
    }

    // ---- highlighting --------------------------------------------------------------

    /// highlighter state at the start of line i, if the saved states reach
    /// it (at most STEP lines from one)
    export fn state_at(mut self: &Buf, i: i64) -> i64? {
        let k: i64 = i / STEP;

        if (k >= self.valid) {
            return none;
        }
        var s: i64 = self.states[k];
        var out: Hl[] = [];
        let lang: string = self.ft.syntax;

        for (let l: i64 in (k * STEP)..i) {
            let t: string = self.text.get(l);

            s = syntax::line(lang, &t, s, mut &out);
            out.clear();
        }
        return s;
    }

    /// do the saved states reach line i?
    export fn reaches(self: &Buf, i: i64) -> bool { return i / STEP < self.valid; }

    /// load the history saved for its file, if the file is as it was then
    /// -> was it?
    export fn recall_history(mut self: &Buf) -> bool {
        if (self.text.file.len == 0 || self.modified) {
            return false;
        }
        if (let h = undo::load(self.path, self.text.stamp, self.text.stamp_time / 1ns)) {
            self.hist = h;
            self.hist.at = self.hist.saved;
            return true;
        }
        return false;
    }

    /// reread its file (changes lost; undo history cleared)
    export fn reload(mut self: &Buf) -> void | fs::NotFound | fs::PermissionDenied |
        fs::IsADirectory | fs::IoError {
        if (self.path.len == 0) {
            return;
        }
        let m: MemLine = ml::open(self.path)?;

        self.text.close();
        self.text = m;
        self.gen += 1;
        self.modified = false;
        self.hist = History {};
        self.states = [0];
        self.valid = 1;
        self.clamp();
    }
}

#test fn edits_and_undoes() -> i32 {
    var b: Buf = scratch(1, "t", "one\ntwo\nthree\n");

    b.begin();
    b.put(1, 1, "X\nY");
    b.commit();
    if (b.lines() != 4 || !str::eq(b.line(1), "tX") || !str::eq(b.line(2), "Ywo")) {
        return 1;
    }
    b.begin();
    let gone: string = b.cut(0, 1, 2, 1);

    b.commit();
    if (!str::eq(gone, "ne\ntX\nY") || !str::eq(b.line(0), "owo") || b.lines() != 2) {
        return 2;
    }
    if (!b.undo_last() || b.lines() != 4 || !str::eq(b.line(2), "Ywo")) {
        return 3;
    }
    if (!b.undo_last() || !str::eq(b.text.text(), "one\ntwo\nthree\n")) {
        return 4;
    }
    if (b.undo_last()) {
        return 5;
    }
    if (!b.redo_last() || !str::eq(b.line(1), "tX")) {
        return 6;
    }
    if (!b.redo_last() || !str::eq(b.line(0), "owo")) {
        return 7;
    }
    return 0;
}

#test fn keeps_every_branch() -> i32 {
    var b: Buf = scratch(1, "t", "a\n");
