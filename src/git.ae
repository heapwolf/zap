//! git signs: per-line marks in the gutter's first column for what changed
//! since the file's last commit. The committed text comes from git (`git
//! show HEAD:./file`, in the background: editor.ae); zap diffs line hashes
//! itself, again on each change: the common prefix and suffix are trimmed,
//! then Myers's diff runs on the rest (if the rewrite is too large for it,
//! the rest is marked changed).

/// a line's mark: none, added, changed, lines removed after it, lines
/// removed before it (only on the first line: removed at the top)
export let NONE: i64 = 0;
export let ADD: i64 = 1;
export let CHANGE: i64 = 2;
export let DELETE: i64 = 3;
export let DELETE_TOP: i64 = 4;

// max edits Myers's diff searches for (memory grows with its square)
let MAX_EDITS: i64 = 400;

/// line hashes (what the diff compares)
export fn hashes(lines: &string[]) -> i64[] {
    var out: i64[] = [];

    for (let l: string in lines) { out.push(std::hash(l)); }
    return out;
}

/// the mark for each line of cur, an edit of base (both as hashes)
export fn signs(base: &i64[], cur: &i64[]) -> i64[] {
    var out: i64[] = [];

    for (let k: i64 in 0..cur.len) { out.push(NONE); }
    // trim the common prefix and suffix
    var lo: i64 = 0;

    while (lo < base.len && lo < cur.len && base[lo] == cur[lo]) { lo += 1; }
    var ahi: i64 = base.len;
    var bhi: i64 = cur.len;

    while (ahi > lo && bhi > lo && base[ahi - 1] == cur[bhi - 1]) {
        ahi -= 1;
        bhi -= 1;
    }
    if (ahi == lo && bhi == lo) {
        return out;
    }
    // which cur lines were inserted, and how many lines were removed before each
    var ins: bool[] = [];
    var dels: i64[] = [];

    for (let k: i64 in 0..(bhi - lo + 1)) {
        ins.push(false);
        dels.push(0);
    }
    if (!myers(base, lo, ahi, cur, lo, bhi, mut &ins, mut &dels)) {
        // (too many edits: the whole middle is one change)
        for (let k: i64 in 0..(bhi - lo)) { ins[k] = true; }

        for (let k: i64 in 0..(bhi - lo + 1)) { dels[k] = 0; }
        dels[0] = ahi - lo;
    }
    mark(&ins, &dels, lo, mut &out);
    return out;
}

// a diff's marks: at each place, the lines inserted there and the lines
// removed there or among them; if both, that many are changed (the rest
// added); if only removed, the line before is marked
fn mark(ins: &bool[], dels: &i64[], lo: i64, mut out: &i64[]) -> void {
    let m: i64 = ins.len - 1;
    var p: i64 = 0;

    while (p <= m) {
        var r: i64 = 0;

        while (p + r < m && ins[p + r]) { r += 1; }
        var gone: i64 = 0;

        for (let q: i64 in p..(p + r + 1)) { gone += dels[q]; }
        if (r > 0) {
            for (let k: i64 in 0..r) {
                if (k < gone) { out[lo + p + k] = CHANGE; } else { out[lo + p + k] = ADD; }
            }
        } else if (gone > 0 && out.len > 0) {
            let at: i64 = lo + p;

            if (at == 0) {
                if (out[0] == NONE) { out[0] = DELETE_TOP; }
            } else if (out[at - 1] == NONE) {
                out[at - 1] = DELETE;
            }
        }
        p += r + 1;
    }
}

// Myers's diff of a[alo..ahi] and b[blo..bhi]: ins[j]: b[blo + j] was
// inserted; dels[j]: lines of a removed just before it -> found within
// MAX_EDITS edits?
fn myers(
    a: &i64[], alo: i64, ahi: i64, b: &i64[], blo: i64, bhi: i64, mut ins: &bool[],
    mut dels: &i64[]
) -> bool {
    let n: i64 = ahi - alo;
    let m: i64 = bhi - blo;
    var cap: i64 = n + m;

    if (cap > MAX_EDITS) { cap = MAX_EDITS; }
    let off: i64 = cap + 1;
    // v[k + off]: the furthest x (along a) reached on diagonal k
    var v: i64[] = [];

    for (let k: i64 in 0..(2 * cap + 3)) { v.push(0); }
    var trace: i64[][] = [];
    var found: i64 = -1;

    for (let d: i64 in 0..(cap + 1)) {
        trace.push(std::copy(v));
        var k: i64 = -d;

        while (k <= d) {
            var x: i64 = 0;

            if (k == -d || (k != d && v[k - 1 + off] < v[k + 1 + off])) {
                x = v[k + 1 + off];
            } else {
                x = v[k - 1 + off] + 1;
            }
            var y: i64 = x - k;

            while (x < n && y < m && a[alo + x] == b[blo + y]) {
                x += 1;
                y += 1;
            }
            v[k + off] = x;
            if (x >= n && y >= m) {
                found = d;
                break;
            }
            k += 2;
        }
        if (found >= 0) { break; }
    }
    if (found < 0) {
        return false;
    }
    // walk back from the end: each step is an insertion or a removal
    var x: i64 = n;
    var y: i64 = m;
    var d: i64 = found;

    while (d > 0) {
        let vd: &trace::&i64[] = &trace[d];
        let k: i64 = x - y;
        var pk: i64 = k - 1;

        if (k == -d || (k != d && vd[k - 1 + off] < vd[k + 1 + off])) { pk = k + 1; }
        let px: i64 = vd[pk + off];
        let py: i64 = px - pk;

        while (x > px && y > py) {
            x -= 1;
            y -= 1;
        }
        if (x == px) {
            ins[py] = true;         // b[py] inserted
        } else {
            dels[py] += 1;          // a[px] removed, before b[py]
        }
        x = px;
        y = py;
        d -= 1;
    }
    return true;
}

// ---- tests ---------------------------------------------------------------------------

fn h(words: string) -> i64[] {
    var out: i64[] = [];

    for (let k: i64 in 0..words.len) { out.push(words[k] as i64); }
    return out;
}

fn same(got: &i64[], want: i64[]) -> bool {
    if (got.len != want.len) {
        return false;
    }

    for (let k: i64 in 0..got.len) {
        if (got[k] != want[k]) {
            return false;
        }
    }
    return true;
}

#test fn marks_changes() -> i32 {
    // a line per letter
    if (!same(&signs(&h("abc"), &h("abc")), [0, 0, 0])) {
        return 1;
    }
    if (!same(&signs(&h("abc"), &h("abxc")), [0, 0, ADD, 0])) {
        return 2;
    }
    if (!same(&signs(&h("abc"), &h("axc")), [0, CHANGE, 0])) {
        return 3;
    }
    if (!same(&signs(&h("abcd"), &h("ad")), [DELETE, 0])) {
        return 4;
    }
    if (!same(&signs(&h("abc"), &h("bc")), [DELETE_TOP, 0])) {
        return 5;
    }
    if (!same(&signs(&h("abc"), &h("ab")), [0, DELETE])) {
        return 6;
    }
    // one changed, one more added after it
    if (!same(&signs(&h("abc"), &h("axyc")), [0, CHANGE, ADD, 0])) {
        return 7;
    }
    // separate edits: marked separately
    if (!same(&signs(&h("abcdefg"), &h("aXcdeYZfg")), [0, CHANGE, 0, 0, 0, ADD, ADD, 0, 0])) {
        return 8;
    }
    // a new file, and an emptied one
    if (!same(&signs(&h(""), &h("ab")), [ADD, ADD])) {
        return 9;
    }
    if (!same(&signs(&h("ab"), &h("")), [])) {
        return 10;
    }
    return 0;
}

#test fn too_many_edits_is_one_change() -> i32 {
    var a: i64[] = [];
    var b: i64[] = [];

    for (let k: i64 in 0..1000) {
        a.push(k);
        b.push(k + 5000);
    }
    let s: i64[] = signs(&a, &b);

    if (s.len != 1000 || s[0] != CHANGE || s[999] != CHANGE) {
        return 1;
    }
    return 0;
}
