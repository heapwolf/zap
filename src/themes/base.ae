//! zap's base themes: paper (light) and ink (dark), inherited by every
//! other built-in theme. (No git.add, git.change, git.delete here: a theme
//! without them uses its own string, type and error colors, which an
//! inherited face would hide.) Part of the defaults (config.ae's DEFAULTS;
//! `:defaults` shows them in place).

/// the base themes, as configuration text
export let BASE: string = """;; ---- themes ---------------------------------------------------------------

;; paper: light, with one accent
(theme "paper"
  (normal :fg "#2b2b2b" :bg "#ffffff")
  (cursor :bg "#c5c8f2")
  (gutter :fg "#8f8f8f")
  (gutter.current :fg "#3a3a3a")
  (gutter.error :fg "#ffffff" :bg "#e03e1a")
  (tree :fg "#3d3d3d" :bg "#f2f2f2")
  (tree.root :fg "#1a1a1a" :bold true)
  (tree.dir :fg "#1f1f1f")
  (tree.file :fg "#4a4a4a")
  (tree.special :fg "#f0581f" :italic true)
  (tree.open :fg "#1a1a1a" :bold true)
  (tree.cursor :bg "#e4e4e4")
  (divider :fg "#e4e4e4" :bg "#f2f2f2")
  (status :fg "#2b2b2b" :bg "#d6d6d6")
  (status.file :fg "#1a1a1a")
  (status.info :fg "#3a3a3a")
  (status.end :fg "#ffffff" :bg "#3f3f3f")
  (status.mode.normal :fg "#ffffff" :bg "#3f3f3f")
  (status.mode.insert :fg "#ffffff" :bg "#f0581f")
  (status.mode.command :fg "#ffffff" :bg "#5b6ee1")
  (status.mode.tree :fg "#ffffff" :bg "#6b6b6b")
  (status.mode.visual :fg "#ffffff" :bg "#8a3fb0")
  (visual :bg "#e3e7fa")
  (search :fg "#ffffff" :bg "#f0581f")
  (cmdline :fg "#2b2b2b" :bg "#ffffff")
  (error :fg "#d0301a" :bold true)
  (panel :fg "#2b2b2b" :bg "#f7f7f7")
  (dialog :fg "#2b2b2b" :bg "#ffffff")
  (menu :fg "#2b2b2b" :bg "#ebebeb")
  (menu.selected :fg "#1a1a1a" :bg "#f9bea4")
  (menu.match :fg "#a8360a" :bold true)
  (menu.kind :fg "#666666")
  (menu.doc :fg "#2b2b2b" :bg "#f0f0f0")
  (menu.doc.title :fg "#1a1a1a" :bold true)
  (menu.border :fg "#b0b0b0")
  (heading :fg "#f0581f")
  (bold :bold true)
  (italic :italic true)
  (link :underline true)
  (url :fg "#f0581f")
  (list :fg "#f0581f")
  (code :fg "#7d5a00")
  (quote :fg "#6b6b6b" :italic true)
  (comment :fg "#858585" :italic true)
  (string :fg "#3f8a3a")
  (keyword :fg "#a12fa1")
  (type :fg "#b26b00")
  (number :fg "#b25400")
  (function :fg "#2f5fd0")
  (constant :fg "#007f9f")
  (operator :fg "#6a6a6a")
  (punct :fg "#9a9a9a")
  (escape :fg "#007f9f")
  (error.text :fg "#d0301a"))

;; ink: dark, the same accent
(theme "ink" :inherit "paper"
  (normal :fg "#d7d7d2" :bg "#1d1f21")
  (cursor :bg "#7f86d9")
  (gutter :fg "#5c5f63")
  (gutter.current :fg "#b0b0aa")
  (tree :fg "#b9b9b3" :bg "#25272a")
  (tree.root :fg "#e8e8e2" :bold true)
  (tree.dir :fg "#e0e0da")
  (tree.file :fg "#a9a9a3")
  (tree.open :fg "#ffffff" :bold true)
  (tree.cursor :bg "#33363a")
  (divider :fg "#33363a" :bg "#25272a")
  (status :fg "#d7d7d2" :bg "#33363a")
  (status.file :fg "#ffffff")
  (status.info :fg "#c0c0ba")
  (status.end :fg "#1d1f21" :bg "#b0b0aa")
  (status.mode.normal :fg "#1d1f21" :bg "#b0b0aa")
  (status.mode.visual :fg "#1d1f21" :bg "#c678dd")
  (visual :bg "#2f3447")
  (error :fg "#ff6b57" :bold true)
  (cmdline :fg "#d7d7d2" :bg "#1d1f21")
  (panel :fg "#d7d7d2" :bg "#25272a")
  (dialog :fg "#d7d7d2" :bg "#25272a")
  (menu :fg "#d7d7d2" :bg "#2e3134")
  (menu.selected :fg "#ffffff" :bg "#6b3a22")
  (menu.match :fg "#ff9566" :bold true)
  (menu.kind :fg "#8f8f8a")
  (menu.doc :fg "#d7d7d2" :bg "#282a2d")
  (menu.doc.title :fg "#ffffff" :bold true)
  (menu.border :fg "#55595e")
  (code :fg "#e5c07b")
  (quote :fg "#9a9a94" :italic true)
  (comment :fg "#6f737a" :italic true)
  (string :fg "#98c379")
  (keyword :fg "#c678dd")
  (type :fg "#e5c07b")
  (number :fg "#d19a66")
  (function :fg "#61afef")
  (constant :fg "#56b6c2")
  (operator :fg "#9a9a94")
  (punct :fg "#6f737a")
  (escape :fg "#56b6c2")
  (error.text :fg "#ff6b57"))

(set theme "paper")

""";
