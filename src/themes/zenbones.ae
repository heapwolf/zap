//! The zenbones themes (github.com/zenbones-theme/zenbones.nvim), from
//! its compiled Vim colorschemes and lualine themes: light and dark for
//! each variant (`zenbones-light`, `zenbones-dark`, ...), or the only one
//! some have (vimbones, nordbones, duckbones, zenburned, kanagawabones).
//! Mostly monochrome: keywords bold, strings and constants italic.
//! Light ones inherit paper, dark ones ink.

/// the themes, as configuration text (read after the defaults)
export let ZENBONES: string = """
;; zenbones-light: a contrast-based colorscheme, light
(theme "zenbones-light" :inherit "paper"
  (normal :fg "#2c363c" :bg "#f0edec")
  (cursor :bg "#2c363c")
  (gutter :fg "#a4968f")
  (gutter.current :fg "#2c363c" :bold true)
  (gutter.error :fg "#f0edec" :bg "#a8334c")
  (tree :fg "#2c363c" :bg "#e9e4e2")
  (tree.root :fg "#2c363c" :bold true)
  (tree.dir :fg "#2c363c")
  (tree.file :fg "#44525b")
  (tree.special :fg "#944927" :italic true)
  (tree.open :fg "#2c363c" :bold true)
  (tree.cursor :bg "#c4b6af")
  (divider :fg "#a4968f" :bg "#e9e4e2")
  (status :fg "#2c363c" :bg "#ddd6d3")
  (status.file :fg "#2c363c" :bold true)
  (status.info :fg "#2c363c")
  (status.end :fg "#564e4a" :bg "#cabfb9")
  (status.mode.normal :fg "#564e4a" :bg "#bbaba3" :bold true)
  (status.mode.insert :fg "#564e4a" :bg "#a9bed1" :bold true)
  (status.mode.command :fg "#564e4a" :bg "#deb9d6" :bold true)
  (status.mode.tree :fg "#564e4a" :bg "#ebd8da" :bold true)
  (status.mode.visual :fg "#564e4a" :bg "#cbd9e3" :bold true)
  (visual :bg "#cbd9e3")
  (search :fg "#2c363c" :bg "#deb9d6")
  (cmdline :fg "#2c363c" :bg "#f0edec")
  (error :fg "#a8334c" :bold true)
  (panel :fg "#2c363c" :bg "#ddd6d3")
  (dialog :fg "#2c363c" :bg "#ddd6d3")
  (menu :fg "#2c363c" :bg "#dad3cf")
  (menu.selected :fg "#2c363c" :bg "#c4b6af")
  (menu.match :fg "#c074b2" :bold true)
  (menu.kind :fg "#948985")
  (menu.doc :fg "#2c363c" :bg "#ddd6d3")
  (menu.doc.title :fg "#2c363c" :bold true)
  (menu.border :fg "#786d68")
  (heading :fg "#2c363c" :bold true)
  (url :fg "#556570" :underline true)
  (list :fg "#8e817b")
  (code :fg "#556570" :italic true)
  (quote :fg "#948985" :italic true)
  (comment :fg "#948985" :italic true)
  (string :fg "#556570" :italic true)
  (keyword :fg "#2c363c" :bold true)
  (type :fg "#6a5549")
  (number :fg "#556570")
  (function :fg "#2c363c")
  (constant :fg "#556570" :italic true)
  (operator :fg "#2c363c")
  (punct :fg "#8e817b")
  (escape :fg "#4f5e68" :bold true)
  (error.text :fg "#a8334c"))

;; zenbones-dark: a contrast-based colorscheme, dark
