//! The zenbones themes (github.com/zenbones-theme/zenbones.nvim), from
//! its compiled Vim colorschemes and lualine themes: light and dark for
//! each variant (`zenbones-light`, `zenbones-dark`, ...), or the only one
//! some have (vimbones, nordbones, duckbones, zenburned, kanagawabones).
//! Mostly monochrome: keywords bold, strings and constants italic.
//! Light ones inherit paper, dark ones ink.

/// the themes, as configuration text (read after the defaults)
export let ZENBONES: string = """
;; zenbones-light: a contrast-based colorscheme, light
(theme "zenbones-light" :inherit "paper"
  (normal :fg "#2c363c" :bg "#f0edec")
  (cursor :bg "#2c363c")
  (gutter :fg "#a4968f")
  (gutter.current :fg "#2c363c" :bold true)
  (gutter.error :fg "#f0edec" :bg "#a8334c")
