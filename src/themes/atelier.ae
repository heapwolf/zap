// configuration text for all schemes, in order
fn all() -> string {
    var b: str::Builder = str::Builder {};

    for (let s: &SCHEMES::&string[] in &SCHEMES) {
        var colors: string[] = [];

        for (let k: i64 in 3..s.len) { colors.push(s[k]); }
        b.add("\n");
        b.add(scheme(s[0], s[1], s[2], &colors));
    }
    return b.to_string();
}

/// the themes, as configuration text (read after the defaults)
export let ATELIER: string = all();
