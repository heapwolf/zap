//! zap's themes: a theme is a set of named faces (`normal`, `tree.dir`,
//! `heading`, `status.mode.insert`, ...), each a style. A missing face falls
//! back by name: `tree.dir`, then `tree`, then `normal`. A theme can
//! `:inherit` another's faces and override some.
//!
//! ```ae,ignore
//! (theme "mine" :inherit "paper"
//!   (normal :fg "#202020" :bg "#fbfbf8")
//!   (heading :fg "#0b7285" :bold true))
//! (set theme "mine")
//! ```

import tui from "std/tui";
import str from "std/string";
import { Sx, SxKind } from "../sexp.ae";
import { GROUP_NAMES } from "../syntax.ae";

/// a named style
export struct Face {
    export name: string;
    export style: tui::Style;
}

/// a theme: name, faces, parent theme
export struct Theme {
    export name: string = "";
    export parent: string = "";
    export faces: Face[] = [];
}

/// the resolved faces used for drawing, computed once per theme
export struct Look {
    export normal: tui::Style;
    export gutter: tui::Style = tui::Style {};
    export gutter_current: tui::Style = tui::Style {};
    export gutter_error: tui::Style = tui::Style {};
    export git_add: tui::Style = tui::Style {};       // git signs (git.add, git.change,
    export git_change: tui::Style = tui::Style {};    //   git.delete; default: the theme's
    export git_delete: tui::Style = tui::Style {};    //   string, type, error colors)
    export tree: tui::Style = tui::Style {};
    export tree_root: tui::Style = tui::Style {};
    export tree_dir: tui::Style = tui::Style {};
    export tree_file: tui::Style = tui::Style {};
    export tree_special: tui::Style = tui::Style {};
    export tree_open: tui::Style = tui::Style {};
    export tree_cursor: tui::Style = tui::Style {};
    export divider: tui::Style = tui::Style {};
    export status: tui::Style = tui::Style {};
    export status_file: tui::Style = tui::Style {};
    export status_info: tui::Style = tui::Style {};
    export status_end: tui::Style = tui::Style {};
    export mode_normal: tui::Style = tui::Style {};
    export mode_insert: tui::Style = tui::Style {};
    export mode_command: tui::Style = tui::Style {};
    export mode_tree: tui::Style = tui::Style {};
    export mode_visual: tui::Style = tui::Style {};
    export visual: tui::Style = tui::Style {};      // selection (drawn over the text's colors)
    export menu: tui::Style = tui::Style {};        // command-line completions
    export menu_selected: tui::Style = tui::Style {};
    export menu_match: tui::Style = tui::Style {};  // over a row: the typed part of each word
    export menu_kind: tui::Style = tui::Style {};   // over a row: icons with no syntax color
    export menu_doc: tui::Style = tui::Style {};    // docs beside the menu
    export menu_doc_title: tui::Style = tui::Style {};
    export menu_border: tui::Style = tui::Style {};
    export search: tui::Style = tui::Style {};
    export cmdline: tui::Style = tui::Style {};
    export message: tui::Style = tui::Style {};
    export error: tui::Style = tui::Style {};
    export panel: tui::Style = tui::Style {};
    export dialog: tui::Style = tui::Style {};
    export sheet_head: tui::Style = tui::Style {};  // spreadsheet column letters and row numbers
    export sheet_head_current: tui::Style = tui::Style {};  // the cursor's column and row in those
    export sheet_cursor: tui::Style = tui::Style {};    // cursor cell
    export sheet_sel: tui::Style = tui::Style {};   // selected cells
    export sheet_header: tui::Style = tui::Style {};    // header row
    export sheet_bar: tui::Style = tui::Style {};   // formula bar: cell name and contents
    export cursor: string = "";          // terminal cursor color ("": terminal default)
    export syn: tui::Style[] = [];       // by syntax::Group
}

/// parse a color: "#rrggbb", "default" (terminal's), "none" (show what is
/// underneath), one of the 16 names ("red", "brightblue", ...), or a palette
/// index "0".."255"
export fn color(s: string) -> tui::Color? {
    let t: string = str::to_lower(str::trim(s));

    if (t.len == 7 && t[0] == '#') {
        let r: i64 = hex(&t, 1);
        let g: i64 = hex(&t, 3);
        let b: i64 = hex(&t, 5);

        if (r < 0 || g < 0 || b < 0) {
            return none;
        }
        return tui::rgb(r, g, b);
    }
    if (str::eq(t, "default")) {
        return tui::Color::Default;
    }
    if (str::eq(t, "none")) {
        return tui::Color::Reset;
    }
    let names: string[] = [
        "black", "red", "green", "yellow", "blue", "magenta", "cyan", "white", "brightblack",
        "brightred", "brightgreen", "brightyellow", "brightblue", "brightmagenta", "brightcyan",
        "brightwhite"
    ];

    for (let i: i64, let nm: string in &names) {
        if (str::eq(nm, t)) {
            return tui::ansi(i);
        }
    }
    match (str::parse_int(t)) {
        n => {
            if (n >= 0 && n <= 255) {
                return tui::ansi(n);
            }
        },
        e: str::BadInt => {}
    }
    return none;
}

fn hex_digit(c: u8) -> i64 {
    if (c >= '0' && c <= '9') {
        return (c as i64) - 48;
    }
    if (c >= 'a' && c <= 'f') {
        return (c as i64) - 87;
    }
    return -1;
}

// value of the two hex digits at s[i], or -1
fn hex(s: &string, i: i64) -> i64 {
    let a: i64 = hex_digit(s[i]);
    let b: i64 = hex_digit(s[i + 1]);

    if (a < 0 || b < 0) {
        return -1;
    }
    return a * 16 + b;
}

/// parse a face form, `(name :fg "#fff" :bg "#000" :bold true ...)`;
/// errors go to errs
export fn face(f: &Sx, mut errs: &string[]) -> Face {
    var s: tui::Style = tui::Style {};
    let n: i64 = f.items.len;
    var i: i64 = 1;

    while (i + 1 < n) {
        let k: string = f.items[i].text;
        let v: string = f.items[i + 1].text;
        let on: bool = str::eq(v, "true");

        if (str::eq(k, ":fg") || str::eq(k, ":bg")) {
            if (let c = color(v)) {
                if (str::eq(k, ":fg")) { s.fg = c; } else { s.bg = c; }
            } else {
                errs.push("line \(f.line): not a color: \(v)");
            }
        } else if (str::eq(k, ":bold")) { s.bold = on; }
        else if (str::eq(k, ":italic")) { s.italic = on; }
        else if (str::eq(k, ":underline")) { s.underline = on; }
        else if (str::eq(k, ":dim")) { s.dim = on; }
        else if (str::eq(k, ":reverse")) { s.reverse = on; }
        else if (str::eq(k, ":strike")) { s.strike = on; }
        else { errs.push("line \(f.line): a face has no \(k)"); }
        i += 2;
    }
    return Face { name: f.head(), style: s };
}

/// parse a theme form, `(theme "name" [:inherit "other"] faces...)`
export fn theme(f: &Sx, mut errs: &string[]) -> Theme {
    var t: Theme = Theme {};

    if (f.items.len > 1) { t.name = f.items[1].text; }
    let n: i64 = f.items.len;
    var i: i64 = 2;

    while (i < n) {
        let it: &f::&Sx = &f.items[i];

        if (it.is(":inherit") && i + 1 < n) {
            t.parent = f.items[i + 1].text;
            i += 2;
            continue;
        }
        if (it.kind == SxKind::List) {
            t.faces.push(face(it, errs));
        } else {
            errs.push("line \(it.line): a theme holds faces: (name :fg ...), not \(it.show())");
        }
        i += 1;
    }
    return t;
}

// face `face` of theme `name`, searching its parents (none if not found)
fn find_face(themes: &Theme[], name: string, face: string, depth: i64) -> tui::Style? {
    if (depth > 8) {
        return none;
    }
    var k: i64 = themes.len - 1;

    while (k >= 0) {
        let t: &themes::&Theme = &themes[k];

        k -= 1;
        if (!str::eq(t.name, name)) { continue; }
        var j: i64 = t.faces.len - 1;

        while (j >= 0) {
            if (str::eq(t.faces[j].name, face)) {
                return std::copy(t.faces[j].style);
            }
            j -= 1;
        }
        if (t.parent.len > 0) {
            return find_face(themes, t.parent, face, depth + 1);
        }
        return none;
    }
    return none;
}

/// the style of `face` in theme `name`, falling back by name (`a.b.c`,
/// `a.b`, `a`, `normal`)
export fn style(themes: &Theme[], name: string, face: string) -> tui::Style {
    var f: string = face;

    while (true) {
        if (let s = find_face(themes, name, f, 0)) {
            return s;
        }
        let dot: i64 = str::rfind(f, ".") ?? -1;

        if (dot < 0) { break; }
        f = str::substr(f, 0, dot);
    }
    if (let s = find_face(themes, name, "normal", 0)) {
        return s;
    }
    return tui::Style {};
}

// face merged over base (its unset parts come from base)
fn over(themes: &Theme[], name: string, face: string, base: &tui::Style) -> tui::Style {
    let s: tui::Style = style(themes, name, face);

    return tui::merge(base, &s);
}

/// the resolved Look of theme `name`
export fn look(themes: &Theme[], name: string) -> Look {
    let normal: tui::Style = style(themes, name, "normal");
    var l: Look = Look { normal: std::copy(normal) };

    l.gutter = over(themes, name, "gutter", &normal);
    l.gutter_current = over(themes, name, "gutter.current", &l.gutter);
    l.gutter_error = over(themes, name, "gutter.error", &l.gutter);
    l.tree = over(themes, name, "tree", &normal);
    l.tree_root = over(themes, name, "tree.root", &l.tree);
    l.tree_dir = over(themes, name, "tree.dir", &l.tree);
    l.tree_file = over(themes, name, "tree.file", &l.tree);
    l.tree_special = over(themes, name, "tree.special", &l.tree);
    l.tree_open = over(themes, name, "tree.open", &l.tree);
    l.tree_cursor = over(themes, name, "tree.cursor", &l.tree);
    l.divider = over(themes, name, "divider", &l.tree);
    l.status = over(themes, name, "status", &normal);
    l.status_file = over(themes, name, "status.file", &l.status);
    l.status_info = over(themes, name, "status.info", &l.status);
    l.status_end = over(themes, name, "status.end", &l.status);
    l.mode_normal = over(themes, name, "status.mode.normal", &l.status);
    l.mode_insert = over(themes, name, "status.mode.insert", &l.mode_normal);
    l.mode_command = over(themes, name, "status.mode.command", &l.mode_normal);
    l.mode_tree = over(themes, name, "status.mode.tree", &l.mode_normal);
    l.mode_visual = over(themes, name, "status.mode.visual", &l.mode_normal);
    l.visual = style(themes, name, "visual");
    l.search = over(themes, name, "search", &normal);
    l.panel = over(themes, name, "panel", &normal);
    l.menu = over(themes, name, "menu", &l.panel);
    l.menu_selected = over(themes, name, "menu.selected", &l.search);
    l.menu_match = own(themes, name, "menu.match");
    l.menu_kind = own(themes, name, "menu.kind");
    l.menu_doc = over(themes, name, "menu.doc", &l.menu);
    l.menu_doc_title = own(themes, name, "menu.doc.title");
    l.menu_border = own(themes, name, "menu.border");
    l.cmdline = over(themes, name, "cmdline", &normal);
    l.message = over(themes, name, "message", &l.cmdline);
    l.error = over(themes, name, "error", &l.cmdline);
    l.dialog = over(themes, name, "dialog", &normal);
    // (sheet faces a theme omits default to similar faces, not to the name
    // fallback, which would give normal)
    l.sheet_head = tui::merge(&l.status, &own(themes, name, "sheet.head"));
    l.sheet_head_current = tui::merge(&l.mode_normal, &own(themes, name, "sheet.head.current"));
    var cur: tui::Style = tui::merge(&normal, &l.search);

    cur.bold = true;
    l.sheet_cursor = tui::merge(&cur, &own(themes, name, "sheet.cursor"));
    l.sheet_sel = tui::merge(
        &tui::merge(&normal, &l.visual), &own(themes, name, "sheet.selection")
    );
    var bold: tui::Style = std::copy(normal);

    bold.bold = true;
    l.sheet_header = tui::merge(&bold, &own(themes, name, "sheet.header"));
    // (the bar uses the grid's background)
    l.sheet_bar = tui::merge(&normal, &own(themes, name, "sheet.bar"));
    l.cursor = "";
    if (let c = cursor_color(themes, name)) { l.cursor = c; }
    l.git_add = sign(themes, name, "git.add", "string", &l.gutter);
    l.git_change = sign(themes, name, "git.change", "type", &l.gutter);
    l.git_delete = sign(themes, name, "git.delete", "error.text", &l.gutter);

    for (let g: string in &GROUP_NAMES) {
        // (the error group uses error.text; "error" is the command line's)
        var face: string = g;

        if (str::eq(g, "error")) { face = "error.text"; }
        // groups merge over normal; an omitted one is plain normal (no name fallback)
        if (let s = find_face(themes, name, face, 0)) {
            l.syn.push(tui::merge(&normal, &s));
        } else {
            l.syn.push(std::copy(normal));
        }
    }
    return l;
}

// a git sign's face over the gutter; if the theme lacks it, take the fg of
// syntax face `like` (so themes without git faces still get three colors)
fn sign(
    themes: &Theme[], name: string, face: string, like: string, gutter: &tui::Style
) -> tui::Style {
    var s: tui::Style = tui::merge(gutter, &own(themes, name, face));

    if (find_face(themes, name, face, 0) == none) {
        s.fg = std::copy(own(themes, name, like).fg);
    }
    s.bold = false;
    return s;
}

// face from the theme or its parents, with no name fallback (for faces
// drawn over others: only the colors they set apply)
fn own(themes: &Theme[], name: string, face: string) -> tui::Style {
    if (let s = find_face(themes, name, face, 0)) {
        return s;
    }
    return tui::Style {};
}

// the cursor face's background as "#rrggbb", for the terminal cursor
// (as with any face, a later definition of the theme wins)
fn cursor_color(themes: &Theme[], name: string) -> string? {
    if (let s = find_face(themes, name, "cursor", 0)) {
        if (let tui::Color::Rgb { r, g, b } = s.bg) {
            return "#\(hex2(r))\(hex2(g))\(hex2(b))";
        }
    }
    return none;
}

fn hex2(n: i64) -> string {
    let digits: string = "0123456789abcdef";

    return "\(str::substr(digits, (n / 16) % 16, 1))\(str::substr(digits, n % 16, 1))";
}
