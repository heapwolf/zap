//! zap's other built-in themes (paper and ink are in base.ae, with the
//! defaults): three soft, three high-contrast, two monochrome, light and
//! dark, each inheriting paper or ink with its own colors.

/// the themes, as configuration text (read after the defaults)
export let MORE: string = """
;; ---- soft -----------------------------------------------------------------

