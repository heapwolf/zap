//! zap: a terminal editor in Aela, on std/tui. nvim-like: modes, a command
//! line, search, a file tree in a mouse-resizable split, buffers, themes,
//! and add-ins (s-expressions in ~/.config/zap/init.zap) that run the Aela
//! compiler's tools. Files are kept in chunks (the memline); only on-screen
//! lines are read and highlighted.
//!
//!   aec main.ae -o zap && ./zap [file...] [+line]

import tui from "std/tui";
import term from "std/term";
import path from "std/path";
import fs from "std/fs";
import str from "std/string";
import time from "std/time";
import cfgm from "config.ae";
import editor from "editor.ae";
import { App, Mode } from "editor.ae";
import view from "view.ae";
import process from "std/process";

// routes terminal events to the editor (the picker and mouse via std/tui)
fn on_event(mut ui: &tui::Ui(App), mut app: &App, e: tui::Event) -> void {
    let picking: bool = app.picking.len > 0;

    match (e) {
        tui::Event::Key { key } => {
            if (picking) {
                tui::handle(ui, app, &tui::Event::Key { key: std::copy(key) });
            } else {
                app.key(&key);
            }
        },
        tui::Event::Paste { text } => {
            if (picking) {
                tui::handle(ui, app, &tui::Event::Paste { text: text });
            } else {
                app.paste(text);
            }
        },
        tui::Event::Mouse { kind, button, x, y, ctrl, alt, shift } => {
            let wheel: bool = kind == term_up() || kind == term_down();
            let sideways: bool = kind == term::MouseKind::ScrollLeft ||
                kind == term::MouseKind::ScrollRight || (wheel && shift);

            if (sideways && !picking) {
                // (sideways wheel, or Shift+wheel: Shift+up is left)
                var dir: i64 = 2;

                if (kind == term::MouseKind::ScrollLeft || kind == term_up()) { dir = -2; }
                let d: i64 = app.wheel_amount(dir, 4, time::since_epoch() / 1ms);

                if (d != 0) { app.hwheel(x, d); }
            } else if (wheel && !picking) {
                var dir: i64 = 1;

                if (kind == term_up()) { dir = -1; }
                let d: i64 = app.wheel_amount(dir, 3, time::since_epoch() / 1ms);

                if (d != 0) { app.wheel(x, d); }
            } else if (!picking && kind == term::MouseKind::Press && button == term::Button::Left &&
                app.in_text(x, y)) {
                app.mouse_press(x - app.edit_x, y, time::since_epoch() / 1ms);
            } else if (!picking && kind == term::MouseKind::Drag && app.dragging) {
                app.mouse_drag(x - app.edit_x, y);
            } else if (kind == term::MouseKind::Release && app.dragging) {
                app.mouse_release();
            } else {
                tui::handle(ui, app, &tui::Event::Mouse {
                    kind: kind, button: button, x: x, y: y, ctrl: ctrl, alt: alt, shift: shift
                });
            }
        },
        tui::Event::Resize { cols, rows } => {
            ui.resize(cols, rows);
            app.cols = cols;
            app.rows = rows;
        },
        tui::Event::End => { app.quit = true; },
        tui::Event::Tick => {}
    }
}

fn term_up() -> term::MouseKind { return term::MouseKind::ScrollUp; }

fn term_down() -> term::MouseKind { return term::MouseKind::ScrollDown; }

// sets the cursor shape for the mode: a bar while typing, else a block
fn shape(mut app: &App) -> void {
    var want: i64 = 2;

    if (app.mode == Mode::Insert || app.mode == Mode::Command || app.mode == Mode::Search) {
        want = 6;
    }
    if (want != app.shape) {
        if (app.shape < 0 && app.look.cursor.len > 0) { print("\x1b]12;\(app.look.cursor)\x07"); }
        print("\x1b[\(want) q");
        app.shape = want;
    }
}

async fn main(args: string[]) -> i32 {
    var cwd: string = process::env("PWD");

    if (cwd.len == 0) { cwd = "."; }
    cwd = path::clean(cwd);
    var files: string[] = [];
    var line: i64 = 0;
    var dir_given: bool = false;

    for (let i: i64 in 1..args.len) {
        let a: string = args[i];

        if (str::eq(a, "-h") || str::eq(a, "--help")) {
            println(
                "zap [file...] [+line]: an editor (:help inside; config: \(cfgm::config_path()))"
            );
            return 0;
        }
        if (str::starts_with(a, "+")) {
            match (str::parse_int(str::substr(a, 1, a.len - 1))) {
                n => { line = n; },
                e: str::BadInt => {}
            }
            continue;
        }
        var p: string = a;

        // (on AeOS, @NAME/... is another program's space, like /@NAME/...)
        if (str::starts_with(p, "@")) { p = "/\(p)"; }
        if (!path::is_absolute(p)) { p = path::join(cwd, p); }
        match (await fs::info(p)) {
            inf => {
                if (inf.kind == fs::Kind::Dir) {
                    cwd = path::clean(p);
                    dir_given = true;
                    continue;
                }
            },
            e: fs::NotFound => {}, e2: fs::PermissionDenied => {}, e3: fs::IoError => {}
        }
        files.push(p);
    }
    // a file outside cwd (and no directory given): root the tree at its directory
    // (zap /@aec/hello.ae shows aec's files, not the start directory)
    if (!dir_given && files.len > 0 && !path::is_within(cwd, files[0])) {
        let d: string = path::dir(files[0]);

        if (d.len > 0) { cwd = path::clean(d); }
    }
    let cfg: cfgm::Config = cfgm::load(cwd);
    var app: App = editor::app(cfg, cwd);

    // (over ssh the system clipboard is the remote host's: OSC 52 only)
    app.native_clip = process::env("SSH_TTY").len == 0 && process::env("SSH_CONNECTION").len == 0;
    app.recall_cmd_history();
    app.splash = files.len == 0;

    for (let f: string in &files) { app.edit(f); }
    if (line > 0) { app.ex("\(line)"); }
    if (app.cfg.untrusted.len > 0) {
        app.fail_msg("\(app.cfg.untrusted) is not trusted, so not read (:trust reads it)");
    }
    var ui = match (tui::open(view::view)) {
        u => u,
        e: tui::NotATerminal => {
            eprintln("zap: standard input is not a terminal");
            return 1;
        }
    };

    app.cols = ui.cols;
    app.rows = ui.rows;

    while (!app.quit) {
        app.prepare();
        tui::frame(mut &ui, mut &app);
        shape(mut &app);

        // send to the terminal's clipboard (OSC 52)
        for (let c: string in &app.clips) { print(c); }
        app.clips.clear();
        if (app.busy() && app.has_work()) {
            select {
                let e = await ui.event() => { on_event(mut &ui, mut &app, e); },
                let r = await editor::job_read(mut &app.jobs[0]) => { app.job_output(r); },

                await std::sleep(0ms) => { app.background(); },
            }
        } else if (app.busy()) {
            select {
                let e = await ui.event() => { on_event(mut &ui, mut &app, e); },
                let r = await editor::job_read(mut &app.jobs[0]) => { app.job_output(r); },

                await std::sleep(100ms) => {},
            }
        } else if (app.has_work()) {
            select {
                let e = await ui.event() => { on_event(mut &ui, mut &app, e); },

                await std::sleep(0ms) => { app.background(); },
            }
        } else if (app.polling()) {
            // (git replying, or signs due once typing pauses: check again soon)
            select {
                let e = await ui.event() => { on_event(mut &ui, mut &app, e); },

                await std::sleep(20ms) => {},
            }
        } else if (app.msg_wait() >= 0) {
            // (a message is showing: redraw when it expires)
            let wait: i64 = app.msg_wait();

            select {
                let e = await ui.event() => { on_event(mut &ui, mut &app, e); },

                await std::sleep(wait * 1ms) => {},
            }
        } else {
            let e: tui::Event = await ui.event();

            on_event(mut &ui, mut &app, e);
        }
    }
    ui.close();
    print("\x1b[0 q\x1b]112\x07");
    return 0;
}
