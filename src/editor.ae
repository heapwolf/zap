//! zap's editor: its state (buffers, tree, modes, command line, running
//! command) and what keys and commands do to it. Screen: view.ae; loop:
//! main.ae.
//!
//! Modes, as in vi: Normal (commands, counts, operators, motions), Insert,
//! Command (`:`), Search (`/`, `?`). The tree takes the keys when focused
//! (`<Tab>`, `<C-w>h`, `<leader>e`). Configured bindings are tried first; a
//! key that only starts a binding waits for the next.

import str from "std/string";
import fs from "std/fs";
import path from "std/path";
import process from "std/process";
import time from "std/time";
import enc from "std/encoding";
import tui from "std/tui";
import { Model } from "std/tui";
import {
    Config,
    Command,
    Keymap,
    FileType,
    OPTIONS,
    DEFAULTS,
    token,
    config_path
} from "config.ae";
import cfgm from "config.ae";
import { Look, Theme, look } from "themes/theme.ae";
import { Tree, Entry, tree } from "tree.ae";
import bufm from "buffer.ae";
import {
    Buf,
    Diag,
    Matcher,
    matcher,
    next_char,
    prev_char,
    col_of,
    byte_at,
    cell_width,
    wordy
} from "buffer.ae";
import { ChangedOnDisk, MemLine } from "memline.ae";
import { History, Change } from "undo.ae";
import symbols from "symbols.ae";
import { Index, Decl, Kind } from "symbols.ae";
import { Hl } from "syntax.ae";
import syntax from "syntax.ae";
import sheetm from "sheet.ae";
import { Sheet, SheetVis } from "sheet.ae";
import mermaid from "mermaid.ae";
import { Canvas } from "mermaid.ae";
import state from "state.ae";
import git from "git.ae";

/// what the keys do
export enum Mode { Normal, Insert, Command, Search, Visual }

/// an editor window line, ready to paint: number (0: past the end), text,
/// highlights, search matches, whether a tool flagged it, whether the cursor is on it
export struct VisLine {
    export no: i64;
    export text: string = "";
    export hls: Hl[] = [];
    export matches: i64[] = [];
    export diag: bool = false;
    export current: bool = false;
    export sel_lo: i64 = -1;        // selection's screen columns (-1: none; hi exclusive)
    export sel_hi: i64 = 0;
    export sign: i64 = 0;           // git sign (git.ae)
}

// a pending git request for a buffer's committed text; the answer goes to out
struct GitAsk {
    id: i64;
    out: string;
    child: process::Child[] = [];
}

/// a completion: word, kind (Text: a buffer's word), and its declaration in
/// the index (-1: none)
export struct CompItem {
    export word: string;
    export kind: Kind;
    export exported: bool = false;
    export owner: string = "";
    export decl: i64 = -1;
}

/// a tree window row, ready to paint
export struct VisRow {
    export name: string;
    export depth: i64;
    export kind: i64;               // 0 root, 1 directory, 2 file
    export special: bool;
    export open: bool;              // the current buffer's file
    export selected: bool;
    export matches: i64[];
}

/// a location a tool printed: file, line, column (1-based), message
export struct Loc {
    export file: string;
    export line: i64;
    export col: i64;
    export message: string;
}

/// a background command: program, output so far
export struct Job {
    export name: string;
    export cmd: Command;
    export file: string;            // file it ran on
    export out: str::Builder = str::Builder {};
    export started: time::Instant;
    child: process::Child[] = [];
}

/// result of one wait on a job
export struct JobRead {
    export data: string = "";
    export done: bool = false;
    export code: i64 = 0;
}

/// the editor
export struct App {
    export cfg: Config;
    export look: Look;
    export cwd: string;
    // current buffer
    export b: Buf = Buf { id: 0, name: "", text: MemLine {}, ft: cfgm::FileType { name: "" } };
    export others: Buf[] = [];           // the rest, by id
    export alt: i64 = -1;
    export next_id: i64 = 1;
    export tree: Tree;
    export split: tui::SplitState;
    export focus_tree: bool = false;
    export mode: Mode = Mode::Normal;
    export pending: string[] = [];
    export cmd: tui::TextInput;
    export cmd_kind: string = "";        // ":", "/" or "?"
    export last_search: string = "";
    export search_fwd: bool = true;
    export hl: bool = false;                // last search's matches shown
    export matcher: Matcher = Matcher {};
    export msg: string = "";
    export msg_error: bool = false;
    export msg_until: i64 = 0;          // when it goes (ms since epoch; 0: at the next message)
    export panel: string[] = [];
    export panel_title: string = "";
    export reg: string = "";
    export reg_lines: bool = false;
    export last_find: string = "";       // last f/t/F/T and its character (; and , repeat it)
    export cols: i64 = 80;
    export rows: i64 = 24;
    export edit_h: i64 = 20;
    export edit_w: i64 = 60;
    export gutter: i64 = 0;
    export tree_h: i64 = 20;
    export vis: VisLine[] = [];
    export tree_vis: VisRow[] = [];
    export want_states: i64 = -1;   // line the background highlighter must reach
    export jobs: Job[] = [];             // running command (one at a time)
    export queue: string[] = [];         // commands queued behind it
    export locs: Loc[] = [];
    export loc_at: i64 = -1;
    export picker: tui::PickerState;
    export picking: string = "";         // "": no picker; "palette"
    export pick_items: string[] = [];
    export pick_values: string[] = [];
    export cat: i64 = 0;                // palette category (CATEGORIES)
    export shell_off: bool = false;      // no shell, as on AeOS (tests)
    export prev_cwd: string = "";        // directory before the last :cd (for :cd -)
    export files: string[] = [];         // project files (listed in background: walk_step)
    file_names: string[] = [];          // each as the palette shows it (short_name)
    files_root: string = "";            // directory files is of ("": not listed yet)
    files_hidden: bool = false;         // and whether it has hidden files
    export walking: bool = false;       // project listing in progress
    walk_live: bool = false;            // listing straight into files (first listing)
    walk_dirs: string[] = [];           // directories the walk is in, outermost first
    walk_names: string[][] = [];        // entries of each
    walk_next: i64[] = [];              // next entry of each
    walk_out: string[] = [];            // what a relisting found (becomes files when done)
    pick_gen: i64 = 0;                  // pick_items replaced (not just grown)
    export shown: string[] = [];         // what the picker shows: best matches, at most SHOWN_MAX
    shown_at: i64[] = [];               // index of each in pick_items
    match_at: i64[] = [];               // every item the query matches, in order
    match_score: i64[] = [];
    match_query: string = "";
    match_upto: i64 = 0;                // items checked so far
    match_gen: i64 = -1;                // pick_gen when matched
    export grep_query: string = "";      // project search query ("": none)
    export grep_at: i64 = 0;            // next file it reads
    export symbols: string[] = [];       // aec outline's declarations (shown, then where)
    export symbol_at: string[] = [];
    export symbols_asked: bool = false;
    export quit: bool = false;
    export shape: i64 = -1;         // cursor shape last set
    export splash: bool = false;            // started with no file: intro shows (until an edit)
    export vkind: i64 = 0;              // visual selection: 1 characters, 2 lines, 3 block
    export vy: i64 = 0;                 // its other end (the cursor is one end)
    export vx: i64 = 0;
    export gv: i64[] = [];               // last selection: kind, vy, vx, cy, cx (gv, '< '>)
    export blk: i64[] = [];              // block insert: y1, y2, column, start byte, pad (Esc fills
                                         //   the rest)
    export dragging: bool = false;          // mouse is selecting
    export clicks: i64 = 0;             // 1, 2 (word), 3 (line): presses close together
    export click_ms: i64 = 0;
    export click_y: i64 = 0;
    export press_y: i64 = 0;
    export press_x: i64 = 0;
    export edit_x: i64 = 0;             // editor window's first screen column
    export clips: string[] = [];         // text to send to the terminal's clipboard (OSC 52)
    export native_clip: bool = false;       // also yank to the system clipboard (pbcopy, wl-copy,
                                            //   xclip)
    gits: GitAsk[] = [];                // git requests, for signs (one per buffer)
    copiers: process::Child[] = [];      // running clipboard programs, to reap
    export persist: bool = false;           // keep history on disk (undo files, command-line
                                            //   history)
    export hist_cmd: string[] = [];      // command-line history (:)
    export hist_search: string[] = [];   // search history (/ ?)
    export wild: string[] = [];          // command-line completions (Tab cycles them)
    export wild_at: i64 = 0;            // the one now in the command line
    export wild_head: string = "";       // text before the word they complete
    export wild_text: string = "";       // command line as Tab left it (else: new completions)
    export comp: CompItem[] = [];        // insert-mode completions of the typed word
    export comp_at: i64 = 0;            // chosen one (Enter inserts it)
    export comp_doc: string[] = [];      // its doc comment (read from its file)
    export index: Index = Index {};            // aec outline's declarations (completion, palette)
    export index_stale: bool = true;    // needs rereading (a file was written)
    export index_quiet: bool = false;       // read for completion: no message when done
    export comp_prefix: string = "";     // what was typed
    export comp_y: i64 = 0;             // where the word starts
    export comp_x: i64 = 0;
    export sheet_vis: SheetVis = SheetVis {};     // spreadsheet window, ready to paint
    export cell_r: i64 = 0;             // cell the command line edits (cmd_kind "cell")
    export cell_c: i64 = 0;
    export sizing: i64 = -1;        // column an edge drag resizes (-1: none)
    export sheet_block: string[][] = []; // cells yanked from a selection (p puts them)
    sheet_drag: i64 = 0;                // what a drag selects: 1 cells, 2 rows, 3 columns
    export viewer: Viewer[] = [];        // mermaid diagram drawn in the text's place (empty: text
                                         //   shows)
    wheel_dir: i64 = 0;                 // last wheel turn: direction (-1, 1; 2 or -2 sideways),
    wheel_ms: i64 = 0;                  // time, speed (hundredths; 100 slowest),
    wheel_speed: i64 = 0;               // and leftover fraction of a cell
    wheel_rest: i64 = 0;
    hl_id: i64 = -1;                    // highlight cache: buffer,
    hl_gen: i64 = -1;                   // text generation, syntax,
    hl_lang: string = "";
    hl_from: i64 = -1;                  // first line (-1: empty)
    hl_rows: Hl[][] = [];               // each line's highlights
    hl_after: i64[] = [];               // and the state after each
    hold_key: string = "";              // last sideways key pressed (keyaccel),
    hold_ms: i64 = 0;                   // time, repeats in a row,
    hold_n: i64 = 0;                    // and leftover fraction of a step
    hold_rest: i64 = 0;
    export key_ms: i64 = -1;            // (tests: a key's time in ms; -1: the clock's)
    sheet_rest: i64 = 0;                // sheet's leftover sideways cells, short of a column
    seen_cy: i64 = -1;              // cursor position when the view last followed it
    seen_cx: i64 = -1;              // (a sideways wheel moves the view, not the cursor)
    seen_id: i64 = -1;
    export diagram_vis: DiagramVis = DiagramVis {}; // diagram window, ready to paint
    sizing_x: i64 = 0;                  // drag start, and the column's width then
    sizing_w: i64 = 0;
}

/// a mermaid diagram drawn in place of the text: source, zoom, window position
export struct Viewer {
    export line: i64;               // a line of its source (Markdown block's; .mmd file: 0)
    export id: i64;                 // buffer id
    export zoom: i64 = 0;
    export px: i64 = 0;                 // window's top left on the canvas
    export py: i64 = 0;
    export canvas: Canvas = Canvas {};
    export src: string = "";             // source it was drawn from, at zoom drawn,
    src_gen: i64 = -1;                  // read from the buffer at this gen
    export drawn: i64 = -100;
    export centered: bool;          // center once drawn
    export press_x: i64 = 0;            // a drag: start, and window position then
    export press_y: i64 = 0;
    export press_px: i64 = 0;
    export press_py: i64 = 0;
}

/// diagram window, ready to paint: bar, and each row's runs of text by kind
export struct DiagramVis {
    export bar: string = "";
    export texts: string[][] = [];
    export kinds: i64[][] = [];
}

/// zap's version (from index.json)
export let VERSION: string = "0.1.0";

let MODE_NAMES: string[] = ["NORMAL", "INSERT", "COMMAND", "SEARCH", "VISUAL"];

/// palette categories, in Tab order
export let CATEGORIES: string[] = ["Files", "Grep", "Symbols", "Buffers", "Commands", "Themes"];

/// ex commands by long name (what Tab completes; ex() also takes short
/// names); keep in sync with ex()'s match
export let EX_NAMES: string[] = [
    "write", "wall", "wq", "wqa", "xit", "quit", "qall", "edit", "enew", "buffers", "buffer",
    "bnext", "bprevious", "bdelete", "set", "nohlsearch", "substitute", "earlier", "later",
    "undolist", "theme", "themes", "sheet", "mermaid", "tree", "focus", "reload", "trust",
    "defaults", "config", "cnext", "cprevious", "clist", "find", "palette", "grep", "commands",
    "cd", "pwd", "help", "messages", "addins", "stop"
];

// history entries kept on disk, per history
let HISTORY_MAX: i64 = 5000;

/// command-line history file
export fn history_path() -> string {
    return state::dir("history");
}

// max project search results
let GREP_MAX: i64 = 2000;

// message and error display time (ms)
let MSG_MS: i64 = 3000;
let ERROR_MS: i64 = 5000;

// max speed-up of held h and l, in multiples (keyaccel)
let KEY_ACCEL_MAX: i64 = 3;

// max matches the palette shows (filtering narrows them)
let SHOWN_MAX: i64 = 500;

// max files the palette lists, and max depth
let WALK_MAX: i64 = 20000;
let WALK_DEPTH: i64 = 24;

/// new editor in directory cwd, configured by cfg
export fn app(cfg: Config, cwd: string) -> App {
    let lk: Look = look(&cfg.themes, cfg.theme);
    let tw: i64 = cfg.tree_width;
    let hidden: bool = cfg.tree_hidden;
    let shown: bool = cfg.tree;
    var a: App = App {
        cfg: cfg, look: lk, cwd: cwd, tree: tree(cwd, hidden), split: tui::split("tree", tw),
        cmd: tui::input("cmd"), picker: tui::picker("pick")
    };

    a.matcher = matcher("", false, true, true);
    a.b = bufm::scratch(1, "", "");
    a.b.scratch = false;
    a.next_id = 2;
    if (!shown) { a.split.at = 0; }

    for (let e: string in &a.cfg.errors) { a.panel.push(e); }
    if (a.panel.len > 0) { a.panel_title = "configuration errors"; }

    return a;
}

impl App as Model {
    fn update(mut self: &App, a: &tui::Action) -> void {
        self.split.update(a);
        self.picker.update(a);
        if (self.picking.len > 0 && self.cat == 1 &&
            !str::eq(self.picker.text(), self.grep_query)) {
            self.start_grep();
        }
        if (a.kind == tui::Kind::Resize) {
            self.cols = a.x;
            self.rows = a.y;
        }
        if (a.kind == tui::Kind::End) { self.quit = true; }
    }

    fn done(self: &App) -> bool { return self.quit; }
}

// ---- small helpers ------------------------------------------------------------------

// count at toks[i..] (0: none; a leading 0 is a motion) -> count, index
// of the next token
fn read_count(toks: &string[], i0: i64) -> (i64, i64) {
    var i: i64 = i0;
    var count: i64 = 0;

    while (i < toks.len && is_digit_tok(&toks[i]) && !(count == 0 && str::eq(toks[i], "0"))) {
        count = count * 10 + ((toks[i][0] as i64) - 48);
        i += 1;
    }
    return (count, i);
}

fn is_digit_tok(t: &string) -> bool { return t.len == 1 && t[0] >= '0' && t[0] <= '9'; }

fn first_non_blank(s: &string) -> i64 {
    var i: i64 = 0;

    while (i < s.len && (s[i] == ' ' || s[i] == '\t')) { i += 1; }
    return i;
}

fn indent_of(s: &string) -> string { return str::substr(*s, 0, first_non_blank(s)); }

// does w start with prefix (fold: ignore case)?
fn starts_like(w: &string, prefix: &string, fold: bool) -> bool {
    if (w.len <= prefix.len) {
        return prefix.len == 0 && w.len > 0;
    }
    if (fold) {
        return str::starts_with(str::to_lower(*w), str::to_lower(*prefix));
    }
    return str::starts_with(*w, *prefix);
}

// is word w among completions xs?
fn has_item(xs: &CompItem[], w: &string) -> bool {
    for (let it: &xs::&CompItem in xs) {
        if (str::eq(it.word, *w)) {
            return true;
        }
    }
    return false;
}

// sorts xs by word
fn sort_items(mut xs: &CompItem[]) -> void {
    let n: i64 = xs.len;

    for (let i: i64 in 1..n) {
        var j: i64 = i;

        while (j > 0 && str::cmp(xs[j].word, xs[j - 1].word) < 0) {
            let t: CompItem = std::copy(xs[j]);

            xs[j] = std::copy(xs[j - 1]);
            xs[j - 1] = t;
            j -= 1;
        }
    }
}

// max completions, and how many lines from the cursor to search
let COMP_MAX: i64 = 60;
let COMP_LINES: i64 = 1500;

// words of line l starting with prefix (low: lowercased; fold: ignore
// case), not yet in out, added to it (skip: byte of the word being typed)
fn words_in(
    l: &string, prefix: &string, low: &string, fold: bool, skip: i64, mut out: &string[]
) -> void {
    let n: i64 = l.len;
    let pn: i64 = prefix.len;
    var i: i64 = 0;

    while (i < n && out.len < COMP_MAX) {
        if (!wordy(l[i])) {
            i += 1;
            continue;
        }
        var e: i64 = i;

        while (e < n && wordy(l[e])) { e += 1; }
        if (e - i > pn && i != skip && !(l[i] >= '0' && l[i] <= '9')) {
            let w: string = str::substr(*l, i, e - i);
            var hit: bool = false;

            if (fold) {
                hit = str::starts_with(str::to_lower(w), *low);
            } else {
                hit = str::starts_with(w, *prefix);
            }
            if (hit) {
                var seen: bool = false;

                for (let o: string in out) {
                    if (str::eq(o, w)) {
                        seen = true;
                        break;
                    }
                }
                if (!seen) { out.push(w); }
            }
        }
        i = e;
    }
}

// sorts xs (insertion sort: completions are few)
fn sort_strings(mut xs: &string[]) -> void {
    let n: i64 = xs.len;

    for (let i: i64 in 1..n) {
        var j: i64 = i;

        while (j > 0 && str::cmp(xs[j], xs[j - 1]) < 0) {
            let a: string = xs[j];

            xs[j] = xs[j - 1];
            xs[j - 1] = a;
            j -= 1;
        }
    }
}

// "secs seconds ago", roughly
fn ago(secs: i64) -> string {
    if (secs < 0) {
        return "just now";
    }
    if (secs < 60) {
        return "\(secs) seconds ago";
    }
    if (secs < 3600) {
        return "\(secs / 60) minutes ago";
    }
    if (secs < 86400) {
        return "\(secs / 3600) hours ago";
    }
    return "\(secs / 86400) days ago";
}

// 0 space, 1 word char, 2 punctuation (big: any non-space is 1)
fn class(b: u8, big: bool) -> i64 {
    if (b == ' ' || b == '\t') {
        return 0;
    }
    if (big || wordy(b)) {
        return 1;
    }
    return 2;
}

/// display name of path p (relative to cwd when inside it)
export fn short_name(cwd: string, p: string) -> string {
    if (path::is_within(cwd, p) && !str::eq(path::clean(cwd), path::clean(p))) {
        match (path::rel(cwd, p)) {
            r => { return r; },
            e: path::BadPath => {}
        }
    }
    return p;
}

/// a buffer, as lists show it
export struct BufInfo {
    export id: i64;
    export name: string;
    export path: string;
    export modified: bool;
    export scratch: bool;
    export line: i64;
}

fn info_of(b: &Buf) -> BufInfo {
    var nm: string = b.name;

    if (nm.len == 0) { nm = "[No Name]"; }
    return BufInfo {
        id: b.id, name: nm, path: b.path, modified: b.modified, scratch: b.scratch, line: b.cy + 1
    };
}

// a motion's result: target, and how an operator takes text to it
struct Motion {
    state: i64;             // 0 needs more keys, 1 done, 2 not a motion
    y: i64 = 0;
    x: i64 = 0;
    linewise: bool = false;
    inclusive: bool = false;
    used: i64 = 0;              // tokens used
}

impl App {
    // ---- buffers -------------------------------------------------------------------

    /// shows a message on the command line
    export fn say(mut self: &App, m: string) -> void {
        self.msg = m;
        self.msg_error = false;
        self.msg_until = time::since_epoch() / 1ms + MSG_MS;
    }

    /// shows an error, like say (a little longer)
    export fn fail_msg(mut self: &App, m: string) -> void {
        self.msg = m;
        self.msg_error = true;
        self.msg_until = time::since_epoch() / 1ms + ERROR_MS;
    }

    /// does the message show in the status line, in the file name's place?
    /// (no command-line row: it comes and goes without moving the status line)
    export fn msg_in_status(self: &App) -> bool { return self.cfg.cmdheight == 0; }

    /// ms until the message goes (-1: no message to wait for)
    export fn msg_wait(self: &App) -> i64 {
        if (self.msg.len == 0 || self.msg_until == 0) {
            return -1;
        }
        let left: i64 = self.msg_until - time::since_epoch() / 1ms;

        if (left < 0) {
            return 0;
        }
        return left;
    }

    /// makes file p's buffer current (opening it if needed) -> did it open?
    export fn edit(mut self: &App, p0: string) -> bool {
        var p: string = p0;

        if (p.len == 0) {
            return false;
        }
        if (!path::is_absolute(p)) { p = path::join(self.cwd, p); }
        p = path::clean(p);
        if (str::eq(self.b.path, p)) {
            self.switch_id(self.b.id);
            return true;
        }
        var found: i64 = -1;

        for (let o: &self::&Buf in &self.others) {
            if (str::eq(o.path, p)) { found = o.id; }
        }
        if (found >= 0) {
            self.switch_id(found);
            return true;
        }
        let ft: FileType = self.cfg.filetype(p);

        match (bufm::open(self.next_id, p, short_name(self.cwd, p), ft)) {
            b0 => {
                var b: Buf = b0;

                b.text.resident = self.cfg.resident;
                if (self.cfg.sheets &&
                    (str::eq(b.ft.syntax, "csv") || str::eq(b.ft.syntax, "tsv"))) {
                    b.sheet.push(Sheet {});
                }
                if (self.persist && self.cfg.undofile) { b.recall_history(); }
                if (b.ft.tabstop == 0) { b.tabstop = self.cfg.tabstop; }
                self.next_id += 1;
                let lines: i64 = b.text.count;
                let id: i64 = b.id;

                self.others.push(b);
                self.switch_id(id);
                // the empty start buffer goes once a file opens
                self.drop_empty_start();
                var info: string = "\"\(short_name(self.cwd, p))\" \(lines)L";

                if (!self.file_exists(p)) { info = "\"\(short_name(self.cwd, p))\" [New]"; }
                self.say(info);
                self.hooks("open", p);
                self.reveal();
                return true;
            },
            e: fs::PermissionDenied => { self.fail_msg("\(p): permission denied"); },
            e2: fs::IsADirectory => { self.fail_msg("\(p) is a directory"); },
            e3: fs::IoError => { self.fail_msg("\(p): cannot be read"); }
        }
        return false;
    }

    fn file_exists(self: &App, p: string) -> bool {
        match (fs::info(p)) {
            i => { return true; },
            e: fs::NotFound => { return false; }, e2: fs::PermissionDenied => { return true; },
            e3: fs::IoError => { return true; }
        }
        return false;
    }

    // index in others of the buffer with id (-1: none)
    fn find_other(self: &App, id: i64) -> i64 {
        for (let i: i64, let o: &self::&Buf in &self.others) {
            if (o.id == id) {
                return i;
            }
        }
        return -1;
    }

    /// buffer ids, in order
    export fn ids(self: &App) -> i64[] {
        var out: i64[] = [];
        var placed: bool = false;

        for (let o: &self::&Buf in &self.others) {
            if (!placed && self.b.id < o.id) {
                out.push(self.b.id);
                placed = true;
            }
            out.push(o.id);
        }
        if (!placed) { out.push(self.b.id); }
        return out;
    }

    /// buffer infos, by id
    export fn infos(self: &App) -> BufInfo[] {
        var out: BufInfo[] = [];

        for (let id: i64 in self.ids()) {
            if (id == self.b.id) {
                out.push(info_of(&self.b));
            } else {
                let at: i64 = self.find_other(id);

                out.push(info_of(&self.others[at]));
            }
        }
        return out;
    }

    // drops the unnamed empty start buffer once there is another
    fn drop_empty_start(mut self: &App) -> void {
        var gone: i64 = -1;

        for (let o: &self::&Buf in &self.others) {
            if (o.path.len == 0 && !o.scratch && !o.modified && o.text.count == 1 && o.id == 1) {
                gone = o.id;
            }
        }
        if (gone >= 0) { self.close_id(gone); }
    }

    /// makes buffer id current -> does it exist?
    export fn switch_id(mut self: &App, id: i64) -> bool {
        self.mode = Mode::Normal;
        self.focus_tree = false;
        if (id == self.b.id) {
            self.git_fetch(false);
            return true;
        }
        let at: i64 = self.find_other(id);

        if (at < 0) {
            return false;
        }
        self.b.commit();
        let old: i64 = self.b.id;
        // others stay ordered by id: the old one goes back to its place
        var rest: Buf[] = [];
        var target: Buf[] = [];
        var placed: bool = false;

        for (let i: i64 in 0..self.others.len) {
            if (i == at) {
                target.push(std::take(mut &self.others[i]));
                continue;
            }
            if (!placed && old < self.others[i].id) {
                rest.push(std::take(mut &self.b));
                placed = true;
            }
            rest.push(std::take(mut &self.others[i]));
        }
        if (!placed) { rest.push(std::take(mut &self.b)); }
        self.others = rest;
        self.b = target.pop();
        self.alt = old;
        self.git_fetch(false);
        return true;
    }

    /// closes buffer id (another becomes current; an empty one if it was the
    /// last)
    export fn close_id(mut self: &App, id: i64) -> void {
        if (id == self.b.id) {
            self.b.text.close();
            var next_id: i64 = -1;

            if (self.alt >= 0 && self.find_other(self.alt) >= 0) { next_id = self.alt; }
            else if (self.others.len > 0) { next_id = self.others[self.others.len - 1].id; }
            if (next_id < 0) {
                self.b = bufm::scratch(self.next_id, "", "");
                self.b.scratch = false;
                self.next_id += 1;
                return;
            }
            let at: i64 = self.find_other(next_id);
            var rest: Buf[] = [];
            var target: Buf[] = [];

            for (let i: i64 in 0..self.others.len) {
                if (i == at) {
                    target.push(std::take(mut &self.others[i]));
                } else {
                    rest.push(std::take(mut &self.others[i]));
                }
            }
            self.others = rest;
            self.b = target.pop();
            self.alt = -1;
            return;
        }
        var rest: Buf[] = [];

        for (let i: i64 in 0..self.others.len) {
            if (self.others[i].id == id) {
                let o: &self::&Buf = mut &self.others[i];

                o.text.close();
            } else {
                rest.push(std::take(mut &self.others[i]));
            }
        }
        self.others = rest;
        if (self.alt == id) { self.alt = -1; }
    }

    /// makes a scratch buffer name with text current (replacing one of that name)
    export fn show_scratch(mut self: &App, name: string, text: string) -> void {
        if (self.b.scratch && str::eq(self.b.name, name)) {
            let id: i64 = self.b.id;

            self.b = bufm::scratch(id, name, text);
            return;
        }
        var have: i64 = -1;

        for (let i: i64, let o: &self::&Buf in &self.others) {
            if (o.scratch && str::eq(o.name, name)) { have = i; }
        }
        if (have >= 0) {
            let id: i64 = self.others[have].id;

            self.others[have] = bufm::scratch(id, name, text);
            self.switch_id(id);
            return;
        }
        let id: i64 = self.next_id;

        self.others.push(bufm::scratch(id, name, text));
        self.next_id += 1;
        self.switch_id(id);
    }

    // selects the current buffer's file in the tree
    fn reveal(mut self: &App) -> void {
        let p: string = self.b.path;

        if (p.len == 0) {
            return;
        }
        let i: i64 = self.tree.reveal(p);

        if (i >= 0) { self.tree.select(i, self.tree_h); }
    }

    // ---- the cursor and the view -----------------------------------------------------

    /// keeps the cursor inside the buffer and (normal mode) on a character
    fn fix_cursor(mut self: &App) -> void {
        self.b.clamp();
        if (self.mode != Mode::Insert) {
            let l: string = self.b.text.get(self.b.cy);

            if (self.b.cx >= l.len && l.len > 0) { self.b.cx = prev_char(&l, l.len); }
        }
    }

    // moves the cursor to line y, byte x (set_want: the wanted column follows)
    fn go(mut self: &App, y: i64, x: i64, set_want: bool) -> void {
        self.b.cy = y;
        self.b.cx = x;
        self.b.clamp();
        if (set_want) {
            let l: string = self.b.text.get(self.b.cy);

            self.b.want = col_of(&l, self.b.cx, self.b.tabstop);
        }
        self.fix_cursor();
    }

    // moves the cursor to line y, at its wanted column
    fn go_line(mut self: &App, y: i64) -> void {
        var yy: i64 = y;

        if (yy >= self.b.text.count) { yy = self.b.text.count - 1; }
        if (yy < 0) { yy = 0; }
        self.b.cy = yy;
        let l: string = self.b.text.get(yy);

        self.b.cx = byte_at(&l, self.b.want, self.b.tabstop);
        self.fix_cursor();
    }

    /// scrolls so the cursor shows (scrolloff lines around it)
    export fn scroll(mut self: &App) -> void {
        let h: i64 = self.edit_h;
        var so: i64 = self.cfg.scrolloff;

        if (so * 2 >= h) { so = (h - 1) / 2; }
        if (so < 0) { so = 0; }
        let tw: i64 = self.edit_w - self.gutter;

        if (self.b.cy < self.b.top + so) { self.b.top = self.b.cy - so; }
        if (self.b.cy >= self.b.top + h - so) { self.b.top = self.b.cy - h + so + 1; }
        if (self.b.top > self.b.text.count - 1) { self.b.top = self.b.text.count - 1; }
        if (self.b.top < 0) { self.b.top = 0; }
        // (sideways: the view follows the cursor once it moves; until then, a
        // sideways wheel's view stays)
        if (self.b.cy == self.seen_cy && self.b.cx == self.seen_cx && self.b.id == self.seen_id) {
            if (self.b.left < 0) { self.b.left = 0; }
            return;
        }
        self.seen_cy = self.b.cy;
        self.seen_cx = self.b.cx;
        self.seen_id = self.b.id;
        let l: string = self.b.text.get(self.b.cy);
        let c: i64 = col_of(&l, self.b.cx, self.b.tabstop);

        if (c < self.b.left) { self.b.left = c; }
        if (tw > 0 && c >= self.b.left + tw) { self.b.left = c - tw + 1; }
        if (self.b.left < 0) { self.b.left = 0; }
    }

    // editor window
    fn prepare_lines(mut self: &App) -> void {
        self.vis.clear();
        let h: i64 = self.edit_h;
        let hl: bool = self.hl && self.matcher.pattern.len > 0;
        let m: Matcher = std::copy(self.matcher);
        let top: i64 = self.b.top;
        let lang: string = self.b.ft.syntax;
        // (cache: kept if it is of this text and reaches the top)
        let same: bool = self.hl_id == self.b.id && self.hl_gen == self.b.gen &&
            str::eq(self.hl_lang, lang) && top >= self.hl_from &&
            top <= self.hl_from + self.hl_rows.len && self.hl_rows.len > 0;
        var state: i64 = 0;

        if (same && top > self.hl_from) {
            state = self.hl_after[top - self.hl_from - 1];
            // (far below its start: drop the lines above the screen)
            let gone: i64 = top - self.hl_from;

            if (gone > 512) {
                var rows: Hl[][] = [];
                var after: i64[] = [];

                for (let k: i64 in gone..self.hl_rows.len) {
                    rows.push(std::take(mut &self.hl_rows[k]));
                    after.push(self.hl_after[k]);
                }
                self.hl_rows = rows;
                self.hl_after = after;
                self.hl_from = top;
            }
        } else if (let s = self.b.state_at(top)) {
            state = s;
            self.hl_rows = [];
            self.hl_after = [];
            self.hl_from = top;
        } else {
            // saved states do not reach here yet: the background finds them and
            // the lines are repainted; meanwhile, the nearest guess (start state, not
            // kept)
            self.want_states = top;
            self.hl_rows = [];
            self.hl_after = [];
            self.hl_from = -1;
        }
        self.hl_id = self.b.id;
        self.hl_gen = self.b.gen;
        self.hl_lang = lang;
        // shown lines with a diagnostic
        var diag_at: bool[] = [];

        for (let y: i64 in 0..h) { diag_at.push(false); }

        for (let d: &self::&Diag in &self.b.diags) {
            if (d.line >= top && d.line < top + h) { diag_at[d.line - top] = true; }
        }
        // selection: its lines, and its ends or columns
        let selecting: bool = self.mode == Mode::Visual;
        var sy1: i64 = -1;
        var sy2: i64 = -2;
        var ends: (i64, i64, i64, i64) = (0, 0, 0, 0);
        var cols: (i64, i64) = (0, 0);

        if (selecting) {
            ends = self.sel_ends();
            let (a, e) = self.sel_lines();

            sy1 = a;
            sy2 = e;
            if (self.vkind == 1) {
                sy1 = ends.0;
                sy2 = ends.2;
            }
            if (self.vkind == 3) { cols = self.block_cols(); }
        }
        let ts: i64 = self.b.tabstop;

        for (let y: i64 in 0..h) {
            let i: i64 = top + y;

            if (i >= self.b.text.count) {
                self.vis.push(VisLine { no: 0 });
                continue;
            }
            let t: string = self.b.text.get(i);
            var hls: Hl[] = [];

            if (self.hl_from >= 0) {
                let (got, after) = self.cached_hls(i, &t, state, &lang);

                hls = got;
                state = after;
            } else if (syntax::known(lang)) {
                state = syntax::line(lang, &t, state, mut &hls);
            }
            var ms: i64[] = [];

            if (hl) { ms = m.all(&t); }
            let dg: bool = diag_at[y];
            var lo: i64 = -1;
            var hi: i64 = 0;

            if (i >= sy1 && i <= sy2) {
                // (a selected line end: one cell past it, for its newline)
                let end_col: i64 = col_of(&t, t.len, ts);

                if (self.vkind == 2) {
                    lo = 0;
                    hi = end_col + 1;
                } else if (self.vkind == 3) {
                    lo = cols.0;
                    hi = cols.1;
                } else {
                    lo = 0;
                    if (i == ends.0) { lo = col_of(&t, ends.1, ts); }
                    hi = end_col + 1;
                    if (i == ends.2) { hi = col_of(&t, ends.3, ts); }
                }
                if (hi <= lo) { lo = -1; }
            }
            var sign: i64 = git::NONE;

            if (self.cfg.gitsigns && i < self.b.signs.len) { sign = self.b.signs[i]; }
            self.vis.push(VisLine {
                no: i + 1, text: t, hls: hls, matches: ms, diag: dg, current: i == self.b.cy,
                sel_lo: lo, sel_hi: hi, sign: sign
            });
        }
    }

    // tree window
    fn prepare_tree(mut self: &App) -> void {
        self.tree_vis.clear();
        if (self.split.at <= 0) {
            return;
        }
        self.tree.show(self.tree_h);
        let open: string = self.b.path;
        let hl: bool = self.hl && self.matcher.pattern.len > 0;
        let n: i64 = self.tree.rows.len;

        for (let y: i64 in 0..self.tree_h) {
            let i: i64 = self.tree.top + y;

            if (i >= n) { break; }
            let e: &self::&Entry = &self.tree.rows[i];
            var kind: i64 = 2;

            if (e.dir) { kind = 1; }
            if (i == 0) { kind = 0; }
            var special: bool = false;

            for (let s: string in &self.cfg.special) {
                if (str::eq(s, e.name)) { special = true; }
            }
            var ms: i64[] = [];

            if (hl) { ms = self.matcher.all(&e.name); }
            self.tree_vis.push(VisRow {
                name: e.name, depth: e.depth, kind: kind, special: special,
                open: str::eq(e.path, open), selected: i == self.tree.cursor, matches: ms
            });
        }
    }

    /// does the intro show? (started with no file, and the start buffer is
    /// still empty and on screen)
    export fn intro(self: &App) -> bool {
        return self.splash && self.b.id == 1 && self.b.path.len == 0 && !self.b.modified &&
            self.b.text.count == 1 && self.vis.len > 0 && self.vis[0].text.len == 0 &&
            self.mode != Mode::Insert;
    }

    /// line i's text as prepare read it ("" if off screen)
    export fn vis_line(self: &App, i: i64) -> string {
        let y: i64 = i - self.b.top;

        if (y < 0 || y >= self.vis.len) {
            return "";
        }
        return self.vis[y].text;
    }

    /// is the command-line row on screen?
    export fn cmd_line_shown(self: &App) -> bool {
        // (a cell edit is in the spreadsheet's bar)
        return self.cfg.cmdheight > 0 || self.mode == Mode::Command ||
            (self.mode == Mode::Search && !str::eq(self.cmd_kind, "cell"));
    }

    /// panel rows (0: none)
    export fn panel_height(self: &App) -> i64 {
        if (self.panel.len == 0) {
            return 0;
        }
        var h: i64 = self.panel.len + 1;

        if (h > self.rows / 2) { h = self.rows / 2; }
        return h;
    }

    /// background work: moves the highlighter's states toward the line the
    /// screen needs -> is there more to do?
    export fn background(mut self: &App) -> bool {
        if (self.walking) { self.walk_step(); }
        if (self.grepping()) { self.grep_step(); }
        if (self.want_states >= 0) {
            let goal: i64 = self.want_states;

            if (self.b.find_states(goal, 4096)) { self.want_states = -1; }
        }
        return self.has_work();
    }

    /// is there background work (highlighting toward the screen, listing the
    /// project, a project search)?
    export fn has_work(self: &App) -> bool {
        return self.want_states >= 0 || self.walking || self.grepping();
    }

    fn grepping(self: &App) -> bool {
        return self.picking.len > 0 && self.cat == 1 && self.grep_query.len >= 2 &&
            self.grep_at < self.files.len && self.pick_items.len < GREP_MAX;
    }

    // ---- keys ------------------------------------------------------------------------

    /// handles key k in the current mode
    export fn key(mut self: &App, k: &tui::Key) -> void {
        let t: string = token(k);

        if (self.mode != Mode::Insert) { self.comp = []; }
        if (self.panel.len > 0 && self.mode != Mode::Command && self.mode != Mode::Search) {
            self.panel = [];
            if (str::eq(t, "<CR>") || str::eq(t, "<Esc>") || str::eq(t, "<Space>") ||
                str::eq(t, "q")) {
                return;
            }
        }
        if (self.mode == Mode::Command || self.mode == Mode::Search) {
            self.cmd_key(k, &t);
            return;
        }
        if (self.mode == Mode::Insert) {
            if (self.mapped("insert", &t)) {
                return;
            }
            self.insert_key(&t, k);
            self.after();
            return;
        }
        // (a message stays its time; Esc dismisses it)
        if (self.msg.len > 0 && self.pending.len == 0 && str::eq(t, "<Esc>")) { self.msg = ""; }
        self.pending.push(t);
        var mode: string = "normal";

        if (self.focus_tree) { mode = "tree"; }
        if (self.mode == Mode::Visual) { mode = "visual"; }
        // a configured binding: fully typed, or only its start
        var exact: string = "";
        var longer: bool = false;

        for (let m: &self::&Keymap in &self.cfg.maps) {
            if (!str::eq(m.mode, mode) || self.cfg.disabled_addin(m.addin)) { continue; }
            if (m.keys.len < self.pending.len) { continue; }
            var same: bool = true;

            for (let i: i64, let p: string in &self.pending) {
                if (!str::eq(p, m.keys[i])) { same = false; }
            }
            if (!same) { continue; }
            if (m.keys.len == self.pending.len) { exact = m.cmd; } else { longer = true; }
        }
        if (exact.len > 0 && !longer) {
            self.pending = [];
            self.ex(exact);
            self.after();
            return;
        }
        if (longer) {
            return;
        }
        var toks: string[] = std::copy(self.pending);

        // (h l Left Right held down go a little further each repeat; not in the
        // tree, where they close and open)
        if (toks.len == 1 && !self.focus_tree) {
            let steps: i64 = self.held_steps(&toks[0]);

            if (steps > 1) { toks = ["\(steps)", toks[0]]; }
        }
        var r: i64 = 2;

        if (self.mode == Mode::Visual) {
            r = self.visual_cmd(&toks);
        } else if (self.focus_tree) {
            r = self.tree_cmd(&toks);
        } else if (self.viewing()) {
            r = self.viewer_cmd(&toks);
        } else if (self.sheet_on()) {
            r = self.sheet_cmd(&toks);
        } else {
            r = self.normal_cmd(&toks);
        }
        if (r == 0 && exact.len == 0) {
            return;
        }
        if (r == 2 && exact.len > 0) {
            self.pending = [];
            self.ex(exact);
            self.after();
            return;
        }
        self.pending = [];
        self.after();
    }

    // runs mode's binding for the single token t (insert mode: no sequences)
    fn mapped(mut self: &App, mode: string, t: &string) -> bool {
        var cmd: string = "";

        for (let m: &self::&Keymap in &self.cfg.maps) {
            if (str::eq(m.mode, mode) && m.keys.len == 1 && str::eq(m.keys[0], *t) &&
                !self.cfg.disabled_addin(m.addin)) {
                cmd = m.cmd;
            }
        }
        if (cmd.len == 0) {
            return false;
        }
        self.ex(cmd);
        self.after();
        return true;
    }

    // after a key: keeps the cursor in, the view on it
    fn after(mut self: &App) -> void {
        if (self.b.readonly && (self.b.refused || self.mode == Mode::Insert)) {
            self.b.refused = false;
            self.blk = [];
            self.b.commit();
            if (self.mode == Mode::Insert) { self.mode = Mode::Normal; }
            self.fail_msg("E21: Cannot make changes, the buffer is read-only (q closes it)");
        }
        self.fix_cursor();
        self.scroll();
    }

    // ---- normal mode ---------------------------------------------------------------

    // motion at toks[i..] (count times) from the cursor
    fn motion(mut self: &App, toks: &string[], i: i64, count: i64) -> Motion {
        let n: i64 = toks.len;

        if (i >= n) {
            return Motion { state: 0 };
        }
        let t: string = toks[i];
        var c: i64 = count;

        if (c < 1) { c = 1; }
        let y: i64 = self.b.cy;
        let x: i64 = self.b.cx;
        let l: string = self.b.text.get(y);
        let last: i64 = self.b.text.count - 1;

        match (t) {
            "h" | "<Left>" | "<BS>" => {
                var nx: i64 = x;

                for (let k: i64 in 0..c) { nx = prev_char(&l, nx); }
                return Motion { state: 1, y: y, x: nx, used: 1 };
            },
            "l" | "<Right>" => {
                var nx: i64 = x;

                for (let k: i64 in 0..c) {
                    if (nx < l.len) { nx = next_char(&l, nx); }
                }
                return Motion { state: 1, y: y, x: nx, used: 1 };
            },
            "j" | "<Down>" | "<C-n>" | "<C-j>" => {
                var ny: i64 = y + c;

                if (ny > last) { ny = last; }
                return Motion { state: 1, y: ny, x: -1, linewise: true, used: 1 };
            },
            "k" | "<Up>" | "<C-p>" => {
                var ny: i64 = y - c;

                if (ny < 0) { ny = 0; }
                return Motion { state: 1, y: ny, x: -1, linewise: true, used: 1 };
            },
            "0" | "<Home>" => { return Motion { state: 1, y: y, x: 0, used: 1 }; },
            "^" => { return Motion { state: 1, y: y, x: first_non_blank(&l), used: 1 }; },
            "$" | "<End>" => {
                var ny: i64 = y + c - 1;

                if (ny > last) { ny = last; }
                let nl: string = self.b.text.get(ny);

                return Motion { state: 1, y: ny, x: nl.len, inclusive: false, used: 1 };
            },
            "G" => {
                var ny: i64 = last;

                if (count > 0) { ny = count - 1; }
                if (ny > last) { ny = last; }
                return Motion { state: 1, y: ny, x: -2, linewise: true, used: 1 };
            },
            "g" => {
                if (i + 1 >= n) {
                    return Motion { state: 0 };
                }
                if (str::eq(toks[i + 1], "g")) {
                    var ny: i64 = 0;

                    if (count > 0) { ny = count - 1; }
                    if (ny > last) { ny = last; }
                    return Motion { state: 1, y: ny, x: -2, linewise: true, used: 2 };
                }
                if (str::eq(toks[i + 1], "_")) {
                    var e: i64 = l.len;

                    while (e > 0 && (l[e - 1] == ' ' || l[e - 1] == '\t')) { e -= 1; }
                    return Motion { state: 1, y: y, x: prev_char(&l, e), inclusive: true, used: 2 };
                }
                return Motion { state: 2 };
            },
            "w" | "W" => {
                var p: (i64, i64) = (y, x);

                for (let k: i64 in 0..c) { p = self.word_fwd(p.0, p.1, str::eq(t, "W")); }
                return Motion { state: 1, y: p.0, x: p.1, used: 1 };
            },
            "b" | "B" => {
                var p: (i64, i64) = (y, x);

                for (let k: i64 in 0..c) { p = self.word_back(p.0, p.1, str::eq(t, "B")); }
                return Motion { state: 1, y: p.0, x: p.1, used: 1 };
            },
            "e" | "E" => {
                var p: (i64, i64) = (y, x);

                for (let k: i64 in 0..c) { p = self.word_end(p.0, p.1, str::eq(t, "E")); }
                return Motion { state: 1, y: p.0, x: p.1, inclusive: true, used: 1 };
            },
            "}" => {
                var ny: i64 = y;

                for (let k: i64 in 0..c) { ny = self.paragraph(ny, 1); }
                return Motion { state: 1, y: ny, x: 0, used: 1 };
            },
            "{" => {
                var ny: i64 = y;

                for (let k: i64 in 0..c) { ny = self.paragraph(ny, -1); }
                return Motion { state: 1, y: ny, x: 0, used: 1 };
            },
            "H" => { return Motion { state: 1, y: self.b.top, x: -2, linewise: true, used: 1 }; },
            "L" => {
                var ny: i64 = self.b.top + self.edit_h - 1;

                if (ny > last) { ny = last; }
                return Motion { state: 1, y: ny, x: -2, linewise: true, used: 1 };
            },
            "M" => {
                var ny: i64 = self.b.top + self.edit_h / 2;

                if (ny > last) { ny = last; }
                return Motion { state: 1, y: ny, x: -2, linewise: true, used: 1 };
            },
            "f" | "t" | "F" | "T" => {
                if (i + 1 >= n) {
                    return Motion { state: 0 };
                }
                self.last_find = "\(t)\(toks[i + 1])";
                return self.find_char(t, toks[i + 1], c, 2);
            },
            ";" | "," => {
                if (self.last_find.len < 2) {
                    return Motion { state: 2 };
                }
                var kind: string = str::substr(self.last_find, 0, 1);

                if (str::eq(t, ",")) {
                    match (kind) {
                        "f" => { kind = "F"; }, "F" => { kind = "f"; }, "t" => { kind = "T"; },
                        "T" => { kind = "t"; }, _ => {}
                    }
                }
                let ch: string = str::substr(self.last_find, 1, self.last_find.len - 1);

                return self.find_char(kind, ch, c, 1);
            },
            "%" => {
                if (let p = self.matching(y, x)) {
                    return Motion { state: 1, y: p.0, x: p.1, inclusive: true, used: 1 };
                }
                return Motion { state: 2 };
            },
            _ => {}
        }
        return Motion { state: 2 };
    }

    // f/t/F/T: the count-th ch on the line
    fn find_char(mut self: &App, kind: string, ch: string, count: i64, used: i64) -> Motion {
        let l: string = self.b.text.get(self.b.cy);
        var x: i64 = self.b.cx;
        let fwd: bool = str::eq(kind, "f") || str::eq(kind, "t");
        let till: bool = str::eq(kind, "t") || str::eq(kind, "T");
        var c: string = ch;

        if (str::eq(c, "<Space>")) { c = " "; }
        if (str::eq(c, "<lt>")) { c = "<"; }

        for (let k: i64 in 0..count) {
            if (fwd) {
                var start: i64 = next_char(&l, x);

                if (till && k == 0) { start = next_char(&l, start); }
                if (let at = str::find_from(l, c, start)) {
                    x = at;
                } else {
                    return Motion { state: 2 };
                }
            } else {
                var found: i64 = -1;
                var j: i64 = 0;
                var lim: i64 = x;

                if (till && k == 0) { lim = prev_char(&l, x); }

                while (true) {
                    if (let at = str::find_from(l, c, j)) {
                        if (at >= lim) { break; }
                        found = at;
                        j = at + 1;
                    } else {
                        break;
                    }
                }
                if (found < 0) {
                    return Motion { state: 2 };
                }
                x = found;
            }
        }
        if (till) {
            if (fwd) { x = prev_char(&l, x); } else { x = next_char(&l, x); }
        }
        return Motion { state: 1, y: self.b.cy, x: x, inclusive: fwd, used: used };
    }

    // next word start from (y, x)
    fn word_fwd(mut self: &App, y0: i64, x0: i64, big: bool) -> (i64, i64) {
        var y: i64 = y0;
        var x: i64 = x0;
        var l: string = self.b.text.get(y);

        if (x < l.len) {
            let c0: i64 = class(l[x], big);

            while (x < l.len && class(l[x], big) == c0 && c0 != 0) { x = next_char(&l, x); }
        }

        while (true) {
            while (x < l.len && class(l[x], big) == 0) { x += 1; }
            if (x < l.len) {
                return (y, x);
            }
            if (y + 1 >= self.b.text.count) {
                return (y, l.len);
            }
            y += 1;
            x = 0;
            l = self.b.text.get(y);
            if (l.len == 0) {
                return (y, 0);
            }
        }
        return (y, x);
    }

    // start of the word before (y, x)
    fn word_back(mut self: &App, y0: i64, x0: i64, big: bool) -> (i64, i64) {
        var y: i64 = y0;
        var x: i64 = x0;
        var l: string = self.b.text.get(y);

        while (true) {
            while (x > 0 && class(l[prev_char(&l, x)], big) == 0) { x = prev_char(&l, x); }
            if (x > 0) { break; }
            if (y == 0) {
                return (0, 0);
            }
            y -= 1;
            l = self.b.text.get(y);
            x = l.len;
            if (l.len == 0) {
                return (y, 0);
            }
        }
        let c0: i64 = class(l[prev_char(&l, x)], big);

        while (x > 0 && class(l[prev_char(&l, x)], big) == c0) { x = prev_char(&l, x); }
        return (y, x);
    }

    // end of the word at or after (y, x)
    fn word_end(mut self: &App, y0: i64, x0: i64, big: bool) -> (i64, i64) {
        var y: i64 = y0;
        var l: string = self.b.text.get(y);
        var x: i64 = next_char(&l, x0);

        while (true) {
            while (x < l.len && class(l[x], big) == 0) { x += 1; }
            if (x < l.len) { break; }
            if (y + 1 >= self.b.text.count) {
                return (y, prev_char(&l, l.len));
            }
            y += 1;
            x = 0;
            l = self.b.text.get(y);
        }
        let c0: i64 = class(l[x], big);

        while (next_char(&l, x) < l.len && class(l[next_char(&l, x)], big) == c0) {
            x = next_char(&l, x);
        }
        return (y, x);
    }

    // next (dir 1) or previous blank line
    fn paragraph(mut self: &App, y0: i64, dir: i64) -> i64 {
        let n: i64 = self.b.text.count;
        var y: i64 = y0 + dir;

        while (y >= 0 && y < n && str::trim(self.b.text.get(y)).len == 0) { y += dir; }

        while (y >= 0 && y < n && str::trim(self.b.text.get(y)).len > 0) { y += dir; }
        if (y < 0) {
            return 0;
        }
        if (y >= n) {
            return n - 1;
        }
        return y;
    }

    // bracket matching the one at or after (y, x) on its line
    fn matching(mut self: &App, y: i64, x: i64) -> (i64, i64)? {
        let l: string = self.b.text.get(y);
        // (compares bytes, not one-byte strings)
        let opens: string = "([{";
        let closes: string = ")]}";
        var at: i64 = x;
        var open: u8 = 0;
        var close: u8 = 0;
        var dir: i64 = 1;

        while (at < l.len && open == 0) {
            for (let k: i64 in 0..3) {
                if (l[at] == opens[k]) {
                    open = opens[k];
                    close = closes[k];
                } else if (l[at] == closes[k]) {
                    open = closes[k];
                    close = opens[k];
                    dir = -1;
                }
            }
            if (open == 0) { at += 1; }
        }
        if (open == 0) {
            return none;
        }
        var depth: i64 = 0;
        var cy: i64 = y;
        var cx: i64 = at;
        var line: string = l;
        var steps: i64 = 0;

        while (steps < 200000) {
            steps += 1;
            let c: u8 = line[cx];

            if (c == open) { depth += 1; }
            if (c == close) {
                depth -= 1;
                if (depth == 0) {
                    return (cy, cx);
                }
            }
            cx += dir;

            while (cx < 0 || cx >= line.len) {
                cy += dir;
                if (cy < 0 || cy >= self.b.text.count) {
                    return none;
                }
                line = self.b.text.get(cy);
                if (dir > 0) { cx = 0; } else { cx = line.len - 1; }
                if (line.len == 0) { cx = -1; if (dir > 0) { cx = 0; } }
                if (line.len == 0) { continue; }
                break;
            }
        }
        return none;
    }

    // applies a motion: the cursor moves to its end
    fn move_to(mut self: &App, m: &Motion) -> void {
        if (m.x == -1) {
            self.go_line(m.y);
        } else if (m.x == -2) {
            let l: string = self.b.text.get(m.y);

            self.go(m.y, first_non_blank(&l), true);
        } else {
            self.go(m.y, m.x, true);
        }
    }

    // applies operator op ("d", "c", "y", ">", "<") from the cursor to m
    fn operate(mut self: &App, op: string, m: &Motion) -> void {
        var y1: i64 = self.b.cy;
        var x1: i64 = self.b.cx;
        var y2: i64 = m.y;
        var x2: i64 = m.x;

        if (m.linewise || x2 < 0) {
            if (y2 < y1) {
                let t: i64 = y1;

                y1 = y2;
                y2 = t;
            }
            self.op_lines(op, y1, y2);
            return;
        }
        if (y2 < y1 || (y2 == y1 && x2 < x1)) {
            let ty: i64 = y1;
            let tx: i64 = x1;

            y1 = y2;
            x1 = x2;
            y2 = ty;
            x2 = tx;
        }
        if (m.inclusive) {
            let l: string = self.b.text.get(y2);

            x2 = next_char(&l, x2);
        }
        if (str::eq(op, ">") || str::eq(op, "<")) {
            self.op_lines(op, y1, y2);
            return;
        }
        if (str::eq(op, "y")) {
            self.reg = self.yank_text(y1, x1, y2, x2);
            self.reg_lines = false;
            self.clip(self.reg);
            self.go(y1, x1, true);
            return;
        }
        self.b.begin();
        self.reg = self.b.cut(y1, x1, y2, x2);
        self.reg_lines = false;
        self.b.cy = y1;
        self.b.cx = x1;
        if (str::eq(op, "c")) {
            self.mode = Mode::Insert;
        } else {
            self.b.commit();
        }
        self.go(y1, x1, true);
    }

    // text from (y1, x1) to (y2, x2), without removing it
    fn yank_text(mut self: &App, y1: i64, x1: i64, y2: i64, x2: i64) -> string {
        if (y1 == y2) {
            return str::substr(self.b.text.get(y1), x1, x2 - x1);
        }
        var s: str::Builder;
        let first: string = self.b.text.get(y1);

        s.add(str::substr(first, x1, first.len - x1));

        for (let k: i64 in (y1 + 1)..y2) {
            s.add_byte(10);
            s.add(self.b.text.get(k));
        }
        s.add_byte(10);
        s.add(str::substr(self.b.text.get(y2), 0, x2));
        return s.to_string();
    }

    // applies operator op to whole lines y1..=y2
    fn op_lines(mut self: &App, op: string, y1: i64, y2: i64) -> void {
        var s: str::Builder;

        for (let k: i64 in y1..(y2 + 1)) {
            s.add(self.b.text.get(k));
            s.add_byte(10);
        }
        if (str::eq(op, "y")) {
            self.reg = s.to_string();
            self.reg_lines = true;
            self.clip(self.reg);
            if (y2 > y1) { self.say("\(y2 - y1 + 1) lines yanked"); }
            return;
        }
        self.b.begin();
        if (str::eq(op, ">") || str::eq(op, "<")) {
            var unit: string = "\t";

            if (self.cfg.expandtab) { unit = str::repeat(" ", self.b.tabstop); }

            for (let k: i64 in y1..(y2 + 1)) {
                let l: string = self.b.text.get(k);

                if (str::eq(op, ">")) {
                    if (l.len > 0) { self.b.set_line(k, "\(unit)\(l)"); }
                } else {
                    var cut: i64 = 0;

                    while (cut < l.len && cut < self.b.tabstop && l[cut] == ' ') { cut += 1; }
                    if (cut == 0 && l.len > 0 && l[0] == '\t') { cut = 1; }
                    self.b.set_line(k, str::substr(l, cut, l.len - cut));
                }
            }
            self.b.commit();
            let l: string = self.b.text.get(y1);

            self.go(y1, first_non_blank(&l), true);
            return;
        }
        self.reg = s.to_string();
        self.reg_lines = true;
        if (str::eq(op, "c")) {
            let ind: string = indent_of(&self.b.text.get(y1));

            for (let k: i64 in (y1 + 1)..(y2 + 1)) { self.b.remove_line(y1 + 1); }
            self.b.set_line(y1, ind);
            self.b.cy = y1;
            self.b.cx = ind.len;
            self.mode = Mode::Insert;
            return;
        }

        for (let k: i64 in y1..(y2 + 1)) { self.b.remove_line(y1); }
        self.b.commit();
        var ny: i64 = y1;

        if (ny >= self.b.text.count) { ny = self.b.text.count - 1; }
        let l: string = self.b.text.get(ny);

        self.go(ny, first_non_blank(&l), true);
        if (y2 - y1 + 1 >= 3) { self.say("\(y2 - y1 + 1) fewer lines"); }
    }

    // puts the register after the cursor (after: p) or before it (P)
    fn put_reg(mut self: &App, after: bool, count: i64) -> void {
        if (self.reg.len == 0) {
            return;
        }
        var c: i64 = count;

        if (c < 1) { c = 1; }
        let text: string = str::repeat(self.reg, c);
        let lines_mode: bool = self.reg_lines;

        self.b.begin();
        if (lines_mode) {
            var lines: string[] = str::split(text, "\n");

            if (lines.len > 0 && lines[lines.len - 1].len == 0) { lines.pop(); }
            var at: i64 = self.b.cy;

            if (after) { at += 1; }

            for (let k: i64, let l: string in &lines) { self.b.insert_line(at + k, l); }
            self.b.commit();
            let l: string = self.b.text.get(at);

            self.go(at, first_non_blank(&l), true);
            return;
        }
        let l: string = self.b.text.get(self.b.cy);
        var x: i64 = self.b.cx;

        if (after && l.len > 0) { x = next_char(&l, x); }
        let end: (i64, i64) = self.b.put(self.b.cy, x, text);

        self.b.commit();
        let el: string = self.b.text.get(end.0);

        self.go(end.0, prev_char(&el, end.1), true);
    }

    // a normal-mode command: toks so far -> 0 needs more keys, 1 done, 2 not one
    fn normal_cmd(mut self: &App, toks: &string[]) -> i64 {
        let n: i64 = toks.len;
        let (count, i) = read_count(toks, 0);

        if (i >= n) {
            return 0;
        }
        let t: string = toks[i];
        var c1: i64 = count;

        if (c1 < 1) { c1 = 1; }
        // operators
        if (str::eq(t, "d") || str::eq(t, "c") || str::eq(t, "y") || str::eq(t, ">") ||
            str::eq(t, "<lt>")) {
            var op: string = t;

            if (str::eq(op, "<lt>")) { op = "<"; }
            let (count2, j) = read_count(toks, i + 1);

            if (j >= n) {
                return 0;
            }
            var total: i64 = count;

            if (count2 > 0) {
                if (total < 1) { total = 1; }
                total = total * count2;
            }
            if (str::eq(toks[j], t)) {
                // dd, cc, yy, >>, <<: whole lines
                var tl: i64 = total;

                if (tl < 1) { tl = 1; }
                let y1: i64 = self.b.cy;
                var y2: i64 = y1 + tl - 1;
                let last: i64 = self.b.text.count - 1;

                if (y2 > last) { y2 = last; }
                self.op_lines(op, y1, y2);
                return 1;
            }
            // iw aw iW aW: the word under the cursor (and the spaces after it)
            if (str::eq(toks[j], "i") || str::eq(toks[j], "a")) {
                if (j + 1 >= n) {
                    return 0;
                }
                let o: string = toks[j + 1];

                if (!str::eq(o, "w") && !str::eq(o, "W")) {
                    return 2;
                }
                let y: i64 = self.b.cy;
                let (wa, we) = self.word_at(y, self.b.cx, str::eq(o, "W"), str::eq(toks[j], "a"));

                if (we <= wa) {
                    return 1;
                }
                self.b.cx = wa;
                self.operate(op, &Motion { state: 1, y: y, x: we, used: 2 });
                return 1;
            }
            // cw acts as ce (to the word's end, not the next word's start)
            var toks2: string[] = std::copy(*toks);

            if (str::eq(op, "c") && (str::eq(toks[j], "w") || str::eq(toks[j], "W"))) {
                let l: string = self.b.text.get(self.b.cy);
                let x: i64 = self.b.cx;

                if (x < l.len && class(l[x], false) != 0) {
                    if (str::eq(toks[j], "w")) { toks2[j] = "e"; } else { toks2[j] = "E"; }
                }
            }
            let m: Motion = self.motion(&toks2, j, total);

            if (m.state != 1) {
                return m.state;
            }
            self.operate(op, &m);
            return 1;
        }
        let m: Motion = self.motion(toks, i, count);

        if (m.state == 0) {
            return 0;
        }
        if (m.state == 1) {
            self.move_to(&m);
            return 1;
        }
        let rest: i64 = n - i - 1;

        match (t) {
            "i" | "<Insert>" => { self.start_insert(); },
            "a" => {
                let l: string = self.b.text.get(self.b.cy);

                if (l.len > 0) { self.b.cx = next_char(&l, self.b.cx); }
                self.start_insert();
            },
            "I" => {
                let l: string = self.b.text.get(self.b.cy);

                self.b.cx = first_non_blank(&l);
                self.start_insert();
            },
            "A" => {
                self.b.cx = self.b.text.get(self.b.cy).len;
                self.start_insert();
            },
            "o" | "O" => {
                self.b.begin();
                var ind: string = "";

                if (self.cfg.autoindent) { ind = indent_of(&self.b.text.get(self.b.cy)); }
                var at: i64 = self.b.cy + 1;

                if (str::eq(t, "O")) { at = self.b.cy; }
                self.b.insert_line(at, ind);
                self.b.cy = at;
                self.b.cx = ind.len;
                self.mode = Mode::Insert;
            },
            "x" | "<Del>" | "X" => {
                let l: string = self.b.text.get(self.b.cy);

                if (l.len == 0) {
                    return 1;
                }
                var a: i64 = self.b.cx;
                var e: i64 = self.b.cx;

                for (let k: i64 in 0..c1) {
                    if (str::eq(t, "X")) {
                        a = prev_char(&l, a);
                    } else if (e < l.len) {
                        e = next_char(&l, e);
                    }
                }
                if (a == e) {
                    return 1;
                }
                self.b.begin();
                self.reg = self.b.cut(self.b.cy, a, self.b.cy, e);
                self.reg_lines = false;
                self.b.commit();
                self.b.cx = a;
            },
            "s" => {
                let l: string = self.b.text.get(self.b.cy);
                var e: i64 = self.b.cx;

                for (let k: i64 in 0..c1) {
                    if (e < l.len) { e = next_char(&l, e); }
                }
                self.b.begin();
                self.reg = self.b.cut(self.b.cy, self.b.cx, self.b.cy, e);
                self.mode = Mode::Insert;
            },
            "S" => {
                let y: i64 = self.b.cy;

                self.op_lines("c", y, y);
            },
            "D" | "C" => {
                let l: string = self.b.text.get(self.b.cy);

                self.b.begin();
                self.reg = self.b.cut(self.b.cy, self.b.cx, self.b.cy, l.len);
                self.reg_lines = false;
                if (str::eq(t, "C")) {
                    self.mode = Mode::Insert;
                } else {
                    self.b.commit();
                }
            },
            "Y" => {
                let y: i64 = self.b.cy;

                self.op_lines("y", y, y);
            },
            "p" => { self.put_reg(true, count); },
            "P" => { self.put_reg(false, count); },
            "J" => {
                let y: i64 = self.b.cy;

                self.join_lines(y, c1);
            },
            "r" => {
                if (rest < 1) {
                    return 0;
                }
                var ch: string = toks[i + 1];

                if (str::eq(ch, "<Space>")) { ch = " "; }
                if (str::eq(ch, "<lt>")) { ch = "<"; }
                if (str::eq(ch, "<Esc>")) {
                    return 1;
                }
                if (str::starts_with(ch, "<") && ch.len > 1) {
                    return 2;
                }
                let l: string = self.b.text.get(self.b.cy);

                if (self.b.cx >= l.len) {
                    return 1;
                }
                var e: i64 = self.b.cx;

                for (let k: i64 in 0..c1) {
                    if (e < l.len) { e = next_char(&l, e); }
                }
                let x: i64 = self.b.cx;

                self.b.begin();
                self.b.cut(self.b.cy, x, self.b.cy, e);
                self.b.put(self.b.cy, x, str::repeat(ch, c1));
                self.b.commit();
                self.b.cx = x;
            },
            "~" => {
                let l: string = self.b.text.get(self.b.cy);

                if (self.b.cx >= l.len) {
                    return 1;
                }
                let e: i64 = next_char(&l, self.b.cx);
                let ch: string = str::substr(l, self.b.cx, e - self.b.cx);
                var sw: string = str::to_upper(ch);

                if (str::eq(sw, ch)) { sw = str::to_lower(ch); }
                self.b.begin();
                self.b.set_line(
                    self.b.cy, "\(str::substr(l, 0, self.b.cx))\(sw)\(str::substr(l, e, l.len - e))"
                );
                self.b.commit();
                if (e < l.len) { self.b.cx = e; }
            },
            "u" => {
                for (let k: i64 in 0..c1) {
                    if (!self.b.undo_last()) {
                        self.say("Already at oldest change");
                        break;
                    }
                }
            },
            "<C-r>" => {
                for (let k: i64 in 0..c1) {
                    if (!self.b.redo_last()) {
                        self.say("Already at newest change");
                        break;
                    }
                }
            },
            "n" => { self.search_next(self.search_fwd); },
            "N" => { self.search_next(!self.search_fwd); },
            "*" | "#" => {
                let w: string = self.b.word();

                if (w.len == 0) {
                    return 1;
                }
                self.last_search = w;
                self.search_fwd = str::eq(t, "*");
                self.set_matcher(w);
                self.search_next(self.search_fwd);
            },
            ":" => { self.start_cmd(":"); },
            "/" => { self.start_cmd("/"); },
            "?" => { self.start_cmd("?"); },
            "<C-d>" | "<C-u>" | "<C-f>" | "<C-b>" | "<PageDown>" | "<PageUp>" => {
                var by: i64 = self.edit_h / 2;

                if (str::eq(t, "<C-f>") || str::eq(t, "<C-b>") || str::eq(t, "<PageDown>") ||
                    str::eq(t, "<PageUp>")) {
                    by = self.edit_h - 2;
                }
                if (by < 1) { by = 1; }
                if (str::eq(t, "<C-u>") || str::eq(t, "<C-b>") || str::eq(t, "<PageUp>")) {
                    by = 0 - by;
                }
                self.b.top += by;
                if (self.b.top < 0) { self.b.top = 0; }
                if (self.b.top > self.b.text.count - 1) { self.b.top = self.b.text.count - 1; }
                let y: i64 = self.b.cy + by;

                self.go_line(y);
            },
            "<C-e>" | "<C-y>" => {
                var by: i64 = c1;

                if (str::eq(t, "<C-y>")) { by = 0 - c1; }
                self.b.top += by;
                if (self.b.top < 0) { self.b.top = 0; }
                if (self.b.top > self.b.text.count - 1) { self.b.top = self.b.text.count - 1; }
                var y: i64 = self.b.cy;

                if (y < self.b.top) { y = self.b.top; }
                if (y >= self.b.top + self.edit_h) { y = self.b.top + self.edit_h - 1; }
                self.go_line(y);
            },
            "z" => {
                if (rest < 1) {
                    return 0;
                }
                let z: string = toks[i + 1];

                if (str::eq(z, "z") || str::eq(z, ".")) {
                    self.b.top = self.b.cy - self.edit_h / 2;
                }
                else if (str::eq(z, "t") || str::eq(z, "<CR>")) { self.b.top = self.b.cy; }
                else if (str::eq(z, "b") || str::eq(z, "-")) {
                    self.b.top = self.b.cy - self.edit_h + 1;
                }
                else {
                    return 2;
                }
                if (self.b.top < 0) { self.b.top = 0; }
            },
            "Z" => {
                if (rest < 1) {
                    return 0;
                }
                if (str::eq(toks[i + 1], "Z")) { self.ex("x"); }
                else if (str::eq(toks[i + 1], "Q")) { self.ex("q!"); }
                else {
                    return 2;
                }
            },
            "<C-w>" => {
                if (rest < 1) {
                    return 0;
                }
                let w: string = toks[i + 1];

                if (str::eq(w, "h") || str::eq(w, "w") || str::eq(w, "<C-w>") ||
                    str::eq(w, "<C-h>") ||
                    str::eq(w, "p")) {
                    self.focus_on_tree();
                } else if (str::eq(w, "l") || str::eq(w, "<C-l>")) {
                    return 1;
                } else if (str::eq(w, ">") || str::eq(w, "<lt>")) {
                    var d: i64 = c1;

                    if (str::eq(w, "<lt>")) { d = 0 - c1; }
                    self.split.by(d);
                } else {
                    return 2;
                }
            },
            "<C-g>" => { self.file_info(); },
            "<C-o>" | "<C-^>" => { if (self.alt >= 0) { self.switch_id(self.alt); } },
            "<Esc>" => {},
            "<CR>" | "+" => {
                let y: i64 = self.b.cy + c1;

                if (y < self.b.text.count) {
                    let l: string = self.b.text.get(y);

                    self.go(y, first_non_blank(&l), true);
                }
            },
            "-" => {
                let y: i64 = self.b.cy - c1;

                if (y >= 0) {
                    let l: string = self.b.text.get(y);

                    self.go(y, first_non_blank(&l), true);
                }
            },
            "v" => { self.start_visual(1); },
            "V" => { self.start_visual(2); },
            "q" => {
                if (!self.b.readonly) {
                    return 2;
                }
                self.ex("bd");
            },
            "<C-v>" => { self.start_visual(3); },
            "g" => {
                if (rest < 1) {
                    return 0;
                }
                let g: string = toks[i + 1];

                if (str::eq(g, "-")) {
                    if (!self.b.go_to(self.b.hist.at - c1)) {
                        self.say("Already at oldest change");
                    }
                    else { self.say_state(); }
                } else if (str::eq(g, "+")) {
                    if (!self.b.go_to(self.b.hist.at + c1)) {
                        self.say("Already at newest change");
                    }
                    else { self.say_state(); }
                } else if (str::eq(g, "v")) {
                    if (self.gv.len < 5) {
                        return 1;
                    }
                    let last: i64 = self.b.text.count - 1;
                    var vy: i64 = self.gv[1];
                    var cy: i64 = self.gv[3];

                    if (vy > last) { vy = last; }
                    if (cy > last) { cy = last; }
                    self.start_visual(self.gv[0]);
                    self.vy = vy;
                    self.vx = self.gv[2];
                    self.go(cy, self.gv[4], true);
                } else {
                    return 2;
                }
            },
            _ => { return 2; }
        }
        return 1;
    }

    fn insert_edit(mut self: &App, t: &string, k: &tui::Key) -> void {
        self.b.begin();
        match (*t) {
            "<Esc>" | "<C-c>" | "<C-[>" => {
                self.leave_insert();
                return;
            },
            "<CR>" | "<C-j>" | "<C-m>" => {
                let l: string = self.b.text.get(self.b.cy);
                var ind: string = "";

                if (self.cfg.autoindent) { ind = indent_of(&l); }
                var head: string = str::substr(l, 0, self.b.cx);
                let tail: string = str::substr(l, self.b.cx, l.len - self.b.cx);

                if (str::trim(head).len == 0) { head = ""; }
                self.b.set_line(self.b.cy, head);
                self.b.insert_line(self.b.cy + 1, "\(ind)\(tail)");
                self.b.cy += 1;
                self.b.cx = ind.len;
            },
            "<BS>" | "<C-h>" => {
                if (self.b.cx > 0) {
                    let l: string = self.b.text.get(self.b.cy);
                    let a: i64 = prev_char(&l, self.b.cx);

                    self.b.cut(self.b.cy, a, self.b.cy, self.b.cx);
                    self.b.cx = a;
                } else if (self.b.cy > 0) {
                    let prev: string = self.b.text.get(self.b.cy - 1);

                    self.b.cut(self.b.cy - 1, prev.len, self.b.cy, 0);
                    self.b.cy -= 1;
                    self.b.cx = prev.len;
                }
            },
            "<Del>" => {
                let l: string = self.b.text.get(self.b.cy);

                if (self.b.cx < l.len) {
                    self.b.cut(self.b.cy, self.b.cx, self.b.cy, next_char(&l, self.b.cx));
                } else if (self.b.cy + 1 < self.b.text.count) {
                    self.b.cut(self.b.cy, self.b.cx, self.b.cy + 1, 0);
                }
            },
            "<C-w>" => {
                let l: string = self.b.text.get(self.b.cy);
                var a: i64 = self.b.cx;

                while (a > 0 && (l[a - 1] == ' ' || l[a - 1] == '\t')) { a -= 1; }
                if (a > 0) {
                    let c0: i64 = class(l[a - 1], false);

                    while (a > 0 && class(l[a - 1], false) == c0) { a -= 1; }
                }
                self.b.cut(self.b.cy, a, self.b.cy, self.b.cx);
                self.b.cx = a;
            },
            "<C-u>" => {
                let l: string = self.b.text.get(self.b.cy);
                let a: i64 = first_non_blank(&l);
                var from_x: i64 = 0;

                if (self.b.cx > a) { from_x = a; }
                self.b.cut(self.b.cy, from_x, self.b.cy, self.b.cx);
                self.b.cx = from_x;
            },
            "<Tab>" => {
                if (self.cfg.expandtab) {
                    let l: string = self.b.text.get(self.b.cy);
                    let c: i64 = col_of(&l, self.b.cx, self.b.tabstop);

                    self.insert_text(str::repeat(" ", self.b.tabstop - c % self.b.tabstop));
                } else {
                    self.insert_text("\t");
                }
                return;
            },
            "<Left>" => {
                let l: string = self.b.text.get(self.b.cy);

                self.b.cx = prev_char(&l, self.b.cx);
            },
            "<Right>" => {
                let l: string = self.b.text.get(self.b.cy);

                self.b.cx = next_char(&l, self.b.cx);
            },
            "<Up>" => { if (self.b.cy > 0) { self.b.cy -= 1; } },
            "<Down>" => { if (self.b.cy + 1 < self.b.text.count) { self.b.cy += 1; } },
            "<Home>" => { self.b.cx = 0; },
            "<End>" => { self.b.cx = self.b.text.get(self.b.cy).len; },
            "<C-r>" => {
                self.insert_text(self.reg);
                return;
            },
            _ => {
                if (let c = k.typed()) {
                    self.insert_text(str::from_char(c));
                    return;
                }
                if (str::eq(*t, "<Space>")) {
                    self.insert_text(" ");
                    return;
                }
                return;
            }
        }
        let l: string = self.b.text.get(self.b.cy);

        self.b.clamp();
        self.b.want = col_of(&l, self.b.cx, self.b.tabstop);
    }

    /// pastes into the buffer (insert mode, or normal mode at the cursor) or
    /// the command line
    export fn paste(mut self: &App, text: string) -> void {
        if (self.mode == Mode::Command || self.mode == Mode::Search) {
            self.cmd.paste(str::replace(text, "\n", " "));
            return;
        }
        if (self.focus_tree) {
            return;
        }
        self.end_visual();
        let t: string = str::replace(text, "\r\n", "\n");
        let was_normal: bool = self.mode == Mode::Normal;

        self.insert_text(str::replace(t, "\r", "\n"));
        if (was_normal) {
            self.b.commit();
        }
        self.after();
    }

    // ---- the command line --------------------------------------------------------------

    fn start_cmd(mut self: &App, kind: string) -> void {
        self.cmd_kind = kind;
        if (str::eq(kind, ":")) {
            self.cmd.history = std::copy(self.hist_cmd);
        } else {
            self.cmd.history = std::copy(self.hist_search);
        }
        self.cmd.clear();
        self.msg = "";
        if (str::eq(kind, ":")) { self.mode = Mode::Command; } else { self.mode = Mode::Search; }
    }

    fn cmd_key(mut self: &App, k: &tui::Key, t: &string) -> void {
        if (str::eq(*t, "<Esc>") || str::eq(*t, "<C-c>") ||
            (str::eq(*t, "<BS>") && self.cmd.text.len == 0)) {
            self.mode = Mode::Normal;
            return;
        }
        if ((str::eq(*t, "<Tab>") || str::eq(*t, "<S-Tab>") || str::eq(*t, "<C-n>") ||
            str::eq(*t, "<C-p>")) && self.mode == Mode::Command) {
            self.complete(str::eq(*t, "<Tab>") || str::eq(*t, "<C-n>"));
            return;
        }
        self.wild = [];
        let r: tui::Edit = self.cmd.handle(k);

        if (r != tui::Edit::Submit && !str::eq(*t, "<CR>")) {
            return;
        }
        let line: string = self.cmd.commit();
        let kind: string = self.cmd_kind;

        self.mode = Mode::Normal;
        if (str::eq(kind, "cell")) {
            self.set_cell(self.cell_r, self.cell_c, line);
            return;
        }
        if (str::eq(kind, ":")) {
            self.hist_cmd = std::copy(self.cmd.history);
        } else {
            self.hist_search = std::copy(self.cmd.history);
        }
        self.keep_cmd_history();
        if (str::eq(kind, ":")) {
            self.ex(line);
        } else {
            var pat: string = line;

            if (pat.len == 0) { pat = self.last_search; }
            if (pat.len == 0) {
                self.fail_msg("E35: No previous regular expression");
                return;
            }
            self.last_search = pat;
            self.search_fwd = str::eq(kind, "/");
            self.set_matcher(pat);
            self.search_next(self.search_fwd);
        }
        self.after();
    }

    // a tree key -> 0 needs more keys, 1 done, 2 not one
    fn tree_cmd(mut self: &App, toks: &string[]) -> i64 {
        let n: i64 = toks.len;
        let t: string = toks[0];
        let h: i64 = self.tree_h;
        let at: i64 = self.tree.cursor;

        match (t) {
            "j" | "<Down>" | "<C-n>" => { self.tree.select(at + 1, h); },
            "k" | "<Up>" | "<C-p>" => { self.tree.select(at - 1, h); },
            "G" => { self.tree.select(self.tree.rows.len - 1, h); },
            "g" => {
                if (n < 2) {
                    return 0;
                }
                if (str::eq(toks[1], "g")) {
                    self.tree.select(0, h);
                } else {
                    return 2;
                }
            },
            "<C-d>" | "<PageDown>" => { self.tree.select(at + h / 2, h); },
            "<C-u>" | "<PageUp>" => { self.tree.select(at - h / 2, h); },
            "<CR>" | "o" | "l" | "<Right>" | "<2-LeftMouse>" => {
                self.tree_open(at, true);
            },
            "h" | "<Left>" => {
                if (self.tree.rows[at].open && at > 0) {
                    self.tree.collapse(at);
                } else {
                    self.tree.select(self.tree.parent(at), h);
                }
            },
            "R" => {
                self.tree.refresh();
                self.say("tree read again");
            },
            "H" => {
                self.tree.hidden = !self.tree.hidden;
                self.tree.refresh();
            },
            "-" => {
                let up: string = path::dir(self.tree.root);

                if (!str::eq(up, self.tree.root)) {
                    self.tree = tree(up, self.tree.hidden);
                    self.reveal();
                }
            },
            "C" => {
                if (self.tree.rows[at].dir) {
                    self.tree = tree(self.tree.rows[at].path, self.tree.hidden);
                }
            },
            "q" => {
                self.split.at = 0;
                self.focus_tree = false;
            },
            "n" => { self.search_next(self.search_fwd); },
            "N" => { self.search_next(!self.search_fwd); },
            ":" => { self.start_cmd(":"); },
            "/" => { self.start_cmd("/"); },
            "?" => { self.start_cmd("?"); },
            "<Esc>" => {},
            "<C-w>" => {
                if (n < 2) {
                    return 0;
                }
                let w: string = toks[1];

                if (str::eq(w, "l") || str::eq(w, "w") || str::eq(w, "<C-w>") ||
                    str::eq(w, "<C-l>") ||
                    str::eq(w, "p")) {
                    self.focus_tree = false;
                } else if (str::eq(w, ">") || str::eq(w, "<lt>")) {
                    if (str::eq(w, ">")) { self.split.by(1); } else { self.split.by(-1); }
                } else if (!str::eq(w, "h")) {
                    return 2;
                }
            },
            _ => { return 2; }
        }
        return 1;
    }

    /// chooses tree row i: a directory toggles, a file opens (focus: the editor
    /// gets the keys)
    export fn tree_open(mut self: &App, i: i64, focus: bool) -> void {
        if (i < 0 || i >= self.tree.rows.len) {
            return;
        }
        self.tree.cursor = i;
        if (self.tree.rows[i].dir) {
            if (i > 0) { self.tree.toggle(i); }
            return;
        }
        let p: string = self.tree.rows[i].path;

        if (self.edit(p) && focus) { self.focus_tree = false; }
    }

    // ---- ex commands -------------------------------------------------------------------

    /// runs an ex command line (what follows ":")
    export fn ex(mut self: &App, line0: string) -> void {
        var line: string = str::trim(line0);

        while (str::starts_with(line, ":")) {
            line = str::trim(str::substr(line, 1, line.len - 1));
        }
        if (line.len == 0) {
            return;
        }
        // a line number: 42, $
        if (str::eq(line, "$")) {
            self.go_first(self.b.text.count - 1);
            return;
        }
        match (str::parse_int(line)) {
            n => {
                self.go_first(n - 1);
                return;
            },
            e: str::BadInt => {}
        }
        if (str::starts_with(line, "!")) {
            let sh: string = str::trim(str::substr(line, 1, line.len - 1));

            if (!self.builtin(sh)) {
                self.run_job(Command { name: "!", run: ["sh", "-c", sh], show: "panel" });
            }
            return;
        }
        // a range: lines y1..y2 (%, N, ., $, '<, '>, optionally followed by +N, -N)
        var y1: i64 = self.b.cy;
        var y2: i64 = self.b.cy;
        var ranged: bool = false;
        let rg: i64[] = self.ex_range(&line);

        if (rg.len == 1) {
            self.fail_msg("E16: Invalid range");
            return;
        }
        if (rg.len == 3) {
            ranged = true;
            y1 = rg[0];
            y2 = rg[1];
            line = str::trim(str::substr(line, rg[2], line.len - rg[2]));
            if (y2 < y1) {
                let t: i64 = y1;

                y1 = y2;
                y2 = t;
            }
            if (line.len == 0) {
                self.go_first(y2);
                return;
            }
        }
        if (str::starts_with(line, "substitute") ||
            (line.len > 1 && line[0] == 's' && !wordy(line[1]) && line[1] != ' ')) {
            self.substitute(line, ranged, y1, y2);
            return;
        }
        if (ranged) {
            let what: string = str::trim(line);

            if (str::eq(what, "d") || str::eq(what, "delete")) {
                self.op_lines("d", y1, y2);
            } else if (str::eq(what, "y") || str::eq(what, "yank")) {
                self.op_lines("y", y1, y2);
            } else if (str::eq(what, ">") || str::eq(what, "<")) {
                self.op_lines(what, y1, y2);
            } else if (str::eq(what, "j") || str::eq(what, "join")) {
                var times: i64 = y2 - y1;

                if (times < 1) { times = 1; }
                self.join_lines(y1, times);
            } else {
                self.fail_msg("E481: No range allowed: \(what) (ranges: s d y > < j)");
            }
            return;
        }
        // name: letters (and a trailing !), then the argument
        var ne: i64 = 0;

        while (ne < line.len && line[ne] != ' ' && line[ne] != '!') { ne += 1; }
        var bang: bool = false;
        var name: string = str::substr(line, 0, ne);

        if (ne < line.len && line[ne] == '!') {
            bang = true;
            ne += 1;
        }
        let arg: string = str::trim(str::substr(line, ne, line.len - ne));

        match (name) {
            "w" | "write" => { self.write(arg, bang); },
            "earlier" | "ea" | "later" | "lat" => {
                let back: bool = str::starts_with(name, "e");
                var a: string = arg;

                if (a.len == 0) { a = "1"; }
                var unit: i64 = 0;          // 0: changes, else seconds per unit
                let last: u8 = a[a.len - 1];

                if (last == 's') { unit = 1; }
                if (last == 'm') { unit = 60; }
                if (last == 'h') { unit = 3600; }
                if (last == 'd') { unit = 86400; }
                if (last == 'f') { unit = -1; }
                var num: string = a;

                if (unit != 0) { num = str::substr(a, 0, a.len - 1); }
                var k: i64 = 0;

                match (str::parse_int(num)) {
                    v => { k = v; },
                    e: str::BadInt => {
                        self.fail_msg("E475: :\(name) N, Ns, Nm, Nh, Nd or Nf");
                        return;
                    }
                }
                var moved: bool = false;

                if (unit == 0) {
                    if (back) { moved = self.b.go_to(self.b.hist.at - k); }
                    else { moved = self.b.go_to(self.b.hist.at + k); }
                } else if (unit < 0) {
                    // f: to the last written state
                    moved = self.b.go_to(self.b.hist.saved);
                } else if (back) {
                    moved = self.b.earlier_by(k * unit);
                } else {
                    moved = self.b.later_by(k * unit);
                }
                if (moved) {
                    self.say_state();
                } else if (back) {
                    self.say("Already at oldest change");
                } else {
                    self.say("Already at newest change");
                }
            },
            "undol" | "undolist" | "undotree" => {
                var out: string[] = [];
                let now: i64 = time::since_epoch() / 1s;
                let h: &self::&History = &self.b.hist;
                var mark: string = " ";

                if (h.at == 0) { mark = ">"; }
                // (the latest states, as many as the panel shows)
                let first: i64 = h.nodes.len - 15;

                if (first <= 0) { out.push("\(mark)    0  the file as read"); }

                for (let k: i64, let c: &h::&Change in &h.nodes) {
                    if (k < first) { continue; }
                    mark = " ";
                    if (k + 1 == h.at) { mark = ">"; }
                    var saved: string = "";

                    if (k + 1 == h.saved) { saved = "  (written)"; }
                    let no: string = str::pad_start("\(k + 1)", 5, ' ');
                    let par: string = str::pad_start("\(c.parent)", 5, ' ');

                    out.push("\(mark)\(no)  from \(par)  \(c.ops.len) edits  \(ago(now - c.time))\(saved)"
                    );
                }
                self.panel = out;
                self.panel_title = "undo history: \(self.b.hist.nodes.len) states (g- g+ :earlier :later)";
            },
            "wq" | "x" | "xit" | "exit" => {
                if (self.b.modified || !str::eq(name, "x")) {
                    if (!self.write(arg, bang)) {
                        return;
                    }
                }
                self.quit_all(bang);
            },
            "wa" | "wall" => {
                if (self.b.modified && self.b.path.len > 0) { self.write("", bang); }
                var failed: string[] = [];

                for (let i: i64 in 0..self.others.len) {
                    let o: &self::&Buf = mut &self.others[i];

                    if (o.modified && o.path.len > 0 && !o.scratch) {
                        let (n, bad) = save_buf(o, "", bang, self.persist && self.cfg.undofile);

                        if (str::starts_with(bad, "E949")) {
                            failed.push("\(o.name) (changed since read)");
                        } else if (bad.len > 0) {
                            failed.push(o.name);
                        }
                    }
                }
                if (failed.len > 0) {
                    self.fail_msg("E141: not written: \(str::join(&failed, ", "))");
                }
            },
            "q" | "quit" | "qa" | "qall" | "quitall" => { self.quit_all(bang); },
            "wqa" | "xa" | "xall" => {
                self.ex("wa");
                self.quit_all(bang);
            },
            "e" | "edit" => {
                if (arg.len == 0) {
                    if (bang) {
                        self.reload_current();
                    } else {
                        self.file_info();
                    }
                    return;
                }
                self.edit(arg);
            },
            "ene" | "enew" => {
                var nb: Buf = bufm::scratch(self.next_id, "", "");

    fn file_info(mut self: &App) -> void {
        var nm: string = self.b.name;

        if (nm.len == 0) { nm = "[No Name]"; }
        var mod: string = "";

        if (self.b.modified) { mod = " [Modified]"; }
        let pct: i64 = (self.b.cy + 1) * 100 / self.b.text.count;
        var extra: string = "";

        if (self.b.text.broken.len > 0) { extra = " (\(self.b.text.broken))"; }
        self.say(
            "\"\(nm)\"\(mod) \(self.b.text.count) lines --\(pct)%-- (\(self.b.text.loaded_count())/\(self.b.text.chunk_count()) chunks in memory)\(extra)"
        );
    }

    fn list_buffers(mut self: &App) -> void {
        var lines: string[] = [];

        for (let b: BufInfo in self.infos()) {
            var flags: string = " ";

            if (b.id == self.b.id) { flags = "%"; } else if (b.id == self.alt) { flags = "#"; }
            var mod: string = " ";

            if (b.modified) { mod = "+"; }
            lines.push("\(str::pad_start("\(b.id)", 3, ' ')) \(flags)\(mod) \"\(b.name)\"  line \(b.line)"
            );
        }
        self.panel = lines;
        self.panel_title = "buffers (:b N)";
    }

    fn buffer_arg(mut self: &App, arg: string) -> void {
        if (arg.len == 0) {
            self.open_picker("buffers");
            return;
        }
        if (str::eq(arg, "#")) {
            if (self.alt >= 0) { self.switch_id(self.alt); }
            return;
        }
        let all: BufInfo[] = self.infos();

        for (let b: &BufInfo in &all) {
            if (str::eq("\(b.id)", arg)) {
                self.switch_id(b.id);
                return;
            }
        }
        var hit: i64 = -1;
        var hits: i64 = 0;

        for (let b: &BufInfo in &all) {
            if (str::contains(b.name, arg)) {
                hit = b.id;
                hits += 1;
            }
        }
        if (hits == 1) {
            self.switch_id(hit);
            return;
        }
        if (hits > 1) {
            self.fail_msg("E93: More than one match for \(arg)");
            return;
        }
        self.fail_msg("E94: No matching buffer for \(arg)");
    }

    fn set_cmd(mut self: &App, arg: string) -> void {
        if (arg.len == 0 || str::eq(arg, "all")) {
            var lines: string[] = [];

            for (let o: string in &OPTIONS) { lines.push("  \(o)=\(self.cfg.get(o))"); }
            self.panel = lines;
            self.panel_title = "options";
            return;
        }

        for (let word: string in str::fields(arg)) {
            var name: string = word;
            var value: string = "true";

            if (let eq = str::find(word, "=")) {
                name = str::substr(word, 0, eq);
                value = str::substr(word, eq + 1, word.len - eq - 1);
            } else if (str::ends_with(word, "?")) {
                let nm: string = str::substr(word, 0, word.len - 1);

                self.say("  \(nm)=\(self.cfg.get(nm))");
                continue;
            } else if (str::ends_with(word, "!")) {
                name = str::substr(word, 0, word.len - 1);
                if (str::eq(self.cfg.get(name), "true")) { value = "false"; }
            } else if (str::starts_with(word, "no") &&
                self.cfg.get(str::substr(word, 2, word.len - 2)).len > 0) {
                name = str::substr(word, 2, word.len - 2);
                value = "false";
            } else if (str::starts_with(word, "inv")) {
                name = str::substr(word, 3, word.len - 3);
                if (str::eq(self.cfg.get(name), "true")) { value = "false"; }
            }
            let why: string = self.cfg.set(name, value);

            if (why.len > 0) {
                self.fail_msg("E518: \(why)");
                return;
            }
            if (str::eq(name, "theme")) {
                self.look = look(&self.cfg.themes, self.cfg.theme);
                self.shape = -1;
            }
            if (str::eq(name, "tree")) {
                if (self.cfg.tree) {
                    self.split.at = self.cfg.tree_width;
                } else {
                    self.split.at = 0;
                }
            }
            if (str::eq(name, "tree-width") && self.split.at > 0) {
                self.split.at = self.cfg.tree_width;
            }
            if (str::eq(name, "tabstop") || str::eq(name, "ts")) {
                self.b.tabstop = self.cfg.tabstop;
            }
        }
    }

/// the running job's next output, or its end (cancel-safe: a select that
/// drops it loses nothing)
export async fn job_read(mut j: &Job) -> JobRead {
    let c: &j::&process::Child = mut &j.child[0];

    match (await c.stdout.read(65536)) {
        data => {
            if (data.len > 0) {
                return JobRead { data: data };
            }
        },
        e: process::IoError => {}
    }
    match (await c.wait()) {
        ex => {
            c.close();
            var code: i64 = ex.code;

            if (ex.signal != 0) { code = 128 + ex.signal; }
            return JobRead { done: true, code: code };
        },
        e: process::ProcError => {
            c.close();
            return JobRead { done: true, code: -1 };
        }
    }
    return JobRead { done: true, code: -1 };
}

// writes b (to p; "": its own file; force: even if changed on disk), with
// its undo history if keep -> bytes written, and the error ("": none)
fn save_buf(mut b: &Buf, p: string, force: bool, keep: bool) -> (i64, string) {
    match (b.save(p, force)) {
        n => {
            if (keep) { b.keep_history(); }
            return (n, "");
        },
        e: fs::NotFound => { return (0, "E212: Can't open file for writing: \(e.path)"); },
        e2: fs::PermissionDenied => { return (0, "E212: permission denied: \(e2.path)"); },
        e3: fs::IsADirectory => { return (0, "E502: is a directory: \(e3.path)"); },
        e4: fs::IoError => { return (0, "E667: write failed: \(e4.path)"); },
        e5: ChangedOnDisk => {
            return (0, "E949: \(b.name) changed since it was read (:w! to write anyway)");
        }
    }
    return (0, "");
}
