//! zap's file tree: the directory zap started in, with directories opened
//! and closed in place. The tree holds only visible rows: opening a
//! directory lists it (directories first, then files, each by name) and
//! inserts its entries below it; closing removes them.

import fs from "std/fs";
import str from "std/string";
import path from "std/path";
import state from "state.ae";

/// a tree row: an entry, its depth, and for a directory whether it is
/// open
export struct Entry {
    export path: string;
    export name: string;
    export depth: i64;
    export dir: bool;
    export open: bool = false;
}

/// the visible rows, the selected one, the first one on screen
export struct Tree {
    export root: string;
    export rows: Entry[] = [];
    export cursor: i64 = 0;
    export top: i64 = 0;
    export hidden: bool = true;  // show names starting with "."
}

/// the tree of directory root (its name as first row, its entries open)
export fn tree(root: string, hidden: bool) -> Tree {
    var t: Tree = Tree { root: root, hidden: hidden };
    var name: string = path::base(root);

    if (name.len == 0) { name = root; }
    t.rows.push(Entry { path: root, name: name, depth: 0, dir: true, open: false });
    t.expand(0);
    return t;
}

// does entry i sort before j (by name ignoring case, then bytes)? low[k]
// is entry k's name lowercased
fn before(xs: &Entry[], low: &string[], i: i64, j: i64) -> bool {
    let c: i64 = str::cmp(low[i], low[j]);

    if (c != 0) {
        return c < 0;
    }
    return str::cmp(xs[i].name, xs[j].name) < 0;
}

// sort xs: a merge sort of their indices, each name lowercased once (a
// directory can have thousands of entries: node_modules)
fn sort(mut xs: &Entry[]) -> void {
    let n: i64 = xs.len;

    if (n < 2) {
        return;
    }
    var low: string[] = [];
    var idx: i64[] = [];

    for (let k: i64 in 0..n) {
        low.push(str::to_lower(xs[k].name));
        idx.push(k);
    }
    var tmp: i64[] = std::copy(idx);
    var width: i64 = 1;

    while (width < n) {
        var lo: i64 = 0;

        while (lo < n) {
            var mid: i64 = lo + width;

            if (mid > n) { mid = n; }
            var hi: i64 = lo + 2 * width;

            if (hi > n) { hi = n; }
            var i: i64 = lo;
            var j: i64 = mid;
            var k: i64 = lo;

            while (k < hi) {
                if (i < mid && (j >= hi || !before(xs, &low, idx[j], idx[i]))) {
                    tmp[k] = idx[i];
                    i += 1;
                } else {
                    tmp[k] = idx[j];
                    j += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        let t: i64[] = idx;

        idx = tmp;
        tmp = t;
        width *= 2;
    }
    var out: Entry[] = [];

    for (let k: i64 in &idx) { out.push(std::take(mut &xs[k])); }
    *xs = out;
}

impl Tree {
    /// open row i (a directory): its entries go below it
    export fn expand(mut self: &Tree, i: i64) -> void {
        if (i < 0 || i >= self.rows.len || !self.rows[i].dir || self.rows[i].open) {
            return;
        }
        let dir: string = self.rows[i].path;
        let depth: i64 = self.rows[i].depth + 1;
        let names: string[] = match (fs::list(dir)) {
            n => n,
            e: fs::NotFound => [], e2: fs::PermissionDenied => [], e3: fs::NotADirectory => [],
            e4: fs::IoError => []
        };
        var dirs: Entry[] = [];
        var files: Entry[] = [];

        for (let nm: string in &names) {
            if (!self.hidden && nm.len > 0 && nm[0] == '.') { continue; }
            let p: string = path::join(dir, nm);
            var is_dir: bool = false;

            match (fs::info(p)) {
                inf => { is_dir = inf.kind == fs::Kind::Dir; },
                e: fs::NotFound => {}, e2: fs::PermissionDenied => {}, e3: fs::IoError => {}
            }
            let en: Entry = Entry { path: p, name: nm, depth: depth, dir: is_dir };

            if (is_dir) { dirs.push(en); } else { files.push(en); }
        }
        sort(mut &dirs);
        sort(mut &files);
        var rest: Entry[] = [];

        while (self.rows.len > i + 1) { rest.push(self.rows.pop()); }

        for (let k: i64 in 0..dirs.len) { self.rows.push(std::take(mut &dirs[k])); }

        for (let k: i64 in 0..files.len) { self.rows.push(std::take(mut &files[k])); }

        while (rest.len > 0) { self.rows.push(rest.pop()); }
        self.rows[i].open = true;
    }

    /// close row i (a directory): its entries are removed
    export fn collapse(mut self: &Tree, i: i64) -> void {
        if (i < 0 || i >= self.rows.len || !self.rows[i].open) {
            return;
        }
        let depth: i64 = self.rows[i].depth;
        var end: i64 = i + 1;

        while (end < self.rows.len && self.rows[end].depth > depth) { end += 1; }
        let gone: i64 = end - (i + 1);
        var keep: Entry[] = [];

        for (let k: i64 in 0..self.rows.len) {
            if (k <= i || k >= end) { keep.push(std::copy(self.rows[k])); }
        }
        self.rows = keep;
        self.rows[i].open = false;
        if (self.cursor > i && self.cursor < end) {
            self.cursor = i;
        } else if (self.cursor >= end) {
            self.cursor -= gone;
        }
    }

    /// open or close row i
    export fn toggle(mut self: &Tree, i: i64) -> void {
        if (i < 0 || i >= self.rows.len || !self.rows[i].dir) {
            return;
        }
        if (self.rows[i].open) { self.collapse(i); } else { self.expand(i); }
    }

    /// the row of row i's directory (i itself for the root)
    export fn parent(self: &Tree, i: i64) -> i64 {
        if (i <= 0 || i >= self.rows.len) {
            return 0;
        }
        let d: i64 = self.rows[i].depth;
        var k: i64 = i - 1;

        while (k > 0 && self.rows[k].depth >= d) { k -= 1; }
        return k;
    }

    /// select row i (clamped), shown in height rows
    export fn select(mut self: &Tree, i: i64, height: i64) -> void {
        var j: i64 = i;

        if (j >= self.rows.len) { j = self.rows.len - 1; }
        if (j < 0) { j = 0; }
        self.cursor = j;
        self.show(height);
    }

    /// scroll so the selection shows in height rows
    export fn show(mut self: &Tree, height: i64) -> void {
        if (self.cursor < self.top) { self.top = self.cursor; }
        if (height > 0 && self.cursor >= self.top + height) { self.top = self.cursor - height + 1; }
        if (self.top < 0) { self.top = 0; }
    }
