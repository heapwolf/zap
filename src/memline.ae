//! zap's text storage (memline): a buffer's lines in chunks of ~8 KB of
//! whole lines, at most `resident` of them in memory at once.
//!
//! * Opening a file reads it once, block by block, to find each chunk's
//!   start and line count; no text is kept.
//! * A chunk is loaded (`fs::read_at`) on first access; the least recently
//!   used one is evicted when too many are loaded.
//! * A changed chunk is the only copy of its lines: on eviction it is
//!   appended to a swap file (`~/.local/state/zap/swap/`) and reloaded from
//!   there. A chunk past 512 lines is split.
//! * Writing goes to a new file first, chunk by chunk, then over the old one
//!   in place (same file: mode, owner and links kept); after that every chunk
//!   comes from it. A file changed on disk since it was read is not
//!   overwritten unless forced.
//! * If a chunk fails to reload (file changed or gone), the memline is marked
//!   `broken` and refuses to write: it never saves lost lines.

import fs from "std/fs";
import str from "std/string";
import time from "std/time";
import process from "std/process";
import state from "state.ae";

let CHUNK_BYTES: i64 = 8192;
let SPLIT_LINES: i64 = 512;
let SCAN_BLOCK: i64 = 65536;

/// where a chunk's text lives when not in memory
export enum Where { File, Swap, Memory }

// a run of lines: where its text is (bytes off..off+size of the file or
// swap file), its line count, and its lines while in memory
struct Chunk {
    place: Where;
    off: i64 = 0;
    size: i64 = 0;
    count: i64;
    lines: string[] = [];
    loaded: bool = false;
    dirty: bool = false;  // in memory and changed: the lines are the only copy
    used: i64 = 0;        // last use time (for eviction)
}

/// a buffer's lines
export struct MemLine {
    export file: string = "";    // where File chunks are read from ("": none)
    export count: i64 = 0;       // lines
    export crlf: bool = false;   // file lines end in \r\n
    export eol: bool = true;     // last line ends in a newline
    export resident: i64 = 32;   // max chunks in memory
    export broken: string = "";  // why a chunk failed to load ("": none)
    export swapped: i64 = 0;     // chunks written to the swap file so far
    swap: string = "";
    swap_size: i64 = 0;
    chunks: Chunk[] = [];
    loaded: i64[] = [];  // chunks in memory
    clock: i64 = 0;
    hint: i64 = 0;       // last chunk found, and its first line
    hint_start: i64 = 0;
    export stamp: i64 = 0;  // file size and time when read (or written)
    export stamp_time: Duration = 0ms;
}

/// one empty line, in memory
export fn empty() -> MemLine {
    var m: MemLine = MemLine {};

    m.chunks.push(Chunk { place: Where::Memory, count: 1, lines: [""], loaded: true, dirty: true }
    );
    m.loaded.push(0);
    m.count = 1;
    return m;
}

/// lines in memory (a scratch buffer, e.g. a command's output)
export fn of_text(text: string) -> MemLine {
    var m: MemLine = MemLine {};
    var lines: string[] = str::split(text, "\n");

    if (lines.len > 1 && lines[lines.len - 1].len == 0) { lines.pop(); }
    var part: string[] = [];

    for (let l: string in lines) {
        part.push(l);
        if (part.len >= SPLIT_LINES / 2) {
            m.add_memory(part);
            part = [];
        }
    }
    // (split gives at least one line, so at least one chunk)
    if (part.len > 0) { m.add_memory(part); }
    return m;
}

/// the file at p, indexed only (no text kept): its chunks and lines
export fn open(p: string) -> MemLine | fs::NotFound | fs::PermissionDenied | fs::IsADirectory |
    fs::IoError {
    var m: MemLine = MemLine { file: p };
    let info: fs::Info = match (fs::info(p)) {
        i => i,
        e: fs::NotFound => { fail e; },
        e2: fs::PermissionDenied => { fail e2; },
        e3: fs::IoError => { fail e3; }
    };

    if (info.kind == fs::Kind::Dir) { fail fs::IsADirectory { path: p }; }
    m.stamp = info.size;
    m.stamp_time = info.modified;
    var at: i64 = 0;
    var start: i64 = 0;  // start of the chunk being found
    var lines: i64 = 0;  // its lines so far
    var last: u8 = 10;
    var first_line: bool = true;

    while (true) {
        let block: string = fs::read_at(p, at, SCAN_BLOCK)?;
        let n: i64 = block.len;

        if (n == 0) { break; }

        for (let i: i64 in 0..n) {
            if (block[i] == 10) {
                if (first_line) {
                    m.crlf = i > 0 && block[i - 1] == 13;
                    first_line = false;
                }
                lines += 1;
                let end: i64 = at + i + 1;

                if (end - start >= CHUNK_BYTES) {
                    m.chunks.push(Chunk {
                        place: Where::File, off: start, size: end - start, count: lines
                    });
                    m.count += lines;
                    start = end;
                    lines = 0;
                }
            }
        }
        last = block[n - 1];
        at += n;
    }
    m.eol = last == 10;
    if (at > start) {
        // the rest: whole lines, plus the last one if it has no newline
        var count: i64 = lines;

        if (!m.eol) { count += 1; }
        m.chunks.push(Chunk { place: Where::File, off: start, size: at - start, count: count });
        m.count += count;
    }
    if (m.chunks.len == 0) {
        m.chunks.push(Chunk {
            place: Where::Memory, count: 1, lines: [""], loaded: true, dirty: true
        });
        m.loaded.push(0);
        m.count = 1;
    }
    return m;
}

// swap file path for a buffer of file p (dir made on first use)
fn swap_path(p: string) -> string {
    let dir: string = state::dir("swap");

    state::ensure_dir(dir);
    var name: string = state::flat(p);

    if (name.len == 0) { name = "noname"; }
    return "\(dir)/\(name).\(time::now().elapsed() / 1ns).swp";
}

/// the file changed on disk since it was read (:w! writes anyway)
export failure ChangedOnDisk { path: string; }

// where p's new text goes when p's directory cannot take a file
fn stage_path(p: string) -> string {
    let dir: string = state::dir("new");

    state::ensure_dir(dir);
    return "\(dir)/\(state::flat(p))";
}

fn remove_quietly(p: string) -> void {
    match (fs::remove(p)) {
        v => {}, e: fs::NotFound => {}, e2: fs::PermissionDenied => {}, e3: fs::NotEmpty => {},
        e4: fs::IoError => {}
    }
}

// copy size bytes of src over dst (truncate, then append block by block:
// dst stays the same file) -> did it all go?
fn copy_over(src: string, dst: string, size: i64) -> bool {
    match (fs::write_text(dst, "", fs::Write {})) {
        v => {},
        e: fs::NotFound => { return false; }, e2: fs::PermissionDenied => { return false; },
        e3: fs::IsADirectory => { return false; }, e4: fs::IoError => { return false; }
    }
    var at: i64 = 0;

    while (at < size) {
        let block: string = match (fs::read_at(src, at, 1048576)) {
            t => t,
            e: fs::NotFound => { return false; }, e2: fs::PermissionDenied => { return false; },
            e3: fs::IsADirectory => { return false; }, e4: fs::IoError => { return false; }
        };

        if (block.len == 0) {
            return false;
        }
        match (fs::write_text(dst, block, fs::Write { append: true })) {
            v => {},
            e: fs::NotFound => { return false; }, e2: fs::PermissionDenied => { return false; },
            e3: fs::IsADirectory => { return false; }, e4: fs::IoError => { return false; }
        }
        at += block.len;
    }
    return true;
}

// text split into lines (no trailing empty line; \r stripped if crlf)
fn split_lines(text: string, crlf: bool) -> string[] {
    var lines: string[] = str::split(text, "\n");

    if (lines.len > 0 && lines[lines.len - 1].len == 0) { lines.pop(); }
    if (crlf) {
        for (let i: i64 in 0..lines.len) {
            let l: string = lines[i];

            if (l.len > 0 && l[l.len - 1] == 13) { lines[i] = str::substr(l, 0, l.len - 1); }
        }
    }
    return lines;
}

impl MemLine {
    // append a chunk of in-memory lines
    fn add_memory(mut self: &MemLine, lines: string[]) -> void {
        let n: i64 = lines.len;

        self.chunks.push(Chunk {
            place: Where::Memory, count: n, lines: lines, loaded: true, dirty: true
        });
        self.loaded.push(self.chunks.len - 1);
        self.count += n;
    }

    /// chunks in total, and in memory now
    export fn chunk_count(self: &MemLine) -> i64 { return self.chunks.len; }

    export fn loaded_count(self: &MemLine) -> i64 { return self.loaded.len; }

    /// the chunk holding line i (0 <= i <= count; count: last chunk); its
    /// first line goes in hint_start
    fn locate(mut self: &MemLine, i: i64) -> i64 {
        let n: i64 = self.chunks.len;
        var k: i64 = self.hint;
        var s: i64 = self.hint_start;

        if (k >= n || k < 0) {
            k = 0;
            s = 0;
        }

        while (i < s && k > 0) {
            k -= 1;
            s -= self.chunks[k].count;
        }

        while (k < n - 1 && i >= s + self.chunks[k].count) {
            s += self.chunks[k].count;
            k += 1;
        }
        self.hint = k;
        self.hint_start = s;
        return k;
    }

    // load chunk k if needed and mark it most recently used
    fn load(mut self: &MemLine, k: i64) -> void {
        self.clock += 1;
        self.chunks[k].used = self.clock;
        if (self.chunks[k].loaded) {
            return;
        }
        let want: i64 = self.chunks[k].count;
        var src: string = self.file;
        var crlf: bool = self.crlf;

        if (self.chunks[k].place == Where::Swap) {
            src = self.swap;
            crlf = false;
        }
        var lines: string[] = [];

        match (fs::read_at(src, self.chunks[k].off, self.chunks[k].size)) {
            text => {
                if (text.len != self.chunks[k].size) {
                    self.broken = "\(src) is shorter than when it was read";
                }
                lines = split_lines(text, crlf);
            },
            e: fs::NotFound => { self.broken = "\(src) is gone"; },
            e2: fs::PermissionDenied => { self.broken = "\(src) cannot be read"; },
            e3: fs::IsADirectory => { self.broken = "\(src) is a directory now"; },
            e4: fs::IoError => { self.broken = "\(src) could not be read"; }
        }
        if (self.chunks[k].place == Where::File && self.broken.len == 0) {
            if (self.changed_on_disk()) { self.broken = "\(src) changed on disk"; }
        }

        // (a short chunk keeps its line count: blank lines, and broken says why)
        while (lines.len < want) { lines.push(""); }

        while (lines.len > want) { lines.pop(); }
        self.chunks[k].lines = lines;
        self.chunks[k].loaded = true;
        self.loaded.push(k);
        self.trim(k);
    }

    /// remove line i (later lines move up)
    export fn remove(mut self: &MemLine, i: i64) -> void {
        let k: i64 = self.locate(i);

        self.load(k);
        let j: i64 = i - self.hint_start;
        let n: i64 = self.chunks[k].lines.len;

        for (let m: i64 in j..(n - 1)) { self.chunks[k].lines[m] = self.chunks[k].lines[m + 1]; }
        self.chunks[k].lines.pop();
        self.chunks[k].count -= 1;
        self.chunks[k].dirty = true;
        self.count -= 1;
        if (self.chunks[k].count == 0 && self.chunks.len > 1) { self.drop_chunk(k); }
    }

    // split chunk k (in memory, too long) in two
    fn split(mut self: &MemLine, k: i64) -> void {
        let n: i64 = self.chunks[k].lines.len;
        let half: i64 = n / 2;
        var tail: string[] = [];

        for (let m: i64 in half..n) { tail.push(self.chunks[k].lines[m]); }

        while (self.chunks[k].lines.len > half) { self.chunks[k].lines.pop(); }
        self.chunks[k].count = half;
        var rest: Chunk[] = [];

        while (self.chunks.len > k + 1) { rest.push(self.chunks.pop()); }
        self.clock += 1;
        self.chunks.push(Chunk {
            place: Where::Memory, count: n - half, lines: tail, loaded: true, dirty: true,
            used: self.clock
        });

        while (rest.len > 0) { self.chunks.push(rest.pop()); }

        for (let j: i64 in 0..self.loaded.len) {
            if (self.loaded[j] > k) { self.loaded[j] += 1; }
        }
        self.loaded.push(k + 1);
        self.trim(k);
    }

    // remove chunk k (empty) from the list
    fn drop_chunk(mut self: &MemLine, k: i64) -> void {
        var rest: Chunk[] = [];

        while (self.chunks.len > k + 1) { rest.push(self.chunks.pop()); }
        self.chunks.pop();

        while (rest.len > 0) { self.chunks.push(rest.pop()); }
        var j: i64 = 0;

        while (j < self.loaded.len) {
            if (self.loaded[j] == k) {
                self.drop_loaded(j);
                continue;
            }
            if (self.loaded[j] > k) { self.loaded[j] -= 1; }
            j += 1;
        }
        self.hint = 0;
        self.hint_start = 0;
    }

    // chunk k's lines as in the file (with newlines; the last line's only if
    // the file ends in one), without loading it into memory
    fn chunk_text(mut self: &MemLine, k: i64, last: bool) -> string {
        if (!self.chunks[k].loaded && self.chunks[k].place == Where::File) {
            match (fs::read_at(self.file, self.chunks[k].off, self.chunks[k].size)) {
                t => {
                    if (t.len != self.chunks[k].size) { self.broken = "\(self.file) changed"; }
                    return t;
                },
                e: fs::NotFound => { self.broken = "\(self.file) is gone"; },
                e2: fs::PermissionDenied => { self.broken = "\(self.file) cannot be read"; },
                e3: fs::IsADirectory => { self.broken = "\(self.file) is a directory"; },
                e4: fs::IoError => { self.broken = "\(self.file) could not be read"; }
            }
            return "";
        }
        var lines: string[] = [];

        if (self.chunks[k].loaded) {
            lines = std::copy(self.chunks[k].lines);
        } else {
            match (fs::read_at(self.swap, self.chunks[k].off, self.chunks[k].size)) {
                t => { lines = split_lines(t, false); },
                e: fs::NotFound => { self.broken = "the swap file is gone"; },
                e2: fs::PermissionDenied => { self.broken = "the swap file cannot be read"; },
                e3: fs::IsADirectory => { self.broken = "the swap file is a directory"; },
                e4: fs::IoError => { self.broken = "the swap file could not be read"; }
            }
        }
        var b: str::Builder;
        let n: i64 = lines.len;

        for (let i: i64, let l: string in &lines) {
            b.add(l);
            if (i < n - 1 || !last || self.eol) {
                if (self.crlf) { b.add_byte(13); }
                b.add_byte(10);
            }
        }
        return b.to_string();
    }

    /// write every line to file p -> bytes written. The text goes to a new
    /// file first (beside p, or in zap's state directory if p's directory
    /// cannot take one), then over p in place: p keeps its inode, mode,
    /// owner and links (a symlink's target is written). If p changed on disk
    /// since it was read, it is not written unless force. If copying over p
    /// fails, the new file stays and the failure names it. adopt: p becomes
    /// this buffer's file and every chunk comes from it (none from memory or
    /// the swap file)
    export fn write(mut self: &MemLine, p: string, adopt: bool, force: bool) -> i64 |
        fs::NotFound | fs::PermissionDenied | fs::IsADirectory | fs::IoError | ChangedOnDisk {
        if (self.broken.len > 0) { fail fs::IoError { path: self.broken }; }
        var there: bool = false;

        match (fs::info(p)) {
            i => {
                if (i.kind == fs::Kind::Dir) { fail fs::IsADirectory { path: p }; }
                there = true;
            },
            e: fs::NotFound => {}, e2: fs::PermissionDenied => { fail e2; },
            e3: fs::IoError => { fail e3; }
        }
        if (there && !force && str::eq(p, self.file) && (self.stamp_time / 1ns) != 0 &&
            self.changed_on_disk()) {
            fail ChangedOnDisk { path: p };
        }
        // write the whole new text somewhere first
        var tmp: string = "\(p).zap-new";

        match (fs::write_text(tmp, "", fs::Write {})) {
            v => {},
            e: fs::NotFound => { tmp = stage_path(p); },
            e2: fs::PermissionDenied => { tmp = stage_path(p); },
            e3: fs::IsADirectory => { tmp = stage_path(p); },
            e4: fs::IoError => { tmp = stage_path(p); }
        }
        fs::write_text(tmp, "", fs::Write {})?;
        var offs: i64[] = [];
        var sizes: i64[] = [];
        var at: i64 = 0;
        var b: str::Builder;
        let n: i64 = self.chunks.len;

        for (let k: i64 in 0..n) {
            let t: string = self.chunk_text(k, k == n - 1);

            offs.push(at);
            sizes.push(t.len);
            at += t.len;
            b.add(t);
            if (b.len() >= 262144 || k == n - 1) {
                fs::write_text(tmp, b.to_string(), fs::Write { append: true })?;
                b.clear();
            }
        }
        if (self.broken.len > 0) {
            remove_quietly(tmp);
            fail fs::IoError { path: self.broken };
        }
        // then over p: a new file is renamed into place; an existing one is
        // overwritten block by block
        var placed: bool = false;

        if (!there) {
            match (fs::rename(tmp, p)) {
                v => { placed = true; },
                e: fs::NotFound => {}, e2: fs::PermissionDenied => {}, e3: fs::IsADirectory => {},
                e4: fs::NotEmpty => {}, e5: fs::IoError => {}
            }
        }
        if (!placed) {
            if (!copy_over(tmp, p, at)) {
                fail fs::IoError { path: "\(p) (its new text is in \(tmp))" };
            }
            remove_quietly(tmp);
        }
        if (adopt) {
            self.file = p;

            for (let k: i64 in 0..n) {
                self.chunks[k].place = Where::File;
                self.chunks[k].off = offs[k];
                self.chunks[k].size = sizes[k];
                self.chunks[k].dirty = false;
            }
            match (fs::info(p)) {
                i => {
                    self.stamp = i.size;
                    self.stamp_time = i.modified;
                },
                e: fs::NotFound => {}, e2: fs::PermissionDenied => {}, e3: fs::IoError => {}
            }
            self.drop_swap();
        }
        return at;
    }

    // remove the swap file (nothing comes from it any more)
    fn drop_swap(mut self: &MemLine) -> void {
        if (self.swap.len == 0) {
            return;
        }
        remove_quietly(self.swap);
        self.swap = "";
        self.swap_size = 0;
    }

    /// done: remove its swap file (unsaved changes are lost)
    export fn close(mut self: &MemLine) -> void {
        for (let k: i64 in 0..self.chunks.len) {
            if (self.chunks[k].place == Where::Swap) { self.chunks[k].place = Where::Memory; }
        }
        self.drop_swap();
    }

    /// all lines as one string (small buffers: command output, tests)
    export fn text(mut self: &MemLine) -> string {
        var b: str::Builder;

        for (let i: i64 in 0..self.count) {
            b.add(self.get(i));
            b.add_byte(10);
        }
        return b.to_string();
    }
}

// ---- tests ---------------------------------------------------------------------

fn sample(n: i64) -> string {
    var b: str::Builder;

    for (let i: i64 in 0..n) {
        b.add("line \(i) ");
        b.add(str::repeat("x", i % 37));
        b.add_byte(10);
    }
    return b.to_string();
}

fn tmp_file(name: string, text: string) -> string {
    let dir: string = fs::temp_dir();
    let p: string = "\(dir)/zap-test-\(name)";

    fs::write_file(p, text);
    return p;
}

#test fn indexes_without_reading() -> i32 {
    let p: string = tmp_file("index", sample(5000));

    match (open(p)) {
        m0 => {
            var m: MemLine = m0;

            if (m.count != 5000) {
                return 1;
            }
            if (m.loaded_count() != 0 || m.chunk_count() < 10) {
                return 2;
            }
            if (!str::eq(m.get(4321), "line 4321 \(str::repeat("x", 4321 % 37))")) {
                return 3;
            }
            if (m.loaded_count() != 1) {
                return 4;
            }
            m.resident = 3;

            for (let i: i64 in 0..5000) {
                if (!str::eq(m.get(i), "line \(i) \(str::repeat("x", i % 37))")) {
                    return 5;
                }
            }
            if (m.loaded_count() > 3) {
                return 6;
            }
        },
        e: fs::NotFound => { return 9; }, e2: fs::PermissionDenied => { return 9; },
        e3: fs::IsADirectory => { return 9; }, e4: fs::IoError => { return 9; }
    }
    return 0;
}

#test fn edits_survive_the_swap() -> i32 {
    let p: string = tmp_file("swap", sample(3000));

    match (open(p)) {
        m0 => {
            var m: MemLine = m0;

            m.resident = 2;

            // change every chunk, then read them all (each changed one goes
            // to the swap file and back)
            for (let i: i64 in 0..300) { m.set(i * 10, "changed \(i)"); }

            for (let i: i64 in 0..600) { m.insert(1500, "new \(i)"); }
            m.remove(0);
            if (m.count != 3599) {
                return 1;
            }
            if (m.swapped == 0) {
                return 2;
            }
            if (!str::eq(m.get(9), "changed 1")) {
                return 3;
            }
            if (!str::eq(m.get(1499), "new 599") || !str::eq(m.get(2098), "new 0")) {
                return 4;
            }
            if (!str::eq(m.get(2099), "changed 150")) {
                return 5;
            }
            if (!str::eq(m.get(3598), "line 2999 \(str::repeat("x", 2999 % 37))")) {
                return 6;
            }
            match (m.write(p, true, false)) {
                n => {},
                e: fs::NotFound => { return 7; }, e2: fs::PermissionDenied => { return 7; },
                e3: fs::IsADirectory => { return 7; }, e4: fs::IoError => { return 7; },
                e5: ChangedOnDisk => { return 7; }
            }
            let back: string = fs::read_file(p) ?? "";
            let lines: string[] = str::split(back, "\n");

            if (lines.len != 3600 || !str::eq(lines[2099], "changed 150")) {
                return 8;
            }
            if (!str::eq(m.get(2099), "changed 150") || m.broken.len > 0) {
                return 10;
            }
            m.close();
        },
        e: fs::NotFound => { return 9; }, e2: fs::PermissionDenied => { return 9; },
        e3: fs::IsADirectory => { return 9; }, e4: fs::IoError => { return 9; }
    }
    return 0;
}

#test fn keeps_line_endings() -> i32 {
    let p: string = tmp_file("crlf", "a\r\nb\r\nc");

    match (open(p)) {
        m0 => {
            var m: MemLine = m0;

            if (!m.crlf || m.eol || m.count != 3) {
                return 1;
            }
            if (!str::eq(m.get(1), "b") || !str::eq(m.get(2), "c")) {
                return 2;
            }
            m.insert(3, "d");
            match (m.write(p, true, false)) {
                n => {},
                e: fs::NotFound => { return 7; }, e2: fs::PermissionDenied => { return 7; },
                e3: fs::IsADirectory => { return 7; }, e4: fs::IoError => { return 7; },
                e5: ChangedOnDisk => { return 7; }
            }
            if (!str::eq(fs::read_file(p) ?? "", "a\r\nb\r\nc\r\nd")) {
                return 3;
            }
        },
        e: fs::NotFound => { return 9; }, e2: fs::PermissionDenied => { return 9; },
        e3: fs::IsADirectory => { return 9; }, e4: fs::IoError => { return 9; }
    }
    var e: MemLine = of_text("");

    if (e.count != 1 || e.get(0).len != 0) {
        return 4;
    }
    return 0;
}

#test fn writes_in_place() -> i32 {
    let p: string = tmp_file("inplace", "one\ntwo\n");
    let link: string = "\(p).link";

    // its own mode, and a symlink to it
    if (process::run(
        ["/bin/sh", "-c", "chmod 751 \"$0\" && rm -f \"$1\" && ln -s \"$0\" \"$1\"", p, link]
    ) !=
        0) {
        return 1;
    }
    match (open(link)) {
        m0 => {
            var m: MemLine = m0;

            m.set(0, "uno");
            match (m.write(link, true, false)) {
                n => {},
                e: fs::NotFound => { return 2; }, e2: fs::PermissionDenied => { return 2; },
                e3: fs::IsADirectory => { return 2; }, e4: fs::IoError => { return 2; },
                e5: ChangedOnDisk => { return 2; }
            }
            // the link is still a link; its file has the new text and mode
            if (process::run(
                [
                    "/bin/sh", "-c",
                    "test -L \"$1\" && test \"$(stat -c %a \"$0\" 2>/dev/null || stat -f %Lp \"$0\")\" = 751",
                    p, link
                ]
            ) !=
                0) {
                return 3;
            }
            if (!str::eq(fs::read_file(p) ?? "", "uno\ntwo\n")) {
                return 4;
            }
            if (!str::eq(m.get(1), "two") || m.broken.len > 0) {
                return 5;
            }
            // changed by someone else: not overwritten unless forced
            fs::write_file(p, "theirs\n");
            m.set(0, "mine");
            match (m.write(link, true, false)) {
                n => { return 6; },
                e: fs::NotFound => { return 7; }, e2: fs::PermissionDenied => { return 7; },
                e3: fs::IsADirectory => { return 7; }, e4: fs::IoError => { return 7; },
                e5: ChangedOnDisk => {}
            }
            if (!str::eq(fs::read_file(p) ?? "", "theirs\n")) {
                return 8;
            }
        },
        e: fs::NotFound => { return 9; }, e2: fs::PermissionDenied => { return 9; },
        e3: fs::IsADirectory => { return 9; }, e4: fs::IoError => { return 9; }
    }
    return 0;
}
