//! Python: keywords (match and case only at statement start), builtins,
//! @decorators, prefixed strings (r b f u, or two of them), multi-line
//! """ and ''' strings, numbers, # comments.
//!
//! State: 0 code, 1 in a """ string, 2 in a ''' string.

import str from "std/string";
import {
    Hl, Group, add, is_ident_start, is_ident, is_digit, is_space, limit_to, string_end, number_end,
    ident_end, Words, words
} from "core.ae";

/// keywords, including soft ones
export let KEYWORDS: string[] = [
    "and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif",
    "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda",
    "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield", "match",
    "case", "type"
];

/// builtin types
export let TYPES: string[] = [
    "int", "float", "complex", "bool", "str", "bytes", "bytearray", "list", "tuple", "dict", "set",
    "frozenset", "object", "type", "range", "memoryview"
];

/// constants
export let CONSTANTS: string[] = [
    "True", "False", "None", "self", "cls", "NotImplemented", "Ellipsis", "__name__", "__file__"
];

// keywords only at statement start (elsewhere names: re.match(...))
let SOFT: string[] = ["match", "case", "type"];

// all of them, for lookup: soft keywords 0, keywords 1, types 2, constants 3
// (soft ones are also in KEYWORDS, so soft comes first)
let WORDS: Words = words(
    &[std::copy(SOFT), std::copy(KEYWORDS), std::copy(TYPES), std::copy(CONSTANTS)]
);

// end of a triple-quoted string from i (inside it, quote q) -> (end, closed?)
fn triple_end(text: &string, i: i64, n: i64, q: u8) -> (i64, bool) {
    var j: i64 = i;

    while (j < n) {
        if (text[j] == '\\') {
            j += 2;
            continue;
        }
        if (text[j] == q && j + 2 < n && text[j + 1] == q && text[j + 2] == q) {
            return (j + 3, true);
        }
        j += 1;
    }
    return (n, false);
}

// a string prefix at i (r, b, f, u, rb, br, fr, rf, any case) and its quote
// -> the quote's position (-1: none)
fn prefixed(text: &string, i: i64, n: i64) -> i64 {
    var j: i64 = i;

    while (j < n && j - i < 2) {
        let c: u8 = text[j];

        if (c != 'r' && c != 'b' && c != 'f' && c != 'u' && c != 'R' && c != 'B' && c != 'F' &&
            c != 'U') {
            break;
        }
        j += 1;
    }
    if (j > i && j < n && (text[j] == '"' || text[j] == '\'')) {
        return j;
    }
    return -1;
}

/// lex bytes lo..hi of a Python line, from state -> next line's state
export fn line(text: &string, lo: i64, hi: i64, state: i64, mut out: &Hl[]) -> i64 {
    let n: i64 = limit_to(text, lo, hi);
    var i: i64 = lo;

    if (state == 1 || state == 2) {
        var q: u8 = '"';

        if (state == 2) { q = '\''; }
        let (e, closed) = triple_end(text, i, n, q);

        add(out, i, e, Group::String);
        if (!closed) {
            return state;
        }
        i = e;
    }
    var first: i64 = i;

    while (first < n && is_space(text[first])) { first += 1; }

    while (i < n) {
        let c: u8 = text[i];

        if (c == '#') {
            add(out, i, n, Group::Comment);
            return 0;
        }
        var q: i64 = -1;

        if (c == '"' || c == '\'') { q = i; }
        else if (is_ident_start(c) && (i == lo || !is_ident(text[i - 1]))) {
            q = prefixed(text, i, n);
        }
        if (q >= 0) {
            let qc: u8 = text[q];

            if (q + 2 < n && text[q + 1] == qc && text[q + 2] == qc) {
                let (e, closed) = triple_end(text, q + 3, n, qc);

                add(out, i, e, Group::String);
                if (!closed) {
                    if (qc == '"') {
                        return 1;
                    }
                    return 2;
                }
                i = e;
                continue;
            }
            let j: i64 = string_end(text, q, n, qc);

            add(out, i, j, Group::String);
            i = j;
            continue;
        }
        if (c == '@' && i == first && i + 1 < n && is_ident_start(text[i + 1])) {
            var e: i64 = ident_end(text, i + 1, n, false);

            while (e + 1 < n && text[e] == '.' && is_ident_start(text[e + 1])) {
                e = ident_end(text, e + 1, n, false);
            }
            add(out, i, e, Group::Constant);
            i = e;
            continue;
        }
        if (is_digit(c) || (c == '.' && i + 1 < n && is_digit(text[i + 1]))) {
            let j: i64 = number_end(text, i, n);

            add(out, i, j, Group::Number);
            i = j;
            continue;
        }
        if (is_ident_start(c)) {
            let j: i64 = ident_end(text, i, n, false);
            // (soft keywords 0, keywords 1, types 2, constants 3)
            let kind: i64 = WORDS.kind_at(text, i, j);
            var k: i64 = j;

            while (k < n && is_space(text[k])) { k += 1; }
            var nx: u8 = 0;

            if (k < n) { nx = text[k]; }
            let attr: bool = i > lo && text[i - 1] == '.';

            if (kind == 0) {
                // match x: / case 1: / type X = ... (not match(...), x.match, match = 1)
                if (i == first && k > j && nx != '=' && nx != '.' && nx != ':' && nx != '(') {
                    add(out, i, j, Group::Keyword);
                } else if (!attr && str::eq(str::substr(*text, i, j - i), "type")) {
                    add(out, i, j, Group::Type);
                } else if (nx == '(') {
                    add(out, i, j, Group::Function);
                }
            } else if (!attr && kind == 1) {
                add(out, i, j, Group::Keyword);
                let word: string = str::substr(*text, i, j - i);

                // def name / class Name: the defined name
                if ((str::eq(word, "def") || str::eq(word, "class")) && k < n &&
                    is_ident_start(nx)) {
                    let e: i64 = ident_end(text, k, n, false);

                    if (str::eq(word, "def")) { add(out, k, e, Group::Function); }
                    else { add(out, k, e, Group::Type); }
                    i = e;
                    continue;
                }
            } else if (!attr && kind == 2) {
                add(out, i, j, Group::Type);
            } else if (!attr && kind == 3) {
                add(out, i, j, Group::Constant);
            } else if (nx == '(') {
                add(out, i, j, Group::Function);
            } else if (c >= 'A' && c <= 'Z') {
                add(out, i, j, Group::Type);
            }
            i = j;
            continue;
        }
        if (c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '=' || c == '<' ||
            c == '>' || c == '!' || c == '&' || c == '|' || c == '^' || c == '~' || c == ':' ||
            (c == '@' && i != first)) {
            add(out, i, i + 1, Group::Operator);
        }
        i += 1;
    }
    return 0;
}
