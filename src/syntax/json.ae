//! JSON, plus JSONC, JSON5 and JSON Lines: object keys (a string, or a
//! JSON5 bare name, before a colon) colored as functions, strings with
//! escapes (JSON5 '...' too), numbers, constants true false null (and
//! Infinity NaN), { } [ ] : , punctuation, // and /* */ comments (JSONC;
//! also in tsconfig.json and similar).
//!
//! State: 0 a value, 1 in a /* */ comment.

import {
    Hl, Group, add, is_ident_start, is_ident, is_digit, is_space, limit_to, Words, words
} from "core.ae";

/// constants
export let CONSTANTS: string[] = ["true", "false", "null", "Infinity", "NaN"];

// constants, for lookup
let CONSTANT_WORDS: Words = words(&[std::copy(CONSTANTS)]);

// end of the string at i (quote q), highlighting its escapes
fn string_at(text: &string, i: i64, n: i64, q: u8, g: Group, mut out: &Hl[]) -> i64 {
    var j: i64 = i + 1;
    var from: i64 = i;

    while (j < n) {
        let c: u8 = text[j];

        if (c == '\\') {
            add(out, from, j, g);
            var e: i64 = j + 2;

            if (j + 1 < n && text[j + 1] == 'u') { e = j + 6; }      // \uXXXX
            if (e > n) { e = n; }
            add(out, j, e, Group::Escape);
            j = e;
            from = j;
            continue;
        }
        j += 1;
        if (c == q) { break; }
    }
    add(out, from, j, g);
    return j;
}

// is the next non-space after i a colon (so this is a key)?
fn before_colon(text: &string, i: i64, n: i64) -> bool {
    var k: i64 = i;

    while (k < n && is_space(text[k])) { k += 1; }
    return k < n && text[k] == ':';
}

// end of the string at i (quote q), without highlighting
fn string_end_at(text: &string, i: i64, n: i64, q: u8) -> i64 {
    var j: i64 = i + 1;

    while (j < n) {
        if (text[j] == '\\') {
            j += 2;
            continue;
        }
        j += 1;
        if (text[j - 1] == q) { break; }
    }
    if (j > n) { j = n; }
    return j;
}

/// lex bytes lo..hi of a JSON line, from state -> next line's state
export fn line(text: &string, lo: i64, hi: i64, state: i64, mut out: &Hl[]) -> i64 {
    let n: i64 = limit_to(text, lo, hi);
    var i: i64 = lo;

    if (state == 1) {
        var j: i64 = i;

        while (j + 1 < n && !(text[j] == '*' && text[j + 1] == '/')) { j += 1; }
        if (j + 1 >= n) {
            add(out, i, n, Group::Comment);
            return 1;
        }
        add(out, i, j + 2, Group::Comment);
        i = j + 2;
    }

    while (i < n) {
        let c: u8 = text[i];

        if (c == '/' && i + 1 < n && text[i + 1] == '/') {
            add(out, i, n, Group::Comment);
            return 0;
        }
        if (c == '/' && i + 1 < n && text[i + 1] == '*') {
            var j: i64 = i + 2;

            while (j + 1 < n && !(text[j] == '*' && text[j + 1] == '/')) { j += 1; }
            if (j + 1 >= n) {
                add(out, i, n, Group::Comment);
                return 1;
            }
            add(out, i, j + 2, Group::Comment);
            i = j + 2;
            continue;
        }
        if (c == '"' || c == '\'') {
            // a key (before a colon) or a value
            let e: i64 = string_end_at(text, i, n, c);
            var g: Group = Group::String;

            if (before_colon(text, e, n)) { g = Group::Function; }
            i = string_at(text, i, n, c, g, out);
            continue;
        }
        if (is_digit(c) || ((c == '-' || c == '+' || c == '.') && i + 1 < n &&
            (is_digit(text[i + 1]) || text[i + 1] == 'I' || text[i + 1] == 'N'))) {
            var j: i64 = i + 1;

            while (j < n && (is_ident(text[j]) || text[j] == '.' || ((text[j] == '-' ||
                text[j] == '+') && (text[j - 1] == 'e' || text[j - 1] == 'E')))) {
                j += 1;
            }
            add(out, i, j, Group::Number);
            i = j;
            continue;
        }
        if (is_ident_start(c) || c == '$') {
            var j: i64 = i + 1;

            while (j < n && (is_ident(text[j]) || text[j] == '$')) { j += 1; }
            if (before_colon(text, j, n)) {
                add(out, i, j, Group::Function);            // JSON5 bare key
            } else if (CONSTANT_WORDS.kind_at(text, i, j) >= 0) {
                add(out, i, j, Group::Constant);
            }
            i = j;
            continue;
        }
        if (c == '{' || c == '}' || c == '[' || c == ']' || c == ':' || c == ',') {
            add(out, i, i + 1, Group::Punct);
        }
        i += 1;
    }
    return 0;
}
