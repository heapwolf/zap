//! Shared lexer code: the groups themes color, highlight spans, scanning
//! helpers, and the lexer for C-like languages (C, C++, JavaScript, Swift),
//! configured by a CLike.
//!
//! A lexer scans bytes lo..hi of a line from a start state (0: nothing
//! open), appends spans to out (in order, non-overlapping), and returns the
//! next line's start state. lo and hi let HTML pass <script> and <style>
//! contents to the JavaScript and CSS lexers.

import str from "std/string";

/// a text span's kind, for theming
export enum Group {
    Normal, Comment, String, Keyword, Type, Number, Function, Constant, Operator, Punct,
    Heading, Bold, Italic, Code, Link, Url, ListMark, Quote, Escape, Error,
}

/// group names as written in themes
export let GROUP_NAMES: string[] = [
    "normal", "comment", "string", "keyword", "type", "number", "function", "constant",
    "operator", "punct", "heading", "bold", "italic", "code", "link", "url", "list", "quote",
    "escape", "error"
];

/// a span: bytes lo..hi of a line are in group g
export struct Hl {
    export lo: i64;
    export hi: i64;
    export g: Group;
}

/// max highlighted bytes per line (the rest is plain)
export let MAX_COL: i64 = 2000;

export fn add(mut out: &Hl[], lo: i64, hi: i64, g: Group) -> void {
    if (hi > lo) { out.push(Hl { lo: lo, hi: hi, g: g }); }
}

export fn is_ident_start(c: u8) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c >= 128;
}

export fn is_ident(c: u8) -> bool { return is_ident_start(c) || (c >= '0' && c <= '9'); }

export fn is_digit(c: u8) -> bool { return c >= '0' && c <= '9'; }

export fn is_space(c: u8) -> bool { return c == ' ' || c == '\t' || c == '\r'; }

/// where highlighting of text from lo stops (at most hi)
export fn limit_to(text: &string, lo: i64, hi: i64) -> i64 {
    var n: i64 = hi;

    if (n > text.len) { n = text.len; }
    if (n - lo > MAX_COL) { n = lo + MAX_COL; }
    return n;
}

/// end of the string literal at i (quote q), skipping escapes (n if
/// unclosed on this line)
export fn string_end(text: &string, i: i64, n: i64, q: u8) -> i64 {
    var j: i64 = i + 1;

    while (j < n) {
        let c: u8 = text[j];

        if (c == '\\') {
            j += 2;
            continue;
        }
        j += 1;
        if (c == q) {
            return j;
        }
    }
    return n;
}

/// end of the number at i (digits, letters for 0x and suffixes, _, a decimal point)
export fn number_end(text: &string, i: i64, n: i64) -> i64 {
    var j: i64 = i;

    while (j < n && (is_ident(text[j]) || text[j] == '.')) {
        if (text[j] == '.' && (j + 1 >= n || !is_digit(text[j + 1]))) { break; }
        // (exponent sign: 1e-9)
        if ((text[j] == 'e' || text[j] == 'E') && j + 1 < n &&
            (text[j + 1] == '-' || text[j + 1] == '+') &&
            !(j > i && (text[i + 1] == 'x' || text[i + 1] == 'X'))) {
            j += 1;
        }
        j += 1;
    }
    return j;
}

/// a language's words, looked up directly from line bytes (no string per
/// lookup): a hash table over several lists; each word's kind is the index
/// of the first list containing it (keywords, types, constants, ...)
export struct Words {
    list: string[] = [];
    kinds: i64[] = [];
    slots: i64[] = [];      // index into list + 1; 0: empty
    mask: i64 = 0;
}

// hash of bytes i..j of text (kept small to avoid overflow)
fn hash_at(text: &string, i: i64, j: i64) -> i64 {
    var h: i64 = 5381;

    for (let k: i64 in i..j) { h = ((h * 33) + (text[k] as i64)) & 16777215; }
    return h;
}

/// build Words from lists; a word's kind is the first list containing it
export fn words(lists: &string[][]) -> Words {
    var w: Words = Words {};
    var count: i64 = 0;

    for (let l: &lists::&string[] in lists) { count += l.len; }
    var size: i64 = 16;

    while (size < count * 2) { size *= 2; }

    for (let k: i64 in 0..size) { w.slots.push(0); }
    w.mask = size - 1;

    for (let kind: i64, let l: &lists::&string[] in lists) {
        for (let word: &l::&string in l) {
            if (w.kind_at(word, 0, word.len) >= 0) { continue; }
            var at: i64 = hash_at(word, 0, word.len) & w.mask;

            while (w.slots[at] != 0) { at = (at + 1) & w.mask; }
            w.list.push(*word);
            w.kinds.push(kind);
            w.slots[at] = w.list.len;
        }
    }
    return w;
}

impl Words {
    /// kind (list index) of the word at bytes i..j of text, or -1
    export fn kind_at(self: &Words, text: &string, i: i64, j: i64) -> i64 {
        if (self.list.len == 0) {
            return -1;
        }
        let n: i64 = j - i;
        var at: i64 = hash_at(text, i, j) & self.mask;

        while (self.slots[at] != 0) {
            let k: i64 = self.slots[at] - 1;
            let w: &self::&string = &self.list[k];

            if (w.len == n) {
                var same: bool = true;

                for (let b: i64 in 0..n) {
                    if (w[b] != text[i + b]) {
                        same = false;
                        break;
                    }
                }
                if (same) {
                    return self.kinds[k];
                }
            }
            at = (at + 1) & self.mask;
        }
        return -1;
    }

    /// kind of word, or -1
    export fn kind(self: &Words, word: &string) -> i64 { return self.kind_at(word, 0, word.len); }

    /// is word in the table?
    export fn has(self: &Words, word: &string) -> bool {
        return self.kind_at(word, 0, word.len) >= 0;
    }
}

/// is word in set? (for short lists; use Words for a language's words)
export fn one_of(word: &string, set: &string[]) -> bool {
    for (let w: string in set) {
        if (str::eq(w, *word)) {
            return true;
        }
    }
    return false;
}

/// end of the identifier at i (dollar: $ counts as a name character)
export fn ident_end(text: &string, i: i64, n: i64, dollar: bool) -> i64 {
    var j: i64 = i;

    while (j < n && (is_ident(text[j]) || (dollar && text[j] == '$'))) { j += 1; }
    return j;
}

// ---- C family -------------------------------------------------------------------

/// a C-like language's features (its words are passed to clike)
export struct CLike {
    export nested: bool = false;            // /* */ nests (Swift)
    export template: bool = false;          // multi-line `...` strings (JavaScript)
    export triple: bool = false;            // multi-line """ strings (Swift)
    export preproc: bool = false;           // # lines are directives (C)
    export pound: bool = false;             // #name is a directive anywhere (Swift: #if,
                                            //   #available)
    export attrs: bool = false;             // @name is an attribute (Swift; JavaScript
                                            //   decorators)
    export quotes: bool = false;            // '...' is a literal (C characters, JavaScript
                                            //   strings)
    export regex: bool = false;             // /.../ in value position is a regex (JavaScript)
    export dollar: bool = false;            // $ is a name character (JavaScript)
    export raw: bool = false;               // multi-line R"x(...)x" strings (C++)
    export separators: bool = false;        // ' digit separators (C++: 1'000'000)
}

/// states: 0 code; 1..99 in /* */ (the depth, if nested); 100 in a
/// template string; 101 in a triple-quoted string; 102 in a raw string
export let IN_TEMPLATE: i64 = 100;
export let IN_TRIPLE: i64 = 101;
export let IN_RAW: i64 = 102;

// end of a raw string from i (inside it) at its )delimiter" (this delimiter,
// or any one on lines after the opening) -> (end, closed?)
fn raw_end(text: &string, i: i64, n: i64, delim: string, any: bool) -> (i64, bool) {
    var j: i64 = i;

    while (j < n) {
        if (text[j] == ')') {
            if (!any) {
                let close: string = ")\(delim)\"";

                if (j + close.len <= n && str::eq(str::substr(*text, j, close.len), close)) {
                    return (j + close.len, true);
                }
            } else {
                var k: i64 = j + 1;

                while (k < n && k - j <= 17 && text[k] != '"' && text[k] != ' ' && text[k] != '(' &&
                    text[k] != ')' && text[k] != '\\') {
                    k += 1;
                }
                if (k < n && text[k] == '"') {
                    return (k + 1, true);
                }
            }
        }
        j += 1;
    }
    return (n, false);
}

// end of a block comment from i at depth -> (end, remaining depth; 0: closed)
fn comment_end(text: &string, i: i64, n: i64, depth: i64, nested: bool) -> (i64, i64) {
    var j: i64 = i;
    var d: i64 = depth;

    while (j < n) {
        if (j + 1 < n && text[j] == '*' && text[j + 1] == '/') {
            d -= 1;
            j += 2;
            if (d == 0) {
                return (j, 0);
            }
            continue;
        }
        if (nested && j + 1 < n && text[j] == '/' && text[j + 1] == '*') {
            d += 1;
            j += 2;
            continue;
        }
        j += 1;
    }
    return (n, d);
}

// end of a template string from i (inside it) -> (end, closed?)
fn template_end(text: &string, i: i64, n: i64) -> (i64, bool) {
    var j: i64 = i;

    while (j < n) {
        if (text[j] == '\\') {
            j += 2;
            continue;
        }
        if (text[j] == '`') {
            return (j + 1, true);
        }
        j += 1;
    }
    return (n, false);
}

// end of a triple-quoted string from i (inside it) -> (end, closed?)
fn triple_end(text: &string, i: i64, n: i64) -> (i64, bool) {
    if (let k = str::find_from(*text, "\"\"\"", i)) {
        if (k + 3 <= n) {
            return (k + 3, true);
        }
    }
    return (n, false);
}

// can a / at i start a regex (i.e. what precedes it is not a value)?
fn pattern_here(text: &string, lo: i64, i: i64) -> bool {
    var k: i64 = i - 1;

    while (k >= lo && is_space(text[k])) { k -= 1; }
    if (k < lo) {
        return true;
    }
    let p: u8 = text[k];

    if (p == '(' || p == ',' || p == '=' || p == ':' || p == '[' || p == '!' || p == '&' ||
        p == '|' || p == '?' || p == '{' || p == '}' || p == ';' || p == '+' || p == '-' ||
        p == '*' || p == '%' || p == '<' || p == '>' || p == '~' || p == '^') {
        return true;
    }
    // (a value follows return, typeof, ...)
    var a: i64 = k;

    while (a > lo && is_ident(text[a - 1])) { a -= 1; }
    let w: string = str::substr(*text, a, k + 1 - a);

    return str::eq(w, "return") || str::eq(w, "typeof") || str::eq(w, "case") || str::eq(w, "in") ||
        str::eq(w, "of") || str::eq(w, "delete") || str::eq(w, "void") || str::eq(w, "yield");
}

// end of the regex at i: past its closing / (not inside [...]) and its flags
fn pattern_end(text: &string, i: i64, n: i64) -> i64 {
    var j: i64 = i + 1;
    var in_set: bool = false;

    while (j < n) {
        let c: u8 = text[j];

        if (c == '\\') {
            j += 2;
            continue;
        }
        if (c == '[') { in_set = true; }
        if (c == ']') { in_set = false; }
        if (c == '/' && !in_set) {
            j += 1;

            while (j < n && is_ident(text[j])) { j += 1; }
            return j;
        }
        j += 1;
    }
    return -1;
}

/// lex bytes lo..hi of text as language spec (words: its keywords, types,
/// constants), from state -> next line's state
export fn clike(
    text: &string, lo: i64, hi: i64, state: i64, mut out: &Hl[], spec: &CLike, words: &Words
) -> i64 {
    let n: i64 = limit_to(text, lo, hi);
    var i: i64 = lo;

    // continue what the previous line left open
    if (state >= 1 && state < 100) {
        let (e, d) = comment_end(text, i, n, state, spec.nested);

        add(out, i, e, Group::Comment);
        if (d > 0) {
            return d;
        }
        i = e;
    } else if (state == IN_TEMPLATE) {
        let (e, closed) = template_end(text, i, n);

        add(out, i, e, Group::String);
        if (!closed) {
            return IN_TEMPLATE;
        }
        i = e;
    } else if (state == IN_TRIPLE) {
        let (e, closed) = triple_end(text, i, n);

        add(out, i, e, Group::String);
        if (!closed) {
            return IN_TRIPLE;
        }
        i = e;
    } else if (state == IN_RAW) {
        let (e, closed) = raw_end(text, i, n, "", true);

        add(out, i, e, Group::String);
        if (!closed) {
            return IN_RAW;
        }
        i = e;
    }
    // (first non-space: where a C directive starts)
    var first: i64 = i;

    while (first < n && is_space(text[first])) { first += 1; }

    while (i < n) {
        let c: u8 = text[i];
        var c2: u8 = 0;

        if (i + 1 < n) { c2 = text[i + 1]; }
        if (c == '/' && c2 == '/') {
            add(out, i, n, Group::Comment);
            return 0;
        }
        if (c == '/' && c2 == '*') {
            let (e, d) = comment_end(text, i + 2, n, 1, spec.nested);

            add(out, i, e, Group::Comment);
            if (d > 0) {
                return d;
            }
            i = e;
            continue;
        }
        if (c == '"') {
            if (spec.triple && c2 == '"' && i + 2 < n && text[i + 2] == '"') {
                let (e, closed) = triple_end(text, i + 3, n);

                add(out, i, e, Group::String);
                if (!closed) {
                    return IN_TRIPLE;
                }
                i = e;
                continue;
            }
            let j: i64 = string_end(text, i, n, '"');

            add(out, i, j, Group::String);
            i = j;
            continue;
        }
        if (c == '\'' && spec.quotes) {
            let j: i64 = string_end(text, i, n, '\'');

            add(out, i, j, Group::String);
            i = j;
            continue;
        }
        if (c == '`' && spec.template) {
            let (e, closed) = template_end(text, i + 1, n);

            add(out, i, e, Group::String);
            if (!closed) {
                return IN_TEMPLATE;
            }
            i = e;
            continue;
        }
        if (c == '#' && ((spec.preproc && i == first) || spec.pound) && i + 1 < n) {
            // #include <file>: the directive, then the file as a string
            var j: i64 = i + 1;

            while (spec.preproc && j < n && is_space(text[j])) { j += 1; }
            let e: i64 = ident_end(text, j, n, false);

            if (e > j) {
                add(out, i, e, Group::Constant);
                let word: string = str::substr(*text, j, e - j);

                if (spec.preproc && (str::eq(word, "include") || str::eq(word, "import"))) {
                    var k: i64 = e;

                    while (k < n && is_space(text[k])) { k += 1; }
                    if (k < n && text[k] == '<') {
                        var m: i64 = k;

                        while (m < n && text[m] != '>') { m += 1; }
                        if (m < n) { m += 1; }
                        add(out, k, m, Group::String);
                        i = m;
                        continue;
                    }
                }
                i = e;
                continue;
            }
        }
        if (c == '@' && spec.attrs && i + 1 < n && is_ident_start(text[i + 1])) {
            let e: i64 = ident_end(text, i + 1, n, spec.dollar);

            add(out, i, e, Group::Constant);
            i = e;
            continue;
        }
        if (c == '/' && spec.regex && pattern_here(text, lo, i)) {
            let e: i64 = pattern_end(text, i, n);

            if (e > i) {
                add(out, i, e, Group::Escape);
                i = e;
                continue;
            }
        }
        if (is_digit(c) || (c == '.' && is_digit(c2))) {
            var j: i64 = number_end(text, i, n);

            while (spec.separators && j + 1 < n && text[j] == '\'' && is_ident(text[j + 1])) {
                j = number_end(text, j + 1, n);
            }
            add(out, i, j, Group::Number);
            i = j;
            continue;
        }
        // R"x(...)x", optionally prefixed: LR, uR, UR, u8R
        if (spec.raw && (c == 'R' || c == 'L' || c == 'u' || c == 'U')) {
            var q: i64 = i;

            while (q < n && q - i < 3 && (text[q] == 'L' || text[q] == 'u' || text[q] == 'U' ||
                text[q] == '8')) {
                q += 1;
            }
            if (q + 1 < n && text[q] == 'R' && text[q + 1] == '"') {
                let open: i64 = str::find_from(*text, "(", q + 2) ?? -1;

                if (open > 0 && open < n && open - q - 2 <= 16) {
                    let delim: string = str::substr(*text, q + 2, open - q - 2);
                    let (e, closed) = raw_end(text, open + 1, n, delim, false);

                    add(out, i, e, Group::String);
                    if (!closed) {
                        return IN_RAW;
                    }
                    i = e;
                    continue;
                }
            }
        }
        if (is_ident_start(c) || (spec.dollar && c == '$')) {
            let j: i64 = ident_end(text, i, n, spec.dollar);
            // (words: keywords 0, types 1, constants 2)
            let kind: i64 = words.kind_at(text, i, j);
            var k: i64 = j;

            while (k < n && is_space(text[k])) { k += 1; }
            if (kind == 0) {
                add(out, i, j, Group::Keyword);
            } else if (kind == 1) {
                add(out, i, j, Group::Type);
            } else if (kind == 2) {
                add(out, i, j, Group::Constant);
            } else if (k < n && text[k] == '(') {
                add(out, i, j, Group::Function);
            } else if (c >= 'A' && c <= 'Z') {
                add(out, i, j, Group::Type);
            }
            i = j;
            continue;
        }
        if (c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '=' || c == '<' ||
            c == '>' || c == '!' || c == '&' || c == '|' || c == '^' || c == '~' || c == '?' ||
            c == ':') {
            add(out, i, i + 1, Group::Operator);
        }
        i += 1;
    }
    return 0;
}
