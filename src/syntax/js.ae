//! JavaScript (plus TypeScript words): keywords, multi-line `template`
//! strings, '...' and "..." strings, /regexes/, @decorators, comments,
//! numbers; $ is a name character.

import { Hl, CLike, clike, Words, words } from "core.ae";

/// JavaScript and TypeScript keywords
export let KEYWORDS: string[] = [
    "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do",
    "else", "export", "extends", "finally", "for", "function", "if", "import", "in",
    "instanceof", "let", "new", "return", "super", "switch", "throw", "try", "typeof", "var",
    "void", "while", "with", "yield", "async", "await", "of", "static", "get", "set", "from",
    "as", "interface", "type", "enum", "implements", "namespace", "declare", "abstract",
    "readonly", "private", "protected", "public", "keyof", "infer", "is", "satisfies",
    "override"
];

/// TypeScript types
export let TYPES: string[] = [
    "number", "string", "boolean", "any", "unknown", "never", "object", "symbol", "bigint"
];

/// constants
export let CONSTANTS: string[] = ["true", "false", "null", "undefined", "NaN", "Infinity", "this"];

// all three, for lookup (keywords 0, types 1, constants 2)
let WORDS: Words = words(&[std::copy(KEYWORDS), std::copy(TYPES), std::copy(CONSTANTS)]);

fn spec() -> CLike {
    return CLike {
        template: true, attrs: true,
        quotes: true, regex: true, dollar: true
    };
}

/// lex bytes lo..hi of a JavaScript line, from state -> next line's state
export fn line(text: &string, lo: i64, hi: i64, state: i64, mut out: &Hl[]) -> i64 {
    let s: CLike = spec();

    return clike(text, lo, hi, state, out, &s, &WORDS);
}
