//! Swift: keywords (including contextual ones), types, @attributes,
//! #directives, nested /* */ comments, strings, multi-line """ strings,
//! numbers.

import { Hl, CLike, clike, Words, words } from "core.ae";

/// keywords, including contextual ones
export let KEYWORDS: string[] = [
    "associatedtype", "class", "deinit", "enum", "extension", "fileprivate", "func", "import",
    "init", "inout", "internal", "let", "open", "operator", "private", "precedencegroup",
    "protocol", "public", "rethrows", "static", "struct", "subscript", "typealias", "var",
    "break", "case", "catch", "continue", "default", "defer", "do", "else", "fallthrough", "for",
    "guard", "if", "in", "repeat", "return", "throw", "switch", "where", "while", "as", "is",
    "try", "await", "async", "throws", "some", "any", "get", "set", "willSet", "didSet", "lazy",
    "weak", "unowned", "mutating", "nonmutating", "override", "final", "required", "convenience",
    "dynamic", "optional", "indirect", "actor", "nonisolated", "isolated", "consuming",
    "borrowing", "consume", "package", "macro", "each"
];

/// standard types (any capitalized name is a type anyway)
export let TYPES: string[] = [
    "Int", "Int8", "Int16", "Int32", "Int64", "UInt", "UInt8", "UInt16", "UInt32", "UInt64",
    "Double", "Float", "Bool", "String", "Character", "Void", "Any", "AnyObject", "Never",
    "Self"
];

/// constants
export let CONSTANTS: string[] = ["true", "false", "nil", "self", "super"];

// all three, for lookup (keywords 0, types 1, constants 2)
let WORDS: Words = words(&[std::copy(KEYWORDS), std::copy(TYPES), std::copy(CONSTANTS)]);

fn spec() -> CLike {
    return CLike {
        nested: true, triple: true,
        pound: true, attrs: true
    };
}

/// lex bytes lo..hi of a Swift line, from state -> next line's state
export fn line(text: &string, lo: i64, hi: i64, state: i64, mut out: &Hl[]) -> i64 {
    let s: CLike = spec();

    return clike(text, lo, hi, state, out, &s, &WORDS);
}
